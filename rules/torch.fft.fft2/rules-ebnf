Rule 11 (input tensor must have complex dtype)
{v_1 : tensor} |= dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 12 (If a dimension is specified in dim, the corresponding dimension cannot have zero size)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : shape(v_1, v_2[i]) > 0
