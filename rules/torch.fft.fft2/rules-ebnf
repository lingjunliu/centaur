Rule 7 (If out is specified, its dtype must be complex)
{v_1 : tensor} |= if v_1 then (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10)
>>
Rule 8 (The dimensions specified in dim must be within the valid range for the input tensor)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : (0 - ndim(v_1)) ≤ v_2[i] ∧ v_2[i] < ndim(v_1)
>>
Rule 9 (If s is given, its length must be less than or equal to the number of dimensions of the input tensor)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len ≤ ndim(v_1)
>>
Rule 10 (If out is specified, it must be a Tensor and have compatible shape)
{v_1 : tensor, v_2 : tensor} |= if v_2 then ndim(v_1) = ndim(v_2)
