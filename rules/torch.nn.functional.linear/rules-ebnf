Rule 1 (input and weight tensors in linear function must have the same dtype, weight must be 2D, bias can be either 1D or empty tuple)
{v_1 : tensor, v_2 : tensor, v_3 : tensor ⊎ tuple(tensor)} |= dtype_(v_1) = dtype_(v_2) ∧ ndim(v_2) = 2 ∧ (ndim(v_3) = 1 ∨ ndim(v_3) = 0)
>>
Rule 2 (input and weight's last dimension should match when weight is a matrix.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) = 2 then shape(v_1, ndim(v_1)-1) = shape(v_2, 1)
>>
Rule 3 (If bias is present, its shape should match the first dimension of weight when weight is a matrix)
{v_2 : tensor, v_3 : tensor} |= if ndim(v_3) = 1 then shape(v_3, 0) = shape(v_2, 0)
>>
Rule 4 (weight cannot be a scalar.)
{v_2 : tensor} |= ndim(v_2) > 0
>>
Rule 5 (If weight is a vector, its length should equal the last dimension of the input)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) = 1 then shape(v_1, ndim(v_1) - 1) = shape(v_2, 0)
>>
Rule 6 (input tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 7 (if bias is present, it must be a 1-D tensor)
{v_3 : tensor} |= ndim(v_3) = 1
>>
Rule 8 (Dtype of bias must match dtype of input)
{v_1 : tensor, v_3 : tensor} |= dtype_(v_1) = dtype_(v_3)
>>
Rule 9 (If weight is a 2D tensor, the bias must have the same dtype)
{v_2 : tensor, v_3 : tensor} |= if ndim(v_2) = 2 then dtype_(v_2) = dtype_(v_3)
>>
Rule 10 (If bias is a 1D tensor, the weight must be a 2D tensor)
{v_2 : tensor, v_3 : tensor} |= if ndim(v_3) = 1 then ndim(v_2) = 2
>>
Rule 11 (If bias is an empty tuple, the weight must be a 1D tensor.)
{v_2 : tensor, v_3 : tuple(tensor)} |= if ndim(v_3) = 0 then ndim(v_2) = 1
>>
Rule 12 (When weight is a 2D matrix, its first dimension (out_features) cannot be zero.)
{v_2 : tensor} |= if ndim(v_2) = 2 then shape(v_2, 0) > 0
>>
Rule 13 (When weight is a vector, its length cannot be zero)
{v_2 : tensor} |= if ndim(v_2) = 1 then shape(v_2, 0) > 0
>>
Rule 14 (If weight is a 1D tensor, the bias must be None)
{v_2 : tensor, v_3 : tensor ⊎ tuple(tensor)} |= if ndim(v_2) = 1 then ndim(v_3) = 0
>>
Rule 15 (When weight is a matrix its shape cannot be [0,0])
{v_2 : tensor} |= if ndim(v_2) = 2 then shape(v_2, 0) > 0 ∧ shape(v_2, 1) > 0
>>
Rule 16 (If input has more than 2 dimensions, weight must be a matrix)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 1 then ndim(v_2) = 2
>>
Rule 17 (If input is a 1D tensor, weight must be a vector)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 then ndim(v_2) = 1
>>
Rule 18 (Dtype of weight must be one of the floating point types.)
{v_2 : tensor} |= dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8
>>
Rule 19 (If the input has a batch dimension, the weight must be a matrix.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 2 then ndim(v_2) = 2
>>
Rule 20 (If weight has a batch dimension, the input must have a batch dimension.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > 2 then ndim(v_1) > 2
