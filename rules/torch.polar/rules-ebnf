Rule 3 (abs tensor should not contain negative values)
{v_1 : tensor} |= min(v_1) ≥ 0
>>
Rule 4 (out tensor is complex and has the same shape as abs)
{v_1 : tensor, v_3 : tensor} |= (dtype_(v_3) = 10 ∨ dtype_(v_3) = 11) ∧ (ndim(v_1) = ndim(v_3) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_3, i)) ∨ (ndim(v_1) = 0 ∧ ndim(v_3) = 0)
>>
Rule 5 (if abs is float32, then out is complex64, else if abs is float64, then out is complex128)
{v_1 : tensor, v_3 : tensor} |= if dtype_(v_1) = 7 then dtype_(v_3) = 10 else if dtype_(v_1) = 8 then dtype_(v_3) = 11
>>
Rule 6 (angle tensor should not contain infinite values)
{v_2 : tensor} |= ∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) ≥ 0
>>
Rule 7 (if out is specified, its dtype must be complex)
{v_3 : tensor} |= (dtype_(v_3) = 10) ∨ (dtype_(v_3) = 11)
>>
Rule 8 (angle tensor should not contain NaN values)
{v_2 : tensor} |= min(v_2) = min(v_2)
