{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ((dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8) ∧ dtype_(v_1) = dtype_(v_2) ∧ ((dtype_(v_1) = 7 ∧ dtype_(v_3) = 10) ∨ (dtype_(v_1) = 8 ∧ dtype_(v_3) = 11)))
