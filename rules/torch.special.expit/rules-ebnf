{v_1 : tensor, v_2 : tensor} |= if v_2 ≠ "none" then ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 4 (Input tensor cannot be boolean)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 5 (The input tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 6 (If output tensor is provided, it must have a floating-point or complex dtype)
{v_2 : tensor} |= if v_2 ≠ "none" then (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)
>>
Rule 7 (If out is provided, it cannot be of integer type.)
{v_2 : tensor} |= if v_2 ≠ "none" then (dtype_(v_2) ≠ 1 ∧ dtype_(v_2) ≠ 2 ∧ dtype_(v_2) ≠ 3 ∧ dtype_(v_2) ≠ 4 ∧ dtype_(v_2) ≠ 5)
>>
Rule 8 (If out is provided, its dtype must be compatible with input's dtype)
{v_1 : tensor, v_2 : tensor} |= if v_2 ≠ "none" then (if (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) then (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8) else (dtype_(v_2) = 9 ∨ dtype_(v_2) = 10))
