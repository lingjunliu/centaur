Rule 12 (if the input tensor only has one dimension, then start_dim must be 0 and end_dim can only be 0 or -1)
{v_1 : tensor, v_2 : int, v_3 : int} |= if ndim(v_1) = 1 then v_2 = 0 ∧ (v_3 = 0 ∨ v_3 = -1)
