{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) = 3 ∧ ndim(v_2) = 3 ∧ ndim(v_3) = 3 ∧ shape(v_1, 0) = shape(v_2, 0) ∧ shape(v_1, 0) = shape(v_3, 0) ∧ shape(v_1, 1) = shape(v_2, 1) ∧ shape(v_1, 2) = shape(v_3, 2)
