Rule 1 (batch1 and batch2 must be 3-D tensors with the same number of matrices)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 3 ∧ ndim(v_2) = 3 ∧ shape(v_1, 0) = shape(v_2, 0)
>>
Rule 2 (input, batch1, and batch2 dtypes must be the same)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= dtype_(v_1) = dtype_(v_2) ∧ dtype_(v_1) = dtype_(v_3)
>>
Rule 3 (input tensor shape should be broadcastable with batch1 and batch2 multiplication result)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) = 3 ∧ ndim(v_2) = 3 ∧ ndim(v_3) = 3 ∧ shape(v_1,0) = shape(v_2,0) ∧ shape(v_1,1) = shape(v_2,1) ∧ shape(v_1,2) = shape(v_3,2) ∧ shape(v_2,2) = shape(v_3,1)
>>
Rule 4 (alpha and beta must be int if input is not FloatTensor/DoubleTensor, otherwise must be float)
{v_1 : tensor, v_2 : int ⊎ float, v_3 : int ⊎ float} |= if (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) then true else (v_2 = v_2 ∧ v_3 = v_3)
>>
Rule 5 (batch1's last dimension must equal batch2's second to last dimension for matrix multiplication)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 3 ∧ ndim(v_2) = 3 ∧ shape(v_1, 2) = shape(v_2, 1)
>>
Rule 6 (output tensor, if provided, must have the same dtype as input tensor)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 7 (If beta is 0, input shape can be anything, otherwise input must be broadcastable to the result of batch1 @ batch2)
{v_1 : tensor, v_2 : float, v_3 : tensor, v_4 : tensor} |= if v_2 = 0 then true else (ndim(v_1) = 3 ∧ ndim(v_3) = 3 ∧ ndim(v_4) = 3 ∧ shape(v_1,0) = shape(v_3,0) ∧ shape(v_1,1) = shape(v_3,1) ∧ shape(v_1,2) = shape(v_4,2) ∧ shape(v_3,2) = shape(v_4,1))
>>
Rule 8 (If output tensor is provided, its shape must be (b, n, p) where batch1 is (b, n, m) and batch2 is (b, m, p))
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) = 3 ∧ ndim(v_2) = 3 ∧ ndim(v_3) = 3 ∧ shape(v_1, 0) = shape(v_2, 0) ∧ shape(v_3,0) = shape(v_1,0) ∧ shape(v_1,1) = shape(v_2,1) ∧ shape(v_3,2) = shape(v_2,2)
>>
Rule 9 (out argument must be a Tensor, not a float)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_1, i)
>>
Rule 10 (If input's dtype is float16, ROCm devices may use different precision for backward)
{v_1 : tensor} |= if dtype_(v_1) = 6 then true
>>
Rule 11 (Input and batch1 have the same number of rows and columns as the first two dimensions.)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 1) = shape(v_2, 1) ∧ shape(v_1, 0) = shape(v_2, 0)
>>
Rule 12 (Shape of the product of batch1 and batch2 should be compatible with the shape of input tensor, if beta is not 0.)
{v_1 : tensor, v_2 : tensor, v_3 : float} |= if v_3 = 0 then true else (shape(v_1, 0) = shape(v_2, 0))
>>
Rule 13 (batch1 last dimension must match batch2 second dimension for matrix multiplication)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 2) = shape(v_2, 1)
