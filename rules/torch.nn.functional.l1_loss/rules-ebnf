Rule 6 (If reduction is sum/mean, then at least one dimension of the input tensors must not be zero)
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if (v_3 = "sum" ∨ v_3 = "mean") then ((∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0))
