{v_1 : tensor, v_2 : tensor, v_3 : str} |= if (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) then ((∃j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) = 0) ∨ v_3 = "sum" ∨ v_3 = "mean")
