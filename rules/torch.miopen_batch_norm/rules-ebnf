Rule 1 (training and running mean data types should match)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (input tensor must be at least 3D)
{v_1 : tensor} |= ndim(v_1) ≥ 3
>>
Rule 3 (weight and bias tensors must have the same size as the channel dimension of the input tensor)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= shape(v_2, 0) = shape(v_3, 0) ∧ shape(v_1, 1) = shape(v_2, 0)
>>
Rule 4 (batch dimension of the input tensor should be greater than 0)
{v_1 : tensor} |= shape(v_1, 0) > 0
>>
Rule 5 (weight and bias tensors must be 1D)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 1 ∧ ndim(v_2) = 1
>>
Rule 6 (input, weight, and bias tensors must have the same dtype)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= dtype_(v_1) = dtype_(v_2) ∧ dtype_(v_1) = dtype_(v_3)
>>
Rule 7 (If training is true, running_mean and running_var must be provided)
{v_1 : bool, v_2 : tensor, v_3 : tensor} |= if v_1 then ndim(v_2) > 0 ∧ ndim(v_3) > 0
>>
Rule 8 (eps value must be a non-negative float)
{v_1 : float} |= v_1 ≥ 0
>>
Rule 9 (momentum value must be between 0 and 1 inclusive)
{v_1 : float} |= 0 ≤ v_1 ∧ v_1 ≤ 1
>>
Rule 10 (If training is false, running_mean and running_var must be provided and be non-empty.)
{v_1 : bool, v_2 : tensor, v_3 : tensor} |= if v_1 = false then ndim(v_2) > 0 ∧ ndim(v_3) > 0 ∧ shape(v_2, 0) > 0 ∧ shape(v_3, 0) > 0
>>
Rule 11 (weight, bias, running_mean and running_var should have compatible dtypes)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : tensor} |= (dtype_(v_1) = dtype_(v_2)) ∧ (dtype_(v_1) = dtype_(v_3)) ∧ (dtype_(v_1) = dtype_(v_4))
>>
Rule 12 (If input is a quantized tensor, weight and bias must be provided)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if dtype_(v_1) = 13 then ndim(v_2) > 0 ∧ ndim(v_3) > 0
>>
Rule 13 (If training is true, input tensor must be of floating point type)
{v_1 : bool, v_2 : tensor} |= if v_1 then (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)
>>
Rule 14 (momentum must be a float between 0 and 1 inclusive, eps is float and not negative)
{v_1 : float, v_2 : float} |= 0 ≤ v_1 ∧ v_1 ≤ 1 ∧ v_2 ≥ 0
>>
Rule 15 (Input tensor and weight tensor's 1st dimension must match if weight and bias are provided.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > 0 then shape(v_1, 1) = shape(v_2, 0)
>>
Rule 16 (Input, running_mean and running_var must have compatible dtypes)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= (dtype_(v_1) = dtype_(v_2)) ∧ (dtype_(v_1) = dtype_(v_3))
