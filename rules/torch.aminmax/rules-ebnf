Rule 34 (If out is provided, dtype of tensor in the tuple should be the same as the input tensor)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 35 (If keepdim is False, the dimension dim should be a valid dimension of input.)
{v_1 : tensor, v_2 : int, v_3 : bool} |= if v_3 = false then (0 - ndim(v_1)) ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 44 (If keepdim is True, the output shape at dimension dim should be 1)
{v_1 : tensor, v_2 : int, v_3 : bool} |= if v_3 = true then shape(v_1, v_2) = 1
>>
Rule 50 (If dim is provided, the dimension should fall into valid range)
{v_1 : tensor, v_2 : int} |= (0 - ndim(v_1)) <= v_2 ∧ v_2 < ndim(v_1)
>>
Rule 57 (The two tensors in out should have same data type with the input tensor.)
{v_1 : tensor, v_2 : tensor, v_3 : tuple(tensor)} |= dtype_(v_1) = dtype_(v_2) ∧ dtype_(v_1) = dtype_(v_3)
>>
