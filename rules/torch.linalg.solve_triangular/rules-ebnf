Rule 1 (A and B tensors must have compatible shapes for solve_triangular)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 then ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2) else ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1)
>>
Rule 2 (A must be square if left is True)
{v_1 : tensor, v_2 : bool} |= if v_2 then ndim(v_1) ≥ 2 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 3 (A and B tensors must have compatible dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 4 (A and B tensors must have at least 2 dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2
>>
Rule 5 (A dtype must be float, double, cfloat or cdouble)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 6 (unitriangular must be a boolean)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 7 (Last two dimensions of A must be same size when solving AX=B if left=True)
{v_1 : tensor, v_2 : bool} |= if v_2 then shape(v_1, ndim(v_1)-1) = shape(v_1, ndim(v_1)-2)
>>
Rule 8 (A must be square if left is True, considering batch dimensions)
{v_1 : tensor, v_2 : bool} |= if v_2 then ∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) = shape(v_1, i) ∧ shape(v_1, ndim(v_1)-1) = shape(v_1, ndim(v_1)-2)
>>
Rule 9 (When left=False, the first two dimensions of A must be same size)
{v_1 : tensor, v_2 : bool} |= if (v_2 = false) then shape(v_1, ndim(v_1)-1) = shape(v_1, ndim(v_1)-2)
>>
Rule 10 (When A and B are batched, they must have similar number of batch dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 2 ∧ ndim(v_2) > 2 then (ndim(v_1) - ndim(v_2)) ≥ -2 ∧ (ndim(v_1) - ndim(v_2)) ≤ 2
