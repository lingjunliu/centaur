{v_1: tensor, v_2: int} |= if v_2 ≥ 0 ∧ v_2 < ndim(v_1) then shape(v_1, v_2) > 0 else if v_2 < 0 ∧ v_2 ≥ (0 - ndim(v_1)) then shape(v_1, ndim(v_1) + v_2) > 0
