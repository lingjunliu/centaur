Rule 1 (input and target tensors must have the same shape)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 2 (reduction parameter must be a valid string)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "mean" ∨ v_1 = "sum"
>>
Rule 3 (size_average and reduce are mutually exclusive when both are booleans)
{v_1 : bool, v_2 : bool} |= if v_1 = true then v_2 = false else if v_1 = false then v_2 = true
>>
Rule 4 (if reduction is none, size_average and reduce must be false)
{v_1 : str, v_2 : bool, v_3 : bool} |= if v_1 = "none" then v_2 = false ∧ v_3 = false
>>
Rule 5 (input and target dtypes should be float if reduction is mean or sum)
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "mean" ∨ v_3 = "sum" then (dtype_(v_1) = 7) ∨ (dtype_(v_1) = 8) ∧ (dtype_(v_2) = 7) ∨ (dtype_(v_2) = 8)
>>
Rule 6 (if input and target have different number of dimensions, both should be one)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≠ ndim(v_2) then ndim(v_1) = 1 ∧ ndim(v_2) = 1
>>
Rule 7 (if input is empty tensor, then target must also be)
{v_1 : tensor, v_2 : tensor} |= if ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0 then ∃j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) = 0
>>
Rule 8 (If reduction is 'none', then input and target must have same dtype)
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "none" then dtype_(v_1) = dtype_(v_2)
>>
Rule 9 (if size_average or reduce are specified, reduction must be default or not specified)
{v_1 : bool, v_2 : bool, v_3 : str} |= if (v_1 = true ∨ v_1 = false) ∨ (v_2 = true ∨ v_2 = false) then v_3 = "mean" ∨ v_3 = ""
>>
Rule 10 (input and target tensors must have floating point or complex dtypes)
{v_1 : tensor, v_2 : tensor} |= (6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 11) ∧ (6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 11)
>>
Rule 11 (if reduction is sum or mean, total number of elements should match)
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "sum" ∨ v_3 = "mean" then (∃N ∈ [1, 10000] : (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) * shape(v_2, i) = N))
>>
Rule 12 (if reduction is none, then input and target must have same dtype and shape)
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "none" then dtype_(v_1) = dtype_(v_2) ∧ ndim(v_1) = ndim(v_2) ∧ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 13 (dimension difference between input and target tensors should not exceed one)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > ndim(v_2) then ndim(v_1) - ndim(v_2) ≤ 1 else ndim(v_2) - ndim(v_1) ≤ 1
