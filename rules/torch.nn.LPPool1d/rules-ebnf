Rule 1 (kernel_size and stride should be greater than zero)
{v_1 : int, v_2 : int} |= v_1 > 0 ∧ v_2 > 0
>>
Rule 2 (Input tensor should have 2 or 3 dimensions)
{v_1 : tensor} |= ndim(v_1) = 2 ∨ ndim(v_1) = 3
>>
Rule 3 (When ceil_mode is true, the output size should be greater than or equal to the floor of output size)
{v_1 : int, v_2 : int, v_3 : bool, v_4 : int} |= if v_3 then (v_4 >= (v_1 - v_2)/v_2 + 1)
>>
Rule 4 (Kernel size should be smaller or equal to the input length when input is 2D tensor.)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 then v_2 <= shape(v_1, 1)
>>
Rule 5 (Kernel size should be smaller or equal to the input length when input is 3D tensor.)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 3 then v_2 <= shape(v_1, 2)
>>
Rule 6 (Kernel size cannot be negative)
{v_1 : int} |= v_1 >= 0
>>
Rule 7 (When stride is not given, it defaults to kernel_size)
{v_1 : int, v_2 : int} |= if v_2 = 0 then v_2 = v_1
>>
Rule 8 (Output length should be non-negative)
{v_1 : int, v_2 : int, v_3: int} |= (v_1 - v_2)/v_3 + 1 >= 0
>>
Rule 9 (If stride is larger than kernel size, some input elements will be skipped.)
{v_1 : int, v_2 : int} |= if v_2 > v_1 then true
>>
Rule 10 (If input is 2D, number of channels C must be greater than 0)
{v_1: tensor} |= if ndim(v_1) = 2 then shape(v_1, 0) > 0
>>
Rule 11 (If input is 3D, number of channels C must be greater than 0)
{v_1: tensor} |= if ndim(v_1) = 3 then shape(v_1, 1) > 0
>>
Rule 12 (The last dimension of input tensor should be larger than kernel size)
{v_1: tensor, v_2: int} |= shape(v_1, ndim(v_1)-1) ≥ v_2
>>
Rule 13 (The L_in must be larger than kernel_size - stride.)
{v_1: tensor, v_2: int, v_3: int} |= shape(v_1, ndim(v_1)-1) >= v_2 -v_3
>>
Rule 14 (The L_out must be smaller or equal to the L_in)
{v_1: tensor, v_2: int} |= if ndim(v_1) = 2 then true else if ndim(v_1) = 3 then shape(v_1, 2) >= shape(v_1, 2) - v_2
>>
Rule 15 (When stride equals kernel size, L_in must be divisible by stride (without ceil mode), L_in and stride are int)
{v_1: int, v_2: int, v_3: bool} |= if v_3 then true else (v_1 / v_2) * v_2 = v_1
>>
Rule 16 (When kernel size equals the length of L_in, the L_out becomes 1.)
{v_1: tensor, v_2: int} |= if shape(v_1, ndim(v_1)-1) = v_2 then true
>>
Rule 17 (When kernel size = 1, output size equals to input size.)
{v_1: tensor} |= if shape(v_1, ndim(v_1) -1) > 0 then true
>>
Rule 18 (The channel number C must be an integer and greater than 0.)
{v_1: tensor} |= ∃i ∈ [0, ndim(v_1) -1 ] : shape(v_1, i) > 0
>>
Rule 19 (Kernel size must be integer type)
{v_1 : int ⊎ float} |= v_1 = v_1
>>
Rule 20 (The last dimension of input tensor must be non-negative)
{v_1 : tensor} |= shape(v_1, ndim(v_1)-1) ≥ 0
>>
Rule 21 (If the input is a 3D tensor, its shape should be N x C x L_in, where N, C and L_in are positive integers)
{v_1: tensor} |= if ndim(v_1) = 3 then shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0
