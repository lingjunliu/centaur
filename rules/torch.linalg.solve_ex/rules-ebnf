Rule 1 (Input tensor A must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (Input tensor A must have floating point or complex dtype)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 11
>>
Rule 3 (Input tensors A and B must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 4 (A's last two dimensions must be square)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 5 (Incompatible shapes of A and B for the equation AX = B)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 1 then shape(v_1, ndim(v_1) - 1) = shape(v_2, 0)
>>
Rule 6 (check_errors parameter is a boolean)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 7 (out parameter is a tuple of tensors)
{v_1 : tuple(tensor)} |= v_1.len = 2
>>
Rule 8 (If check_errors is true, info tensor should have int32 dtype.)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then dtype_(v_2) = 3
>>
Rule 9 (If check_errors is false, result is a tensor)
{v_1 : bool, v_2 : tensor} |= if v_1 = false then ndim(v_2) > 0
