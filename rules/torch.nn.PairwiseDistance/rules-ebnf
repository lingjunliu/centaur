Rule 1 (Input tensors must have the same number of dimensions and matching sizes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 2 (keepdim parameter is boolean)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 3 (eps parameter should be a non-negative float)
{v_1 : float} |= v_1 ≥ 0
>>
Rule 4 (Shape must have positive dimensions)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 5 (If one input is a vector, the other one should also be a vector, or both are matrices)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 1 ∧ ndim(v_2) = 1) ∨ (ndim(v_1) = 2 ∧ ndim(v_2) = 2)
>>
Rule 6 (If one input is a vector (1D) and the other is matrix(2D), the D dimension should match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 2 then shape(v_1, 0) = shape(v_2, 1) else if ndim(v_1) = 2 ∧ ndim(v_2) = 1 then shape(v_1, 1) = shape(v_2, 0)
>>
Rule 7 (The absolute value of the norm degree 'p' should be reasonable to avoid overflow)
{v_1 : int ⊎ float} |= v_1 < 1000000 ∧ v_1 > -1000000
>>
Rule 8 (If inputs are matrices N should match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 9 (Tensors v1 and v2 have at least one dimension)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0
>>
Rule 10 (If the inputs are 1D, they must have the same size)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 11 (D dimension of the inputs should be greater than 0)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then shape(v_1, 1) > 0 ∧ shape(v_2, 1) > 0 else if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then shape(v_1, 0) > 0 ∧ shape(v_2, 0) > 0
>>
Rule 12 (If inputs are tensors then their dtypes must be the same)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 13 (If one input is matrix (2D) then the other one should be too.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 then ndim(v_2) = 2
>>
Rule 14 (The dimension of the tensors should be 1 or 2)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 1 ∨ ndim(v_1) = 2) ∧ (ndim(v_2) = 1 ∨ ndim(v_2) = 2)
>>
Rule 15 (The output shape should be 1D if keepdim is false)
{v_1 : bool, v_2 : tensor} |= if v_1 = false then ndim(v_2) = 1
>>
Rule 16 (if keepdim is true, the output should be a 2D tensor)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then ndim(v_2) = 2
>>
Rule 17 (if the output is a 2D tensor with keepdim then the second dimension should be 1)
{v_1 : bool, v_2 : tensor} |= if v_1 = true ∧ ndim(v_2) = 2 then shape(v_2, 1) = 1
>>
Rule 18 (When input tensors are 2D, D must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then shape(v_1, 1) = shape(v_2, 1)
>>
Rule 19 (if one input has N and D dimensions, and other has D, then it is okay)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 2 ∧ ndim(v_2) = 1 ∧ shape(v_1, 1) = shape(v_2, 0)) ∨ (ndim(v_1) = 1 ∧ ndim(v_2) = 2 ∧ shape(v_1, 0) = shape(v_2, 1))
>>
Rule 20 (When input tensors are 2D, N needs to be greater than zero.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then shape(v_1, 0) > 0 ∧ shape(v_2, 0) > 0
>>
Rule 21 (The result should be a 0D tensor if input tensors are 1D and keepdim = False)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 ∧ v_3 = false then ndim(v_1) = 0
