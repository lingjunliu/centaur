Rule 4 (if end is tensor then dtype is float/complex)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 5 (if start is int and end is float then steps must be greater than 1)
{v_1 : int, v_2 : float, v_3 : int} |= if v_1 < v_2 then v_3 > 1
>>
Rule 6 (if start and end are numbers then they should have the same sign, if steps = 1)
{v_1 : float, v_2 : float, v_3 : int} |= if v_3 = 1 then (v_1 ≥ 0 ∧ v_2 ≥ 0) ∨ (v_1 ≤ 0 ∧ v_2 ≤ 0)
>>
Rule 7 (If dtype is specified, it must be a valid dtype)
{v_1 : dtype} |= v_1 = 0 ∨ v_1 = 1 ∨ v_1 = 2 ∨ v_1 = 3 ∨ v_1 = 4 ∨ v_1 = 5 ∨ v_1 = 6 ∨ v_1 = 7 ∨ v_1 = 8 ∨ v_1 = 9 ∨ v_1 = 10 ∨ v_1 = 12
>>
Rule 8 (If start is complex, then end should be complex)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then dtype_(v_2) = 9 ∨ dtype_(v_2) = 10
>>
Rule 9 (If start and end are the same tensor, then steps must be 1)
{v_1 : tensor, v_2 : int} |= if v_1 = v_1 then v_2 = 1
>>
Rule 10 (If dtype is complex64, then start and end should be complex64/complex128)
{v_1 : dtype, v_2 : tensor, v_3 : tensor} |= if v_1 = 9 then dtype_(v_2) = 9 ∨ dtype_(v_2) = 10 ∧ dtype_(v_3) = 9 ∨ dtype_(v_3) = 10
>>
Rule 11 (If requires_grad is true, then start and end must be float or complex tensors)
{v_1 : bool, v_2 : tensor, v_3 : tensor} |= if v_1 = true then (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10) ∧ (dtype_(v_3) = 6 ∨ dtype_(v_3) = 7 ∨ dtype_(v_3) = 8 ∨ dtype_(v_3) = 9 ∨ dtype_(v_3) = 10)
