>>
Rule 1 (input tensors v_1 and v_2 must have compatible shapes)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2)
>>
Rule 2 (Input tensors v_1 and v_2 should not have complex dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10
>>
Rule 3 (If the first tensor is a scalar (ndim = 0), the second tensor must also be a scalar)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then ndim(v_2) = 0
>>
Rule 4 (If v_1 is a bool tensor, then v_2 must be a bool tensor)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 0 then dtype_(v_2) = 0
