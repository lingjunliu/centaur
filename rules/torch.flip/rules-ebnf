Rule 1 (dims should be a list or tuple of integers and within valid range and unique)
{v_1 : tensor, v_2 : list(int) ⊎ tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : (v_2[i] ≥ (0 - ndim(v_1))) ∧ (v_2[i] < ndim(v_1)) ∧ (∀j ∈ [i + 1, v_2.len - 1] : v_2[i] ≠ v_2[j])
>>
Rule 2 (If dims is a tuple, it must not be empty)
{v_1 : tuple(int)} |= v_1.len > 0
>>
Rule 3 (If dims is a list, it must not be empty)
{v_1 : list(int)} |= v_1.len > 0
>>
Rule 4 (If tensor has more than 3 dimensions, dim should not be greater than 2)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) > 3 then v_2 ≤ 2
>>
Rule 5 (If tensor has ndim=0, dims is not allowed.)
{v_1 : tensor, v_2 : list(int) ⊎ tuple(int)} |= if ndim(v_1) = 0 then v_2.len = 0
>>
Rule 6 (dims must be int, a list of int or tuple of int. Tensor must have ndim >0 if dims is not empty)
{v_1 : tensor, v_2 : int ⊎ list(int) ⊎ tuple(int)} |= if v_2 < 0 then false else if v_2.len > 0 then ndim(v_1) > 0
>>
Rule 7 (When dims is an integer, it should be a valid dimension for the tensor)
{v_1 : tensor, v_2 : int} |= v_2 ≥ (0 - ndim(v_1)) ∧ v_2 < ndim(v_1)
