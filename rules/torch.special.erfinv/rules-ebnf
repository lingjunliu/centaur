>>
Rule 1 (input tensor elements must be in the range (-1, 1))
{v_1 : tensor} |= (min(v_1) > -1) ∧ (max(v_1) < 1)
>>
Rule 2 (input tensor dtype must be float16, float32, or float64)
{v_1 : tensor} |= (dtype_(v_1) = 6) ∨ (dtype_(v_1) = 7) ∨ (dtype_(v_1) = 8)
>>
Rule 3 (If out is specified, it must have the same dtype as input)
{v_1 : tensor, v_2 : tensor} |= if ∃i ∈ [0, ndim(v_1)-1] : shape(v_1, i) > 0 then dtype_(v_1) = dtype_(v_2)
>>
Rule 4 (If out is specified, it must have the same shape as input)
{v_1 : tensor, v_2 : tensor} |= if ∃i ∈ [0, ndim(v_1)-1] : shape(v_1, i) > 0 then (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 5 (The input tensor must have real valued dtype)
{v_1 : tensor} |= if (dtype_(v_1) = 10) ∨ (dtype_(v_1) = 11) then false
>>
Rule 6 (If the out tensor is specified, it must be writeable)
{v_2: tensor} |= if ∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0 then true
>>
Rule 7 (If input is complex, the out tensor must be complex)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 10) ∨ (dtype_(v_1) = 11) then (dtype_(v_2) = 10) ∨ (dtype_(v_2) = 11)
>>
Rule 8 (The out tensor, if specified, must have the same layout as the input tensor)
{v_1 : tensor, v_2 : tensor} |= if ∃i ∈ [0, ndim(v_2)-1] : shape(v_2, i) > 0 then ndim(v_1) = ndim(v_2)
>>
Rule 9 (If input has shape (s1, s2, ..., sn), then out has shape (s1, s2, ..., sn))
{v_1 : tensor, v_2 : tensor} |= if ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 then  ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
