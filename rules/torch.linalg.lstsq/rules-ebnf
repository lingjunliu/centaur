Rule 12 (If driver is gels then A must be full rank.)
{v_1 : tensor, v_2 : str} |= if v_2 = "gels" then shape(v_1, ndim(v_1) - 2) = shape(v_1, ndim(v_1) - 1)
>>
Rule 13 (If driver is gels and A is on CUDA, then A must be full rank and A and B must be the same dtype)
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "gels" then dtype_(v_1) = dtype_(v_2)
