Rule 1 (source and destination dimensions should be within the valid range of input tensor's dimensions)
{v_1 : tensor, v_2 : int, v_3 : int} |= (0 - ndim(v_1)) ≤ v_2 ∧ v_2 < ndim(v_1) ∧ (0 - ndim(v_1)) ≤ v_3 ∧ v_3 < ndim(v_1)
>>
Rule 2 (source and destination dimensions cannot be equal)
{v_2 : int, v_3 : int} |= v_2 ≠ v_3
>>
Rule 3 (if source and destination are lists, they should have same length)
{v_1 : list(int), v_2 : list(int)} |= v_1.len = v_2.len
>>
Rule 4 (if source is a list, then each dimension in source cannot be repeated)
{v_1 : list(int)} |= ∀i ∈ [0, v_1.len - 1] : ∀j ∈ [i + 1, v_1.len - 1] : v_1[i] ≠ v_1[j]
>>
Rule 5 (if source and destination are lists, and the tensor is 1D, the length of the source and destination lists must be 1)
{v_1 : tensor, v_2 : list(int), v_3 : list(int)} |= if ndim(v_1) = 1 then v_2.len = 1 ∧ v_3.len = 1
>>
Rule 6 (if source and destination are not lists, at least one of them should be within a valid range of input tensor's dimensions)
{v_1 : tensor, v_2 : int, v_3 : int} |= ((0 - ndim(v_1)) ≤ v_2 ∧ v_2 < ndim(v_1)) ∨ ((0 - ndim(v_1)) ≤ v_3 ∧ v_3 < ndim(v_1))
>>
Rule 7 (source and destination dimensions must be valid, considering negative indexing)
{v_1 : tensor, v_2 : int, v_3 : int} |= if v_2 < 0 then (0 - v_2) ≤ ndim(v_1) else v_2 < ndim(v_1) ∧ if v_3 < 0 then (0 - v_3) ≤ ndim(v_1) else v_3 < ndim(v_1)
