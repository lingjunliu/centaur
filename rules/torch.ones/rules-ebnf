Rule 5 (If layout is specified then it must be "torch.strided")
{v_1 : str} |= v_1 = "torch.strided"
>>
Rule 6 (All elements of size tuple must be non-negative)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
