Rule 1 (Integral types must have integer alpha)
{v_1 : tensor, v_3 : float, v_4 : int} |=  (if (dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 5) then v_3 = v_4)
>>
Rule 2 (Subtraction requires tensors to have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 3 (First dimension of tensors must match)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) = shape(v_2, 0)
