Rule 1 (target tensor should be 1D if input tensors are 2D and size of the first dimension of input tensors should match with the size of target tensor, target tensor should be 0D if input tensors are 1D.)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if (ndim(v_1) = 2 ∧ ndim(v_2) = 2) then (ndim(v_3) = 1 ∧ shape(v_1, 0) = shape(v_3, 0)) else if (ndim(v_1) = 1 ∧ ndim(v_2) = 1) then ndim(v_3) = 0
>>
Rule 2 (margin should be between -1 and 1)
{v_1 : float} |= v_1 ≥ -1 ∧ v_1 ≤ 1
>>
Rule 3 (the first and second input tensors should have the same shape if their ndims are not 0)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) ≠ 0 ∧ ndim(v_2) ≠ 0) then (∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : (ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0) ∨ (shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1)))
>>
Rule 4 (reduction should be one of 'none', 'mean', or 'sum')
{v_1 : str} |= v_1 = "none" ∨ v_1 = "mean" ∨ v_1 = "sum"
>>
Rule 5 (target tensor should only contains 1 or -1)
{v_1 : tensor} |= (min(v_1) = -1) ∧ (max(v_1) = 1) ∧ (∀i ∈ [0, ndim(v_1) - 1] : (∃j ∈ [0, shape(v_1,i) - 1]: v_1[j] = 1 ∨ v_1[j] = -1))
>>
Rule 6 (if input tensors are 2D, the embedding dimension should be greater than 0)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 2 ∧ ndim(v_2) = 2) then shape(v_1, 1) > 0
>>
Rule 7 (Input tensors should have floating point or complex dtype)
{v_1 : tensor, v_2 : tensor} |= (6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10) ∧ (6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 10)
>>
Rule 8 (If input tensors are 1D, they should have the same dimension size)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 9 (target tensor values should be either 1 or -1)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : ∀j ∈ [0, if ndim(v_1) = 0 then 1 else shape(v_1, i) -1 ] : v_1[j] = 1 ∨ v_1[j] = -1
>>
Rule 10 (if target tensor is 0D, it can only have value 1 or -1)
{v_1 : tensor} |= if ndim(v_1) = 0 then (v_1 = 1 ∨ v_1 = -1)
>>
Rule 11 (If input1 is 1D, then input2 must also be 1D)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 then ndim(v_2) = 1
>>
Rule 12 (If reduction is 'none', then output tensor dim should match the target tensor dim.)
{v_1 : str, v_2 : tensor, v_3 : tensor} |= if v_1 = "none" then ndim(v_2) = ndim(v_3)
>>
Rule 13 (When input tensors are 2D, they must have the same size for the embedding dimension)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then shape(v_1, 1) = shape(v_2, 1)
>>
Rule 14 (if reduction is None and target is not 0D, then target must be 1D)
{v_1 : str, v_2 : tensor} |= if v_1 = "none" then if ndim(v_2) ≠ 0 then ndim(v_2) = 1
>>
Rule 15 (If one of the inputs is a scalar then the other input has to be scalar too and the target has to be scalar)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_1) = 0 then (ndim(v_2) = 0 ∧ ndim(v_3) = 0)
>>
Rule 16 (If the input tensors are 2D, the target tensor should have a first dimension equal to the first dimension of the input tensors.)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if (ndim(v_1) = 2 ∧ ndim(v_2) = 2) then shape(v_1, 0) = shape(v_3, 0)
>>
Rule 17 (Input and target tensor cannot both be scalars with reduction 'none')
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if (ndim(v_1) = 0 ∧ ndim(v_2) = 0 ∧ v_3 = "none") then false
