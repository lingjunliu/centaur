Rule 3 (If keepdim is true, the dimension dim will be retained with size 1)
{v_1 : tensor, v_2 : int, v_3 : bool} |= if v_3 = true then shape(v_1, v_2) = 1
>>
Rule 4 (The dimension argument v_1 must be an integer or tuple(int).)
{v_1 : int ⊎ tuple(int)} |= if v_1.len > 0 then true
>>
Rule 5 (If input is uint8, the output dtype is uint8, otherwise it is bool)
{v_1 : tensor} |= if dtype_(v_1) = 5 then dtype_(v_1) = 5 else dtype_(v_1) = 0
>>
Rule 6 (If the input tensor is not bool, throw an error.)
{v_1 : tensor} |= if dtype_(v_1) ≠ 0 then false
>>
Rule 7 (The dim argument cannot appear multiple times in tuple of ints)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : ∀j ∈ [i+1, v_1.len - 1] : v_1[i] ≠ v_1[j]
>>
Rule 8 (The out argument must have the same dtype as the input when the input is uint8, and bool otherwise.)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 5 then dtype_(v_2) = 5 else dtype_(v_2) = 0
>>
Rule 9 (When using dim, the number of dimensions to reduce cannot exceed the total number of dimensions)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len ≤ ndim(v_1)
>>
Rule 10 (The out argument must have the same shape as the input when keepdim is true)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 = true then ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 11 (if dim is a tuple, the out tensor has `ndim(input) - len(dim)` dimensions when keepdim is false, and ndim(input) dimensions otherwise.)
{v_1 : tensor, v_2 : tuple(int), v_3 : bool} |= if v_3 = false then ndim(v_1) - v_2.len ≥ 0 else ndim(v_1) ≥ 0
>>
Rule 12 (If dim is a tuple, all dimensions specified in tuple must be valid dimensions of input tensor)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : (0 - ndim(v_1)) ≤ v_2[i] ∧ v_2[i] < ndim(v_1)
>>
Rule 13 (When using dim, the shape of out must be 1 in the specified dim)
{v_1 : tensor, v_2 : int} |= shape(v_1, v_2) = 1
>>
Rule 14 (If the input tensor has a dimension of size 0, the result is always true along that dimension)
{v_1 : tensor, v_2 : int} |= if shape(v_1, v_2) = 0 then true
>>
Rule 15 (The dimensions specified in dim cannot be out of bounds of the input tensor)
{v_1 : tensor, v_2 : int ⊎ tuple(int)} |= if v_2.len > 0 then ∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ (0 - ndim(v_1)) ∧ v_2[i] < ndim(v_1) else v_2 ≥ (0 - ndim(v_1)) ∧ v_2 < ndim(v_1)
>>
Rule 16 (The out tensor cannot be the same tensor as the input tensor)
{v_1 : tensor, v_2 : tensor} |= v_1 ≠ v_2
>>
Rule 17 (If a tuple of dimensions is specified for reduction, all dimensions in the tuple must be present in the input tensor)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : ∃j ∈ [0, ndim(v_1) - 1] : v_2[i] = j
