>>
Rule 1 (Input tensor dimension should be 3, 4, or 5)
{v_1 : tensor} |= ndim(v_1) = 3 ∨ ndim(v_1) = 4 ∨ ndim(v_1) = 5
>>
Rule 2 (Only one of size or scale_factor should be defined; if size is defined, scale_factor should not be defined and vice versa.)
{v_1 : tuple(int) ⊎ int, v_2 : tuple(float) ⊎ float} |= (v_1 = false ∧ v_2 ≠ false) ∨ (v_1 ≠ false ∧ v_2 = false)
>>
Rule 3 (When align_corners is True, mode must be linear, bilinear, bicubic, or trilinear)
{v_1 : bool, v_2 : str} |= if v_1 = true then v_2 = "linear" ∨ v_2 = "bilinear" ∨ v_2 = "bicubic" ∨ v_2 = "trilinear"
>>
Rule 4 (If recompute_scale_factor is True, scale_factor must be defined.)
{v_1 : bool, v_2 : float ⊎ tuple(float)} |= if v_1 = true then v_2 ≠ false
>>
Rule 5 (If antialias is True, mode must be bilinear or bicubic and input tensor must be 4-dimensional)
{v_1 : bool, v_2 : str, v_3 : tensor} |= if v_1 = true then (v_2 = "bilinear" ∨ v_2 = "bicubic") ∧ ndim(v_3) = 4
>>
Rule 6 (Input and output sizes should be greater than 0, for each dimension)
{v_1 : tensor, v_2 : tuple(int)} |= ndim(v_1) - 2 = v_2.len ∧ ∀i ∈ [0, v_2.len - 1] : v_2[i] > 0 ∧ shape(v_1, i+2) > 0
>>
Rule 7 (If scale_factor is a tuple, its length has to match the number of spatial dimensions of the input tensor)
{v_1 : tensor, v_2 : tuple(float)} |= v_2.len = ndim(v_1) - 2
>>
Rule 8 (Input and output must have the same number of spatial dimensions)
{v_1 : tensor, v_2 : tuple(int)} |= ndim(v_1) - 2 = v_2.len
>>
Rule 9 (If mode is linear, the input tensor must be 3-dimensional)
{v_1 : str, v_2 : tensor} |= if v_1 = "linear" then ndim(v_2) = 3
>>
Rule 10 (If mode is bicubic, the input tensor must be 4-dimensional)
{v_1 : str, v_2 : tensor} |= if v_1 = "bicubic" then ndim(v_2) = 4
>>
Rule 11 (If mode is trilinear, the input tensor must be 5-dimensional)
{v_1 : str, v_2 : tensor} |= if v_1 = "trilinear" then ndim(v_2) = 5
>>
Rule 12 (If mode is bilinear, the input tensor can be 3-dimensional or 4-dimensional)
{v_1 : str, v_2 : tensor} |= if v_1 = "bilinear" then ndim(v_2) = 3 ∨ ndim(v_2) = 4
>>
Rule 13 (If mode is trilinear, linear, bilinear, bicubic or area, the dtype of input tensor should not be float16)
{v_1 : str, v_2 : tensor} |= if (v_1 = "linear" ∨ v_1 = "bilinear" ∨ v_1 = "bicubic" ∨ v_1 = "trilinear" ∨ v_1 = "area") then dtype_(v_2) ≠ 6
>>
Rule 14 (The length of size tuple must be equal to the number of spatial dimensions of input tensor, i.e. ndim(input)-2 )
{v_1 : tensor, v_2 : tuple(int)} |= shape(v_1,0) > 0 ∧ shape(v_1,1) > 0 ∧ v_2.len = ndim(v_1) - 2
>>
Rule 15 (If scale_factor is a tuple, all elements should be greater than zero)
{v_1 : tuple(float)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] > 0
>>
Rule 16 (Output size values should be positive)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] > 0
