>>
Rule 1 (simplified padding and tensor dimension check)
{v_2 : tensor} |= (ndim(v_2) = 4)
>>
Rule 2 (padding size compared to tensor shape)
{v_1 : int, v_2 : tensor} |= if ndim(v_2) > 0 then v_1 ≤ shape(v_2, 0)
>>
Rule 3 (tuple padding values must be non-negative)
{v_1 : tuple(int)} |=  v_1.len = 6 ∧ ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 4 (tuple padding requires 4D or 5D tensor)
{v_1 : tuple(int), v_2 : tensor} |= v_1.len = 6 ∧ (ndim(v_2) = 4 ∨ ndim(v_2) = 5) ∧ ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 5 (Integer padding must be less than a constant)
{v_1 : int} |= v_1 < 100
