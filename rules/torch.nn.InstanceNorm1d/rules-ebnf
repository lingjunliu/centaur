Rule 1 (input tensor must be 2D or 3D)
{v_1 : tensor} |= ndim(v_1) = 2 ∨ ndim(v_1) = 3
>>
Rule 2 (num_features must match the channel dimension of the input)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 2 ∧ shape(v_1, 1) = v_2
>>
Rule 3 (eps must be a non-negative float)
{v_1 : float} |= v_1 ≥ 0
>>
Rule 4 (running_mean size should match num_features if track_running_stats is true)
{v_1 : bool, v_2 : tensor, v_3 : int} |= if v_1 then shape(v_2, 0) = v_3
>>
Rule 5 (input tensor's dtype should be float or complex)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 6 (momentum must be between 0 and 1 inclusive)
{v_1 : float} |= v_1 ≥ 0 ∧ v_1 ≤ 1
>>
Rule 7 (affine should be a boolean value)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 8 (If input is 2D, num_features must equal the first dimension)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 then shape(v_1, 0) = v_2
>>
Rule 9 (All dimensions of input tensor should be non-negative)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 10 (If affine is true, gamma and beta parameters must be float tensors.)
{v_1 : bool, v_2 : tensor} |= if v_1 then (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)
>>
Rule 11 (If input is 3D, num_features must match the second dimension)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 3 then shape(v_1, 1) = v_2
>>
Rule 12 (num_features should be positive)
{v_1 : int} |= v_1 > 0
>>
Rule 13 (Input tensor's datatype should not be Char.)
{v_1 : tensor} |= dtype_(v_1) ≠ 11
>>
Rule 14 (The dtype of running mean and running var should be the same)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 15 (Input tensor dimensions must be within a reasonable range.)
{v_1 : tensor} |= ndim(v_1) ≤ 5
