Rule 5 (If an output tensor is given, its dtype must be compatible with the input tensor's dtype.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > 0 then (if dtype_(v_1) = "float32" then (dtype_(v_2) = "float32" ∨ dtype_(v_2) = "float64") else if dtype_(v_1) = "float64" then dtype_(v_2) = "float64" else if dtype_(v_1) = "float16" then dtype_(v_2) = "float16" else if dtype_(v_1) = "complex64" then dtype_(v_2) = "complex64" else dtype_(v_2) = "complex128")
