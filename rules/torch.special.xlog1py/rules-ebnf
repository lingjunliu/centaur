>>
Rule 1 (At least one of input or other must be a tensor)
{v_1 : tensor ⊎ int ⊎ float, v_2 : tensor ⊎ int ⊎ float} |= (ndim(v_1) ≥ 0) ∨ (ndim(v_2) ≥ 0)
>>
Rule 2 (If both inputs are tensors, their shapes must be compatible for broadcasting.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
>>
Rule 3 (Tensor's dtype must be floating point.)
{v_1 : tensor} |= (dtype_(v_1) = 6) ∨ (dtype_(v_1) = 7) ∨ (dtype_(v_1) = 8) ∨ (dtype_(v_1) = 9) ∨ (dtype_(v_1) = 10)
>>
Rule 4 (If input is zero, other can not be NaN.)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : if v_1[i] = 0 then v_2[i] ≠ "nan"
>>
Rule 5 (If other contains NaN, output should be NaN in the same position)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : if v_2[i] = "nan" then v_1[i] * 0 = "nan"
>>
Rule 6 (If input and other are both tensors, at least one of them should have floating point dtype.)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) ∨ (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)
>>
Rule 7 (If other is scalar, it should be greater than or equal to -1.)
{v_2 : int ⊎ float} |= v_2 ≥ -1
>>
Rule 8 (If other is a tensor, it cannot contain any element smaller than -1)
{v_2 : tensor} |= min(v_2) ≥ -1
>>
Rule 9 (if v_2 is a int, cast to float before the operation)
{v_2 : int ⊎ float} |= if v_2 < 0 then true
>>
Rule 10 (If input contains 0 and other contains -1, output should be 0.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : if v_1[i] = 0 ∧ v_2[i] = -1 then v_1[i] * shape(v_1, i) = 0
>>
Rule 11 (If input is a tensor with complex dtype, the other must also be complex)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 9) ∨ (dtype_(v_1) = 10) then (dtype_(v_2) = 9) ∨ (dtype_(v_2) = 10)
