>>
Rule 1 (input tensors must be 1-dimensional)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 1 ∧ ndim(v_2) = 1
>>
Rule 2 (output tensor shape must match the outer product of input shapes)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) = 1 ∧ ndim(v_2) = 1 ∧ ndim(v_3) = 2 ∧ shape(v_1, 0) = shape(v_3, 0) ∧ shape(v_2, 0) = shape(v_3, 1)
>>
Rule 3 (input tensors must have compatible dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 4 (If an output tensor is given, it must have the correct dtype)
{v_1 : tensor, v_3 : tensor} |= if ndim(v_3) > 0 then dtype_(v_1) = dtype_(v_3)
>>
Rule 5 (if out is given, its dtype must be floating point)
{v_3 : tensor} |= if ndim(v_3) > 0 then (dtype_(v_3) = 6 ∨ dtype_(v_3) = 7 ∨ dtype_(v_3) = 8)
>>
Rule 6 (If an output tensor is given, its shape must be correct)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_3) > 0 then (shape(v_1, 0) = shape(v_3, 0) ∧ shape(v_2, 0) = shape(v_3, 1))
>>
Rule 7 (input and vec2 cannot be boolean tensors)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 0 ∧ dtype_(v_2) ≠ 0
>>
Rule 8 (Input tensors should have numerical dtypes)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) > 0 ∧ dtype_(v_1) < 11) ∧ (dtype_(v_2) > 0 ∧ dtype_(v_2) < 11)
>>
Rule 9 (If an output tensor is given, it should have the same device as the input tensor.)
{v_3 : tensor} |= if ndim(v_3) > 0 then true
>>
Rule 10 (The 'out' argument, if provided, must be a tensor)
{v_3 : tensor} |= ndim(v_3) ≥ 0
>>
Rule 11 (If input is int, vec2 should be int)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5) then (dtype_(v_2) = 1 ∨ dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 ∨ dtype_(v_2) = 5)
>>
Rule 12 (If input is float, vec2 should be float)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) then (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)
>>
Rule 13 (If input is complex, vec2 should be complex)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) then (dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)
>>
Rule 14 (if input tensor has requires_grad=True, then vec2 should also have requires_grad=True )
{v_1 : tensor} |= if ndim(v_1) > 0 then true
>>
Rule 15 (If vec2 is float, input should be float)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8) then (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 16 (If vec2 is complex, input should be complex)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_2) = 9 ∨ dtype_(v_2) = 10) then (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10)
>>
Rule 17 (If input is int, vec2 cannot be boolean)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5) then dtype_(v_2) ≠ 0
>>
Rule 18 (If vec2 is int, input cannot be boolean)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_2) = 1 ∨ dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 ∨ dtype_(v_2) = 5) then dtype_(v_1) ≠ 0
>>
Rule 19 (If vec2 tensor has layout!=torch.strided, then output tensor should have layout!=torch.strided)
{v_2 : tensor} |= if ndim(v_2) > 0 then true
>>
Rule 20 (If out is not provided then the output tensor will be created with the same layout as input tensor)
{v_1: tensor, v_2: tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then true
>>
Rule 21 (If vec2 is boolean, input should also be boolean)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_2) = 0 then dtype_(v_1) = 0
