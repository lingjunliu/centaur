Rule 1 (Dimension argument must be non-negative)
{v_1 : int} |= v_1 ≥ 0
>>
Rule 2 (Dimension argument must be within the valid range for the input tensor)
{v_1 : tensor, v_2 : int} |= v_2 ≥ 0 ∧ v_2 < ndim(v_1)
>>
Rule 3 (input tensor must not be empty along the dimension dim)
{v_1 : tensor, v_2 : int} |= shape(v_1, v_2) > 0
>>
Rule 4 (input tensor must be a tensor)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 5 (input tensor must have a numeric dtype)
{v_1 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 11
>>
Rule 6 (if out is specified, it must be a tuple of two tensors)
{v_1 : tuple(tensor)} |= v_1.len = 2
