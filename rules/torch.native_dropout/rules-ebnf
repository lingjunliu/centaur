Rule 8 (If the input is complex type, then p must be 0)
{v_1 : tensor, p : float} |= if dtype_(v_1) = 10 ∨ dtype_(v_1) = 11 then p = 0
>>
Rule 9 (When training, the input tensor should not have a dimension with size zero)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 10 (If training=False, then the input tensor's dtype should be equal to the output's dtype)
{v_1 : tensor, v_2 : bool} |= if v_2 = false then dtype_(v_1) = dtype_(v_1)
>>
Rule 11 (If training=True, then p cannot be zero if any dimension is 1)
{v_1 : tensor, p : float, v_2 : bool} |= if v_2 = true then (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1) ∧ p > 0
>>
Rule 12 (The training flag v_2 must be a boolean)
{v_2: bool} |= v_2 = true ∨ v_2 = false
>>
Rule 13 (When not training, p should be between 0 and 1 inclusive, or equal to 0)
{p : float, v_1 : bool} |= if v_1 = false then (p ≥ 0 ∧ p ≤ 1) ∨ p = 0
>>
Rule 14 (The probability `p` in native_dropout cannot be a NaN value)
{p : float} |= p = p
