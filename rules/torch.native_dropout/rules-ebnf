Rule 2 (Input tensor should not have a dtype that cannot be cast to Float.)
{v_1 : tensor} |= dtype_(v_1) ≠ 12
>>
Rule 3 (If training is enabled, then the input tensor must be of floating point type)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 6
>>
Rule 4 (When using native_dropout, the input tensor's dimension should be greater than 0.)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 5 (When using native_dropout, if input tensor is a complex type, training mode must be false.)
{v_1 : tensor, v_2 : bool} |= if dtype_(v_1) = 10 ∨ dtype_(v_1) = 11 then v_2 = false
>>
Rule 6 (The p (probability) value cannot be exactly 1.0 when training is enabled)
{p : float, v_1 : bool} |= if v_1 = true then p < 1
>>
Rule 7 (Input tensor should have float16, float32, or float64 dtype when training)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
