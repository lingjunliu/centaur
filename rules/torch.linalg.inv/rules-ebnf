Rule 2 (input tensor A must be square)
{v_1 : tensor} |= shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 3 (out tensor should have the same dtype as input tensor A if it exists)
{v_1 : tensor, v_2 : tensor} |= if v_2 ≠ false then dtype_(v_1) = dtype_(v_2)
>>
Rule 4 (If out is provided, the last two dimensions of out should be the same as A)
{v_1 : tensor, v_2 : tensor} |= if v_2 ≠ false then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) ∧ shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 2)
>>
Rule 5 (If out is provided, out should have at least 2 dimensions)
{v_1 : tensor} |= if v_1 ≠ false then ndim(v_1) ≥ 2
>>
Rule 6 (If out is provided, the batch dimensions of out and A should match)
{v_1 : tensor, v_2 : tensor} |= if v_2 ≠ false then ∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) = shape(v_2, i)
>>
Rule 7 (if out is provided, its dtype must be float32, float64, complex64, or complex128)
{v_1 : tensor} |= if v_1 ≠ false then (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10)
>>
Rule 8 (out must be of floating point or complex dtype, and not half)
{v_1 : tensor} |= if v_1 ≠ false then (dtype_(v_1) ≠ 6)
>>
Rule 9 (if out is provided, it should be large enough to hold the inverse)
{v_1 : tensor, v_2 : tensor} |= if v_2 ≠ false then ndim(v_1) = ndim(v_2)
>>
Rule 10 (input tensor A must be finite)
{v_1 : tensor} |= ∀i ∈ [0, shape(v_1, ndim(v_1) - 1) - 1] : ∀j ∈ [0, shape(v_1, ndim(v_1) - 2) - 1] : min(v_1) > -10000000000 ∧ max(v_1) < 10000000000
>>
Rule 11 (input tensor A must not contain NaN or Inf values)
{v_1 : tensor} |= min(v_1) ≠ "nan" ∧ max(v_1) ≠ "nan" ∧ min(v_1) ≠ "inf" ∧ max(v_1) ≠ "inf"
