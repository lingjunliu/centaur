Rule 1 (The input tensor B should have at least 2 dimensions.)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (The data types of input tensors B and L must be the same.)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (The last two dimensions of L should be equal.)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 4 (The size of the second dimension of B and L should be the same.)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2 ∧ shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 2)
>>
Rule 5 (The supported dtypes for input tensors B and L are float, double, cfloat and cdouble.)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) ∧ (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)
>>
Rule 6 (upper should be a boolean value)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 7 (If the upper flag is set to true, L should be an upper triangular matrix.)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then ∀i ∈ [0, shape(v_1, ndim(v_1) - 1) - 1] : ∀j ∈ [0, i - 1] : v_1[i*shape(v_1, ndim(v_1) - 1) + j] = 0
