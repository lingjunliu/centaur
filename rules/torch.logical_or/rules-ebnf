Rule 3 (If dtype of input tensor v_1 is boolean, then dtype of v_2 must be boolean as well.)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 0 then dtype_(v_2) = 0
>>
Rule 4 (If shape of v_1 is (a,b,c) then shape of v_2 must be (a,b,c) as well.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 3 then shape(v_1, 0) = shape(v_2, 0) ∧ shape(v_1, 1) = shape(v_2, 1) ∧ shape(v_1, 2) = shape(v_2, 2)
>>
Rule 5 (if input tensor v_1 is a scalar, then input tensor v_2 must also be a scalar)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then ndim(v_2) = 0
>>
Rule 6 (The element type of v_1 and v_2 tensors should not be string)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 11 ∧ dtype_(v_2) ≠ 11
>>
Rule 7 (If v_3 is given as out, then ndim(v_1) equals ndim(v_3) and ndim(v_2) equals ndim(v_3))
{v_1 : tensor, v_3 : tensor} |= if v_3 ≠ v_3 then true else ndim(v_1) = ndim(v_3)
>>
Rule 8 (if v_3 is not given and the dtypes of v_1 and v_2 are different, then v_1 and v_2 dtypes must be float32 or float64)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if v_3 ≠ v_3 ∧ dtype_(v_1) ≠ dtype_(v_2) then (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)
>>
Rule 9 (If the input tensors are complex, their dtypes should match.)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) then dtype_(v_1) = dtype_(v_2)
