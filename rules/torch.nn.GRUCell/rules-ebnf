Rule 1 (input_size and hidden_size should be positive integers)
{v_1 : int, v_2 : int} |= v_1 > 0 ∧ v_2 > 0
>>
Rule 2 (input tensor's last dimension must equal input_size)
{v_1 : tensor, v_2 : int} |= ndim(v_1) > 0 ∧ shape(v_1, ndim(v_1) - 1) = v_2
>>
Rule 3 (If input is a 2D tensor, then the batch size of input and hidden should match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 4 (The dtype of input and hidden tensors should be the same)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 5 (If input is 1D, hidden must be 1D, otherwise if input is 2D, hidden must be 2D)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 1 ∧ ndim(v_2) = 1) ∨ (ndim(v_1) = 2 ∧ ndim(v_2) = 2)
>>
Rule 6 (If bias is False, then weight_ih, weight_hh, bias_ih and bias_hh should not be None)
{v_1 : bool, v_2 : tensor, v_3 : tensor, v_4 : tensor, v_5 : tensor} |= if v_1 = false then shape(v_2, 0) > 0 ∧ shape(v_3, 0) > 0 ∧ shape(v_4, 0) > 0 ∧ shape(v_5, 0) > 0
>>
Rule 7 (weight_ih shape[1] should equal input_size)
{v_1 : tensor, v_2 : int} |= shape(v_1, 1) = v_2
>>
Rule 8 (weight_ih shape[0] should equal 3 * hidden_size)
{v_1 : tensor, v_2 : int} |= shape(v_1, 0) = 3 * v_2
>>
Rule 9 (bias_ih shape[0] should equal 3 * hidden_size if bias is true)
{v_1 : tensor, v_2 : int, v_3 : bool} |= if v_3 = true then shape(v_1, 0) = 3 * v_2
>>
Rule 10 (If bias is True, the weight_ih and bias_ih must have the same dtype)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 = true then dtype_(v_1) = dtype_(v_2)
>>
Rule 11 (If bias is True, the weight_ih, weight_hh, bias_ih and bias_hh must have the same dtype)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : tensor, v_5 : bool} |= if v_5 = true then dtype_(v_1) = dtype_(v_2) ∧ dtype_(v_1) = dtype_(v_3) ∧ dtype_(v_1) = dtype_(v_4)
>>
Rule 12 (If bias is False, bias_ih and bias_hh shapes should be 0-dimensional)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 = false then ndim(v_1) = 0 ∧ ndim(v_2) = 0
>>
Rule 13 (If bias is False, weight_ih, weight_hh should have float dtype)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 = false then 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8 ∧ 6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8
>>
Rule 14 (weight_hh is 2D tensor)
{v_1 : tensor} |= ndim(v_1) = 2
>>
Rule 15 (If bias is True, bias_ih is 1D tensor)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then ndim(v_1) = 1
