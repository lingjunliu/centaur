Rule 1 (weight is a scalar or 1-D tensor)
{v_1 : tensor} |= ndim(v_1) ≤ 1
>>
Rule 2 (weight size matches input channel if input dim >= 2, else weight is scalar)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 2 then shape(v_1, 1) = shape(v_2, 0) else ndim(v_2) = 0
>>
Rule 3 (input and weight should not have double and float type at the same time)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 8) ∧ (dtype_(v_2) = 7) then false else if (dtype_(v_1) = 7) ∧ (dtype_(v_2) = 8) then false
>>
Rule 4 (weight must be a tensor)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 5 (weight's dtype should be float or half if input is, otherwise promote to float)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 7 ∨ dtype_(v_1) = 6 then dtype_(v_2) = 7 ∨ dtype_(v_2) = 6
>>
Rule 6 (if input has dim > 2 and weight is 1D, weight can be expanded to the shape of input)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 2 ∧ ndim(v_2) = 1 then true
>>
Rule 7 (if input has dim < 2 and weight is 1D, then weight's shape must be 1)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) < 2 ∧ ndim(v_2) = 1 then shape(v_2, 0) = 1
>>
Rule 8 (if input has complex dtype, weight should also have complex dtype)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then dtype_(v_2) = 9 ∨ dtype_(v_2) = 10
>>
Rule 9 (if input is bool, weight is bool)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 0 then dtype_(v_2) = 0
>>
Rule 10 (if input has integer dtype, weight should also have integer dtype)
{v_1 : tensor, v_2 : tensor} |= if 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5 then 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5
>>
Rule 11 (if input is uint8, weight is uint8)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 5 then dtype_(v_2) = 5
>>
Rule 12 (if weight's shape is not 0, then all the weight's values should be valid.)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 13 (input tensor must have floating point, complex, or integer dtype)
{v_1 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5 ∨ 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
>>
Rule 14 (if input tensor's element is NaN or inf, then the output should be NaN or inf)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : ∃j ∈ [0, shape(v_1, i)-1] : (v_1[j] = "NaN") ∨ (v_1[j] = "inf")
>>
Rule 15 (Weight must be Tensor type)
{v_1: tensor} |= dtype_(v_1) ≥ 0
>>
Rule 16 (weight cannot be a string)
{v_1: tensor} |= dtype_(v_1) ≠ 11
