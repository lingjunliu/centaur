Rule 2 (if dtype is specified, the input tensor's dtype should be convertible without narrowing to the specified dtype)
{v_1 : tensor, v_2 : dtype} |= if (dtype_(v_1) < 6) then (v_2 < 6)
>>
Rule 3 (if dim is a tuple, then dimensions should not appear multiple times in the tuple)
{v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : ∀j ∈ [i + 1, v_2.len - 1] : v_2[i] ≠ v_2[j]
>>
Rule 4 (if dim is an int, then it should be a valid dimension of input tensor)
{v_1 : tensor, v_2 : int} |= (0 - ndim(v_1)) ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 5 (ord can be inf or -inf only if the tensor is non-empty)
{v_1 : tensor, v_2 : int ⊎ float} |= if v_2 = "inf" ∨ v_2 = "-inf" then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0)
>>
Rule 6 (if dtype is complex, input tensor must be complex)
{v_1 : tensor, v_2 : dtype} |= if v_2 ≥ 9 then v_1 ≥ 9
>>
Rule 7 (If dtype is specified, x should be convertible without narrowing to it)
{v_1 : tensor, v_2 : dtype} |= if v_2 < 6 then dtype_(v_1) ≤ v_2
