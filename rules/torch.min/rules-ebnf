Rule 1 (input tensor should not be empty when dim is not specified)
{v_1 : tensor} |= (shape(v_1, 0) > 0) ∨ (ndim(v_1) > 0 ∧ ndim(v_1) = 0)
>>
Rule 2 (If dim is provided, it should be within the valid range of dimensions for the input tensor)
{v_1 : tensor, v_2 : int} |= v_2 ≥ (-1 * ndim(v_1)) ∧ v_2 < ndim(v_1)
>>
Rule 3 (When comparing two tensors, their data types must be compatible)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 4 (When comparing two tensors, their shapes must be broadcastable)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : (ndim(v_1) - i - 1 < 0) ∨ (ndim(v_2) - i - 1 < 0) ∨ (shape(v_1, ndim(v_1) - i - 1) = 1) ∨ (shape(v_2, ndim(v_2) - i - 1) = 1) ∨ (shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1))
>>
Rule 5 (When comparing two tensors, if one of them is 0-dimensional, the other must also be 0-dimensional.)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 0) = (ndim(v_2) = 0)
>>
Rule 6 (When comparing two tensors, if the size of one tensor in a dimension is 0, the other tensor's size in that dimension must also be 0)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = 0) = (shape(v_2, i) = 0)
>>
Rule 7 (If keepdim is True, the output tensors are of the same size as input except in the dimension dim where they are of size 1.)
{v_1 : tensor, v_2 : int, v_3 : bool} |= if v_3 then ∀i ∈ [0, ndim(v_1) - 1] : if i ≠ v_2 then shape(v_1, i) = shape(v_1, i) else shape(v_1, i) = 1
>>
Rule 8 (When comparing two tensors with dim specified, the size of the tensors along other dimensions must be equal, or one of them should be 1)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : if i ≠ v_3 then (shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
>>
Rule 9 (When comparing two tensors, the number of elements must be the same if performing element-wise comparison without dimension specified.)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1]: shape(v_1, i) > 0) ∧ (∀i ∈ [0, ndim(v_2) - 1]: shape(v_2, i) > 0) ∧ (∀i ∈ [0, ndim(v_1) - 1]: shape(v_1, i) > 0 ∧ ndim(v_1) = 1) ∧ (∀i ∈ [0, ndim(v_2) - 1]: shape(v_2, i) > 0 ∧ ndim(v_2) = 1) ∧ shape(v_1, 0) = shape(v_2, 0)
>>
Rule 10 (When comparing two tensors and specifying dim, the other tensor must have size matching that dimension)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= if v_3 ≥ 0 ∧ v_3 < ndim(v_1) then shape(v_1, v_3) = shape(v_2, 0)
>>
Rule 11 (input tensor v_1 is a subtype of floating point number)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 6
>>
Rule 12 (The size of tensor v_1 should match the size of tensor v_2 at non-singleton dimension v_3)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= if v_3 ≥ 0 ∧ v_3 < ndim(v_1) ∧ shape(v_1,v_3) ≠ 1 then (ndim(v_1) = ndim(v_2) ∧ shape(v_1, v_3) = shape(v_2, v_3))
