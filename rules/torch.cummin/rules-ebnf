>>
Rule 1 (input must be a tensor with at least one dimension)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 2 (dim must be within the valid range of dimensions for the input tensor)
{v_1 : tensor, v_2 : int} |= v_2 ≥ 0 ∧ v_2 < ndim(v_1)
>>
Rule 3 (if dim is negative, its absolute value must be less than or equal to the number of dimensions)
{v_1 : tensor, v_2 : int} |= if v_2 < 0 then 0 ≤ ndim(v_1) + v_2
>>
Rule 4 (The 'dim' argument must be an integer type and within the valid range of tensor's dimension)
{v_1 : tensor, v_2 : int} |= if v_2 < 0 then v_2 + ndim(v_1) ≥ 0 else v_2 < ndim(v_1)
>>
Rule 5 (The output tuple must be a tuple of tensors with length 2 if provided)
{v_1 : tuple(tensor)} |= v_1.len = 2
>>
Rule 6 (The dtype of input tensor should be float32 or float64)
{v_1 : tensor} |=  dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 7 (The input tensor should not be a boolean tensor.)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
