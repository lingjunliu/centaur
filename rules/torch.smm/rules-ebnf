Rule 2 (input tensor and mat tensor's data type should be compatible)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (input tensor must have at least two dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 4 (mat tensor must have at least two dimensions)
{v_2 : tensor} |= ndim(v_2) ≥ 2
>>
Rule 5 (shape compatibility for matrix multiplication)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2)
>>
Rule 6 (input tensor must have a floating point dtype)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 7 (mat tensor must have a floating point dtype)
{v_2 : tensor} |= 6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8
>>
Rule 8 (number of dimensions of the mat tensor must be less than or equal to 2)
{v_2 : tensor} |= ndim(v_2) ≤ 2
>>
Rule 9 (if input is 2D, mat can be 1D)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 then ndim(v_2) = 1 ∨ ndim(v_2) = 2
>>
Rule 10 (mat tensor must be at least one dimensional)
{v_2 : tensor} |= ndim(v_2) ≥ 1
>>
Rule 11 (if mat is 1D, it's length must equal the last dimension of input)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) = 1 then shape(v_2, 0) = shape(v_1, ndim(v_1) - 1)
>>
Rule 12 (if input is not a floating point type, mat should not be a floating point type)
{v_1 : tensor, v_2 : tensor} |= if (6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8) then (6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8)
