Rule 2 (mat1 must be a matrix)
{v_1 : tensor} |= ndim(v_1) = 2
>>
Rule 3 (input and mat1 should have compatible shapes for broadcasting)
{v_1 : tensor, v_2 : tensor} |= (shape(v_1, 0) = shape(v_2, 0)) ∧ (shape(v_1, 1) = shape(v_2, 1))
>>
Rule 4 (shape compatibility for matrix multiplication)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 1) = shape(v_2, 0)
>>
Rule 5 (If beta is 0, any value is acceptable.)
{v_1 : float} |= if v_1 = 0 then true
>>
Rule 6 (If input is sparse, out must have the same layout.)
{v_1 : tensor, v_2 : tensor} |= if (min(v_1) = 0 ∧ max(v_1) = 1) then (min(v_2) = 0 ∧ max(v_2) = 1)
>>
Rule 7 (If FloatTensor/DoubleTensor input, alpha and beta are float; otherwise int)
{v_1 : tensor} |= if (dtype_(v_1) = 7) ∨ (dtype_(v_1) = 8) then true
>>
Rule 8 (If input is sparse, out must have the same layout)
{v_1 : tensor, v_2 : tensor} |= (min(v_1) = 0 ∧ max(v_1) = 1) = (min(v_2) = 0 ∧ max(v_2) = 1)
>>
Rule 9 (Output shape should match the broadcasted shape of addmm)
{v_1 : tensor, v_3 : tensor, v_4 : tensor} |= shape(v_4, 0) = shape(v_1, 0) ∧ shape(v_4, 1) = shape(v_3, 1)
>>
Rule 10 (if beta is not 0, input's shape should match the output shape)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : float} |= if v_4 ≠ 0 then (shape(v_1, 0) = shape(v_2, 0) ∧ shape(v_1, 1) = shape(v_3, 1))
