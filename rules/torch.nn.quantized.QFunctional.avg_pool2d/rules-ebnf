{v_1 : tuple(int), v_2 : int} |= (v_2 < v_1[0]) ∧ (v_2 < v_1[1])
>>
Rule 9 (If input tensor has 3 dimensions, padding must be 0.)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 3 then v_2 = 0
>>
Rule 10 (If input tensor has 4 dimensions, padding can be any non-negative integer.)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 4 then v_2 ≥ 0
