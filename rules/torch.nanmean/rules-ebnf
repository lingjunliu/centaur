>>
Rule 2 (dim must be non-negative if it is an integer)
{v_1 : int} |= v_1 ≥ 0
>>
Rule 3 (If dim is a tuple, all elements should be non-negative and less than the number of dimensions of the input tensor)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : 0 ≤ v_2[i] ∧ v_2[i] < ndim(v_1)
>>
Rule 4 (If dim is an integer, it must be within the valid range of dimensions for the input tensor)
{v_1 : tensor, v_2 : int} |= if v_2 < 0 then ndim(v_1) + v_2 ≥ 0 else v_2 < ndim(v_1)
>>
Rule 5 (If dim is None (represented by 0), keepdim has no effect)
{v_1 : bool, v_2 : int ⊎ tuple(int)} |= if v_2 = 0 then v_1 = false
>>
Rule 6 (dtype parameter should match input if specified)
{v_1 : tensor, v_2 : dtype} |= if v_2 ≠ 0 then dtype_(v_1) = v_2
>>
Rule 7 (The output tensor 'out' must have the same dtype as the input tensor)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 8 (keepdim must be boolean value.)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 9 (If dim appears multiple times in the list of dims, it throws an error.)
{v_1 : list(int)} |= ∀i ∈ [0, v_1.len - 1] : ∀j ∈ [i + 1, v_1.len - 1] : v_1[i] ≠ v_1[j]
>>
Rule 10 (If the input tensor contains only NaN values in a reduced dimension, the output should be NaN.)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0
>>
Rule 11 (If dim is a tuple, it cannot be an empty tuple.)
{v_1 : tuple(int)} |= v_1.len > 0
>>
Rule 12 (if dtype is specified, it must be floating point or complex)
{v_1 : dtype} |= v_1 = 6 ∨ v_1 = 7 ∨ v_1 = 8 ∨ v_1 = 9 ∨ v_1 = 10
>>
Rule 13 (The input cannot be a Char dtype.)
{v_1 : tensor} |= dtype_(v_1) ≠ 11
>>
Rule 14 (The output tensor should have the same number of dimensions as the input tensor if keepdim is true, otherwise it should have fewer dimensions)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 = true then ndim(v_1) = ndim(v_2) else ndim(v_2) < ndim(v_1)
