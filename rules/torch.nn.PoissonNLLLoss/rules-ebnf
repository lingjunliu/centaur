Rule 1 (input and target tensors for PoissonNLLLoss should have the same shape)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 2 (reduction parameter should be a valid string.)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "mean" ∨ v_1 = "sum"
>>
Rule 3 (eps parameter should be non-negative when log_input is False)
{v_1 : bool, v_2 : float} |= if v_1 = false then v_2 ≥ 0
>>
Rule 4 (input and target tensors should have floating point dtypes)
{v_1 : tensor, v_2 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8 ∧ 6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8
>>
Rule 5 (full should be a boolean value)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 6 (if log_input is true, input tensor values should be non-negative)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then min(v_2) >= 0
>>
Rule 7 (size_average and reduce should not be specified together when reduction is specified)
{v_1 : str, v_2 : bool, v_3 : bool} |= if v_1 ≠ "mean" ∧ v_1 ≠ "sum" ∧ v_1 ≠ "none" then true else (v_2 = false ∨ v_3 = false)
>>
Rule 8 (if full is false, Stirling approximation is not applied)
{v_1 : bool, v_2 : tensor} |= if v_1 = false then true else (∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) ≥ 0)
>>
Rule 9 (if reduction is none, the output has the same shape as the input)
{v_1 : str, v_2 : tensor, v_3 : tensor} |= if v_1 = "none" then ndim(v_2) = ndim(v_3) ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = shape(v_3, i)
>>
Rule 10 (input tensor should have values greater than or equal to target tensor)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i)) ∧ min(v_1) ≥ min(v_2)
>>
Rule 11 (if log_input is false, the input tensor cannot have negative values less than -eps)
{v_1 : bool, v_2 : tensor, v_3 : float} |= if v_1 = false then min(v_2) ≥ (0 - v_3)
>>
Rule 12 (If reduction is 'mean' or 'sum' output should be scalar)
{v_1 : str, v_2 : tensor} |= if v_1 = "mean" ∨ v_1 = "sum" then ndim(v_2) = 0
>>
Rule 13 (Input and target dtypes should be float16, float32, or float64)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)
>>
Rule 14 (if reduction is none, input and output must have the same dtype)
{v_1 : str, v_2 : tensor, v_3 : tensor} |= if v_1 = "none" then dtype_(v_2) = dtype_(v_3)
>>
Rule 15 (If target values are greater than 1, Stirling approximation is used)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then true else (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 ∧ min(v_1) ≤ 1)
>>
Rule 16 (if log_input is True, then target values must be greater than or equal to 0)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then min(v_2) ≥ 0
>>
Rule 17 (If target values are less than or equal to 1, zeros are added to the loss)
{v_1 : tensor} |= (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (max(v_1) ≤ 1 ∨ max(v_1) > 1)
>>
Rule 18 (if log_input is true, input tensor values must be representable as exp(x))
{v_1 : bool, v_2 : tensor} |= if v_1 = true then (∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0 )
>>
Rule 19 (input and target tensors must have the same dtype.)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 20 (If reduction is 'mean' or 'sum', setting size_average or reduce is invalid)
{v_1 : str, v_2 : bool, v_3 : bool} |= if v_1 = "mean" ∨ v_1 = "sum" then (v_2 = true ∧ v_3 = true) = false
