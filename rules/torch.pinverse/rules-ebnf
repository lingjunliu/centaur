Rule 1 (input tensor should have 2 or more dimensions and its dtype should be float, double, cfloat or cdouble)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 10 ∨ dtype_(v_1) = 11)
>>
Rule 2 (rcond must be a non-negative float)
{v_1 : float} |= v_1 ≥ 0
>>
Rule 3 (if input tensor's dtype is complex, rcond should not be zero)
{v_1 : tensor, v_2 : float} |= if dtype_(v_1) = 10 ∨ dtype_(v_1) = 11 then v_2 ≠ 0
>>
Rule 4 (if input tensor is float16, rcond should be smaller than a certain threshold)
{v_1 : tensor, v_2 : float} |= if dtype_(v_1) = 7 then v_2 < 1
>>
Rule 5 (input tensor should not have inf or NaN values)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : ∀j ∈ [0, shape(v_1, i) - 1] : v_1[j] ≠ "inf" ∧ v_1[j] ≠ "NaN"
>>
Rule 6 (if input tensor's dtype is not float or complex, rcond should be zero)
{v_1 : tensor, v_2 : float} |= if dtype_(v_1) ≠ 7 ∧ dtype_(v_1) ≠ 8 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_1) ≠ 11 then v_2 = 0
>>
Rule 7 (if input tensor is complex, rcond must be smaller than the max value of that dtype.)
{v_1 : tensor, v_2 : float} |= if dtype_(v_1) = 10 then v_2 < 3.402823e+38 else if dtype_(v_1) = 11 then v_2 < 1.797693e+308
>>
Rule 8 (The input tensor should not have any dimension of size 1 if rcond is zero)
{v_1 : tensor, v_2 : float} |= if v_2 = 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≠ 1
>>
Rule 9 (if the input tensor has more than 2 dimensions, rcond must be greater than 0.)
{v_1 : tensor, v_2 : float} |= if ndim(v_1) > 2 then v_2 > 0
