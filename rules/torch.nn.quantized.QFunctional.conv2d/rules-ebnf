Rule 1 (weight and bias must have compatible shapes for conv2d)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= shape(v_2, 1) = shape(v_1, 0) ∧ shape(v_3, 0) = shape(v_1, 0)
>>
Rule 2 (input tensor must have a floating-point dtype)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 3 (input tensor must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 4 (stride must be positive integers)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] > 0
>>
Rule 5 (padding must be non-negative integers)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 6 (groups must be a positive integer)
{v_1 : int} |= v_1 > 0
>>
Rule 7 (bias must be 1-dimensional)
{v_1 : tensor} |= ndim(v_1) = 1
>>
Rule 8 (groups must divide the number of input channels)
{v_1 : tensor, v_2 : int} |= shape(v_1, 1) / v_2 = shape(v_1, 1) / v_2
>>
Rule 9 (kernel size must be a tuple of length 2 or 3)
{v_1 : tuple(int)} |= v_1.len = 2 ∨ v_1.len = 3
>>
Rule 10 (groups must divide the number of output channels)
{v_1 : tensor, v_2 : int} |= shape(v_1, 0) / v_2 = shape(v_1, 0) / v_2
>>
Rule 11 (padding_mode must be a valid string)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "zeros" ∨ v_1 = "reflect" ∨ v_1 = "replicate" ∨ v_1 = "circular"
>>
Rule 12 (bias must have the same dtype as the output)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 13 (if bias is present, its shape should match the number of output channels)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > 0 then shape(v_2, 0) = shape(v_1, 0)
>>
Rule 14 (stride must be a tuple with the same length as kernel_size)
{v_1 : tuple(int), v_2 : tuple(int)} |= v_1.len = v_2.len
>>
Rule 15 (if output_padding is specified, its length must be less than or equal to the length of kernel_size)
{v_1 : tuple(int), v_2 : tuple(int)} |= if v_1.len > 0 then v_1.len ≤ v_2.len
>>
Rule 16 (When groups > 1, the number of input channels should be divisible by groups)
{v_1 : tensor, v_2 : int} |= if v_2 > 1 then shape(v_1, 1) / v_2 = shape(v_1, 1) / v_2
