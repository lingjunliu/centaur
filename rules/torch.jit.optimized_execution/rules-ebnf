Rule 1 (optimized_execution flag must be a boolean value)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 2 (If optimization level is provided, it must be a non-negative integer)
{v_1 : int} |= v_1 ≥ 0
>>
Rule 3 (If a string argument is passed, it must be one of the allowed values.)
{v_1 : str} |= v_1 = "ii" ∨ v_1 = "ii->i" ∨ v_1 = "i,j->ij" ∨ v_1 = "bij,bjk->bik" ∨ v_1 = "...ij->...ji" ∨ v_1 = "bn,anm,bm->ba" ∨ v_1 = "none" ∨ v_1 = "mean" ∨ v_1 = "sum" ∨ v_1 = "max" ∨ v_1 = "constant" ∨ v_1 = "tanh"
>>
Rule 4 (If multiple tensor arguments are provided, their number of dimensions must be equal.)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 5 (If one tensor argument is given, its dtype must not be a boolean.)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 6 (If optimization level and tensor are given, level must be less than or equal to the number of dimensions of the tensor.)
{v_1 : int, v_2 : tensor} |= v_1 ≤ ndim(v_2)
>>
Rule 7 (If a list of ints is passed, the length should be greater than 0.)
{v_1 : list(int)} |= v_1.len > 0
>>
Rule 8 (List must have length of at least zero)
{v_1 : list(tensor)} |= v_1.len ≥ 0
>>
Rule 9 (if a tuple of ints is provided, then all the ints must be positive)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] > 0
>>
Rule 10 (If a tensor is passed as an argument, it must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 11 (If dtype is passed in, it should be a valid dtype index)
{v_1 : dtype} |= v_1 ≥ 0 ∧ v_1 ≤ 12
>>
Rule 12 (if a tensor and int are given, check the shape at that dimension is greater than zero)
{v_1 : tensor, v_2 : int} |= if v_2 ≥ 0 ∧ v_2 < ndim(v_1) then shape(v_1, v_2) > 0
>>
Rule 13 (If a float is given, it should be between -1 and 1 inclusive.)
{v_1 : float} |= v_1 ≥ -1 ∧ v_1 ≤ 1
