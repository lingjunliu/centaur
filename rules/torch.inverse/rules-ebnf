>>
Rule 1 (input tensor must have at least 2 dimensions and be of floating point or complex type)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 10 ∨ dtype_(v_1) = 9)
>>
Rule 2 (input tensor must be square matrix if it is 2D)
{v_1 : tensor} |= if ndim(v_1) = 2 then shape(v_1, 0) = shape(v_1, 1)
>>
Rule 3 (out tensor dtype must be float or complex if it exists)
{v_2 : tensor} |= if v_2 ≠ None then (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)
>>
Rule 4 (out tensor shape must match input tensor shape if it exists)
{v_1 : tensor, v_2 : tensor} |= if v_2 ≠ None then (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 5 (the out tensor should have the same dtype as input tensor)
{v_1 : tensor, v_2 : tensor} |= if v_2 ≠ None then dtype_(v_1) = dtype_(v_2)
>>
Rule 6 (input tensor should not have low precision dtype)
{v_1 : tensor} |= dtype_(v_1) ≠ 6
>>
Rule 7 (if input tensor has more than 2 dimensions, the last two dimensions must form a square matrix)
{v_1 : tensor} |= if ndim(v_1) > 2 then shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 8 (input tensor should not have bool or int8 dtype)
{v_1 : tensor} |= dtype_(v_1) ≠ 0 ∧ dtype_(v_1) ≠ 1
>>
Rule 9 (the out tensor should be contiguous if provided)
{v_2 : tensor} |= if v_2 ≠ None then true
>>
Rule 10 (If input tensor is complex, out tensor must also be complex if provided.)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then (if v_2 ≠ None then (dtype_(v_2) = 9 ∨ dtype_(v_2) = 10))
>>
Rule 11 (If input is float16, promote it to float32 and use float32 as out dtype)
{v_1: tensor, v_2: tensor} |= if dtype_(v_1) = 6 then (if v_2 ≠ None then (dtype_(v_2) = 7))
>>
Rule 12 (the input tensor should not be quantized data type)
{v_1 : tensor} |= dtype_(v_1) ≠ 12
>>
Rule 13 (The last two dimensions of the input tensor must be greater than 0)
{v_1 : tensor} |= shape(v_1, ndim(v_1) - 1) > 0 ∧ shape(v_1, ndim(v_1) - 2) > 0
>>
Rule 14 (Input tensor should be a square matrix in batch dimensions also)
{v_1 : tensor} |= ∀i ∈ [0, if ndim(v_1) - 2 > 0 then ndim(v_1) - 3 else 0] : shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 15 (Input tensor must not have inf or nan values)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 16 (if the input tensor is complex128, the output tensor, if specified, should also be complex128.)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 10 then (if v_2 ≠ None then dtype_(v_2) = 10)
>>
Rule 17 (The shape of input and output should be same if out tensor is passed.)
{v_1 : tensor, v_2 : tensor} |= if v_2 ≠ None then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 18 (Check if all the batch dimensions of the input tensor are greater than 0)
{v_1 : tensor} |= ∀i ∈ [0, if ndim(v_1) - 2 > 0 then ndim(v_1) - 3 else -1] : shape(v_1, i) > 0
>>
Rule 19 (If the input dtype is float, the output should not be complex. If it's complex, the output should not be float)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 then (if v_2 ≠ None then (dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10)) else if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then (if v_2 ≠ None then (dtype_(v_2) ≠ 7 ∧ dtype_(v_2) ≠ 8))
>>
Rule 20 (if input tensor has only 2 dimensions and one of them is 1, it's invalid)
{v_1 : tensor} |= if ndim(v_1) = 2 then (shape(v_1, 0) ≠ 1 ∨ shape(v_1, 1) ≠ 1)
>>
Rule 21 (if out tensor is provided, the last two dimensions of it should be square matrix)
{v_2 : tensor} |= if v_2 ≠ None then (shape(v_2, ndim(v_2) - 1) = shape(v_2, ndim(v_2) - 2))
>>
Rule 22 (The element size of input should be less than 2^31)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) < 2147483648
>>
Rule 23 (if input tensor has only 2 dimensions and one of them is 0, it's invalid)
{v_1 : tensor} |= if ndim(v_1) = 2 then (shape(v_1, 0) ≠ 0 ∧ shape(v_1, 1) ≠ 0)
>>
Rule 24 (For complex data type, the input should have hermitian property)
{v_1 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then true
>>
Rule 25 (The input tensor’s element size should fit in memory)
{v_1 : tensor} |= if dtype_(v_1) = 7 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) < 10000 else if dtype_(v_1) = 8 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) < 5000
>>
Rule 26 (If out tensor is provided, it should not overlap with input tensor)
{v_1 : tensor, v_2 : tensor} |= if v_2 ≠ None then v_1 ≠ v_2
>>
Rule 27 (if the out tensor is specified, the last two dimensions must be same as input tensor)
{v_1 : tensor, v_2 : tensor} |= if v_2 ≠ None then (shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) ∧ shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 2))
