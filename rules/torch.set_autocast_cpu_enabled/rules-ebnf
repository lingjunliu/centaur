Rule 1 (torch.set_autocast_cpu_enabled enabled parameter must be a boolean value)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 2 (If enabled is true, a tensor must have a floating-point dtype: 6–8 when autocast is enabled)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then 6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8
>>
Rule 3 (If enabled is false, it must be false)
{v_1 : bool} |= if v_1 = false then v_1 = false
>>
Rule 4 (If enabled is true, then min of the tensor should be greater than zero.)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then min(v_2) > 0
>>
Rule 5 (If enabled is true, then ndim of the tensor should be less than or equal to 4.)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then ndim(v_2) ≤ 4
>>
Rule 6 (If enabled is true and dtype is float16, then max of the tensor should be less than 65500.)
{v_1 : bool, v_2 : tensor} |= if v_1 = true ∧ dtype_(v_2) = 6 then max(v_2) < 65500
>>
Rule 7 (If enabled is false, then the value of enabled doesn't matter)
{v_1 : bool} |= if v_1 = false then true
>>
Rule 8 (The dtype of the tensor must be float16, float32 or float64)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 9 (If enabled is true, then all the elements of the tensor should be less than 65500 when the dtype is float16)
{v_1 : bool, v_2 : tensor} |= if v_1 = true ∧ dtype_(v_2) = 6 then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = 0 ∨ max(v_2) < 65500
>>
Rule 10 (If enabled is true, then the tensor cannot be empty.)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0
>>
Rule 11 (If enabled is true, then the tensor must have at least one element.)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then ∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0
>>
Rule 12 (If enabled is true, the shape of the tensor at any dimension must not be negative.)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) ≥ 0
>>
Rule 13 (If enabled is true, then the shape of the tensor at any dimension must not be zero.)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) ≠ 0
>>
Rule 14 (If enabled is true, the shape of the tensor at any dimension should be less than 2^31)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) < 2147483648
>>
Rule 15 (If enabled is true and dtype is bfloat16, the shape of the tensor at any dimension must not be greater than 2048)
{v_1 : bool, v_2 : tensor} |= if v_1 = true ∧ dtype_(v_2) = 6 then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) ≤ 2048
>>
Rule 16 (If enabled is true and dtype is float16 or float32, then the shape of the tensor must have at least 2 dimensions)
{v_1 : bool, v_2 : tensor} |= if v_1 = true ∧ (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7) then ndim(v_2) ≥ 2
