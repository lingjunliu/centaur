Rule 10 (If the input's dtype is complex, then requires_grad should be false)
{v_1 : tensor, v_2 : bool} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then v_2 = false
>>
Rule 11 (If input has dtype int8, int16, int32 or int64 then output's dtype can not be boolean)
{v_1 : tensor, v_2 : dtype} |= if dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 then v_2 ≠ 0
