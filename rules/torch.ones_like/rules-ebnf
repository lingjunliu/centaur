Rule 15 (memory_format can be 'torch.preserve_format', 'torch.contiguous_format' or 'torch.channels_last')
{v_1 : str} |= v_1 = "torch.preserve_format" ∨ v_1 = "torch.contiguous_format" ∨ v_1 = "torch.channels_last"
