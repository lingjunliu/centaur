{v_1 : str, v_2 : tensor} |= (v_1 = "torch.preserve_format") ∨ (v_1 = "torch.contiguous_format") ∨ (v_1 = "torch.channels_last" ∧ (ndim(v_2) = 2 ∨ ndim(v_2) = 3))
