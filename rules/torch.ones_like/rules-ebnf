Rule 1 (input must be a tensor)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 2 (dtype can be None or a valid dtype)
{v_1 : tensor, v_2 : dtype ⊎ str} |= (v_2 = "none") ∨ (dtype_(v_1) = v_2)
>>
Rule 3 (requires_grad is a boolean)
{v_1 : bool} |= (v_1 = true) ∨ (v_1 = false)
>>
Rule 4 (if requires_grad is true, dtype must be floating point or complex)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10)
>>
Rule 5 (shape of input tensor is same as shape of output tensor)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 6 (if input tensor has a particular dimension size then another tensor must have the same dimension size)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= if ndim(v_1) > v_3 ∧ ndim(v_2) > v_3 then shape(v_1, v_3) = shape(v_2, v_3)
>>
Rule 7 (if input is int type then other variable cannot be string)
{v_1 : tensor, v_2 : str} |= if dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 then v_2 = "none"
>>
Rule 8 (memory_format is string and valid value)
{v_1 : str} |= (v_1 = "preserve_format") ∨ (v_1 = "contiguous_format") ∨ (v_1 = "channels_last")
>>
Rule 9 (If dtype is specified, it must be a valid dtype)
{v_1 : dtype} |= v_1 = 0 ∨ v_1 = 1 ∨ v_1 = 2 ∨ v_1 = 3 ∨ v_1 = 4 ∨ v_1 = 5 ∨ v_1 = 6 ∨ v_1 = 7 ∨ v_1 = 8 ∨ v_1 = 9 ∨ v_1 = 10 ∨ v_1 = 12
