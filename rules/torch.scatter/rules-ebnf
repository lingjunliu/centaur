Rule 1 (scatter API: input and src dtype should be equal, and dim should be within the range of input's dimensions)
{input : tensor, dim : int, src : tensor} |= dtype_(input) = dtype_(src) ∧ dim ≥ (0 - ndim(input)) ∧ dim < ndim(input)
>>
Rule 2 (scatter API: the number of dimensions of index should be equal to input - 1, given dim is not none)
{input : tensor, index : tensor, dim : int} |= if dim ≥ 0 ∧ dim < ndim(input) then ndim(index) = ndim(input) - 1
>>
Rule 3 (scatter API: index tensor must be int type)
{index : tensor} |= dtype_(index) = 1 ∨ dtype_(index) = 2 ∨ dtype_(index) = 3 ∨ dtype_(index) = 4 ∨ dtype_(index) = 5
>>
Rule 4 (scatter API: the shape of src except dim dimension should be same as the shape of index)
{input : tensor, dim : int, index : tensor, src : tensor} |= ∀i ∈ [0, ndim(input) - 1] : if i ≠ dim then shape(src, i) = shape(index, i)
>>
Rule 5 (scatter API: index value should be less than input shape at dimension dim)
{input : tensor, index : tensor, dim : int} |= max(index) < shape(input, dim)
>>
Rule 6 (scatter API: if dim is negative, convert to positive)
{input : tensor, dim : int} |= if dim < 0 then dim + ndim(input) ≥ 0
>>
Rule 7 (scatter API: the values in index should be non-negative.)
{index : tensor} |= min(index) >= 0
>>
Rule 8 (scatter API: if dim is out of range, an IndexError will be raised.)
{input : tensor, dim : int} |= dim >= (0 - ndim(input)) ∧ dim < ndim(input)
>>
Rule 9 (scatter API: all elements in index must be within the bounds of the dimension they are scattering to.)
{input : tensor, index : tensor, dim : int} |= ∀i ∈ [0, index.len - 1] : index[i] < shape(input, dim)
>>
Rule 10 (scatter API: if index is empty, then output is same as input.)
{index : tensor} |= ∃i ∈ [0, ndim(index) - 1] : shape(index, i) = 0
>>
Rule 11 (scatter API: src tensor should have same shape as input when index has same shape as input except at dimension dim)
{input : tensor, dim : int, index : tensor, src : tensor} |= if ∀i ∈ [0, ndim(input) - 1] : i = dim ∨ shape(index, i) = shape(input, i) then ndim(input) = ndim(src) ∧ ∀i ∈ [0, ndim(input) - 1]: shape(input, i) = shape(src, i)
>>
Rule 12 (scatter API: if dim is not specified, dim is zero.)
{dim: int, input: tensor} |= if 0 > dim ∨ dim ≥ ndim(input) then false
>>
Rule 13 (scatter API: number of elements in src should match number of elements can be scattered)
{src : tensor, index : tensor, input : tensor, dim : int} |= if ndim(index) = ndim(input) - 1 then shape(src, dim) = shape(input,dim)
>>
Rule 14 (scatter API: size of index should match size of src except in dim. src size at dim should match input size)
{input : tensor, index : tensor, src : tensor, dim : int} |=  ∀i ∈ [0, ndim(input) - 1] : if i ≠ dim then shape(index, i) = shape(src, i) else shape(src, dim) = shape(input,dim)
>>
Rule 15 (scatter API: if index's ndim = input's ndim, then shape of index must be same as input except for dim)
{input : tensor, index : tensor, dim: int} |= if ndim(input) = ndim(index) then ∀i ∈ [0, ndim(input) - 1] : if i = dim then true else shape(index, i) = shape(input, i)
>>
Rule 16 (scatter API: the values in index should be less or equal than input shape at dimension dim, when index's ndim equals to input's ndim -1)
{input : tensor, index : tensor, dim : int} |= if ndim(index) = ndim(input) -1 then max(index) ≤ shape(input, dim) -1
>>
Rule 17 (scatter API: values in index tensor should not exceed maximum possible index value)
{input : tensor, index : tensor, dim : int} |= if ndim(index) < ndim(input) then max(index) < shape(input, dim)
>>
Rule 18 (scatter API: if index's ndim = input's ndim, then the values in index must be less than input's dim size.)
{input : tensor, index : tensor, dim : int} |= if ndim(index) = ndim(input) then max(index) < shape(input, dim)
>>
Rule 19 (scatter API: index should be able to broadcast with input when index's ndim equals to input's ndim -1)
{input : tensor, index : tensor, dim : int} |= if ndim(index) = ndim(input) - 1 then  ∀i ∈ [0, ndim(input) - 1] : if i=dim then true else shape(index, i) = shape(input, i) ∨ shape(index, i) = 1
>>
Rule 20 (scatter API: input should have positive number of dimensions)
{input: tensor} |= ndim(input) > 0
>>
Rule 21 (scatter API: index tensor should not be empty)
{index : tensor} |= ndim(index) > 0
>>
Rule 22 (scatter API: src tensor should not be empty)
{src : tensor} |= ndim(src) > 0
>>
Rule 23 (scatter API: src dimension should be valid)
{src : tensor, dim : int} |= dim ≥ (0 - ndim(src)) ∧ dim < ndim(src)
