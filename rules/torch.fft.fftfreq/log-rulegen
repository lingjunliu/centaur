{v_1 : dtype} |= v_1 = 6 ∨ v_1 = 7 ∨ v_1 = 8

Rule 6 (last dimension of a tensor matches first dimension of the other)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ shape(v_1, ndim(v_1) − 1) = shape(v_2, 0)

Rule 7 (first dimension of a tensor matches second dimension of the other)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 2 ∧ shape(v_1, 0) = shape(v_2, 1)

