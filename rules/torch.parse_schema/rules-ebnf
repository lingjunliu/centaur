>>
Rule 1 (schema string should be non-empty)
{v_1 : str} |= v_1 ≠ ""
>>
Rule 2 (schema string should only contain allowed characters)
{v_1 : str} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] = "i" ∨ v_1[i] = "j" ∨ v_1[i] = "k" ∨ v_1[i] = "b" ∨ v_1[i] = "n" ∨ v_1[i] = "m" ∨ v_1[i] = "," ∨ v_1[i] = ">" ∨ v_1[i] = "-" ∨ v_1[i] = "."
>>
Rule 3 (If allow_typevars is false, schema should not contain typevars)
{v_1 : str, v_2 : bool} |= if v_2 = false then (∀i ∈ [0, v_1.len - 1] : v_1[i] ≠ "T" ∧ v_1[i] ≠ "U" ∧ v_1[i] ≠ "V")
>>
Rule 4 (schema string should have valid arrow notation)
{v_1 : str} |= ∃i ∈ [0, v_1.len - 1] : v_1[i] = ">"
>>
Rule 5 (If the schema contains a list, the type inside the list should be defined)
{v_1 : str} |= if ∃i ∈ [0, v_1.len - 1] : v_1[i] = "list(" then ∃i ∈ [0, v_1.len - 1] : v_1[i] = "int" ∨ v_1[i] = "float" ∨ v_1[i] = "bool" ∨ v_1[i] = "tensor"
>>
Rule 6 (Schema should not contain unsupported type)
{v_1 : str} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≠ "complex64" ∧ v_1[i] ≠ "complex128"
>>
Rule 7 (If schema represents a reduction, the output should have fewer dimensions or the same number of dimensions)
{v_1 : str} |= if ∃i ∈ [0, v_1.len - 1] : v_1[i] = "->" then true
>>
Rule 8 (schema should contain at least one argument)
{v_1 : str} |= ∃i ∈ [0, v_1.len - 1] : v_1[i] = "tensor" ∨ v_1[i] = "int" ∨ v_1[i] = "float" ∨ v_1[i] = "bool" ∨ v_1[i] = "dtype" ∨ v_1[i] = "str"
>>
Rule 9 (If schema contains Tuple, it should not be empty)
{v_1 : str} |= if ∃i ∈ [0, v_1.len - 1] : v_1[i] = "tuple(" then ∃i ∈ [0, v_1.len - 1] : v_1[i] = "int" ∨ v_1[i] = "float" ∨ v_1[i] = "bool" ∨ v_1[i] = "tensor" ∨ v_1[i] = "dtype" ∨ v_1[i] = "str"
>>
Rule 10 (Schema should contain valid comma separation)
{v_1 : str} |= ∀i ∈ [0, v_1.len - 2] : if v_1[i] = "," then v_1[i+1] = "tensor" ∨ v_1[i+1] = "int" ∨ v_1[i+1] = "float" ∨ v_1[i+1] = "bool" ∨ v_1[i+1] = "dtype" ∨ v_1[i+1] = "str"
>>
Rule 11 (If Schema contains dtype, it should have a valid value)
{v_1 : str} |= if ∃i ∈ [0, v_1.len - 1] : v_1[i] = "dtype" then true
>>
Rule 12 (if Schema has "str", the following charaters should not be allowed)
{v_1 : str} |= if ∃i ∈ [0, v_1.len - 1] : v_1[i] = "str" then (∀i ∈ [0, v_1.len - 1] : v_1[i] ≠ "[" ∧ v_1[i] ≠ "]" ∧ v_1[i] ≠ "+" ∧ v_1[i] ≠ "-" ∧ v_1[i] ≠ "*" ∧ v_1[i] ≠ "/")
>>
Rule 13 (Shape arguments should not be float)
{v_1 : str} |= ∀i ∈ [0, v_1.len - 1] : if v_1[i] = "shape" then (∀i ∈ [0, v_1.len - 1] : v_1[i] ≠ "float")
>>
Rule 14 (If schema contains '...', the number of dimensions before '...' should be matched)
{v_1 : str} |= if ∃i ∈ [0, v_1.len - 1] : v_1[i] = "..." then true
>>
Rule 15 (If schema uses broadcast, the arguments should be Tensor)
{v_1 : str} |= if ∃i ∈ [0, v_1.len - 1] : v_1[i] = "broadcast" then ∀i ∈ [0, v_1.len - 1] : v_1[i] = "tensor"
>>
Rule 16 (if Schema uses 'shape', it should be followed by at least one number)
{v_1 : str} |= if ∃i ∈ [0, v_1.len - 1] : v_1[i] = "shape" then (∃j ∈ [0, v_1.len - 1] : v_1[j] = "0" ∨ v_1[j] = "1" ∨ v_1[j] = "2" ∨ v_1[j] = "3" ∨ v_1[j] = "4" ∨ v_1[j] = "5" ∨ v_1[j] = "6" ∨ v_1[j] = "7" ∨ v_1[j] = "8" ∨ v_1[j] = "9")
>>
Rule 17 (if Schema contains list, the type within the list should match the argument type)
{v_1 : str} |= if ∃i ∈ [0, v_1.len - 1] : v_1[i] = "list" then true
>>
Rule 18 (If schema contains '->', it should have valid left and right hand side arguments)
{v_1 : str} |= ∃i ∈ [0, v_1.len - 1] : v_1[i] = "->"
>>
Rule 19 (if the schema contains list, then the variable should not be tensor)
{v_1 : str} |= if ∃i ∈ [0, v_1.len - 1] : v_1[i] = "list(" then (∀j ∈ [0, v_1.len - 1] : v_1[j] ≠ "tensor")
>>
Rule 20 (If the schema contains the 'aten' namespace, the name should start with lowercase)
{v_1 : str} |= if ∃i ∈ [0, v_1.len - 3] : v_1[i] = "a" ∧ v_1[i+1] = "t" ∧ v_1[i+2] = "e" ∧ v_1[i+3] = "n" then (∃j ∈ [0, v_1.len - 1] : v_1[j] = "a" ∨ v_1[j] = "b" ∨ v_1[j] = "c" ∨ v_1[j] = "d" ∨ v_1[j] = "e" ∨ v_1[j] = "f" ∨ v_1[j] = "g" ∨ v_1[j] = "h" ∨ v_1[j] = "i" ∨ v_1[j] = "j" ∨ v_1[j] = "k" ∨ v_1[j] = "l" ∨ v_1[j] = "m" ∨ v_1[j] = "n" ∨ v_1[j] = "o" ∨ v_1[j] = "p" ∨ v_1[j] = "q" ∨ v_1[j] = "r" ∨ v_1[j] = "s" ∨ v_1[j] = "t" ∨ v_1[j] = "u" ∨ v_1[j] = "v" ∨ v_1[j] = "w" ∨ v_1[j] = "x" ∨ v_1[j] = "y" ∨ v_1[j] = "z")
>>
Rule 21 (If Schema contains tensor argument, it should have a dtype and shape)
{v_1 : str} |= if ∃i ∈ [0, v_1.len - 1] : v_1[i] = "tensor" then true
>>
Rule 22 (The dimension of tensor if schema represents a reduction operation should be valid)
{v_1 : str} |= if ∃i ∈ [0, v_1.len - 1] : v_1[i] = "sum" ∨ v_1[i] = "mean" ∨ v_1[i] = "max" ∨ v_1[i] = "min" then true
