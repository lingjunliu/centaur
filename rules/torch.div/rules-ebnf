Rule 4 (input and other tensors must have compatible dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2) ∨ (dtype_(v_1) = 7 ∧ dtype_(v_2) = 4) ∨ (dtype_(v_1) = 4 ∧ dtype_(v_2) = 7)
