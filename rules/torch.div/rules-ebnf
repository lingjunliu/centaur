Rule 5 (if rounding_mode is specified, the inputs cannot be complex)
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if (v_3 ≠ "none") then (dtype_(v_1) < 9 ∧ dtype_(v_2) < 9)
