Rule 10 (The size of input along dim should be greater than zero.)
{v_1 : tensor, v_2 : int} |= shape(v_1, v_2) > 0
>>
Rule 11 (The index tensor cannot have any zero dimensions)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 12 (For a 2D tensor, if dim is 0, then max(index) < shape(input, 0) )
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 then if 0=0 then max(v_2) < shape(v_1,0)
>>
Rule 13 (src tensor cannot be empty)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
