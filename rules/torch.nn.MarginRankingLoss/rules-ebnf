Rule 1 (input tensors should have the same shape or be scalars, and target should have the same shape as inputs)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= (ndim(v_1) = 0 ∧ ndim(v_2) = 0 ∧ ndim(v_3) = 0) ∨ (ndim(v_1) = 1 ∧ ndim(v_2) = 1 ∧ ndim(v_3) = 1 ∧ shape(v_1, 0) = shape(v_2, 0) ∧ shape(v_1, 0) = shape(v_3, 0))
>>
Rule 2 (margin must be greater than or equal to zero)
{v_1 : float} |= v_1 ≥ 0
>>
Rule 3 (reduction must be a valid string value)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "mean" ∨ v_1 = "sum"
>>
Rule 4 (input1 and input2 tensors should have compatible dtypes)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 7 ∧ dtype_(v_2) = 7) ∨ (dtype_(v_1) = 8 ∧ dtype_(v_2) = 8) ∨ (dtype_(v_1) = 6 ∧ dtype_(v_2) = 6)
>>
Rule 5 (target tensor should have dtype int with values either 1 or -1)
{v_1 : tensor} |= (dtype_(v_1) = 3 ∨ dtype_(v_1) = 4) ∧ (min(v_1) = -1 ∧ max(v_1) = 1)
>>
Rule 6 (if input1 is a scalar, then input2 and target must also be scalars)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_1) = 0 then ndim(v_2) = 0 ∧ ndim(v_3) = 0
>>
Rule 7 (If input1 is a 1D tensor, then input2 and target must also be 1D tensors with the same length)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_1) = 1 then ndim(v_2) = 1 ∧ ndim(v_3) = 1 ∧ shape(v_1, 0) = shape(v_2, 0) ∧ shape(v_1, 0) = shape(v_3, 0)
>>
Rule 8 (If the reduction is 'none', the output tensor should have the same shape as the input tensors.)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : str} |= if v_4 = "none" then ndim(v_1) = ndim(v_2) ∧ ndim(v_1) = ndim(v_3) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∧ shape(v_1, i) = shape(v_3, i)
>>
Rule 9 (inputs and target must have float or int compatible dtypes.)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ((1 <= dtype_(v_1) ∧ dtype_(v_1) <= 8) ∧ (1 <= dtype_(v_2) ∧ dtype_(v_2) <= 8) ∧ (1 <= dtype_(v_3) ∧ dtype_(v_3) <= 8))
>>
Rule 10 (If input1 is a 1D tensor, then the target tensor must have values of 1 or -1.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 then (min(v_2) = -1 ∧ max(v_2) = 1)
>>
Rule 11 (if reduction is none, the output should be a tensor of the same shape; otherwise, the output is a scalar.)
{v_1 : tensor, v_2 : str} |= if v_2 = "none" then true else ndim(v_1) = 0
>>
Rule 12 (If any of the inputs are empty tensors, then all inputs should be empty tensors)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) then (∃j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) = 0) ∧ (∃k ∈ [0, ndim(v_3) - 1] : shape(v_3, k) = 0)
