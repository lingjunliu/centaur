Rule 1 (output tensor and input tensor should have same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (out tensor and input tensor should have compatible shapes if out tensor is provided)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > 0 then ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (input tensor should have floating or complex dtype)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
>>
Rule 4 (input tensor must contain non-negative values)
{v_1 : tensor} |= min(v_1) ≥ 0
>>
Rule 5 (if out tensor is provided, its values must be positive if input values are positive)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > 0 then if min(v_1) >= 0 then min(v_2) >= 0
>>
Rule 6 (if the input tensor is complex, the output tensor must also be complex)
{v_1 : tensor, v_2 : tensor} |= if 9 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10 then 9 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 10
>>
Rule 7 (if input tensor has zero dimension, output tensor also has zero dimension)
{v_1 : tensor, v_2 : tensor} |= if (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) then (∃j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) = 0)
>>
Rule 8 (If input and output tensors are provided, the output tensor's dtype must be able to represent log2 of the input tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > 0 then if dtype_(v_1) = 6 then dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10 else if dtype_(v_1) = 7 then dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10 else if dtype_(v_1) = 8 then dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10 else if dtype_(v_1) = 9 then dtype_(v_2) = 9 ∨ dtype_(v_2) = 10 else if dtype_(v_1) = 10 then dtype_(v_2) = 10
>>
Rule 9 (If input is NaN, output should be NaN)
{v_1 : tensor, v_2 : tensor} |= if max(v_1) = "nan" then max(v_2) = "nan"
>>
Rule 10 (If the input tensor contains only positive values, the output tensor should contain finite values)
{v_1 : tensor, v_2 : tensor} |= if min(v_1) > 0 then ∀i ∈ [0, ndim(v_2) - 1] : min(v_2) ≠ "inf" ∧ max(v_2) ≠ "inf"
>>
Rule 11 (If the input tensor has values in range (0, 1], the output tensor should have values in range (-inf, 0].)
{v_1 : tensor, v_2 : tensor} |= if min(v_1) > 0 ∧ max(v_1) ≤ 1 then min(v_2) = "-inf" ∧ max(v_2) ≤ 0
>>
Rule 12 (If the input tensor has a value of 1, the corresponding element in the output tensor should be 0)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) > 0 then shape(v_1, 0) - 1 else 0] : if v_1[i] = 1 then v_2[i] = 0
>>
Rule 13 (If the input is Inf, the output is also Inf.)
{v_1 : tensor, v_2 : tensor} |= if max(v_1) = "inf" then max(v_2) = "inf"
>>
Rule 14 (The shape of the input and output tensor should be compatible, i.e., the output can be broadcast to the input.)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) >= ndim(v_2) ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_1, ndim(v_1) - ndim(v_2) + i) = shape(v_2, i)
>>
Rule 15 (If any element in input is zero, the corresponding element in the output should be -inf)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) > 0 then shape(v_1, 0) - 1 else 0] : if v_1[i] = 0 then v_2[i] = "-inf"
>>
Rule 16 (If input values close to zero, then output values should be checked against large negative values)
{v_1 : tensor, v_2 : tensor} |= if min(v_1) > 0 ∧ min(v_1) < 0.000001 then min(v_2) < -10
>>
Rule 17 (If input values are very large then output values should be smaller but still large)
{v_1 : tensor, v_2 : tensor} |= if max(v_1) > 1000000 then max(v_2) < max(v_1)
>>
Rule 18 (If the input tensor's dtype is float16, then the output dtype should also be float16)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 6 then dtype_(v_2) = 6
>>
Rule 19 (If the input tensor has bool dtype, it will be casted to float)
{v_1 : tensor} |= if dtype_(v_1) = 0 then true
>>
Rule 20 (If input has zero values then gradient of output is infinite)
{v_1 : tensor} |= if min(v_1) = 0 then true
