>>
Rule 1 (The input tensor A must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (The input tensor A must be square matrices)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 3 (UPLO should be either 'L' or 'U')
{v_1 : str} |= v_1 = "L" ∨ v_1 = "U"
>>
Rule 4 (The output 'out' must be a tuple of two tensors)
{v_1 : tuple(tensor)} |= v_1.len = 2
>>
Rule 5 (A's dtype must be one of float32, float64, complex64, or complex128)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 6 (The output eigenvectors will have the same dtype as A)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 7 (If A is complex, output eigenvalues will be real)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then dtype_(v_2) = 8 ∨ dtype_(v_2) = 7
>>
Rule 8 (The eigenvectors will have the same shape as A)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) ∧ shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 2) ∧ ndim(v_1) = ndim(v_2)
>>
Rule 9 (The eigenvalues will always be real-valued even when A is complex)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then dtype_(v_2) = 7 ∨ dtype_(v_2) = 8
>>
Rule 10 (If A is real, output eigenvectors will be real.)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 then dtype_(v_2) = 7 ∨ dtype_(v_2) = 8
>>
Rule 11 (The batch dimensions of A and out tensors should match)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 2] : shape(v_1, i) = shape(v_2, i) ∧ ndim(v_1) > 1 ∧ ndim(v_2) > 1
>>
Rule 12 (A is assumed to be Hermitian (resp. symmetric))
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 2] : shape(v_1, ndim(v_1)-1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 13 (The output eigenvalues will have the same batch dimensions as input A)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 2 then ndim(v_2) = ndim(v_1) - 1 else ndim(v_2) = 1
>>
Rule 14 (Eigenvalues are returned in ascending order.)
{v_1 : tensor} |= ∀i ∈ [0, shape(v_1, 0) - 2] : v_1[i] ≤ v_1[i+1]
>>
Rule 15 (If A is a batch of matrices, then the output has the same batch dimensions.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 2 then ∀i ∈ [0, ndim(v_1) - 2] : shape(v_1, i) = shape(v_2, i)
>>
Rule 16 (The last dimension of the eigenvectors tensor must match last dim of A.)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1)
>>
Rule 17 (When UPLO is 'L', only the lower triangular part of the matrix is used)
{v_1 : tensor, v_2 : str} |= if v_2 = "L" then shape(v_1, ndim(v_1) -1) > 0 else shape(v_1, ndim(v_1) -1) > 0
