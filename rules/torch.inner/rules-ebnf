Rule 1 (last dimension of input tensors must match if both are non-scalars)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 1 ∧ ndim(v_2) > 1 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1)
>>
Rule 2 (input tensors must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (output tensor should be a tensor)
{v_3 : tensor} |= ndim(v_3) ≥ 0
>>
Rule 4 (if out is provided, its shape should match the expected output shape)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then ∀i ∈ [0, ndim(v_1) - 2] : shape(v_1, i) = shape(v_3, i) ∧ ∀i ∈ [0, ndim(v_2) - 2] : shape(v_2, i) = shape(v_3, ndim(v_1) - 1 + i)
>>
Rule 5 (if either input is a scalar, the output dtype should be the same as the tensor input)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_1) = 0 then dtype_(v_3) = dtype_(v_2) else if ndim(v_2) = 0 then dtype_(v_3) = dtype_(v_1)
>>
Rule 6 (if one input is scalar, the other must be a tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then ndim(v_2) > 0 else if ndim(v_2) = 0 then ndim(v_1) > 0
>>
Rule 7 (for 1D tensors, the result is a scalar)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then ndim(v_3) = 0
>>
Rule 8 (The output shape is input.shape[:-1] + other.shape[:-1] if both inputs are non-scalar)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_1) > 1 ∧ ndim(v_2) > 1 then (∀i ∈ [0, ndim(v_1) - 1 -1]: shape(v_1, i) = shape(v_3, i)) ∧ (∀j ∈ [0, ndim(v_2) - 1 -1]: shape(v_2, j) = shape(v_3, ndim(v_1) - 1 + j))
>>
Rule 9 (If out is specified, its dtype must match the dtype of the inputs)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_3) > 0 then dtype_(v_1) = dtype_(v_3) ∧ dtype_(v_2) = dtype_(v_3)
