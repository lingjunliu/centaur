Rule 1 (equation string should not be empty)
{v_1 : str} |= v_1 ≠ ""
>>
Rule 2 (number of operands should match the equation)
{v_1 : str, v_2 : list(tensor)} |= if v_1 = "ii" then v_2.len = 1 else if v_1 = "ii->i" then v_2.len = 1 else if v_1 = "i,j->ij" then v_2.len = 2 else if v_1 = "bij,bjk->bik" then v_2.len = 2 else if v_1 = "...ij->...ji" then v_2.len = 1 else if v_1 = "bn,anm,bm->ba" then v_2.len = 3
>>
Rule 3 (tensor operands should be tensors)
{v_1 : list(tensor)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≠ null
>>
Rule 4 (operands should be tensors if equation is not an empty string)
{v_1 : str, v_2 : list(tensor)} |= if v_1 ≠ "" then v_2.len > 0
>>
Rule 5 (Dimensions labeled with the same subscript must be broadcastable)
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "i,j->ij" then (shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1)
>>
Rule 6 (The number of subscripts in the equation must match the number of dimensions for the operand)
{v_1 : str, v_2 : tensor} |= if v_1 = "ii" then ndim(v_2) = 2 else if v_1 = "i,j->ij" then ndim(v_2) = 1
>>
Rule 7 (If a subscript is repeated for the same input operand, the dimensions labeled with this subscript must match in size)
{v_1 : str, v_2 : tensor} |= if v_1 = "ii" then shape(v_2, 0) = shape(v_2, 1)
>>
Rule 8 (For equation "bij,bjk->bik", the second dimension of the first tensor must match the first dimension of the second tensor)
{v_1 : str, v_2 : tensor, v_3 : tensor} |= if v_1 = "bij,bjk->bik" then shape(v_2, 1) = shape(v_3, 0)
>>
Rule 9 (In equation "bn,anm,bm->ba", the first dimension of the first, second, and third tensors must match)
{v_1 : str, v_2 : tensor, v_3 : tensor, v_4 : tensor} |= if v_1 = "bn,anm,bm->ba" then shape(v_2, 0) = shape(v_3, 0) ∧ shape(v_3, 0) = shape(v_4, 0)
