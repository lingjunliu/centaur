>>
Rule 1 (sorted_sequence tensor should have dimension greater or equal to 1.)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 2 (If sorter is provided, then boundary and sorter must have the same size.)
{v_1 : tensor, v_2 : tensor} |= if v_2 ≠ false then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (sorted_sequence tensor should be monotonically increasing on the innermost dimension)
{v_1 : tensor} |= ∀i ∈ [1, shape(v_1, ndim(v_1) - 1) - 1] : v_1[i-1] ≤ v_1[i]
>>
Rule 4 (boundaries tensor should be 1 dimension or the first N-1 dimensions of boundaries tensor and input value tensor must match)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 1) ∨ (ndim(v_1) = ndim(v_2) + 1)
>>
Rule 5 (If side is set to "left" then right should be False)
{v_1 : str, v_2 : bool} |= if v_1 = "left" then v_2 = false
>>
Rule 6 (output tensor's dtype is wrong, it can only be Int(int32) or Long(int64) depending on whether out_int32 flag is True)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then dtype_(v_1) = 2 else dtype_(v_1) = 4
>>
Rule 7 (If out is provided, the output tensor, must be the same size as values)
{v_1 : tensor, v_2 : tensor} |= if v_1 ≠ false then ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 8 (Valid side values)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "left" ∨ v_1 = "right"
>>
Rule 9 (If sorted_sequence is N-D, values should be N-D or a scalar)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 1 then ndim(v_2) = ndim(v_1)
>>
Rule 10 (Shape of boundaries should match the first N-1 dimensions of values if values is a tensor and boundary is N-D tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 1 ∧ ndim(v_2) > 0 then ∀i ∈ [0, ndim(v_1) - 2]: shape(v_1, i) = shape(v_2, i)
>>
Rule 11 (values should have numerical data type)
{v_1: tensor} |= (dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 5) ∨ (dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 9)
>>
Rule 12 (If sorted_sequence is 1-D, values can be N-D tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 then true else if ndim(v_2) = ndim(v_1) then true else false
>>
Rule 13 (right cannot be true if side is "left")
{v_1 : bool, v_2 : str} |= if v_1 = true then v_2 ≠ "left"
>>
Rule 14 (If sorter is given, values must be sorted)
{v_1 : tensor, v_2 : tensor} |= if v_2 ≠ false then ∀i ∈ [1, shape(v_1, ndim(v_1) - 1) - 1] : v_1[i-1] ≤ v_1[i]
>>
Rule 15 (If values is a scalar, then its dtype must be the same as sorted_sequence)
{v_1 : tensor, v_2 : float ⊎ int} |= dtype_(v_1) = 7 ∧ v_2 = 0.0 ∨ dtype_(v_1) = 4 ∧ v_2 = 0
>>
Rule 16 (values tensor should have the same dtype as sorted_sequence tensor)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 17 (The values tensor should have compatible dtype with the sorted_sequence tensor)
{v_1 : tensor, v_2 : tensor} |= if 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5 then 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5 else if 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 9 then 6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 9 else false
>>
Rule 18 (if out_int32 is True, output tensor dtype must be int32)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then dtype_(v_1) = 2
