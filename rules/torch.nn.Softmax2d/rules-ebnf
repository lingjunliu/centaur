>>
Rule 1 (Input tensor to Softmax2d must be 3D or 4D)
{v_1 : tensor} |= ndim(v_1) = 3 ∨ ndim(v_1) = 4
>>
Rule 2 (The dtype of the input tensor should be float16, float32, or float64)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 3 (The number of channels (C) in a 3D or 4D input tensor should be greater than 0)
{v_1 : tensor} |= if ndim(v_1) = 3 then shape(v_1, 0) > 0 else if ndim(v_1) = 4 then shape(v_1, 1) > 0 else false
>>
Rule 4 (The height and width dimensions of a 4D input tensor should be greater than 0)
{v_1 : tensor} |= if ndim(v_1) = 4 then shape(v_1, 2) > 0 ∧ shape(v_1, 3) > 0
>>
Rule 5 (The height and width dimensions of a 3D input tensor should be greater than 0)
{v_1 : tensor} |= if ndim(v_1) = 3 then shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0
>>
Rule 6 (If the input tensor is 4D, the batch size must be greater than 0)
{v_1 : tensor} |= if ndim(v_1) = 4 then shape(v_1, 0) > 0
>>
Rule 7 (The output tensor has the same shape as the input tensor)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 8 (Output tensor's values must be between 0 and 1)
{v_1 : tensor} |= min(v_1) ≥ 0 ∧ max(v_1) ≤ 1
>>
Rule 9 (If the input is a 3D tensor, the number of channels is at least 1)
{v_1 : tensor} |= if ndim(v_1) = 3 then shape(v_1, 0) ≥ 1
>>
Rule 10 (If the input tensor is complex64 or complex128, it is not supported)
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 11 (The char dtype is not supported)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 12 (If the input is a 4D tensor, the channels dimension is at least 1)
{v_1 : tensor} |= if ndim(v_1) = 4 then shape(v_1, 1) ≥ 1
>>
Rule 13 (The minimum value of the input tensor is less than or equal to the maximum value)
{v_1 : tensor} |= min(v_1) ≤ max(v_1)
>>
Rule 14 (Input tensor's dimensions can't be zero.)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
