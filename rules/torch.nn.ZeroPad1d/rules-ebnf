Rule 4 (Input tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 5 (Padding values cannot result in negative tensor dimensions after padding)
{v_1 : tensor, v_2 : int ⊎ tuple(int)} |= if v_2.len = 2 then shape(v_1, ndim(v_1) - 1) + v_2[0] + v_2[1] ≥ 0 else shape(v_1, ndim(v_1) - 1) + v_2 * 2 ≥ 0
>>
Rule 6 (The number of dimensions of the input tensor should be less than or equal to 3)
{v_1 : tensor} |= ndim(v_1) ≤ 3
>>
Rule 7 (The input tensor should have positive shape in the dimension being padded)
{v_1 : tensor} |= shape(v_1, ndim(v_1)-1) > 0
>>
Rule 8 (For 3D tensors, the channel dimension must be positive.)
{v_1 : tensor} |= if ndim(v_1) = 3 then shape(v_1, 1) > 0
