{v_1 : tensor, v_2 : int ⊎ tuple(int)} |= if v_2.len = 2 then shape(v_1, ndim(v_1) - 1) + v_2[0] + v_2[1] < 10000 else shape(v_1, ndim(v_1) - 1) + v_2 * 2 < 10000
