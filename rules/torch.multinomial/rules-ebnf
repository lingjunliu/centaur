Rule 2 (num_samples must be greater than 0)
{v_1 : int} |= v_1 > 0
>>
Rule 3 (elements of input tensor should be non-negative)
{v_1 : tensor} |= ∀i ∈ [0, shape(v_1, 0) - 1] : v_1[i] ≥ 0
>>
Rule 4 (If replacement is false, num_samples must be less than or equal to the size of the input tensor)
{v_1 : tensor, v_2 : int, v_3 : bool} |= if v_3 = false then v_2 ≤ shape(v_1, 0)
>>
Rule 5 (The sum of probabilities in input tensor should be greater than 0)
{v_1 : tensor} |= min(v_1) > 0
>>
Rule 6 (The input tensor cannot contain `inf` or `nan`)
{v_1 : tensor} |= ∃i ∈ [0, shape(v_1, 0) - 1] : v_1[i] ≠ "inf" ∧  v_1[i] ≠ "nan"
>>
Rule 7 (Output tensor should be LongTensor)
{v_2 : tensor} |= dtype_(v_2) = 4
>>
Rule 8 (Input tensor must be a vector or a matrix)
{v_1 : tensor} |= ndim(v_1) = 1 ∨ ndim(v_1) = 2
>>
Rule 9 (If input is a matrix and replacement is false, num_samples must be less than or equal to the minimum number of non-zero elements in each row)
{v_1 : tensor, v_2 : int, v_3 : bool} |= if ndim(v_1) = 2 ∧ v_3 = false then v_2 ≤ min(v_1)
>>
Rule 10 (If out is specified, its shape must be compatible with input and num_samples)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= if ndim(v_1) = 1 then shape(v_2, 0) = v_3 else if ndim(v_1) = 2 then shape(v_2, 0) = shape(v_1, 0) ∧ shape(v_2, 1) = v_3
