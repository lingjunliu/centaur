>>
Rule 2 (bins must be greater than 0 when it is an integer)
{v_1 : int} |= v_1 > 0
>>
Rule 3 (If bins is a tensor, it must contain at least 2 elements)
{v_1 : tensor} |= ndim(v_1) = 1 ∧ shape(v_1, 0) ≥ 2
>>
Rule 4 (range must be a tuple of two floats)
{v_1 : tuple(float)} |= v_1.len = 2
>>
Rule 5 (If range is given, the first element must be less than or equal to the second)
{v_1 : tuple(float)} |= if (v_1.len = 2) then (v_1[0] ≤ v_1[1])
>>
Rule 6 (If weight is given, it should have the same shape as input)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_2) > 0) then (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 7 (Output must be a tuple of tensors)
{v_1 : tuple(tensor)} |= v_1.len = 2
>>
Rule 8 (Input tensor cannot be Char type.)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 9 (If bins is a tensor, its elements should be increasing)
{v_1 : tensor} |= if (ndim(v_1) = 1 ∧ shape(v_1, 0) > 1) then (∀i ∈ [0, shape(v_1, 0) - 2] : v_1[i] < v_1[i+1])
>>
Rule 10 (if density is true, then the integral should be 1.)
{v_1 : bool} |= if v_1 then true
>>
Rule 11 (If bins is an integer, range has to contain finite numbers)
{v_1 : int, v_2 : tuple(float)} |= if (v_1 > 0 ∧ v_2.len = 2) then (v_2[0] > -1000000000000000.0 ∧ v_2[0] < 1000000000000000.0 ∧ v_2[1] > -1000000000000000.0 ∧ v_2[1] < 1000000000000000.0)
>>
Rule 12 (Input tensor must be a tensor.)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 13 (If out is specified, both hist and bin_edges must be specified)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0
>>
Rule 14 (If bins is a tensor, it must be one dimensional)
{v_1 : tensor} |= ndim(v_1) = 1
>>
Rule 15 (If bins is a tensor and range is specified, range should contain the min and max values of the tensor)
{v_1 : tensor, v_2 : tuple(float)} |= if (ndim(v_1) = 1 ∧ v_2.len = 2) then (min(v_1) ≥ v_2[0] ∧ max(v_1) ≤ v_2[1])
>>
Rule 16 (bin_edges' dtype and input's dtype should be the same)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_2) > 0) then dtype_(v_1) = dtype_(v_2)
>>
Rule 17 (Output cannot be Tensor.)
{v_1 : tensor ⊎ tuple(tensor)} |= if (v_1 = v_1) then true else false
>>
Rule 18 (If density is true, the bin_edges must be specified by the user.)
{v_1 : bool, v_2 : tensor} |= if (v_1 = true) then (ndim(v_2) > 0)
>>
