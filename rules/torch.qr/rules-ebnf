Rule 1 (input tensor must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (input tensor dtype must be float16, float32, float64, complex64, or complex128)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 3 (If out argument is a tuple, its elements must be tensors)
{v_1 : tuple(tensor)} |= v_1.len = 2
>>
Rule 4 (If some is True, the minimum dimension of input should be positive)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then shape(v_1, ndim(v_1) - 2) > 0 ∧ shape(v_1, ndim(v_1) - 1) > 0
