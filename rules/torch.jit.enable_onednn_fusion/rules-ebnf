Rule 8 (two tensors have the same shape along a certain dimension)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= (0 - ndim(v_1)) <= v_3 ∧ v_3 < ndim(v_1) ∧ (0 - ndim(v_2)) <= (v_3 - (ndim(v_1) - ndim(v_2))) ∧ (v_3 - (ndim(v_1) - ndim(v_2))) < ndim(v_2) ∧ shape(v_1, v_3) = shape(v_2, (v_3 - (ndim(v_1) - ndim(v_2))))
