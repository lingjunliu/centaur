Rule 21 (If value is zero, all tensors need to have the same dtype)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : int ⊎ float} |= if v_4 = 0 then (dtype_(v_1) = dtype_(v_2) ∧ dtype_(v_2) = dtype_(v_3))
