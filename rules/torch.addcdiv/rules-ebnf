>>
Rule 14 (value should be greater than 0)
{v_4 : int ⊎ float} |= v_4 > 0
>>
Rule 15 (dtype of tensor1 and tensor2 cannot be boolean)
{v_2 : tensor, v_3 : tensor} |= dtype_(v_2) ≠ 0 ∧ dtype_(v_3) ≠ 0
>>
Rule 16 (if input is complex128, tensor1 and tensor2 should be complex128)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if (dtype_(v_1) = 11) then (dtype_(v_2) = 11 ∧ dtype_(v_3) = 11)
>>
Rule 17 (at least one of the tensors should have more than 1 dimension)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) > 1 ∨ ndim(v_2) > 1 ∨ ndim(v_3) > 1
>>
Rule 18 (If tensor1 has dtype int8, tensor2's dtype should be from int8 to int64.)
{v_2 : tensor, v_3 : tensor} |= if (dtype_(v_2) = 1) then (dtype_(v_3) = 1 ∨ dtype_(v_3) = 2 ∨ dtype_(v_3) = 3 ∨ dtype_(v_3) = 4 ∨ dtype_(v_3) = 5)
