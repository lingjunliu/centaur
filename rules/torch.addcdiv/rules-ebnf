Rule 3 (if input is float, then value should be float)
{v_1 : tensor, v_4 : int ⊎ float} |= if (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) then (v_4 > -1000 ∧ v_4 < 1000)
>>
Rule 4 (tensor1 and tensor2 should have the same dtype)
{v_2 : tensor, v_3 : tensor} |= dtype_(v_2) = dtype_(v_3)
>>
Rule 5 (if tensor1 and tensor2 have integer dtype, value should be an integer)
{v_2 : tensor, v_3 : tensor, v_4 : int ⊎ float} |= if (dtype_(v_2) = 1 ∨ dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 ∨ dtype_(v_2) = 5) ∧ (dtype_(v_3) = 1 ∨ dtype_(v_3) = 2 ∨ dtype_(v_3) = 3 ∨ dtype_(v_3) = 4 ∨ dtype_(v_3) = 5) then (v_4 = 0 ∨ v_4 = 1 ∨ v_4 = 2 ∨ v_4 = 3 ∨ v_4 = 4 ∨ v_4 = 5)
>>
Rule 6 (if tensor1 is complex, then tensor2 should also be complex)
{v_2 : tensor, v_3 : tensor} |= if (dtype_(v_2) = 10 ∨ dtype_(v_2) = 11) then (dtype_(v_3) = 10 ∨ dtype_(v_3) = 11)
>>
Rule 7 (If tensor1 or tensor2 is a bool, input should also be a bool.)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if (dtype_(v_2) = 0 ∨ dtype_(v_3) = 0) then dtype_(v_1) = 0
>>
Rule 8 (If input is a complex number, then value should be a float)
{v_1 : tensor, v_4 : int ⊎ float} |= if (dtype_(v_1) = 10 ∨ dtype_(v_1) = 11) then (v_4 > -1000 ∧ v_4 < 1000)
>>
Rule 9 (If input, tensor1 and tensor2 are float16, value should be float16)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : int ⊎ float} |= if (dtype_(v_1) = 6) ∧ (dtype_(v_2) = 6) ∧ (dtype_(v_3) = 6) then (v_4 > -1000 ∧ v_4 < 1000)
>>
Rule 10 (If input is a bfloat16, tensor1 and tensor2 should be bfloat16)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if (dtype_(v_1) = 13) then (dtype_(v_2) = 13 ∧ dtype_(v_3) = 13)
>>
Rule 11 (tensor1 and tensor2 should have same shape)
{v_2 : tensor, v_3 : tensor} |= ndim(v_2) = ndim(v_3) ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = shape(v_3, i)
>>
Rule 12 (If value is a float and tensor1/tensor2 is int, input has to be float)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : int ⊎ float} |= if (dtype_(v_2) < 6 ∨ dtype_(v_3) < 6) ∧ (v_4 > -1000 ∧ v_4 < 1000) then dtype_(v_1) > 5
