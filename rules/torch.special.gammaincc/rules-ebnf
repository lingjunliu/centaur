Rule 1 (input tensors must be non-negative)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, shape(v_1,0) - 1] : v_1[i] ≥ 0 ∧ ∀i ∈ [0, shape(v_2,0) - 1] : v_2[i] ≥ 0
>>
Rule 2 (at least one input tensor must be strictly positive)
{v_1 : tensor, v_2 : tensor} |= ∃i ∈ [0, shape(v_1, 0) - 1] : v_1[i] > 0 ∨ ∃i ∈ [0, shape(v_2, 0) - 1] : v_2[i] > 0
>>
Rule 3 (input tensors must have floating-point dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 6 ∧ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 6
>>
Rule 4 (input tensor dimensions must be greater than zero)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0
>>
Rule 5 (broadcasting requires shapes to be equal or one)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then ∀i ∈ [0, if ndim(v_1) > ndim(v_2) then ndim(v_1) -1 else ndim(v_2) -1 ] : if ndim(v_1) - i - 1 ≥ 0 ∧ ndim(v_2) - i - 1 ≥ 0 then shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1) ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1
>>
Rule 6 (if one input is scalar, the other must be a tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then ndim(v_2) > 0 else if ndim(v_2) = 0 then ndim(v_1) > 0
>>
Rule 7 (The size of tensors should match at non-singleton dimensions)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) < ndim(v_2) then ndim(v_1) else ndim(v_2)] : (shape(v_1, i) = shape(v_2, i)) ∨ (shape(v_1, i) = 1) ∨ (shape(v_2, i) = 1)
>>
Rule 8 (If both inputs are zero, then false)
{v_1 : tensor, v_2 : tensor} |= (∃i ∈ [0, shape(v_1, 0) - 1] : v_1[i] ≠ 0) ∨ (∃j ∈ [0, shape(v_2, 0) - 1] : v_2[j] ≠ 0)
>>
Rule 9 (input cannot be boolean type)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 0 ∧ dtype_(v_2) ≠ 0
>>
Rule 10 (if input is complex, other should be complex)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then dtype_(v_2) = 9 ∨ dtype_(v_2) = 10
>>
Rule 11 (if one input is float16, the other should be at least float16)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 6 then dtype_(v_2) ≥ 6 else if dtype_(v_2) = 6 then dtype_(v_1) ≥ 6
>>
Rule 12 (If an argument is complex64, the other one must have complex64 or complex128 dtype)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 then (dtype_(v_2) = 9 ∨ dtype_(v_2) = 10) else if dtype_(v_2) = 9 then (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10)
>>
Rule 13 (both inputs are not zero at the same index)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if shape(v_1,0) < shape(v_2,0) then shape(v_1,0)-1 else shape(v_2,0) -1] : (v_1[i] ≠ 0) ∨ (v_2[i] ≠ 0)
>>
Rule 14 (both inputs are not negative)
{v_1 : tensor, v_2 : tensor} |= (min(v_1) ≥ 0) ∧ (min(v_2) ≥ 0)
>>
Rule 15 (at least one of the input must be positive)
{v_1 : tensor, v_2 : tensor} |= (∃i ∈ [0, shape(v_1, 0) - 1] : v_1[i] > 0) ∨ (∃j ∈ [0, shape(v_2, 0) - 1] : v_2[j] > 0)
>>
Rule 16 (If input is complex128, other must have complex128 dtype)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 10 then dtype_(v_2) = 10 else if dtype_(v_2) = 10 then dtype_(v_1) = 10
>>
Rule 17 (if ndim(input) == 1, then shape(input, 0) > 0)
{v_1 : tensor} |= if ndim(v_1) = 1 then shape(v_1, 0) > 0
>>
Rule 18 (If an argument is complex64, the other one must have complex64 dtype)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 then dtype_(v_2) = 9 else if dtype_(v_2) = 9 then dtype_(v_1) = 9
>>
Rule 19 (input and other tensor should have same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
