Rule 1 (Input tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 2 (Input tensor must have an integer dtype)
{v_1 : tensor} |= dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5
>>
Rule 3 (Input tensor must be a 2D tensor with each dimension size greater than 1)
{v_1 : tensor} |= ndim(v_1) = 2 ∧ shape(v_1, 0) > 1 ∧ shape(v_1, 1) > 1
>>
Rule 4 (Input tensor must be a square matrix)
{v_1 : tensor} |= ndim(v_1) = 2 ∧ shape(v_1, 0) = shape(v_1, 1)
>>
Rule 5 (Input tensor must have a minimum value greater than -1)
{v_1 : tensor} |= min(v_1) > -1
>>
Rule 6 (List of integers must have length equal to the number of dimensions in tensor)
{v_1 : tensor, v_2 : list(int)} |= v_2.len = ndim(v_1)
>>
Rule 7 (Tensor's first dimension must equal the length of a tuple)
{v_1 : tensor, v_2 : tuple(int)} |= ndim(v_1) >= 1 ∧ shape(v_1, 0) = v_2.len
>>
Rule 8 (The second dimension of the tensor should be greater than an integer)
{v_1 : tensor, v_2 : int} |= ndim(v_1) >= 2 ∧ shape(v_1, 1) > v_2
>>
Rule 9 (Tensor with floating point dtype must have maximum value less than 10)
{v_1 : tensor} |= if dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 then max(v_1) < 10
>>
Rule 10 (The shape of the first dimension of a tensor must be greater than the given float)
{v_1 : tensor, v_2 : float} |= ndim(v_1) >= 1 ∧ shape(v_1, 0) > v_2
>>
Rule 11 (Tensor dimensions must be less than 64)
{v_1 : tensor} |= ndim(v_1) >= 1 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) < 64
>>
Rule 12 (Boolean tensors must have a minimum value equal to 0)
{v_1 : tensor} |= if dtype_(v_1) = 0 then min(v_1) = 0
>>
Rule 13 (If a tensor is 1D, then its shape must be greater than 5, otherwise it must be less than 5)
{v_1 : tensor} |= if ndim(v_1) = 1 then shape(v_1, 0) > 5 else ∀i ∈ [0, ndim(v_1)-1]: shape(v_1,i) < 5
>>
Rule 14 (If tensor dimension >= 1, then shape of the first dimension has to be greater than 10)
{v_1 : tensor} |= if ndim(v_1) >= 1 then shape(v_1, 0) > 10
