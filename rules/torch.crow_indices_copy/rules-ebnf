Rule 15 (First dimension of tensor1 must be greater than the max value of tensor2)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) >= 1 ∧ shape(v_1, 0) > max(v_2)
>>
Rule 16 (If tensor has an integer dtype, then the float must be positive)
{v_1 : tensor, v_2 : float} |= if dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 then v_2 > 0
>>
Rule 17 (There exists at least one dimension in the tensor's shape that is equal to 1)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1
>>
Rule 18 (All elements in a floating point tensor must be greater than 0.0)
{v_1 : tensor} |= if dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 then ∀i ∈ [0, shape(v_1, 0) - 1] : min(v_1) > 0.0
>>
Rule 19 (if tensor is more than 2 dimensional, then the string cannot be "none")
{v_1 : tensor, v_2 : str} |= if ndim(v_1) > 2 then v_2 ≠ "none"
>>
Rule 20 (All dimensions in tensor must be greater than the provided integer)
{v_1 : tensor, v_2 : int} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > v_2
>>
Rule 21 (The list length must be equal to the number of dimensions, and for a given dimension the shape must be less than list[i] + 10)
{v_1 : tensor, v_2 : list(int)} |= v_2.len = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) < v_2[i] + 10
>>
Rule 22 (If tensor has 2 dimensions then the product of the tuple elements should equal the first dimension of the tensor's shape)
{v_1 : tensor, v_2 : tuple(float)} |= if ndim(v_1) = 2 then v_2[0] * v_2[1] = shape(v_1, 0)
>>
Rule 23 (If the tensor has dtype 1, then its min value must be greater than 0; else if dtype is 2, then its max value must be less than 10,.)
{v_1 : tensor} |= if dtype_(v_1) = 1 then min(v_1) > 0 else if dtype_(v_1) = 2 then max(v_1) < 10
