Rule 1 (input and end tensors should have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (If weight is a tensor, it should have the same dtype as input and end)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= dtype_(v_1) = dtype_(v_3) ∧ dtype_(v_2) = dtype_(v_3)
>>
Rule 3 (Shapes must be broadcastable if weight is a tensor)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1 ∧ ndim(v_3) ≥ 1
>>
Rule 4 (input tensor must have float dtype if weight is float)
{v_1 : tensor} |= (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 5 (If weight is a tensor, the shapes of weight, start, and end must be broadcastable)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) ∧ ndim(v_1) ≥ ndim(v_3) then ndim(v_1) - 1 else if ndim(v_2) >= ndim(v_1) ∧ ndim(v_2) >= ndim(v_3) then ndim(v_2) - 1 else ndim(v_3) - 1] : (ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1)) ∧ (ndim(v_1) - i - 1 < 0 ∨ ndim(v_3) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_3, ndim(v_3) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_3, ndim(v_3) - i - 1)) ∧ (ndim(v_2) - i - 1 < 0 ∨ ndim(v_3) - i - 1 < 0 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_3, ndim(v_3) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = shape(v_3, ndim(v_3) - i - 1))
>>
Rule 6 (If input and end are complex, and weight is a tensor, weight must be float or complex tensor)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if (dtype_(v_1) = 10 ∨ dtype_(v_1) = 11) ∧ (dtype_(v_2) = 10 ∨ dtype_(v_2) = 11) then (dtype_(v_3) = 7 ∨ dtype_(v_3) = 8 ∨ dtype_(v_3) = 10 ∨ dtype_(v_3) = 11)
>>
Rule 7 (If weight is a float, the end should have the same type as input.)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 7 then dtype_(v_2) = 7 else if dtype_(v_1) = 8 then dtype_(v_2) = 8
>>
Rule 8 (If weight is a tensor, start and end must be broadcastable)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : (ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1))
>>
Rule 9 (if input is Bool, end must also be Bool.)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 0 then dtype_(v_2) = 0
>>
Rule 10 (If input is int, end must also be int.)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 1 then dtype_(v_2) = 1 else if dtype_(v_1) = 2 then dtype_(v_2) = 2 else if dtype_(v_1) = 3 then dtype_(v_2) = 3 else if dtype_(v_1) = 4 then dtype_(v_2) = 4 else if dtype_(v_1) = 5 then dtype_(v_2) = 5
>>
Rule 11 (If input is complex, end must also be complex.)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 10 then dtype_(v_2) = 10 else if dtype_(v_1) = 11 then dtype_(v_2) = 11
