{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= (ndim(v_2) = ndim(v_1) - 2 ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = shape(v_1, i)) ∧ (ndim(v_3) = ndim(v_1) - 2 ∧ ∀i ∈ [0, ndim(v_3) - 1] : shape(v_3, i) = shape(v_1, i))
