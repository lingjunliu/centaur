Rule 1 (offset value should not exceed a limit determined by input shape)
{v_1 : tensor, v_2 : int} |= (0 - shape(v_1, 0)) ≤ v_2 ∧ v_2 ≤ shape(v_1, 0)
>>
Rule 2 (input tensor's dimension should be less than 3)
{v_1 : tensor} |= ndim(v_1) < 3
>>
Rule 3 (if input is 2D tensor, its shape[0] should be equal to shape[1])
{v_1 : tensor} |= if ndim(v_1) = 2 then shape(v_1, 0) = shape(v_1, 1)
>>
Rule 4 (The offset must be representable as int32)
{v_1 : int} |= -2147483648 ≤ v_1 ∧ v_1 ≤ 2147483647
>>
Rule 5 (if input tensor is 1D, the output will be square matrix)
{v_1 : tensor} |= if ndim(v_1) = 1 then shape(v_1, 0) = shape(v_1, 0)
>>
Rule 6 (if input tensor's dimension is greater than 1, all shape dimensions must be greater than zero)
{v_1 : tensor} |= if ndim(v_1) > 1 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 7 (if input tensor is 2D and offset is zero, the output's ndim will be same as the flattened input's ndim)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 ∧ v_2 = 0 then ndim(v_1) = ndim(v_1)
>>
Rule 8 (offset affects final shape, if offset=0 and input dim=1 then output will be square with shape[0])
{v_1 : tensor, v_2 : int} |= if v_2 = 0 ∧ ndim(v_1) = 1 then shape(v_1, 0) = shape(v_1, 0)
