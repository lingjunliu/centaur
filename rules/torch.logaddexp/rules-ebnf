{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_3) > 0 then (∀i ∈ [0, ndim(v_3) - 1] : (shape(v_1, i) = shape(v_3, i) ∨ shape(v_2, i) = shape(v_3, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1))
