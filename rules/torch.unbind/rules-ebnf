Rule 1 (The dimension to remove must be within the valid range of dimensions of the input tensor)
{v_1 : tensor, v_2 : int} |= v_2 ≥ -1 * ndim(v_1) ∧ v_2 < ndim(v_1)
>>
Rule 2 (If dimension is a float, it must be representable as an integer)
{v_1 : float} |= if v_1 = (v_1 * 1.0) then true else false
>>
Rule 3 (The input tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 4 (If the dimension is negative, its absolute value must be less than or equal to the number of dimensions of the input tensor)
{v_1 : tensor, v_2 : int} |= if v_2 < 0 then 0 - v_2 ≤ ndim(v_1)
>>
Rule 5 (Dimension 0 must be less than the number of dimensions of the input tensor)
{v_1 : tensor} |= shape(v_1,0) > 0
>>
Rule 6 (The dimension to remove cannot be greater than the number of dimensions in the tensor minus 1)
{v_1 : tensor, v_2 : int} |= v_2 < ndim(v_1)
>>
Rule 7 (The dimension must be an integer between -ndim(v_1) and ndim(v_1) -1)
{v_1 : tensor, v_2 : int} |= v_2 ≥ (0 - ndim(v_1)) ∧ v_2 < ndim(v_1)
>>
Rule 8 (The size of the specified dimension must be greater than 0)
{v_1 : tensor, v_2 : int} |= if v_2 ≥ 0 then shape(v_1, v_2) > 0 else shape(v_1, ndim(v_1) + v_2) > 0
>>
Rule 9 (If dimension is not specified then the number of dimension must be 1)
{v_1 : tensor} |= if ndim(v_1) > 1 then false
>>
Rule 10 (If the input is a scalar then it must be a tensor of dimension 0)
{v_1 : tensor} |= if ndim(v_1) = 0 then true else false
>>
Rule 11 (The output tuple has a length equal to the size of the dimension that is removed)
{v_1 : tensor, v_2 : int, v_3 : tuple(tensor)} |= if v_2 ≥ 0 then v_3.len = shape(v_1, v_2) else v_3.len = shape(v_1, ndim(v_1) + v_2)
