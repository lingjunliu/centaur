Rule 1 (input and src tensors must have the same dtype)
{v_1 : tensor, v_4 : tensor} |= dtype_(v_1) = dtype_(v_4)
>>
Rule 2 (index tensor should have the same number of dimensions as the input tensor)
{v_1 : tensor, v_3 : tensor} |= ndim(v_3) = ndim(v_1)
>>
Rule 3 (dim should be within the valid range of dimensions for the input tensor)
{v_1 : tensor, v_2 : int} |= (0 - ndim(v_1)) ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 4 (The shape of src should match the shape of input except at the dimension dim.)
{v_1 : tensor, v_2 : int, v_4 : tensor} |= ndim(v_1) = ndim(v_4) ∧ ∀i ∈ [0, ndim(v_1) - 1] : if i ≠ v_2 then shape(v_1, i) = shape(v_4, i)
>>
Rule 5 (index tensor's values should be within the bounds of the corresponding input dimension)
{v_1 : tensor, v_2 : int, v_3 : tensor} |= ∀i ∈ [0, shape(v_3, v_2) - 1] : v_3[i] ≥ 0 ∧ v_3[i] < shape(v_1, v_2)
>>
Rule 6 (index tensor's dtype should be int)
{v_3 : tensor} |= dtype_(v_3) = 1 ∨ dtype_(v_3) = 2 ∨ dtype_(v_3) = 3 ∨ dtype_(v_3) = 4 ∨ dtype_(v_3) = 5
>>
Rule 7 (If dim is negative, then it should be a valid negative dimension)
{v_1 : tensor, v_2 : int} |= if v_2 < 0 then v_2 ≥ (0 - ndim(v_1))
>>
Rule 8 (The number of elements in index must be <= number of elements in input)
{v_1 : tensor, v_3 : tensor} |= ∀i ∈ [0, ndim(v_1)-1]: shape(v_3, i) ≤ shape(v_1, i)
>>
Rule 9 (If the index has fewer dimensions than the input, the index tensor is treated as if it has dimensions (input.dim() - index.dim())-many leading singleton dimensions that are implicitly expanded to match the shape of input.)
{v_1 : tensor, v_3 : tensor} |= if ndim(v_3) < ndim(v_1) then ∃i ∈ [0, ndim(v_1) - ndim(v_3) - 1]: shape(v_3, i) = 1
>>
Rule 10 (The size of the src tensor must match the size of the index tensor)
{v_3 : tensor, v_4 : tensor} |= ∀i ∈ [0, ndim(v_3)-1]: shape(v_3, i) = shape(v_4, i)
>>
Rule 11 (if dim is provided, it must be an int)
{v_1 : tensor, v_2 : int ⊎ float} |= if v_2 > ndim(v_1) -1 then false
>>
Rule 12 (The index tensor should have the same shape as src except in the dimension specified by dim)
{v_2 : int, v_3 : tensor, v_4 : tensor} |= ∀i ∈ [0, ndim(v_4)-1]: if i = v_2 then true else shape(v_3, i) = shape(v_4, i)
>>
Rule 13 (When index is a LongTensor, its elements are seen as indices into the source tensor along the specified dimension)
{v_1 : tensor, v_2 : int, v_3 : tensor} |= if dtype_(v_3) = 4 then ∀i ∈ [0, shape(v_3, 0) -1]: v_3[i] ≥ 0 ∧ v_3[i] < shape(v_1, v_2)
>>
Rule 14 (The index tensor cannot have dimensions of size zero)
{v_3 : tensor} |= ∀i ∈ [0, ndim(v_3) - 1] : shape(v_3, i) > 0
>>
Rule 15 (The index must have fewer dimensions than input or same number of dimensions)
{v_1 : tensor, v_3 : tensor} |= ndim(v_3) ≤ ndim(v_1)
>>
Rule 16 (When index has fewer dimensions than input, the size of index must match the slice size of input tensor at dimension dim.)
{v_1 : tensor, v_2 : int, v_3 : tensor} |= if ndim(v_3) < ndim(v_1) then shape(v_3, 0) = shape(v_1, v_2)
>>
Rule 17 (The shape of index must match shape of src except for the dimension dim)
{v_2 : int, v_3 : tensor, v_4 : tensor} |= ∀i ∈ [0, ndim(v_3)-1]: if i=v_2 then true else shape(v_3, i) = shape(v_4, i)
>>
Rule 18 (If index contains out of bounds indices, src values at those indices are not added.)
{v_1 : tensor, v_2 : int, v_3 : tensor} |= ∃p ∈ [0, shape(v_3,0)-1]: v_3[p] < 0 ∨ v_3[p] ≥ shape(v_1,v_2)
>>
Rule 19 (src tensor should not be empty)
{v_4 : tensor} |= ∀i ∈ [0, ndim(v_4) - 1] : shape(v_4, i) > 0
>>
Rule 20 (If input is empty, src can be an empty tensor)
{v_1 : tensor, v_4 : tensor} |= if (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) then (∃j ∈ [0, ndim(v_4) - 1] : shape(v_4, j) = 0)
