Rule 1 (input tensor should not have Half dtype for modified_bessel_k0)
{v_1 : tensor} |= dtype_(v_1) ≠ 6
>>
Rule 2 (input tensor dimension should be greater than or equal to 1)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 3 (input tensor dtype should be float or complex)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 4 (if input is complex, it must be complex64 or complex128)
{v_1 : tensor} |= if dtype_(v_1) = 9 then true else if dtype_(v_1) = 10 then true else if dtype_(v_1) = 7 then true else if dtype_(v_1) = 8 then true else false
>>
Rule 5 (input tensor can have a shape with at least one element greater than 0)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 6 (If the out tensor is provided, it must have the same shape as the input tensor)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 7 (If the out tensor is provided, its dtype must be compatible with the input tensor)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 7 then dtype_(v_2) = 7 else if dtype_(v_1) = 8 then dtype_(v_2) = 8 else if dtype_(v_1) = 9 then dtype_(v_2) = 9 else if dtype_(v_1) = 10 then dtype_(v_2) = 10 else false
>>
Rule 8 (If out is provided and has a different dtype than the input, it must be castable to the input dtype)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 7 then (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8) else if dtype_(v_1) = 8 then dtype_(v_2) = 8 else if dtype_(v_1) = 9 then (dtype_(v_2) = 9 ∨ dtype_(v_2) = 10) else if dtype_(v_1) = 10 then dtype_(v_2) = 10 else false
>>
Rule 9 (Out tensor must have floating-point or complex dtype if input does)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10
>>
Rule 10 (If out is provided, it can have the same dtype or be upcasted )
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 7 then (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8) else if dtype_(v_1) = 8 then dtype_(v_2) = 8 else if dtype_(v_1) = 9 then (dtype_(v_2) = 9 ∨ dtype_(v_2) = 10) else if dtype_(v_1) = 10 then dtype_(v_2) = 10
>>
Rule 11 (If out is provided, the input tensor is not complex but out is, the input dtype must be upcastable.)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ (dtype_(v_2) = 9 ∨ dtype_(v_2) = 10) then True else if (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8) then True else if (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) ∧ (dtype_(v_2) = 9 ∨ dtype_(v_2) = 10) then True else False
>>
Rule 12 (If out is provided, its layout must be the same as the input if they have same shape)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) then True else True
>>
Rule 13 (If input is float16 then the out must be float16)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 6 then dtype_(v_2) = 6 else True
>>
Rule 14 (If input is float32, float64, complex64, or complex128 and out is given then out must have the same dtype as the input, or out must be a float32, float64, complex64, or complex128)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) ∧ (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)
>>
Rule 15 (If out is provided and the input is complex, the out tensor should be complex)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then dtype_(v_2) = 9 ∨ dtype_(v_2) = 10 else True
