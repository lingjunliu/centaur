    >>> A = torch.randn(3, 3)
    >>> A = A @ A.T + torch.eye(3) * 1e-3 # Creates a symmetric positive-definite matrix
    >>> L = torch.linalg.cholesky(A) # Extract Cholesky decomposition
    >>> torch.cholesky_inverse(L)
    tensor([[ 1.9314,  1.2251, -0.0889],
            [ 1.2251,  2.4439,  0.2122],
