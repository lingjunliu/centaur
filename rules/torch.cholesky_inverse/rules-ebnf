>>
Rule 1 (Input tensor L must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (L must have the same number of rows and columns)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ shape(v_1, ndim(v_1) - 2) = shape(v_1, ndim(v_1) - 1)
>>
Rule 3 (The dtype of the input tensor L must be float, double, cfloat, or cdouble)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 10 ∨ dtype_(v_1) = 11
>>
Rule 4 (The last two dimensions of L must be the same)
{v_1 : tensor} |= shape(v_1, ndim(v_1) - 2) = shape(v_1, ndim(v_1) - 1)
>>
Rule 5 (If L has batch dimensions, they must be positive)
{v_1 : tensor} |= if ndim(v_1) > 2 then ∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) > 0
>>
Rule 6 (If input tensor L is complex, the imaginary part must be defined.)
{v_1 : tensor} |= if dtype_(v_1) = 10 ∨ dtype_(v_1) = 11 then true
>>
Rule 7 (The last two dimensions of L must be positive)
{v_1 : tensor} |= shape(v_1, ndim(v_1) - 2) > 0 ∧ shape(v_1, ndim(v_1) - 1) > 0
>>
Rule 8 (If the dtype is complex, then the real and imaginary parts must both be finite)
{v_1 : tensor} |= if dtype_(v_1) = 10 ∨ dtype_(v_1) = 11 then min(v_1) ≠ "inf" ∧ max(v_1) ≠ "inf"
>>
Rule 9 (L's diagonal elements must be positive definite)
{v_1 : tensor} |= min(v_1) > 0
>>
Rule 10 (The upper argument must be a boolean value)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 11 (Input cannot have 'Half' dtype)
{v_1 : tensor} |= dtype_(v_1) ≠ 6
