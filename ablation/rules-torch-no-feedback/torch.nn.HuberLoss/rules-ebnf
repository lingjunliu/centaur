Rule 1 (delta must be positive to avoid huber_loss does not support non-positive values for delta)
{v_1 : float} |= v_1 > 0
>>
Rule 2 (input and target tensors must have the same shape to avoid size mismatch)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (reduction must be one of the allowed values to prevent invalid reduction value)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "mean" ∨ v_1 = "sum"
>>
Rule 7 (Ensure input tensor is not empty)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 12 (Input and target must have compatible shapes to allow element-wise operations.)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
>>
Rule 15 (Delta must be a non-negative float value)
{v_1 : float} |= v_1 ≥ 0
>>
Rule 20 (If reduction is 'none' then the shapes of input and output tensors must be the same.)
{v_1 : str, v_2 : tensor, v_3 : tensor} |= if v_1 = "none" then (ndim(v_2) = ndim(v_3) ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = shape(v_3, i))
>>
Rule 21 (Non-empty tensors with matching sizes or broadcastability)
{v_1 : tensor, v_2 : tensor} |= (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0) ∧ (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1))
>>
Rule 31 (Input and target should either both be empty or both be non-empty)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 0 ∧ ndim(v_2) = 0) ∨ (ndim(v_1) > 0 ∧ ndim(v_2) > 0)
>>
Rule 44 (input and target tensors should have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 49 (Input and target must have compatible shapes for elementwise subtraction)
{v_1 : tensor, v_2 : tensor} |=  ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
>>
Rule 61 (If one of input and target is empty tensor, another one should be also empty tensor)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 0) = (ndim(v_2) = 0)
>>
Rule 81 (If input tensor is empty, the target tensor must also be empty)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then ndim(v_2) = 0
>>
Rule 90 (The input and target tensors must have the same shape, or be broadcastable to the same shape)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1))
>>
Rule 111 (If target tensor is empty, then input tensor must also be empty)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) = 0 then ndim(v_1) = 0
>>
Rule 115 (Input and target tensors must have the same shape or be broadcastable)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = ndim(v_2)) ∧ ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
