Rule 36 (If number of dimensions is not equal to len(dims), there should be duplicate dimensions in dims.)
{v_1 : tensor, v_2 : tuple(int)} |= if ndim(v_1) ≠ shape(v_2, ".len") then ∃i ∈ [0, shape(v_2, ".len") - 1] : ∃j ∈ [i+1, shape(v_2, ".len") - 1] : v_2[i] = v_2[j]
