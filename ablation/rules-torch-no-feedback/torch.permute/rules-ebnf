Rule 5 (input tensor should have at least one dimension)
{input : tensor} |= ndim(input) > 0
>>
Rule 7 (Number of dimensions in the tensor input must match the length of the desired dimensions tuple.)
{v_1 : tensor, v_2 : tuple(int)} |= ndim(v_1) = shape(v_2, ".len")
>>
Rule 10 (The dims tuple should not be empty if the input tensor has dimensions)
{v_1 : tensor, v_2 : tuple(int)} |= if ndim(v_1) > 0 then shape(v_2, ".len") > 0
>>
Rule 12 (The length of dims tuple should not exceed the number of dimensions of the input tensor)
{v_1 : tensor, v_2 : tuple(int)} |= shape(v_2, ".len") ≤ ndim(v_1)
>>
Rule 13 (When input has zero dimensions, dims must be an empty tuple)
{v_1 : tensor, v_2 : tuple(int)} |= if ndim(v_1) = 0 then shape(v_2, ".len") = 0
>>
Rule 16 (dims tuple length must be greater than zero if ndim(input) > 0)
{v_1: tensor, v_2: tuple(int)} |= if ndim(v_1) > 0 then shape(v_2, ".len") > 0
>>
Rule 17 (Permutation should be a valid permutation: each dimension appears exactly once)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, ndim(v_1) - 1] : ∃j ∈ [0, shape(v_2, ".len") - 1] : v_2[j] = i
>>
Rule 18 (If input is a scalar, then dims must be empty)
{v_1: tensor, v_2: tuple(int)} |= if ndim(v_1) = 0 then shape(v_2, ".len") = 0
>>
Rule 23 (If there are duplicate dimensions, the total number of dimensions must match)
{v_1 : tensor, v_2 : tuple(int)} |= if ∃i ∈ [0, shape(v_2, ".len") - 1] : ∃j ∈ [i+1, shape(v_2, ".len") - 1] : v_2[i] = v_2[j] then ndim(v_1) = shape(v_2, ".len")
>>
Rule 24 (If the input tensor is empty, the dimensions tuple must also be empty.)
{v_1 : tensor, v_2 : tuple(int)} |= if (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) then shape(v_2, ".len") = 0
