Rule 34 (If input.dim() is 1, then len(dims) can only be 1 or 0.)
{v_1 : tensor, v_2 : tuple(int)} |= if ndim(v_1) = 1 then shape(v_2, ".len") = 1 ∨ shape(v_2, ".len") = 0
