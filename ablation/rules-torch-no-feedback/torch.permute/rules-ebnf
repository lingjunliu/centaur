Rule 46 (The tensor cannot be a quantized tensor.)
{v_1 : tensor} |= dtype_(v_1) ≠ "torch.quint8" ∧ dtype_(v_1) ≠ "torch.qint8" ∧ dtype_(v_1) ≠ "torch.qint32"
