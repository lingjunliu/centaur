Rule 16 (Check that dim1 and dim2 are different when dim1 is accessed from the end)
{v_1 : tensor, v_3 : int, v_4 : int} |= if v_3 < 0 then (ndim(v_1) + v_3) ≠ v_4
>>
Rule 17 (Check that dim2 and dim1 are different when dim2 is accessed from the end)
{v_1 : tensor, v_3 : int, v_4 : int} |= if v_4 < 0 then (ndim(v_1) + v_4) ≠ v_3
>>
Rule 18 (If the tensor has only one dimension, dim1 and dim2 cannot be the same (0))
{v_1 : tensor, v_3 : int, v_4 : int} |= if ndim(v_1) = 1 then v_3 ≠ v_4
>>
Rule 19 (If the tensor has only one dimension, then dim1 and dim2 must be equal to -1 and 0 respectively or -0 and -1)
{v_1 : tensor, v_3 : int, v_4 : int} |= if ndim(v_1) = 1 then (v_3 = -1 ∧ v_4 = 0) ∨ (v_3=0 ∧ v_4 = -1)
>>
Rule 20 (If the tensor has only one dimension, then dim1 or dim2 must be -1 and the other must be 0.)
{v_1 : tensor, v_3 : int, v_4 : int} |= if ndim(v_1) = 1 then (v_3 = -1 ∧ v_4 = 0) ∨ (v_3 = 0 ∧ v_4 = -1)
>>
Rule 25 (If dim2 is negative, dim1 cannot have the same positive value)
{v_1 : tensor, v_3 : int, v_4 : int} |= if v_4 < 0 then v_3 ≠ (ndim(v_1) + v_4)
>>
Rule 26 (If dim3 is negative, dim2 cannot have the same positive value)
{v_1 : tensor, v_3 : int, v_4 : int} |= if v_3 < 0 then v_4 ≠ (ndim(v_1) + v_3)
>>
Rule 30 (If dim3 and dim4 are equal to default values (-2 and -1), then ndim of tensor must be greater than or equal to 2)
{v_1 : tensor, v_3 : int, v_4 : int} |= if v_3 = -2 ∧ v_4 = -1 then ndim(v_1) ≥ 2
>>
Rule 32 (if ndim of tensor is 1 and dim1 is -1 then dim2 must be 0)
{v_1 : tensor, v_3 : int, v_4 : int} |= if ndim(v_1) = 1 ∧ v_3 = -1 then v_4 = 0
>>
Rule 33 (if ndim of tensor is 1 and dim2 is -1 then dim1 must be 0)
{v_1 : tensor, v_3 : int, v_4 : int} |= if ndim(v_1) = 1 ∧ v_4 = -1 then v_3 = 0
>>
Rule 34 (If ndim of tensor is 1 and dim1 and dim2 are default values (-2 and -1), then this means dim1 should be treated as 0 and dim2 as -1 since diagonal needs dim1 < dim2.)
{v_1 : tensor, v_3 : int, v_4 : int} |= if ndim(v_1) = 1 ∧ v_3 = -2 ∧ v_4 = -1 then true
>>
Rule 35 (If ndim of tensor is 1 and dim2 is -1 then dim1 must be 0 or vice versa)
