Rule 1 (dim should be within the valid range of dimensions for input tensor when dim is an integer)
{v_1 : tensor, v_2 : int} |= -1 * ndim(v_1) ≤ v_2 ∧ v_2 ≤ ndim(v_1) - 1
>>
Rule 2 (out tensor's dtype should match input tensor's dtype)
{v_1 : tensor, v_3 : tensor} |= dtype_(v_1) = dtype_(v_3)
>>
Rule 4 (Reduction dimension cannot be zero)
{v_1 : tensor, v_2 : int} |= shape(v_1, v_2) > 0
>>
Rule 6 (if keepdim is true, dim must be a valid dimension of input)
{v_1 : tensor, v_2 : int, v_3 : bool} |= (v_3 = false) ∨ (-1 * ndim(v_1) ≤ v_2 ∧ v_2 ≤ ndim(v_1) - 1)
>>
Rule 10 (Reduction dimension cannot be zero)
{v_1 : tensor, v_2 : int} |= if v_2 ≥ 0 then shape(v_1, v_2) > 0 else shape(v_1, ndim(v_1) + v_2) > 0
>>
Rule 13 (If input is a scalar tensor, dim must be 0)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 0 then v_2 = 0
>>
Rule 22 (If v2 is a tuple, v2's length should not be greater than v1's dimension)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len <= ndim(v_1)
>>
Rule 29 (If the 'out' tensor is provided, and dim is a tuple, the number of dimensions of out should be equal to the number of dimensions of input minues the length of tuple if keepdim is False, otherwise it must be equal.)
{v_1 : tensor, v_2 : tuple(int), v_3 : bool, v_4 : tensor} |= if v_3 then ndim(v_1) = ndim(v_4) else ndim(v_1) - v_2.len = ndim(v_4)
>>
Rule 31 (If keepdim is False and dim contains all dims, the output is scalar)
{v_1 : tensor, v_2: tuple(int), v_3: bool} |= if v_3 = false ∧ v_2.len = ndim(v_1) then ndim(v_1) = 0
