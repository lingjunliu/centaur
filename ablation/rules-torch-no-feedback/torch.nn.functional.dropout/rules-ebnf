Rule 1 (Dropout probability must be between 0 and 1)
{p : float} |= p ≥ 0 ∧ p ≤ 1
>>
Rule 2 (Training flag must be boolean)
{training : bool} |= training = true ∨ training = false
>>
Rule 3 (Inplace flag must be boolean)
{inplace : bool} |= inplace = true ∨ inplace = false
>>
Rule 4 (Input tensor must have at least one dimension if training is true and p > 0)
{v_1 : tensor, p : float, training : bool} |= if training then (p = 0 ∨ ndim(v_1) > 0)
>>
Rule 5 (If inplace is true, input tensor must be mutable.)
{v_1 : tensor, inplace : bool} |= if inplace then dtype_(v_1) ≠ 11
>>
Rule 6 (When training, probability p cannot be 1 if inplace is true)
{p : float, training : bool, inplace : bool} |= if training ∧ inplace then p ≠ 1
>>
Rule 7 (If p is 0, training must be false)
{p : float, training : bool} |= if p = 0 then training = false
>>
Rule 8 (If p is 1, all elements are zeroed. Input tensor dtype must be float if inplace is true.)
{v_1 : tensor, p : float, training : bool, inplace : bool} |= if p = 1 ∧ training ∧ inplace then (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 10 (Tensor dtype must be floating point if training is true and p is not zero)
{v_1 : tensor, p : float, training : bool} |= if training ∧ p > 0 then (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 12 (When training and p > 0, the input tensor should not have zero elements if inplace is true)
{v_1 : tensor, p : float, training : bool, inplace : bool} |= if training ∧ p > 0 ∧ inplace then min(v_1) ≠ 0
>>
Rule 13 (If training is true and p > 0, at least one element of input tensor should be non-zero)
{v_1 : tensor, p : float, training : bool} |= if training ∧ p > 0 then ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 ∧ max(v_1) > 0
>>
Rule 21 (If training is false, p must be zero to avoid unintended side effects)
{training : bool, p : float} |= if training = false then p = 0
>>
Rule 22 (Input tensor needs to be a float tensor if training and p is non zero and inplace is true)
{v_1 : tensor, p : float, training : bool, inplace : bool} |= if training ∧ p > 0 ∧ inplace then (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 25 (if training is True and p > 0, then the input tensor cannot be complex dtype when inplace is True)
{v_1 : tensor, p: float, training: bool, inplace: bool} |= if training ∧ p > 0 ∧ inplace then (dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10)
>>
Rule 27 (Input tensor has to be 2 or more dimensions when training is set to True.)
{v_1: tensor, training: bool} |= if training then ndim(v_1) > 1
>>
Rule 29 (If training is True and p > 0, input tensor is not a complex tensor.)
{v_1 : tensor, p : float, training : bool} |= if training ∧ p > 0 then (dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10)
>>
Rule 39 (If training=True and p>0, the input tensor must have a floating point type if inplace is set to True)
{v_1: tensor, p: float, training: bool, inplace: bool} |= if training ∧ p > 0 ∧ inplace then (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 43 (If training is True, probability p must be greater than or equal to zero)
{training: bool, p: float} |= if training then p >= 0
>>
Rule 44 (If inplace is True and training is True, then the tensor can not have int64 dtype)
{v_1: tensor, training: bool, inplace:bool} |= if training ∧ inplace then dtype_(v_1) ≠ 4
