>>
Rule 2 (input cannot be a complex tensor)
{v_1 : tensor} |= dtype_(v_1) ≠ "complex64" ∧ dtype_(v_1) ≠ "complex128"
>>
Rule 4 (Input tensor dtype must be float or double or half)
{v_1 : tensor} |= dtype_(v_1) = "float16" ∨ dtype_(v_1) = "float32" ∨ dtype_(v_1) = "float64"
>>
Rule 5 (out tensor, if given, must have the same shape as the input tensor)
{v_1 : tensor, v_2 : tensor} |= if v_2 = v_2 then (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 7 (if out is specified, its dtype must be the same as input)
{v_1 : tensor, v_2 : tensor} |= if v_2 = v_2 then dtype_(v_1) = dtype_(v_2)
>>
Rule 12 (Input cannot be quantized)
{v_1 : tensor} |= dtype_(v_1) ≠ "uint8" ∧ dtype_(v_1) ≠ "int8" ∧ dtype_(v_1) ≠ "int32"
>>
Rule 13 (Input tensor dimension must be less than or equal to 8)
{v_1 : tensor} |= ndim(v_1) ≤ 8
>>
Rule 20 (Input cannot be a bfloat16 tensor)
{v_1 : tensor} |= dtype_(v_1) ≠ "bfloat16"
>>
Rule 22 (Input and out should not alias)
{v_1: tensor, v_2: tensor} |= if v_2 = v_2 then v_1 ≠ v_2
>>
Rule 23 (input tensor must have numerical dtype: not bool or str)
{v_1 : tensor} |= dtype_(v_1) ≠ "bool" ∧ dtype_(v_1) ≠ "str"
>>
Rule 24 (if out is specified, its dtype must be able to represent the result)
{v_1 : tensor, v_2 : tensor} |= if v_2 = v_2 then (if dtype_(v_1) = "float16" then dtype_(v_2) = "float16" ∨ dtype_(v_2) = "float32" ∨ dtype_(v_2) = "float64" else if dtype_(v_1) = "float32" then dtype_(v_2) = "float32" ∨ dtype_(v_2) = "float64" else dtype_(v_2) = "float64")
>>
Rule 52 (The input tensor must be a floating-point tensor)
{v_1 : tensor} |= (dtype_(v_1) = "float16") ∨ (dtype_(v_1) = "float32") ∨ (dtype_(v_1) = "float64")
>>
Rule 53 (if out is specified, ensure that the storage is not shared)
{v_1 : tensor, v_2 : tensor} |= if v_2 = v_2 then v_1 ≠ v_2
>>
Rule 54 (Ensure that if out is specified, its dtype matches the input dtype after type promotion)
{v_1 : tensor, v_2 : tensor} |= if v_2 = v_2 then (if dtype_(v_1) = "float16" then dtype_(v_2) = "float16" else if dtype_(v_1) = "float32" then dtype_(v_2) = "float32" else dtype_(v_2) = "float64")
