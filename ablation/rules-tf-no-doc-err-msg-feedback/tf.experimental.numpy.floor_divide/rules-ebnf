>>
Rule 1 (Both inputs must be tensors)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0
>>
Rule 2 (Resultant tensor must have the same dtype as at least one input tensor)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (The shapes of the input tensors must be broadcastable)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1)
>>
Rule 6 (Both inputs must have compatible data types)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) < 6 ∧ dtype_(v_2) < 6 then true else if dtype_(v_1) > 5 ∧ dtype_(v_2) > 5 then true else false
>>
Rule 9 (If one of the input is bool, other should not be complex)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 0 then dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10 else if dtype_(v_2) = 0 then dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 10 (If one of the inputs is complex, the output should be complex as well)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then dtype_(v_2) = 9 ∨ dtype_(v_2) = 10
>>
Rule 11 (If one of the inputs is complex, the other must be complex, int, or float)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then dtype_(v_2) = 1 ∨ dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 ∨ dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10
>>
Rule 12 (Both inputs should not be boolean type)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 0 ∧ dtype_(v_2) ≠ 0
>>
Rule 13 (If the first argument is int, then the second argument must be int or float)
{v_1 : tensor, v_2 : tensor} |= if 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5 then 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8
>>
Rule 14 (If the first argument is float, then the second argument must be int or float)
{v_1 : tensor, v_2 : tensor} |= if 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8 then 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8
>>
Rule 15 (If the second argument is int, then the first argument must be int or float)
{v_1 : tensor, v_2 : tensor} |= if 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5 then 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 16 (If the second argument is float, then the first argument must be int or float)
{v_1 : tensor, v_2 : tensor} |= if 6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8 then 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 17 (Output tensor dtype should be the same as input tensors if they are integers)
{v_1 : tensor, v_2 : tensor} |= if 1 <= dtype_(v_1) ∧ dtype_(v_1) <= 5 ∧ 1 <= dtype_(v_2) ∧ dtype_(v_2) <= 5 then dtype_(v_1) = dtype_(v_2)
>>
Rule 19 (The input tensors' dimension number are within a reasonable range)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) <= 5 ∧ ndim(v_2) <= 5
>>
Rule 20 (The input tensors must have a compatible dtype to perform floor division)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 0 ∨ dtype_(v_2) = 0 then false else if dtype_(v_1) = 11 ∨ dtype_(v_2) = 11 then false else if dtype_(v_1) = 12 ∨ dtype_(v_2) = 12 then false
>>
Rule 21 (The input tensors can not be complex numbers)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10
>>
Rule 22 (If at least one input is floating-point, then output is also floating point)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) ≥ 6 ∨ dtype_(v_2) ≥ 6 then dtype_(v_1) ≥ 6 ∨ dtype_(v_2) ≥ 6
>>
Rule 24 (If v_2 contains zero, then v_1 must have a floating type)
{v_1 : tensor, v_2 : tensor} |= if ∃i ∈ [0, ndim(v_2) - 1]: shape(v_2, i) > 0 ∧ min(v_2) = 0 then dtype_(v_1) ≥ 6
>>
Rule 25 (If v_2 contains zero, then v_1 must have float or complex type)
{v_1 : tensor, v_2 : tensor} |= if ∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0 ∧ min(v_2) = 0 then dtype_(v_1) ≥ 6 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 26 (If v_2 has 0 and v_1 is int, an error will be raised.)
{v_1 : tensor, v_2 : tensor} |= if ∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0 ∧ min(v_2) = 0 then  if 1 <= dtype_(v_1) ∧ dtype_(v_1) <=5 then false
>>
Rule 29 (If the first tensor is boolean, then the second tensor can not be boolean)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 0 then dtype_(v_2) ≠ 0
>>
Rule 31 (Floor divide by zero will result in inf or -inf when the first argument is float.)
{v_1 : tensor, v_2 : tensor} |= if ∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0 ∧ min(v_2) = 0 then (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 32 (If floor dividing by zero, and the numerator is negative, the result is -inf if numerator is float and error if numerator is int)
{v_1 : tensor, v_2 : tensor} |= if ∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0 ∧ min(v_2) = 0 then if min(v_1) < 0 then (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 33 (Both tensors should have same sign, else result depends on rounding behavior of underlying platform)
{v_1 : tensor, v_2 : tensor} |= (min(v_1) ≥ 0 ∧ min(v_2) ≥ 0) ∨ (max(v_1) ≤ 0 ∧ max(v_2) ≤ 0)
>>
Rule 34 (If v_2 contains zero, then v_1 should not contains infinity or NaN.)
{v_1 : tensor, v_2 : tensor} |= if ∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0 ∧ min(v_2) = 0 then (max(v_1) ≠ "inf" ∧ max(v_1) ≠ "nan")
>>
Rule 35 (If v_2 contains zero, then the corresponding elements in the v_1 must be non-infinite or NaN )
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : (ndim(v_1) - i -1 < 0 ∨ ndim(v_2) -i -1 < 0) ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1) ∨ (v_2[i] ≠ 0 ∨ (v_1[i] ≠ "inf" ∧ v_1[i] ≠ "nan"))
>>
Rule 36 (If v_2 contains zero and corresponding v_1 is non-zero, then the dtype of v_1 must be float)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : (ndim(v_1) - i -1 < 0 ∨ ndim(v_2) -i -1 < 0) ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1) ∨ (v_2[i] ≠ 0 ∨ v_1[i] = 0 ∨ dtype_(v_1) ≥ 6)
>>
Rule 37 (If v_1 contains zero, then the corresponding elements in v_2 should be fine )
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : (ndim(v_1) - i -1 < 0 ∨ ndim(v_2) -i -1 < 0) ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1) ∨ (v_1[i] ≠ 0 ∨ true)
>>
Rule 38 (if either of the tensor is a scalar with value zero, dtype of output will depend on the other's dtype)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 0 ∧ v_1 = 0) ∨ (ndim(v_2) = 0 ∧ v_2 = 0)
>>
Rule 39 (If either of the tensor is a scalar with value zero, and dtype of the other is float, the result is NaN or -NaN depending on the sign )
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 0 ∧ v_1 = 0 ∧ dtype_(v_2) > 5) ∨ (ndim(v_2) = 0 ∧ v_2 = 0 ∧ dtype_(v_1) > 5) then true else false
>>
Rule 40 (If either of the tensor is a scalar with value zero, the other must be a numeric type i.e. not bool, str or dtype )
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 0 ∧ v_1 = 0) ∨ (ndim(v_2) = 0 ∧ v_2 = 0) then dtype_(v_1) < 11 ∧ dtype_(v_2) < 11
>>
Rule 42 (If v_1 is a scalar zero, v_2 should not be complex type)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 ∧ v_1 = 0 then dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10
>>
Rule 43 (If v_2 is a scalar zero, v_1 should not be complex type)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) = 0 ∧ v_2 = 0 then dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 46 (If v_1 is a scalar zero, v_2 can not be equal to zero )
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 ∧ v_1 = 0 then v_2 ≠ 0
>>
Rule 49 (if v_2 is zero, then all elements of v_1 should be finite, if v_1 is float)
{v_1 : tensor, v_2 : tensor} |= if (∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0 ∧ v_2[i] = 0) then if dtype_(v_1) > 5 then ∀j ∈ [0, ndim(v_1) - 1] : v_1[j] ≠ "inf" ∧ v_1[j] ≠ "-inf" ∧ v_1[j] ≠ "nan"
>>
Rule 50 (if dtype of v_1 is complex and v_2 contains zero, this will result in warning.)
{v_1 : tensor, v_2 : tensor} |= if (∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0 ∧ v_2[i] = 0) then dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
