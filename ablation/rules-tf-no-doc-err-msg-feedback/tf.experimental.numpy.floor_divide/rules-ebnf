{v_1 : tensor, v_2 : tensor} |= if (∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0 ∧ v_2[i] = 0) ∧ (∃j ∈ [0, ndim(v_1) - 1] : shape(v_1, j) > 0 ∧ v_1[j] = 0) then (dtype_(v_1) >= 6)
