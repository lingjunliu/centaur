Rule 1 (floormod of two tensors requires compatible shapes)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2)
>>
Rule 20 (Ensure tensor has valid shape with positive dimensions)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) -1] : shape(v_1, i) > 0
>>
Rule 21 (If only one input is a tensor, the other input must be a scalar)
{v_1 : tensor, v_2 : int ⊎ float ⊎ tensor} |= if ndim(v_1) > 0 then ndim(v_2) = 0
>>
Rule 24 (If one of the inputs has zero dimension, the other input must also be scalar)
{v_1 : tensor, v_2 : tensor ⊎ float ⊎ int} |= if ndim(v_1) = 0 then ndim(v_2) = 0
>>
Rule 30 (The shapes must be broadcastable)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then ∃i ∈ [0, if ndim(v_1) > ndim(v_2) then ndim(v_1) else ndim(v_2)] : (if (ndim(v_1) - i -1) >= 0 ∧ (ndim(v_2) - i - 1) >= 0 then (shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1)) ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1)
