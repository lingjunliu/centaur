Rule 1 (Both input tensors must have compatible data types for broadcasting.)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (The number of dimensions of the output tensor should be greater than or equal to the maximum number of dimensions of the input tensors.)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ ndim(v_2) ∧ ndim(v_2) ≥ ndim(v_1)
>>
Rule 8 (The maximum number of dimensions must be less than or equal to 32)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≤ 32 ∧ ndim(v_2) ≤ 32
>>
Rule 9 (At least one of the input tensors must have at least one dimension)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∨ ndim(v_2) > 0
>>
Rule 12 (The rank (number of dimensions) of the input tensors must be non-negative.)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 0 ∧ ndim(v_2) ≥ 0
>>
Rule 16 (The data type of both tensors has to be numerical (int, float))
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∧ dtype_(v_2) = 1 ∨ dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 ∨ dtype_(v_2) = 5 ∨ dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9
>>
Rule 20 (Number of dimensions of output can not be greater than the maximum supported rank.)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≤ 8 ∧ ndim(v_2) ≤ 8
>>
Rule 22 (If one of the input tensors is a scalar (ndim=0), the other tensor's shape is returned.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then true else if ndim(v_2) = 0 then true else false
>>
Rule 23 (Shapes must be of type int32 or int64.)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 3 ∨ dtype_(v_1) = 4) ∧ (dtype_(v_2) = 3 ∨ dtype_(v_2) = 4)
>>
Rule 26 (If the shapes of v_1 and v_2 differ by rank, then the shape with the smaller rank is padded by ones.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) < ndim(v_2) then ∀ i ∈ [0, ndim(v_2)-ndim(v_1)-1] : true else if ndim(v_2) < ndim(v_1) then ∀ i ∈ [0, ndim(v_1)-ndim(v_2)-1] : true
>>
Rule 31 (The number of dimensions in the input tensors should not exceed the maximum allowed (e.g. 10).)
{v_1: tensor, v_2: tensor} |= ndim(v_1) ≤ 10 ∧ ndim(v_2) ≤ 10
>>
Rule 35 (The shape of the output tensor must have the same number of dimensions as the larger input tensor after broadcasting.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > ndim(v_2) then true else if ndim(v_2) > ndim(v_1) then true
>>
Rule 51 (Number of dimensions for either tensor has to be less than a max rank.)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) < 5 ∧ ndim(v_2) < 5
>>
Rule 56 (The number of dimensions of the shapes must be less than 6.)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) < 6 ∧ ndim(v_2) < 6
>>
Rule 63 (The input tensors must contain shapes of type int32 (3) or int64 (4))
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 3) ∨ (dtype_(v_1) = 4) ∧ (dtype_(v_2) = 3) ∨ (dtype_(v_2) = 4)
>>
Rule 65 (If one of the tensors is a scalar, the other must also be a scalar)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 0) then (ndim(v_2) = 0) else if (ndim(v_2) = 0) then (ndim(v_1) = 0)
>>
Rule 66 (The dimension count must be a non-negative integer)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) ≥ 0) ∧ (ndim(v_2) ≥ 0)
>>
Rule 70 (The dimension of v_1 and v_2 cannot be string.)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 11 ∧ dtype_(v_2) ≠ 11
>>
Rule 76 (The dtype of the shape tensors v_1 and v_2 must be integer.)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∧ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4
>>
Rule 91 (Total number of dimensions must be below max value of 10.)
{v_1: tensor, v_2: tensor} |= ndim(v_1) < 10 ∧ ndim(v_2) < 10
>>
Rule 99 (The total number of dimensions for broadcasting cannot exceed max_rank which is 10.)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) < 10 ∧ ndim(v_2) < 10
>>
Rule 107 (If the tensors are of different data type, cast them before processing)
{v_1: tensor, v_2: tensor} |= if dtype_(v_1) != dtype_(v_2) then true else false
>>
Rule 108 (The maximum number of dimensions for tensors is 6.)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) ≤ 6) ∧ (ndim(v_2) ≤ 6)
