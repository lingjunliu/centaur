 - kernel_size: integer, stride: integer, padding: integer, ceil_mode: boolean, count_include_pad: boolean, input: tensor
 - kernel_size: tuple, stride: tuple, padding: tuple, ceil_mode: boolean, count_include_pad: boolean, input: tensor

