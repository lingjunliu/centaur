Rule 56 (If the input tensor is a float16, the output should also be a float16 if specified.)
{input : tensor, out : tensor} |= if dtype_(input) = 6 then (if out ≠ false then dtype_(out) = 6)
>>
Rule 59 (The number of dimensions must match if out is present.)
{input : tensor, out: tensor} |= if out ≠ false then ndim(input) = ndim(out)
