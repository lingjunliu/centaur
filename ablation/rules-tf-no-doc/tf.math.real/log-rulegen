<PRIMVAR> ::= any variable name (e.g., matches [a-zA-Z_][a-zA-Z_0-9]*)
<TENSORVAR> ::= same format as PRIMVAR
<TUPLEVAR> ::= same format as PRIMVAR

<VAR> ::= same format as PRIMVAR
