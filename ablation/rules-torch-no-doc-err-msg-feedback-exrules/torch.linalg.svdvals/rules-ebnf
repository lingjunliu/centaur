Rule 1 (Input tensor should be at least 2D for SVD to be meaningful)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (The compute_uv flag must be a boolean value)
{v_1 : bool} |= (v_1 = true) ∨ (v_1 = false)
>>
Rule 4 (Validate input tensor's data type)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 10 (Check the data type of 'S' output tensor)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_2) = dtype_(v_1)
>>
Rule 11 (Validate that S is a tensor)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 30 (Hermitian flag cannot be true if the input is complex, since it is already assumed.)
{v_1 : tensor, v_2 : bool} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then v_2 = false ∨ v_2 = true
>>
Rule 38 (If 'out' tensor is given, its rank has to be at least 1)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 39 (If input is complex, hermitian must be either True or False)
{v_1 : tensor, v_2 : bool} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then (v_2 = true) ∨ (v_2 = false)
>>
Rule 40 (The number of dimensions of the output tensor must be 1.)
{v_1 : tensor} |= ndim(v_1) = 1
>>
Rule 61 (The input must be a matrix i.e. ndim == 2, when the output S is given.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > 0 then ndim(v_1) = 2
>>
Rule 72 (If the input is a batch of matrices (ndim > 2), hermitian must be false.)
{v_1 : tensor, v_2 : bool} |= if ndim(v_1) > 2 then v_2 = false
>>
Rule 84 (If out tensor is specified, its dtype must be same as input tensor)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > 0 then dtype_(v_1) = dtype_(v_2)
>>
Rule 126 (If the input is real, then the output must be real.)
{v_1 : tensor, v_2: tensor} |= if (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ ndim(v_2) > 0 then (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)
