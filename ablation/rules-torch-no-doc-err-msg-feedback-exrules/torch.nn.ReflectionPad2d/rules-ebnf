Rule 26 (If padding is a tuple, all elements must be non-negative)
{padding : tuple(int)} |= ∀ v_1 ∈ [0, padding.len - 1] : padding[v_1] ≥ 0
>>
Rule 36 (If padding mode is circular, padding must be an int)
{padding : int ⊎ tuple(int), padding_mode : str} |= if padding_mode = "circular" then true
>>
