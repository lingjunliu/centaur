{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 = false then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 118 (If it's float16, float32, float64, complex64, or complex128 must have at least 10 dimensions.)
{v_1 : tensor} |= if dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then ndim(v_1) ≥ 10
>>
Rule 119 (Dimensions must match if all other parameters are fine)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : str, v_5 : int} |= if dtype_(v_1) = dtype_(v_2) ∧ v_3 = true ∧ v_4 = "linear" ∧ v_5 > 0 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 120 (The length of list can not be zero.)
{v_1 : list(int)} |= v_1.len > 0
