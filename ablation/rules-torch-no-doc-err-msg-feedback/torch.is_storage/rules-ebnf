Rule 121 (If bool argument is false, storage object type must be bool, otherwise dtype is bool if it's a floating-point type.)
{v_1 : tensor, v_2 : bool} |= if v_2 = false then dtype_(v_1) = 0 else (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 122 (The given String value must be "area" if object has only a single value.)
{v_1 : tensor, v_2 : str} |= if shape(v_1, 0) = 1 then v_2 = "area"
