Rule 124 (If the second Storage object is Boolean, the dtypes must be 0, 1, 2 or 3.)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_2) = 0 then dtype_(v_1) = 0 ∨ dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3
>>
Rule 125 (If bool equals true dimensions must be one, otherwise min =0, max=0, and all int=1.)
{v_1 : tensor, v_2 : int, v_3 : bool} |= if v_3 then ndim(v_1) = 1 else min(v_1) = 0 ∧ max(v_1) = 0 ∧ v_2= 1
