Rule 3 (The 'to' argument for nextafter should have the same shape as 'self'.)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 4 (The 'to' argument cannot be of boolean type.)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 6 (The 'self' argument must be a real dtype (no complex or bool))
{v_1 : tensor} |= dtype_(v_1) ≠ 0 ∧ dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 9 ('self' cannot be a string.)
{v_1 : tensor} |= dtype_(v_1) ≠ 11
>>
Rule 10 (Both tensors must have at least one dimension.)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1
>>
Rule 11 ('self' and 'to' should have the same dtype category - either both integer or both float.)
{v_1 : tensor, v_2 : tensor} |= ((dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5) ∧ (dtype_(v_2) = 1 ∨ dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 ∨ dtype_(v_2) = 5)) ∨ ((dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8))
>>
Rule 12 (The maximum value of self should be smaller than the maximum value of 'to')
{v_1 : tensor, v_2 : tensor} |= max(v_1) ≤ max(v_2)
>>
Rule 13 (The minimum value of self should be smaller than the minimum value of 'to')
{v_1 : tensor, v_2 : tensor} |= min(v_1) ≤ min(v_2)
>>
Rule 25 (The 'self' tensor should not be empty.)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 28 (The shape of 'self' and 'to' tensors should be positive)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0
>>
