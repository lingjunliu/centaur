{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 1 then dtype_(v_2) ≥ 1 else if dtype_(v_1) = 2 then dtype_(v_2) ≥ 2 else if dtype_(v_1) = 3 then dtype_(v_2) ≥ 3 else if dtype_(v_1) = 4 then dtype_(v_2) ≥ 4 else if dtype_(v_1) = 5 then dtype_(v_2) ≥ 5 else if dtype_(v_1) = 6 then dtype_(v_2) ≥ 6 else if dtype_(v_1) = 7 then dtype_(v_2) ≥ 7 else if dtype_(v_1) = 8 then dtype_(v_2) ≥ 8
