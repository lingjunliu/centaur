>>
Rule 58 (If self's dtype is int16, to's dtype can only be int16, int32, int64.)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 2 then (dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 )
>>
Rule 59 (If self's dtype is int32, to's dtype can only be int32, int64.)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 3 then (dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 )
>>
Rule 60 (If self's dtype is int64, to's dtype can only be int64.)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 4 then dtype_(v_2) = 4
>>
Rule 61 (If self's dtype is uint8, to's dtype can only be uint8, int16, int32, int64.)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 5 then (dtype_(v_2) = 5 ∨ dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 )
>>
Rule 62 (Tensors cannot have complex64 or complex128 type)
