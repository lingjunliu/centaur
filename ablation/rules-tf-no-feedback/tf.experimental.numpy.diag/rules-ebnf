Rule 5 (k must be non-negative if input is 1-dimensional and input tensor has boolean type)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 ∧ dtype_(v_1) = 0 then v_2 ≥ 0
>>
Rule 7 (if input is 1d tensor then k should be less than the size of the tensor along the only dimension)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then v_2 < shape(v_1, 0)
>>
Rule 8 (if input is 2d tensor then k should be less than or equal to shape(v,1))
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 then v_2 ≤ shape(v_1, 1)
>>
Rule 12 (if input is a 2d tensor and k is greater than 0 then shape(v_1, 1) - k should be greater than 0)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 ∧ v_2 > 0 then shape(v_1, 1) - v_2 > 0
>>
Rule 13 (if input is a 2d tensor and k is less than 0 then shape(v_1, 0) + k should be greater than 0 or equal to zero)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 ∧ v_2 < 0 then shape(v_1, 0) + v_2 ≥ 0
>>
Rule 16 (if input is a 2d tensor then k can not be greater than shape(v_1, 1) - 1)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 then v_2 ≤ (shape(v_1, 1) - 1)
>>
Rule 17 (if input is a 2d tensor then if k is positive, it must be less than shape(v_1, 1))
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 ∧ v_2 > 0 then v_2 < shape(v_1, 1)
>>
Rule 19 (if input is 2d tensor and k=0 then shape of returned tensor will be square)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 ∧ v_2 = 0 then shape(v_1, 0) = shape(v_1, 1)
>>
Rule 20 (if input is 2d tensor and k=0 then returned tensor will be square if the dimensions of the input tensor are the same)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 ∧ v_2 = 0 then shape(v_1,0) = shape(v_1,1)
>>
Rule 21 (if input is 1d tensor then k is equal to zero or greater than zero then offset is added on right side )
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 ∧ v_2 ≥ 0 then true
>>
Rule 22 (if input is 1d tensor and k is less than zero then offset is added on left side )
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 ∧ v_2 < 0 then true
>>
Rule 23 (if input is 2d tensor and k is less than or equal zero then offset is added on upside)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 ∧ v_2 ≤ 0 then true
>>
Rule 24 (if input is 2d tensor and k is greater than zero then offset is added on downside)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 ∧ v_2 > 0 then true
>>
Rule 25 (if input is a 2d tensor and k is not equal to 0, then the output is not square)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 ∧ v_2 ≠ 0 then false
>>
Rule 27 (if input is a 2d tensor then if k is negative, the diagonal is shifted upward)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 ∧ v_2 < 0 then true
>>
Rule 29 (if input is a 2d tensor and k = 0 then the resulting diagonal has the same dtype as the input)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 ∧ v_2 = 0 then dtype_(v_1) = dtype_(v_1)
>>
Rule 30 (if input is 1d tensor then the output will be 2d)
{v_1 : tensor} |= if ndim(v_1) = 1 then 2 = 2
>>
Rule 31 (if input is 2d tensor then output will be 1d)
{v_1 : tensor} |= if ndim(v_1) = 2 then 1 = 1
>>
Rule 34 (if input is a 2d tensor, and k = 0 and both shapes are same, output tensor also has same dtype.)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 ∧ v_2 = 0 ∧ shape(v_1, 0) = shape(v_1, 1) then dtype_(v_1) = dtype_(v_1)
>>
Rule 36 (if input is a 2d tensor, then the number of elements in the diagonal should be min of two shapes if k=0)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 ∧ v_2 = 0 then (if shape(v_1, 0) ≤ shape(v_1, 1) then shape(v_1, 0) = shape(v_1, 0) else shape(v_1, 1) = shape(v_1, 1) )
>>
Rule 37 (if input is 1d tensor then the number of columns of the output would be equal to its length added with offset k if positive else length if k is negative)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then (if v_2 ≥ 0 then shape(v_1, 0) + v_2 else shape(v_1, 0) ) > 0
>>
Rule 39 (if input is 2d tensor, and k is positive,the shape[0] of the output would be the same as that of input)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 ∧ v_2 > 0 then shape(v_1,0) = shape(v_1, 0)
>>
Rule 40 (if input is 2d tensor, and k is positive, the number of columns of output would be the same as shape of diagonal(1d) tensor and it is same as input shape[0] plus the positive offset)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 ∧ v_2 > 0 then shape(v_1,0)+v_2 > 0
