>>
Rule 1 (filename must be a non-empty string)
{v_1 : str} |= v_1 ≠ ""
>>
Rule 3 (filename length should be less than 256)
{v_1 : str} |= v_1.len < 256
>>
Rule 5 (contents length should be less than 1MB)
{v_1 : str} |= v_1.len < 1048576
>>
Rule 6 (filename should have at least one character before extension if extension is present)
{v_1 : str} |= if ∃ i ∈ [0, v_1.len - 1] : v_1[i] = "." then i > 0
>>
Rule 7 (filename should be an absolute path)
{v_1 : str} |= v_1[0] = "/"
>>
Rule 8 (contents should not contain null characters)
{v_1 : str} |= ∀ i ∈ [0, v_1.len - 1] : v_1[i] ≠ "\0"
>>
Rule 9 (filename length should be greater than 0 and less than or equal to 255)
{v_1 : str} |= v_1.len > 0 ∧ v_1.len ≤ 255
>>
Rule 18 (If the filename ends in a forward slash, contents must be empty)
{v_1: str, v_2: str} |= if v_1[v_1.len - 1] = "/" then v_2.len = 0
>>
Rule 21 (Filename should not be the empty string if contents is not)
{v_1: str, v_2: str} |= if v_2.len > 0 then v_1.len > 0
>>
Rule 26 (If filename contains wildcard characters, contents must be empty and operation should only create the file.)
{v_1: str, v_2: str} |= if ∃ wildcard ∈ [0, v_1.len - 1] : v_1[wildcard] = "*" ∨ v_1[wildcard] = "?" then v_2.len = 0
>>
Rule 36 (Filename and Contents must be different string)
{v_1: str, v_2:str} |= v_1 ≠ v_2
