Rule 1 (Input tensors must have the same shape)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 2 (The first input tensor's dimension must be greater than zero.)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 3 (The second input tensor's dimension must be greater than zero.)
{v_2 : tensor} |= ndim(v_2) > 0
>>
Rule 11 (Both input tensors should have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 18 (At least one of the input tensors must be non-zero at some index)
{v_1 : tensor, v_2 : tensor} |= (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 ∧ min(v_1) ≠ max(v_1)) ∨ (∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0 ∧ min(v_2) ≠ max(v_2))
>>
Rule 24 (If v1's dimension is greater than v2's dimension, then v2's shape dimensions must equal 1)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > ndim(v_2) then (∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = 1 ∨ shape(v_2, i) = shape(v_1, i))
>>
Rule 25 (If v2's dimension is greater than v1's dimension, then v1's shape dimensions must equal 1)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > ndim(v_1) then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1 ∨ shape(v_1, i) = shape(v_2, i))
>>
Rule 28 (The shape of the first tensor must be greater or equal the shape of the second tensor.)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ ndim(v_2)
>>
Rule 46 (If v_1 is a tuple, v_2 must be a tensor and its ndim must be equal to the length of tuple)
{v_1: tuple(int), v_2: tensor} |= ndim(v_2) = v_1.len
>>
Rule 47 (If v_2 is a tuple, v_1 must be a tensor and its ndim must be equal to the length of tuple)
{v_1: tensor, v_2: tuple(int)} |= ndim(v_1) = v_2.len
>>
Rule 51 (If v_1 is a list, v_2 must be a tensor and have shape[0] equal to the length of list)
{v_1 : list(int ⊎ float ⊎ bool), v_2 : tensor} |= shape(v_2, 0) = v_1.len
