Rule 21 (x1 and x2 must have same shape and be either both float32 or both float64)
{x1 : tensor, x2 : tensor} |= (shape(x1) = shape(x2)) ∧ ((dtype_(x1) = 7 ∧ dtype_(x2) = 7) ∨ (dtype_(x1) = 8 ∧ dtype_(x2) = 8))
