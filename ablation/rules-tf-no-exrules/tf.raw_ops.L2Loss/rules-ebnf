Rule 62 (If ndim is 1, min and max should not be same.)
{t : tensor} |= if ndim(t) = 1 then min(t) ≠ max(t)
>>
Rule 108 (The input tensor t must have the same dtype as the output tensor)
{t : tensor} |= dtype_(t) = dtype_(t)
>>
Rule 109 (The maximum value of the tensor t should be a finite number)
{t : tensor} |= max(t) < 10000000000
