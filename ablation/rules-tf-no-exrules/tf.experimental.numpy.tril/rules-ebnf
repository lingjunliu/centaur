Rule 1 (Input tensor `m` must have at least one dimension)
{m : tensor} |= ndim(m) > 0
>>
Rule 3 (If the input tensor `m` is empty, `k` must be 0)
{m : tensor, k : int} |= if ndim(m) = 0 then k = 0
>>
Rule 24 (The data type of m should be a number)
{m : tensor} |= dtype_(m) ≠ "str" ∧ dtype_(m) ≠ "bool"
>>
Rule 30 (k should be within a reasonable range relative to shape of m)
{m : tensor, k : int} |= if ndim(m) > 1 then k > -1000 ∧ k < 1000
>>
Rule 31 (k must be an integer that is not too large or too small)
{k : int} |= k > -1000000 ∧ k < 1000000
>>
Rule 47 (If the input tensor `m` has ndim > 1, the number of dimensions should be less than 5)
{m : tensor} |= if ndim(m) > 1 then ndim(m) < 5
>>
Rule 60 (If the input tensor `m` is 1D, k must be 0)
{m : tensor, k : int} |= if ndim(m) = 1 then k = 0
>>
Rule 66 (The absolute value of k should not be greater than 1000)
{k: int} |= k > -1000 ∧ k < 1000
>>
Rule 72 (k must be greater or equal to -1000)
{k : int} |= k ≥ -1000
>>
Rule 77 (If the input tensor has more than 0 dimensions, k must not be string.)
{m : tensor, k : int} |= if ndim(m) > 0 then dtype_(k) ≠ "str"
>>
Rule 78 (If the input tensor has more than 0 dimensions, k must be integer.)
{m : tensor, k : int} |= if ndim(m) > 0 then dtype_(k) = "int"
>>
Rule 84 (If the input tensor is not empty, number of dimensions should be less than 5)
{m : tensor} |= if ndim(m) > 0 then ndim(m) < 5
>>
Rule 90 (k should be less than or equal to 1000)
{k : int} |= k ≤ 1000
>>
Rule 102 (If the input tensor is not empty, dtype of m must be float or int.)
{m : tensor} |= if ndim(m) > 0 then dtype_(m) = "float" ∨ dtype_(m) = "int"
>>
Rule 114 (The absolute value of k should not be too large)
{k : int} |= k > -10000 ∧ k < 10000
