Rule 9 (If conjugate is false, the input tensor's dtype can be float32, float64, complex64, complex128, int32, int64)
{a : tensor, conjugate : bool} |= if conjugate = false then (dtype_(a) = 7 ∨ dtype_(a) = 8 ∨ dtype_(a) = 10 ∨ dtype_(a) = 11 ∨ dtype_(a) = 3 ∨ dtype_(a) = 4)
