Rule 2 (indices tensor must be of type int32 or int64)
{indices : tensor} |= (dtype_(indices) = 3) ∨ (dtype_(indices) = 5)
>>
Rule 3 (segment_ids tensor must be of type int32 or int64)
{segment_ids : tensor} |= (dtype_(segment_ids) = 3) ∨ (dtype_(segment_ids) = 5)
>>
Rule 4 (indices tensor must be a 1-D tensor)
{indices : tensor} |= ndim(indices) = 1
>>
Rule 5 (segment_ids tensor must be a 1-D tensor)
{segment_ids : tensor} |= ndim(segment_ids) = 1
>>
Rule 6 (sparse_gradient must be a boolean)
{sparse_gradient : bool} |= (sparse_gradient = true) ∨ (sparse_gradient = false)
>>
Rule 8 (sparse_gradient is false by default)
{sparse_gradient : bool} |= if sparse_gradient = true then true else if sparse_gradient = false then true else false
>>
Rule 15 (The rank of segment_ids should be the same as the rank of indices)
{indices : tensor, segment_ids : tensor} |= ndim(indices) = ndim(segment_ids)
