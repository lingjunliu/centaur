Rule 1 (data tensor must be of type float32, float64, int32, uint8, int16, int8, int64, bfloat16, uint16, half, uint32, uint64)
{data : tensor} |= (dtype_(data) = 7) ∨ (dtype_(data) = 8) ∨ (dtype_(data) = 3) ∨ (dtype_(data) = 6) ∨ (dtype_(data) = 2) ∨ (dtype_(data) = 1) ∨ (dtype_(data) = 5) ∨ (dtype_(data) = 13) ∨ (dtype_(data) = 14) ∨ (dtype_(data) = 15) ∨ (dtype_(data) = 16) ∨ (dtype_(data) = 17)
