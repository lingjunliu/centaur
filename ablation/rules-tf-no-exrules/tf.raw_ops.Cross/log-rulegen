<binding_list> ::= <binding> ("," <binding>)*
<binding> ::= <VAR> ":" <type>

<type> ::= "tensor"
         | "int"
         | "float"
         | "bool"
         | "dtype"
         | "str"
         | "list" "(" <type> ")"
         | "tuple" "(" <type> ")"
         | <type> "⊎" <type>

<expr> ::= <and_expr>
<and_expr> ::= <or_expr> | <and_expr> "∧" <or_expr>
<or_expr> ::= <quant_expr> | <or_expr> "∨" <quant_expr>
<quant_expr> ::= "∀" <PRIMVAR> "∈" "[" <expr> "," <expr> "]" ":" <expr>
               | "∃" <PRIMVAR> "∈" "[" <expr> "," <expr> "]" ":" <expr>
               | <if_expr>
               | <compare_expr>

