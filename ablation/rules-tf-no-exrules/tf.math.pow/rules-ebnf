{x : tensor, y : tensor} |= if ndim(y) ≠ 0 then ndim(x) = ndim(y) ∧ (dtype_(y) = "float16" ∨ dtype_(y) = "float32" ∨ dtype_(y) = "float64" ∨ dtype_(y) = "int32" ∨ dtype_(y) = "int64" ∨ dtype_(y) = "complex64" ∨ dtype_(y) = "complex128")
