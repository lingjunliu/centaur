Rule 2 (x's dtype must be in the allowed list)
{x : tensor} |= dtype_(x) = "float16" ∨ dtype_(x) = "float32" ∨ dtype_(x) = "float64" ∨ dtype_(x) = "int32" ∨ dtype_(x) = "int64" ∨ dtype_(x) = "complex64" ∨ dtype_(x) = "complex128"
>>
Rule 3 (y's dtype must be in the allowed list)
{y : tensor} |= dtype_(y) = "float16" ∨ dtype_(y) = "float32" ∨ dtype_(y) = "float64" ∨ dtype_(y) = "int32" ∨ dtype_(y) = "int64" ∨ dtype_(y) = "complex64" ∨ dtype_(y) = "complex128"
>>
Rule 4 (x and y must have the same dtype if both are not complex)
{x : tensor, y : tensor} |= if (dtype_(x) = "complex64" ∨ dtype_(x) = "complex128") ∨ (dtype_(y) = "complex64" ∨ dtype_(y) = "complex128") then true else dtype_(x) = dtype_(y)
>>
Rule 10 (x and y's dimension should be greater than 0)
{x : tensor, y : tensor} |= ndim(x) > 0 ∧ ndim(y) > 0
>>
Rule 12 (x's dtype must be in the allowed list)
{x : tensor, y : tensor} |= (dtype_(x) = "float16" ∨ dtype_(x) = "float32" ∨ dtype_(x) = "float64" ∨ dtype_(x) = "int32" ∨ dtype_(x) = "int64" ∨ dtype_(x) = "complex64" ∨ dtype_(x) = "complex128") ∧ (dtype_(y) = "float16" ∨ dtype_(y) = "float32" ∨ dtype_(y) = "float64" ∨ dtype_(y) = "int32" ∨ dtype_(y) = "int64" ∨ dtype_(y) = "complex64" ∨ dtype_(y) = "complex128")
>>
Rule 13 (if x is int, y must be int or float)
{x : tensor, y : tensor} |= if dtype_(x) = "int32" ∨ dtype_(x) = "int64" then dtype_(y) = "int32" ∨ dtype_(y) = "int64" ∨ dtype_(y) = "float16" ∨ dtype_(y) = "float32" ∨ dtype_(y) = "float64"
>>
Rule 14 (x's ndim must be equal to y's ndim)
{x : tensor, y : tensor} |= ndim(x) = ndim(y)
>>
Rule 18 (if x is int, y must be int or float. if x is complex, y can be anything)
{x : tensor, y : tensor} |= if dtype_(x) = "int32" ∨ dtype_(x) = "int64" then dtype_(y) = "int32" ∨ dtype_(y) = "int64" ∨ dtype_(y) = "float16" ∨ dtype_(y) = "float32" ∨ dtype_(y) = "float64" else if dtype_(x) = "complex64" ∨ dtype_(x) = "complex128" then true
>>
Rule 19 (x's ndim must be equal to y's ndim or y is scalar)
{x : tensor, y : tensor} |= if ndim(y) = 0 then true else ndim(x) = ndim(y)
>>
Rule 30 (Shape of x must be non-empty)
{x : tensor} |= ndim(x) > 0
>>
Rule 31 (x and y must have compatible shapes and dtypes)
{x : tensor, y : tensor} |= shape(x) = shape(y) ∧ (dtype_(x) = "float16" ∨ dtype_(x) = "float32" ∨ dtype_(x) = "float64" ∨ dtype_(x) = "int32" ∨ dtype_(x) = "int64" ∨ dtype_(x) = "complex64" ∨ dtype_(x) = "complex128") ∧ (dtype_(y) = "float16" ∨ dtype_(y) = "float32" ∨ dtype_(y) = "float64" ∨ dtype_(y) = "int32" ∨ dtype_(y) = "int64" ∨ dtype_(y) = "complex64" ∨ dtype_(y) = "complex128") ∧ (if dtype_(x) = "int32" ∨ dtype_(x) = "int64" then dtype_(y) = "int32" ∨ dtype_(y) = "int64" ∨ dtype_(y) = "float16" ∨ dtype_(y) = "float32" ∨ dtype_(y) = "float64" else if dtype_(x) = "complex64" ∨ dtype_(x) = "complex128" then true)
>>
Rule 34 (y must have non-zero dimension)
{y : tensor} |= ndim(y) > 0
>>
Rule 35 (x and y must have compatible shapes and dtypes, and ndim > 0)
{x : tensor, y : tensor} |= shape(x) = shape(y) ∧ (dtype_(x) = "float16" ∨ dtype_(x) = "float32" ∨ dtype_(x) = "float64" ∨ dtype_(x) = "int32" ∨ dtype_(x) = "int64" ∨ dtype_(x) = "complex64" ∨ dtype_(x) = "complex128") ∧ (dtype_(y) = "float16" ∨ dtype_(y) = "float32" ∨ dtype_(y) = "float64" ∨ dtype_(y) = "int32" ∨ dtype_(y) = "int64" ∨ dtype_(y) = "complex64" ∨ dtype_(y) = "complex128") ∧ (if dtype_(x) = "int32" ∨ dtype_(x) = "int64" then dtype_(y) = "int32" ∨ dtype_(y) = "int64" ∨ dtype_(y) = "float16" ∨ dtype_(y) = "float32" ∨ dtype_(y) = "float64" else if dtype_(x) = "complex64" ∨ dtype_(x) = "complex128" then true) ∧ ndim(x) > 0
>>
Rule 39 (x's ndim must be equal to y's ndim if y is not a scalar, also y must have valid dtype)
{x : tensor, y : tensor} |= if ndim(y) = 0 then true else ndim(x) = ndim(y) ∧ (dtype_(y) = "float16" ∨ dtype_(y) = "float32" ∨ dtype_(y) = "float64" ∨ dtype_(y) = "int32" ∨ dtype_(y) = "int64" ∨ dtype_(y) = "complex64" ∨ dtype_(y) = "complex128")
>>
Rule 41 (x and y must have compatible shapes and dtypes, and both ndim > 0)
{x : tensor, y : tensor} |= shape(x) = shape(y) ∧ (dtype_(x) = "float16" ∨ dtype_(x) = "float32" ∨ dtype_(x) = "float64" ∨ dtype_(x) = "int32" ∨ dtype_(x) = "int64" ∨ dtype_(x) = "complex64" ∨ dtype_(x) = "complex128") ∧ (dtype_(y) = "float16" ∨ dtype_(y) = "float32" ∨ dtype_(y) = "float64" ∨ dtype_(y) = "int32" ∨ dtype_(y) = "int64" ∨ dtype_(y) = "complex64" ∨ dtype_(y) = "complex128") ∧ (if dtype_(x) = "int32" ∨ dtype_(x) = "int64" then dtype_(y) = "int32" ∨ dtype_(y) = "int64" ∨ dtype_(y) = "float16" ∨ dtype_(y) = "float32" ∨ dtype_(y) = "float64" else if dtype_(x) = "complex64" ∨ dtype_(x) = "complex128" then true) ∧ ndim(x) > 0 ∧ ndim(y) > 0
>>
Rule 42 (x's ndim must be equal to y's ndim if y is not a scalar, and y must have valid dtype)
{x : tensor, y : tensor} |= if ndim(y) = 0 then (dtype_(y) = "float16" ∨ dtype_(y) = "float32" ∨ dtype_(y) = "float64" ∨ dtype_(y) = "int32" ∨ dtype_(y) = "int64" ∨ dtype_(y) = "complex64" ∨ dtype_(y) = "complex128") else ndim(x) = ndim(y) ∧ (dtype_(y) = "float16" ∨ dtype_(y) = "float32" ∨ dtype_(y) = "float64" ∨ dtype_(y) = "int32" ∨ dtype_(y) = "int64" ∨ dtype_(y) = "complex64" ∨ dtype_(y) = "complex128")
>>
Rule 44 (x's ndim must be equal to y's ndim if y is not a scalar, and y must have valid dtype, and if y is scalar, its dtype must be the same as x)
{x : tensor, y : tensor} |= if ndim(y) = 0 then (dtype_(y) = "float16" ∨ dtype_(y) = "float32" ∨ dtype_(y) = "float64" ∨ dtype_(y) = "int32" ∨ dtype_(y) = "int64" ∨ dtype_(y) = "complex64" ∨ dtype_(y) = "complex128") ∧ dtype_(x) = dtype_(y) else ndim(x) = ndim(y) ∧ (dtype_(y) = "float16" ∨ dtype_(y) = "float32" ∨ dtype_(y) = "float64" ∨ dtype_(y) = "int32" ∨ dtype_(y) = "int64" ∨ dtype_(y) = "complex64" ∨ dtype_(y) = "complex128")
>>
