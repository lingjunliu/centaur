>>
Rule 2 (Weight tensor should have at least three dimensions)
{weight : tensor} |= ndim(weight) ≥ 3
>>
Rule 3 (Bias tensor should have the correct number of elements)
{weight : tensor, bias : tensor, groups : int} |= if bias ≠ "none" then shape(bias, 0) = shape(weight, 1) * groups
>>
Rule 5 (Dilation should be greater than zero)
{dilation : int} |= dilation > 0
>>
Rule 6 (Stride should be positive)
{stride : int} |= stride > 0
>>
Rule 7 (Groups should be positive)
{groups : int} |= groups > 0
>>
Rule 8 (If groups > 1, in_channels should be divisible by groups)
{input : tensor, weight : tensor, groups : int} |= shape(input, 1) % groups = 0 ∧ shape(weight, 0) % groups = 0
>>
Rule 9 (Output padding should be non-negative)
{output_padding : int} |= output_padding ≥ 0
