Rule 10 (Dilation components should be greater than zero when dilation is a tuple)
{dilation : tuple(int)} |= dilation[0] > 0 ∧ dilation[1] > 0
>>
Rule 11 (Stride components should be positive when stride is a tuple)
{stride : tuple(int)} |= stride[0] > 0 ∧ stride[1] > 0
>>
Rule 12 (Padding components should be non-negative when padding is a tuple)
{padding : tuple(int)} |= padding[0] ≥ 0 ∧ padding[1] ≥ 0
>>
Rule 13 (Output padding components should be non-negative when output_padding is a tuple)
{output_padding : tuple(int)} |= output_padding[0] ≥ 0 ∧ output_padding[1] ≥ 0
>>
Rule 15 (Weight should be divisible by groups at dimension 1)
{weight : tensor, groups : int} |= shape(weight, 1) % groups = 0
>>
Rule 16 (Weight shape[0] must be equal to input shape[1])
{input : tensor, weight : tensor} |= shape(weight, 0) = shape(input, 1)
>>
Rule 17 (The size of the dilation tuple should be 2)
{dilation : tuple(int)} |= ndim(dilation) = 1 ∧ shape(dilation, 0) = 2
>>
Rule 18 (The size of the stride tuple should be 2)
{stride : tuple(int)} |= ndim(stride) = 1 ∧ shape(stride, 0) = 2
>>
Rule 19 (The size of the padding tuple should be 2)
{padding : tuple(int)} |= ndim(padding) = 1 ∧ shape(padding, 0) = 2
>>
Rule 20 (The size of the output_padding tuple should be 2)
{output_padding : tuple(int)} |= ndim(output_padding) = 1 ∧ shape(output_padding, 0) = 2
>>
Rule 23 (Bias tensor should have the correct number of elements)
{weight : tensor, bias : tensor, groups : int} |= if bias = "none" then true else shape(bias, 0) = shape(weight, 1) * groups
>>
Rule 24 (Input and weight tensors should have the same data type)
{input : tensor, weight : tensor} |= dtype_(input) = dtype_(weight)
>>
Rule 34 (Bias should have the same dtype as input if bias is not None)
{input : tensor, bias : tensor} |= if bias = "none" then true else dtype_(input) = dtype_(bias)
>>
Rule 41 (Input tensor should have 3 or 4 dimensions, and all dimensions should be positive)
{input : tensor} |= (ndim(input) = 3 ∨ ndim(input) = 4) ∧ ∀i ∈ [0, ndim(input) - 1] : shape(input, i) > 0
>>
Rule 42 (Weight tensor should have at least three dimensions and be positive)
{weight : tensor} |= ndim(weight) ≥ 3 ∧ ∀i ∈ [0, ndim(weight) - 1] : shape(weight, i) > 0
>>
Rule 48 (If groups > 1, in_channels should be divisible by groups and greater than 0)
{input : tensor, weight : tensor, groups : int} |= shape(input, 1) % groups = 0 ∧ shape(weight, 0) % groups = 0 ∧ shape(input,1) > 0 ∧ shape(weight, 0) > 0
>>
Rule 55 (Number of input channels should be divisible by the number of groups.)
{input : tensor, groups : int} |= shape(input, 1) % groups = 0
>>
Rule 61 (If bias is not none, the number of bias dimensions must be 1)
{bias : tensor} |= if bias = "none" then true else ndim(bias) = 1
>>
Rule 76 (The number of input channels should be divisible by groups if groups > 1)
{input : tensor, groups : int} |= if groups > 1 then shape(input, 1) % groups = 0
>>
Rule 78 (Weight's shape[1] * groups must be the same as the bias' shape[0], when bias is not None)
{weight : tensor, bias : tensor, groups : int} |= if bias = "none" then true else shape(weight, 1) * groups = shape(bias, 0)
>>
Rule 100 (The dimension of dilation must be either 0 or 1)
{dilation : int ⊎ tuple(int)} |= ndim(dilation) = 0 ∨ ndim(dilation) = 1
>>
Rule 101 (The dimension of stride must be either 0 or 1)
{stride : int ⊎ tuple(int)} |= ndim(stride) = 0 ∨ ndim(stride) = 1
>>
Rule 102 (The dimension of padding must be either 0 or 1)
{padding : int ⊎ tuple(int)} |= ndim(padding) = 0 ∨ ndim(padding) = 1
>>
Rule 103 (The dimension of output_padding must be either 0 or 1)
{output_padding : int ⊎ tuple(int)} |= ndim(output_padding) = 0 ∨ ndim(output_padding) = 1
