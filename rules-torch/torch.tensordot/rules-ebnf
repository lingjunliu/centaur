Rule 2 (dims should be non-negative integer when dims is an integer)
{dims : int} |= dims ≥ 0
>>
Rule 3 (The length of dims_a and dims_b should be equal for tuple or list dims)
{dims : tuple(list(int))} |= dims.len = 2
>>
Rule 7 (Check dims when it is a tensor)
{dims : tensor} |= ndim(dims) = 0 ∨ (ndim(dims) = 1 ∧ dtype_(dims) = 4) ∨ (ndim(dims) = 2 ∧ dtype_(dims) = 4)
>>
Rule 10 (dims should be within range if it's an integer)
{a : tensor, b : tensor, dims : int} |= dims ≤ ndim(a) ∧ dims ≤ ndim(b)
>>
Rule 13 (a tensor with 0 elements cannot be converted to Scalar, at least one dimension should be positive)
{a: tensor} |= ∃i ∈ [0, ndim(a) - 1] : shape(a, i) > 0
>>
Rule 14 (Number of dimensions must match when dims is an integer)
{a : tensor, b : tensor, dims : int} |= ndim(a) ≥ dims ∧ ndim(b) ≥ dims
>>
Rule 17 (The length of dims_a and dims_b should be equal for tuple or list dims)
{dims : tuple(list(int))} |= shape(dims, 0) = 2
>>
Rule 18 (When dims is a tuple, each element should be an integer)
{a : tensor, dims : tuple(int)} |= ∀i ∈ [0, shape(dims, 0) - 1] : dims[i] ≥ 0 ∧ dims[i] < ndim(a)
>>
Rule 25 (output tensor should have the correct dtype)
{a : tensor, v_4 : tensor} |= dtype_(v_4) = dtype_(a)
>>
Rule 29 (The shape of dims should be a tuple)
{dims : tensor} |= ndim(dims) < 3
>>
Rule 32 (The length of dims should be 2 for tuple or list dims)
{dims : tuple(list(int))} |= ndim(dims) = 1 ∧ shape(dims, 0) = 2
>>
Rule 33 (When dims is a tuple, each element should be an integer and valid dimension)
{a : tensor, dims : tuple(int)} |= ∀i ∈ [0, dims.len - 1] : dims[i] ≥ 0 ∧ dims[i] < ndim(a)
>>
Rule 47 (dims should not be none, when is is integer)
{dims : int} |= dims ≠ "none"
>>
Rule 74 (If dims is a list of list, then shape(dims, 0) must be equal to 2.)
{dims : list(list(int))} |= shape(dims, 0) = 2
>>
Rule 81 (dims, if a tensor, must have a supported dtype.)
{dims : tensor} |= dtype_(dims) = 3 ∨ dtype_(dims) = 4
>>
Rule 92 (The number of dimensions of the tensors must be positive )
{a : tensor, b : tensor} |= ndim(a) > 0 ∧ ndim(b) > 0
