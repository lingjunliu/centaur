Rule 7 (s[i] must be positive if s is not None)
{v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : v_2[i] > 0 ∨ v_2[i] = -1
>>
Rule 14 (input tensor dtype should not be Half (np.float16).)
{v_1 : tensor} |= dtype_(v_1) ≠ 6
>>
Rule 16 (Dimensions specified in dim should be within valid range, using addition to avoid parse error)
{v_1 : tensor, v_3 : tuple(int)} |= ∀i ∈ [0, v_3.len - 1] : v_3[i] ≥ (0 - ndim(v_1)) ∧ v_3[i] < ndim(v_1)
>>
Rule 17 (if out is specified, its dtype must be complex)
{v_5 : tensor} |= dtype_(v_5) = 9 ∨ dtype_(v_5) = 10
>>
Rule 18 (If s is not None, then the number of elements in s should be less than or equal to the number of dimensions in input)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len ≤ ndim(v_1)
>>
Rule 19 (If input tensor has double dtype, it should have complex dtype for fftn)
{v_1 : tensor} |= dtype_(v_1) ≠ 8
