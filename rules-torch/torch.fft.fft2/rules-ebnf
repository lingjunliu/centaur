Rule 5 (dimensions in dim tuple must be unique)
{v_3 : tuple(int)} |= ∀i ∈ [0, v_3.len - 1] : ∀j ∈ [i + 1, v_3.len - 1] : v_3[i] ≠ v_3[j]
