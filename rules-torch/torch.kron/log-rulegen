<TUPLEVAR> ::= same format as PRIMVAR

<VAR> ::= same format as PRIMVAR
<NUMBER> ::= any integer or decimal number (e.g., -5, 0.3, +7)
<STRING> ::= any quoted string (e.g., "hello", 'world')

