<binding_list> ::= <binding> ("," <binding>)*
<binding> ::= <VAR> ":" <type>

<type> ::= "tensor"
         | "int"
         | "float"
         | "bool"
         | "dtype"
         | "str"
         | "list" "(" <type> ")"
         | "tuple" "(" <type> ")"
