{v_1 : tensor, v_2 : list(int)} |= ∀i ∈ [0, v_2.len - 1] : 0 ≤ v_2[i] ∧ v_2[i] < ndim(v_1)

Rule 30 (list of bools for masking or selection)
{v_1 : tensor, v_2 : list(bool)} |= v_2.len = shape(v_1, 0)

