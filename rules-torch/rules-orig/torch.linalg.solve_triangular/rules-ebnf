Rule 1 (A and B must have the same number of dimensions, and at least 2)
{a : tensor, b : tensor} |= ndim(a) = ndim(b) ∧ ndim(a) ≥ 2
>>
Rule 2 (The last two dimensions of A must be square (n x n or k x k))
{a : tensor, left : bool} |= if left then shape(a, ndim(a) - 1) = shape(a, ndim(a) - 2) else shape(a, ndim(a) - 1) = shape(a, ndim(a) - 2)
>>
Rule 3 (The first dimension of B must be equal to the first dimension of A when left is True)
{a : tensor, b : tensor, left : bool} |= if left then shape(a, ndim(a) - 2) = shape(b, ndim(b) - 2) else shape(a, ndim(a) - 1) = shape(b, ndim(b) - 1)
>>
Rule 4 (A must be a tensor)
{a : tensor} |= ndim(a) ≥ 0
>>
Rule 5 (B must be a tensor)
{b : tensor} |= ndim(b) ≥ 0
>>
Rule 6 (upper must be a boolean)
{upper : bool} |= upper = true ∨ upper = false
>>
Rule 7 (unitriangular must be a boolean)
{unitriangular : bool} |= unitriangular = true ∨ unitriangular = false
>>
Rule 8 (left must be a boolean)
{left : bool} |= left = true ∨ left = false
>>
Rule 9 (A's datatype must be one of the supported types: float32, float64, complex64, complex128)
{a : tensor} |= dtype_(a) = 8 ∨ dtype_(a) = 9 ∨ dtype_(a) = 10 ∨ dtype_(a) = 7
>>
Rule 10 (B's datatype must be one of the supported types: float32, float64, complex64, complex128)
{b : tensor} |= dtype_(b) = 8 ∨ dtype_(b) = 9 ∨ dtype_(b) = 10 ∨ dtype_(b) = 7
>>
Rule 11 (If A is batched, B must also be batched with same batch dimensions)
{a : tensor, b : tensor} |= if ndim(a) > 2 then (∀i ∈ [0, ndim(a) - 2] : shape(a, i) = shape(b, i))
