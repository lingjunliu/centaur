{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then (dtype_(v_2) = 9 ∨ dtype_(v_2) = 10) ∧ (dtype_(v_3) = 9 ∨ dtype_(v_3) = 10)
