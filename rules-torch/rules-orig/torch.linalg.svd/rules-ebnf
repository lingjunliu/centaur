{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if dtype_(v_1) = 7 then dtype_(v_2) = 7 ∧ dtype_(v_3) = 7 else if dtype_(v_1) = 8 then dtype_(v_2) = 8 ∧ dtype_(v_3) = 8 else if dtype_(v_1) = 9 then dtype_(v_2) = 9 ∧ dtype_(v_3) = 9 else if dtype_(v_1) = 10 then dtype_(v_2) = 10 ∧ dtype_(v_3) = 10
