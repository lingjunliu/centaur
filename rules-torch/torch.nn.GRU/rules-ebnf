Rule 1 (dropout should be within the range [0, 1])
{dropout : float} |= dropout ≥ 0 ∧ dropout ≤ 1
>>
Rule 2 (num_layers should be a positive integer)
{num_layers : int} |= num_layers > 0
>>
Rule 3 (hidden_size should be a positive integer)
{hidden_size : int} |= hidden_size > 0
>>
Rule 4 (input_size should be a positive integer)
{input_size : int} |= input_size > 0
>>
Rule 5 (dtype must be a floating-point type or None represented by -1)
{dtype : int} |= dtype = -1 ∨ dtype = 6 ∨ dtype = 7 ∨ dtype = 8
>>
Rule 6 (if batch_first is true, the input tensor must have 3 dimensions)
{batch_first : bool, input : tensor} |= if batch_first then ndim(input) = 3
>>
Rule 7 (If bidirectional is True, h_0's first dimension must be twice num_layers.)
{bidirectional : bool, num_layers : int, h_0 : tensor} |= if bidirectional then shape(h_0, 0) = 2 * num_layers else shape(h_0, 0) = num_layers
>>
Rule 8 (h_0 must have at least 2 dimensions)
{h_0: tensor} |= ndim(h_0) ≥ 2
>>
Rule 9 (input must have at least 2 dimensions)
{input: tensor} |= ndim(input) ≥ 2
>>
Rule 11 (If batch_first is false, the input tensor's first dimension is the sequence length.  Otherwise the second dimension is the sequence length.)
{batch_first : bool, input : tensor} |= if batch_first then shape(input, 1) > 0 else shape(input, 0) > 0
>>
Rule 12 (If bidirectional is true, the input size of h_0 should match hidden_size. Otherwise, the input size should also match hidden_size)
{bidirectional : bool, hidden_size : int, h_0 : tensor} |= if bidirectional then shape(h_0, ndim(h_0) -1) = hidden_size else shape(h_0, ndim(h_0) - 1) = hidden_size
>>
Rule 14 (If batch_first is true, the last dimension of input must match input_size)
{batch_first : bool, input : tensor, input_size : int} |= if batch_first then shape(input, ndim(input) - 1) = input_size
>>
Rule 16 (If batch_first is false, the last dimension of input must match input_size. Otherwise it must match hidden_size if h_0 exists)
{batch_first : bool, input : tensor, input_size : int, h_0:tensor, hidden_size:int} |= if batch_first then shape(input, ndim(input) - 1) = input_size else shape(h_0, ndim(h_0)-1)=hidden_size
>>
Rule 18 (If bias is false then certain weight attributes should not exist, but we cannot represent that)
{bias : bool} |= if bias then true
