    >>> A = A @ A.mH + torch.eye(2) * 1e-3 # Batch of Hermitian positive-definite matrices
    >>> L = torch.linalg.cholesky(A)
    >>> B = torch.randn(2, 1, dtype=torch.complex64)
    >>> X = torch.cholesky_solve(B, L)
    >>> torch.dist(X, A.inverse() @ B)
    tensor(1.6881e-5)

