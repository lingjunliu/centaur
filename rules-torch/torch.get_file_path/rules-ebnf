>>
Rule 7 (url should not contain spaces)
{v_1 : str} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≠ " "
>>
Rule 8 (url should have a top-level domain)
{v_1 : str} |= ∃i ∈ [8, v_1.len - 1] : v_1[i] = "." ∧ i < v_1.len -1 ∧ ((v_1[0] = "h" ∧ v_1[1] = "t" ∧ v_1[2] = "t" ∧ v_1[3] = "p" ∧ v_1[4] = ":" ∧ v_1[5] = "/" ∧ v_1[6] = "/") ∨ (v_1[0] = "h" ∧ v_1[1] = "t" ∧ v_1[2] = "t" ∧ v_1[3] = "p" ∧ v_1[4] = "s" ∧ v_1[5] = ":" ∧ v_1[6] = "/" ∧ v_1[7] = "/"))
>>
Rule 9 (url length should be within reasonable limits)
{v_1 : str} |= v_1.len < 2048
>>
Rule 10 (url should contain only valid characters)
{v_1 : str} |= ∀i ∈ [0, v_1.len - 1] : (v_1[i] ≥ "a" ∧ v_1[i] ≤ "z") ∨ (v_1[i] ≥ "A" ∧ v_1[i] ≤ "Z") ∨ (v_1[i] ≥ "0" ∧ v_1[i] ≤ "9") ∨ v_1[i] = ":" ∨ v_1[i] = "/" ∨ v_1[i] = "." ∨ v_1[i] = "-" ∨ v_1[i] = "_" ∨ v_1[i] = "~" ∨ v_1[i] = "%" ∨ v_1[i] = "+" ∨ v_1[i] = "&" ∨ v_1[i] = "=" ∨ v_1[i] = "?" ∨ v_1[i] = "#"
>>
Rule 11 (url should be an ASCII string)
{v_1 : str} |= ∀i ∈ [0, v_1.len - 1] : (v_1[i] >=" " ∧ v_1[i] <= "~")
>>
Rule 15 (url should not contain consecutive forward slashes after the protocol)
{v_1 : str} |=  (v_1[0] = "h" ∧ v_1[1] = "t" ∧ v_1[2] = "t" ∧ v_1[3] = "p" ∧ v_1[4] = ":" ∧ v_1[5] = "/" ∧ v_1[6] = "/" ∧ v_1[7] = "/") ∨ (v_1[0] = "h" ∧ v_1[1] = "t" ∧ v_1[2] = "t" ∧ v_1[3] = "p" ∧ v_1[4] = "s" ∧ v_1[5] = ":" ∧ v_1[6] = "/" ∧ v_1[7] = "/" ∧ v_1[8] = "/")
>>
Rule 19 (url should not contain consecutive forward slashes after the protocol)
{v_1 : str} |=  ((v_1[0] = "h" ∧ v_1[1] = "t" ∧ v_1[2] = "t" ∧ v_1[3] = "p" ∧ v_1[4] = ":" ∧ v_1[5] = "/" ∧ v_1[6] = "/" ∧ v_1[7] = "/") = false) ∧ ((v_1[0] = "h" ∧ v_1[1] = "t" ∧ v_1[2] = "t" ∧ v_1[3] = "p" ∧ v_1[4] = "s" ∧ v_1[5] = ":" ∧ v_1[6] = "/" ∧ v_1[7] = "/" ∧ v_1[8] = "/") = false)
>>
Rule 21 (url should not contain consecutive forward slashes after the protocol)
{v_1 : str} |= (v_1[0] = "h" ∧ v_1[1] = "t" ∧ v_1[2] = "t" ∧ v_1[3] = "p" ∧ v_1[4] = ":" ∧ v_1[5] = "/" ∧ v_1[6] = "/" ∧ v_1[7] = "/") = false ∧ (v_1[0] = "h" ∧ v_1[1] = "t" ∧ v_1[2] = "t" ∧ v_1[3] = "p" ∧ v_1[4] = "s" ∧ v_1[5] = ":" ∧ v_1[6] = "/" ∧ v_1[7] = "/" ∧ v_1[8] = "/") = false
>>
Rule 22 (url should contain a valid path after the domain name)
{v_1 : str} |= ∃i ∈ [8, v_1.len - 1] : v_1[i] = "/" ∧ ((v_1[0] = "h" ∧ v_1[1] = "t" ∧ v_1[2] = "t" ∧ v_1[3] = "p" ∧ v_1[4] = ":" ∧ v_1[5] = "/" ∧ v_1[6] = "/") ∨ (v_1[0] = "h" ∧ v_1[1] = "t" ∧ v_1[2] = "t" ∧ v_1[3] = "p" ∧ v_1[4] = "s" ∧ v_1[5] = ":" ∧ v_1[6] = "/" ∧ v_1[7] = "/"))
>>
Rule 23 (url should contain a filename at the end)
{v_1 : str} |= ∃i ∈ [8, v_1.len - 1] : v_1[i] = "/" ∧ ∃j ∈ [i, v_1.len -1]: v_1[j] = "." ∧ ((v_1[0] = "h" ∧ v_1[1] = "t" ∧ v_1[2] = "t" ∧ v_1[3] = "p" ∧ v_1[4] = ":" ∧ v_1[5] = "/" ∧ v_1[6] = "/") ∨ (v_1[0] = "h" ∧ v_1[1] = "t" ∧ v_1[2] = "t" ∧ v_1[3] = "p" ∧ v_1[4] = "s" ∧ v_1[5] = ":" ∧ v_1[6] = "/" ∧ v_1[7] = "/"))
>>
Rule 24 (url should end with a valid file extension)
{v_1 : str} |= (v_1.len > 4) ∧ ((v_1[v_1.len - 4] = "." ∧ (v_1[v_1.len - 3] = "p" ∧ v_1[v_1.len - 2] = "t" ∧ v_1[v_1.len - 1] = "h")) ∨ (v_1[v_1.len - 4] = "." ∧ (v_1[v_1.len - 3] = "c" ∧ v_1[v_1.len - 2] = "p" ∧ v_1[v_1.len - 1] = "t")) ∨ (v_1[v_1.len - 4] = "." ∧ (v_1[v_1.len - 3] = "t" ∧ v_1[v_1.len - 2] = "x" ∧ v_1[v_1.len - 1] = "t")) ∨ (v_1[v_1.len - 4] = "." ∧ (v_1[v_1.len - 3] = "m" ∧ v_1[v_1.len - 2] = "d" ∧ v_1[v_1.len - 1] = "l")))
>>
