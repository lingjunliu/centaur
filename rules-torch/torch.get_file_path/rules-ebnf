{v_1 : str} |= (v_1[0] ≠ "/" ∧ v_1[1] ≠ "/")
>>
Rule 28 (url should not consist only of the protocol)
{v_1 : str} |= (v_1 = "http://" ∨ v_1 = "https://") = false
>>
Rule 29 (url must have at least one character after the top-level domain)
{v_1 : str} |= ∃i ∈ [8, v_1.len - 1] : v_1[i] = "." ∧ i < v_1.len -1 ∧ ((v_1[0] = "h" ∧ v_1[1] = "t" ∧ v_1[2] = "t" ∧ v_1[3] = "p" ∧ v_1[4] = ":" ∧ v_1[5] = "/" ∧ v_1[6] = "/") ∨ (v_1[0] = "h" ∧ v_1[1] = "t" ∧ v_1[2] = "t" ∧ v_1[3] = "p" ∧ v_1[4] = "s" ∧ v_1[5] = ":" ∧ v_1[6] = "/" ∧ v_1[7] = "/")) ∧ v_1.len > i + 1
