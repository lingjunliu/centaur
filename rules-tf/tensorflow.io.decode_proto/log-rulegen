  ...    "simple_value: 2.2",
  ...    "simple_value: 1.2",
  ...    "image { height: 128 width: 512 }",
  ...    "image { height: 256 width: 256 }",]
  >>> values = [
  ...    text_format.Parse(v, tf.compat.v1.Summary.Value()).SerializeToString()
  ...    for v in values]

