Rule 1 (input tensor must be 4-dimensional)
{input : tensor} |= ndim(input) = 4
>>
Rule 2 (paddings tensor must be of type int32, represented by the index 3)
{paddings : tensor} |= dtype_(paddings) = 3
>>
Rule 3 (paddings tensor must be a two-column matrix, meaning its last dimension should be 2)
{paddings : tensor} |= shape(paddings, 1) = 2
>>
Rule 4 (the number of rows in paddings must be the same as the rank of the input tensor)
{input : tensor, paddings : tensor} |= shape(paddings, 0) = ndim(input)
>>
Rule 5 (filter tensor must be 4-dimensional)
{filter : tensor} |= ndim(filter) = 4
>>
Rule 6 (input and filter tensors must have the same dtype)
{input : tensor, filter : tensor} |= dtype_(input) = dtype_(filter)
>>
Rule 7 (mode string must be either "REFLECT" or "SYMMETRIC")
{mode : str} |= mode = "REFLECT" ∨ mode = "SYMMETRIC"
>>
Rule 8 (padding string must be either "SAME" or "VALID")
{padding : str} |= padding = "SAME" ∨ padding = "VALID"
>>
Rule 9 (strides list must have length 4)
{strides : list(int)} |= strides.len = 4
>>
Rule 11 (strides must be greater than zero)
{strides : list(int)} |= ∀ i ∈ [0, strides.len - 1] : strides[i] > 0
>>
Rule 21 (batch size dimension of input must be greater than zero)
{input : tensor} |= shape(input, 0) > 0
>>
Rule 23 (input tensor's last dimension must match filter tensor's third dimension)
{input : tensor, filter : tensor} |= shape(input, 3) = shape(filter, 2)
>>
Rule 24 (filter height and width must be greater than 0)
{filter : tensor} |= shape(filter, 0) > 0 ∧ shape(filter, 1) > 0
>>
Rule 26 (if padding is "SAME", input height and width must be greater than 0)
{input : tensor, padding : str} |= if padding = "SAME" then shape(input, 1) > 0 ∧ shape(input, 2) > 0
>>
Rule 44 (if padding is "SAME", input height and width must be greater than 0)
{input : tensor, padding : str} |= if padding = "SAME" then (shape(input, 1) > 0 ∧ shape(input, 2) > 0)
