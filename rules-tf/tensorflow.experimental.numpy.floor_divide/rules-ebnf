>>
Rule 1 (inputs should be tensors)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0
>>
Rule 3 (Type of inputs tensors should be the same)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 6 (divisor tensor element should not be zero)
{v_1 : tensor} |= ∀i ∈ [0, shape(v_1,0) -1] : v_1[i] ≠ 0
>>
Rule 7 (scalar integer cannot be zero)
{v_1 : int} |= v_1 ≠ 0
>>
Rule 11 (at least one element of the divisor tensor should be nonzero)
{v_1 : tensor} |= ∃i ∈ [0, shape(v_1, 0) - 1] : v_1[i] ≠ 0
>>
Rule 12 (if one input is float, the other should also be float or int)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 then dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 1 ∨ dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 ∨ dtype_(v_2) = 5
>>
Rule 13 (The shapes of the tensors should be compatible for floor_divide)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = ndim(v_2)) ∨ (ndim(v_1) = 0) ∨ (ndim(v_2) = 0)
>>
Rule 14 (if the dividend is an integer tensor, the divisor must not contain zero)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 then ∀i ∈ [0, shape(v_2, 0) - 1] : v_2[i] ≠ 0
>>
Rule 16 (scalar divisor cannot be zero)
{v_1 : int ⊎ float} |= v_1 ≠ 0
>>
Rule 17 (element type should not be boolean)
{v_1: tensor} |= dtype_(v_1) ≠ 0
>>
Rule 18 (if one input is complex, the other should also be complex)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then dtype_(v_2) = 9 ∨ dtype_(v_2) = 10
>>
Rule 19 (input tensors must have compatible shapes)
{v_1 : tensor, v_2 : tensor} |= ∃i ∈ [0, if ndim(v_1) > ndim(v_2) then ndim(v_1) else ndim(v_2)] : (i < ndim(v_1) ∧ i < ndim(v_2) ∧ shape(v_1, i) = shape(v_2, i)) ∨ (i >= ndim(v_1)) ∨ (i >= ndim(v_2))
>>
Rule 20 (if the dividend has only one element, the divisor cannot be zero)
{v_1 : tensor, v_2 : tensor} |= if shape(v_1, 0) = 1 then ∀i ∈ [0, shape(v_2, 0) - 1] : v_2[i] ≠ 0
>>
Rule 21 (both tensors should have same dimension if the other is not scalar)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then ndim(v_1) = ndim(v_2)
>>
Rule 22 (The input tensors must have at least one element)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) > 0 ∧ shape(v_2, 0) > 0
>>
Rule 23 (if one input is complex, the other one must be complex to)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 9) ∨ (dtype_(v_1) = 10) then (dtype_(v_2) = 9) ∨ (dtype_(v_2) = 10)
>>
Rule 24 (if one of input is bool the other should not be complex.)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 0) then (dtype_(v_2) ≠ 9) ∧ (dtype_(v_2) ≠ 10) else if (dtype_(v_2) = 0) then (dtype_(v_1) ≠ 9) ∧ (dtype_(v_1) ≠ 10)
>>
Rule 25 (if the divisor has more than one element, none should be zero)
{v_1 : tensor} |= if shape(v_1, 0) > 1 then ∀i ∈ [0, shape(v_1, 0) - 1] : v_1[i] ≠ 0
>>
Rule 26 (if one input is boolean, the other cannot be complex)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 0 ∧ (dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10)) ∨ (dtype_(v_2) = 0 ∧ (dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10)) ∨ (dtype_(v_1) ≠ 0 ∧ dtype_(v_2) ≠ 0)
>>
Rule 27 (If divisor tensor is empty all values in dividend tensor must be zero)
{v_1 : tensor, v_2 : tensor} |= if shape(v_2, 0) = 0 then ∀i ∈ [0, shape(v_1, 0) - 1] : v_1[i] = 0
>>
Rule 28 (if dividend tensor is empty all values in divisor tensor must be zero)
{v_1 : tensor, v_2 : tensor} |= if shape(v_1, 0) = 0 then ∀i ∈ [0, shape(v_2, 0) - 1] : v_2[i] = 0
>>
Rule 29 (if the divisor is boolean, the dividend cannot be complex)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_2) = 0 then dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 30 (If the tensors are 0 dimensional, then the divisor can't be 0)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 ∧ ndim(v_2) = 0 then v_2 ≠ 0
>>
Rule 31 (Either both tensors are int or both tensors are float if both are not complex)
{v_1 : tensor, v_2 : tensor} |= if ((dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5) ∧ (dtype_(v_2) = 1 ∨ dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 ∨ dtype_(v_2) = 5)) ∨ ((dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)) then true else if (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10) then true else false
>>
Rule 32 (if the dividend is boolean, the divisor cannot be complex)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 0 then dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10
>>
Rule 33 (if one tensor's first dimension is greater than 1, no elements in the second tensor can be 0)
{v_1 : tensor, v_2 : tensor} |= if shape(v_1, 0) > 1 then ∀i ∈ [0, shape(v_2, 0) - 1] : v_2[i] ≠ 0
>>
Rule 34 (if the divisor has only one element and is zero, all elements in the dividend must be zero)
{v_1 : tensor, v_2 : tensor} |= if shape(v_2, 0) = 1 ∧ v_2[0] = 0 then ∀i ∈ [0, shape(v_1, 0) - 1] : v_1[i] = 0
>>
Rule 35 (If both are tensors, one of them must be float)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∨ (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)
>>
Rule 36 (The divisor tensor's shape[0] should not be greater than dividend's tensor shape[0].)
{v_1 : tensor, v_2 : tensor} |= shape(v_2, 0) ≤ shape(v_1, 0)
>>
Rule 37 (if one input is str, floor_divide is not feasible)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) ≠ 11) ∧ (dtype_(v_2) ≠ 11)
>>
Rule 38 (if one input is dtype, floor_divide is not feasible)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) ≠ 12) ∧ (dtype_(v_2) ≠ 12)
>>
Rule 39 (if both shapes are 0 and divisor is zero return 0)
{v_1 : tensor, v_2 : tensor} |= if (shape(v_1, 0) = 0) ∧ (shape(v_2, 0) = 0) then v_2 ≠ 0
>>
Rule 40 (if either of the tensor is complex, it must be of type complex128)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 then dtype_(v_1) = 10 else if dtype_(v_2) = 9 then dtype_(v_2) = 10
>>
Rule 41 (if the divisor is a scalar zero, all elements in dividend tensor must be scalar zero)
{v_1 : tensor, v_2 : float ⊎ int} |= if v_2 = 0 then ∀i ∈ [0, shape(v_1, 0) - 1] : v_1[i] = 0
>>
Rule 42 (if both input is boolean then output should be also boolean)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 0) ∧ (dtype_(v_2) = 0) then true else if ((dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) ∧ (dtype_(v_2) = 1 ∨ dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 ∨ dtype_(v_2) = 5 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)) then true else false
>>
Rule 43 (No dimension can be a string)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≠ "none" ∧ shape(v_1, i) ≠ "ii" ∧ shape(v_1, i) ≠ "ii->i" ∧ shape(v_1, i) ≠ "i,j->ij" ∧ shape(v_1, i) ≠ "bij,bjk->bik" ∧ shape(v_1, i) ≠ "...ij->...ji" ∧ shape(v_1, i) ≠ "bn,anm,bm->ba"
