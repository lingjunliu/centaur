>>
Rule 1 (indices tensor should be 2-dimensional)
{indices : tensor} |= ndim(indices) = 2
>>
Rule 2 (dense_shape tensor should be 1-dimensional)
{dense_shape : tensor} |= ndim(dense_shape) = 1
>>
Rule 3 (length of dense_shape should be equal to the rank of indices)
{indices : tensor, dense_shape : tensor} |= ndim(indices) = dense_shape.len
>>
Rule 4 (the default value's type should be the same as the values' type)
{values : tensor, default_value : tensor} |= dtype_(values) = dtype_(default_value)
>>
Rule 5 (the first dimension of indices must be less than or equal to the first element of dense_shape)
{indices : tensor, dense_shape : tensor} |= shape(indices, 0) ≤ shape(dense_shape, 0)
>>
Rule 6 (all values in dense_shape must be greater than or equal to 0)
{dense_shape : tensor} |= ∀i ∈ [0, dense_shape.len - 1] : shape(dense_shape, i) ≥ 0
>>
Rule 7 (all values in indices must be greater than or equal to 0)
{indices : tensor} |= ∀i ∈ [0, indices.len - 1] : indices[i] ≥ 0
>>
Rule 8 (shape of values must be equal to the first dimension of the indices)
{indices : tensor, values : tensor} |= shape(indices, 0) = shape(values, 0)
>>
Rule 9 (the indices tensor must have int64 as its dtype)
{indices : tensor} |= dtype_(indices) = 4
>>
Rule 10 (the dense_shape tensor must have int64 as its dtype)
{dense_shape : tensor} |= dtype_(dense_shape) = 4
>>
Rule 11 (values tensor should not be empty)
{values : tensor} |= ∀i ∈ [0, ndim(values) - 1] : shape(values, i) > 0
>>
Rule 12 (indices and dense_shape must have compatible shapes)
{indices : tensor, dense_shape : tensor} |= shape(indices, 1) = shape(dense_shape, 0)
>>
Rule 13 (default_value must be a scalar)
{default_value : tensor} |= ndim(default_value) = 0
>>
Rule 23 (values tensor is not empty implies indices and dense_shape are also not empty)
{indices : tensor, values : tensor, dense_shape : tensor} |= if shape(values, 0) > 0 then shape(indices,0) > 0 ∧ shape(dense_shape,0) > 0
