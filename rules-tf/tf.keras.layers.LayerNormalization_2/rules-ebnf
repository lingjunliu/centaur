>>
Rule 1 (inputs tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 2 (epsilon must be a positive float)
{v_1 : float} |= v_1 > 0
>>
Rule 3 (axis indices must be valid dimension indices of inputs)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : (v_2[i] ≥ 0 ∧ v_2[i] < ndim(v_1))
>>
Rule 4 (axis tuple length must be between 1 and the dimension of inputs)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len ≥ 1 ∧ v_2.len ≤ ndim(v_1)
>>
Rule 5 (center must be false if rms_scaling is true)
{v_1 : bool, v_2 : bool} |= if v_1 = true then v_2 = false
>>
Rule 6 (input tensor must have a floating point data type)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 7 (epsilon must be positive and less than 1.0)
{v_1 : float} |= v_1 > 0 ∧ v_1 < 1
>>
Rule 9 (all shape dimensions of the input tensor must be positive)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 13 (epsilon must be a small positive value)
{v_1 : float} |= v_1 > 0 ∧ v_1 ≤ 0.1
>>
Rule 14 (the input tensor must have a rank between 2 and 5)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ ndim(v_1) ≤ 5
>>
Rule 15 (dimensions being normalized must have a size greater than 1)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : (v_2[i] ≥ 0 ∧ shape(v_1, v_2[i]) > 1)
>>
Rule 16 (if center is disabled, then beta_regularizer must be none)
{v_1 : bool, v_2 : str} |= if v_1 = false then v_2 = "none"
