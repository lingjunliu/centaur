{x : tensor, y : tensor} |= (dtype_(x) = 7 ∨ dtype_(x) = 8 ∨ dtype_(x) = 3 ∨ dtype_(x) = 6 ∨ dtype_(x) = 2 ∨ dtype_(x) = 1 ∨ dtype_(x) = 4) ∧ (dtype_(y) = 7 ∨ dtype_(y) = 8 ∨ dtype_(y) = 3 ∨ dtype_(y) = 6 ∨ dtype_(y) = 2 ∨ dtype_(y) = 1 ∨ dtype_(y) = 4) ∧ (dtype_(x) = dtype_(y))
