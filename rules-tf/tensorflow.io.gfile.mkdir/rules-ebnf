>>
Rule 2 (path cannot be an empty string)
{v_1 : str} |= v_1 ≠ ""
>>
Rule 4 (path is not None)
{v_1 : str} |= v_1 ≠ "none"
>>
Rule 5 (path cannot contain invalid characters)
{v_1 : str} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≠ ":" ∧ v_1[i] ≠ "*" ∧ v_1[i] ≠ "?" ∧ v_1[i] ≠ "<" ∧ v_1[i] ≠ ">" ∧ v_1[i] ≠ "|"
>>
Rule 6 (path length is within reasonable bounds)
{v_1 : str} |= 1 ≤ v_1.len ∧ v_1.len ≤ 255
>>
Rule 7 (path should not start with a space.)
{v_1 : str} |= if v_1.len > 0 then v_1[0] ≠ " "
>>
Rule 8 (Path contains only valid characters)
{v_1 : str} |= ∀i ∈ [0, v_1.len - 1] : (v_1[i] ≥ "a" ∧ v_1[i] ≤ "z") ∨ (v_1[i] ≥ "A" ∧ v_1[i] ≤ "Z") ∨ (v_1[i] ≥ "0" ∧ v_1[i] ≤ "9") ∨ v_1[i] = "/" ∨ v_1[i] = "_" ∨ v_1[i] = "-" ∨ v_1[i] = "."
>>
Rule 9 (Path does not contain consecutive slashes)
{v_1 : str} |= ∀i ∈ [0, v_1.len - 2] : v_1[i] ≠ "/" ∨ v_1[i+1] ≠ "/"
>>
Rule 10 (Path is an absolute path if it starts with a slash)
{v_1 : str} |= if v_1.len > 0 then if v_1[0] = "/" then true
>>
Rule 11 (If the path ends with a slash, it must not be only a slash)
{v_1 : str} |= if v_1.len > 0 ∧ v_1[v_1.len - 1] = "/" then v_1.len > 1
>>
Rule 12 (path is not just current directory)
{v_1 : str} |= v_1 ≠ "."
>>
Rule 13 (path is not just parent directory)
{v_1 : str} |= v_1 ≠ ".."
>>
Rule 14 (path is not a reserved name such as 'CON', 'PRN', 'AUX', 'NUL', 'COM1', 'COM2', 'COM3', 'COM4', 'LPT1', 'LPT2', 'LPT3', 'CLOCK$', 'CONFIG$')
{v_1 : str} |= v_1 ≠ "CON" ∧ v_1 ≠ "PRN" ∧ v_1 ≠ "AUX" ∧ v_1 ≠ "NUL" ∧ v_1 ≠ "COM1" ∧ v_1 ≠ "COM2" ∧ v_1 ≠ "COM3" ∧ v_1 ≠ "COM4" ∧ v_1 ≠ "LPT1" ∧ v_1 ≠ "LPT2" ∧ v_1 ≠ "LPT3" ∧ v_1 ≠ "CLOCK$" ∧ v_1 ≠ "CONFIG$"
>>
Rule 15 (path does not contain control characters (ASCII 0-31))
{v_1 : str} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] < " "
>>
Rule 16 (path cannot be a Windows drive letter)
{v_1 : str} |= if v_1.len = 2 then (v_1[1] ≠ ":") ∨ (v_1[0] < "A" ∨ v_1[0] > "Z")
>>
Rule 17 (If the path contains a backslash, it's replaced with forward slash)
{v_1 : str} |= if ∃i ∈ [0, v_1.len-1] : v_1[i] = "\\" then true
>>
Rule 18 (If the path contains a backslash, the count of backslashes is equal to count of forward slashes)
{v_1 : str} |= if ∃i ∈ [0, v_1.len - 1] : v_1[i] = "\\" then (∃i ∈ [0, v_1.len - 1] : v_1[i] = "/")
>>
Rule 19 (The path cannot be longer than MAX_PATH)
{v_1 : str} |= v_1.len ≤ 260
