{input_indices: tensor, input_shape: tensor} |= shape(input_shape, 0) > 0 ∧ shape(input_indices, 0) > 0 ∧ shape(input_indices, 1) > 0 ∧ min(input_indices) >= 0 ∧ max(input_indices) < max(input_shape)
