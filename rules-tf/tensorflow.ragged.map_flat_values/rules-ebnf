Rule 1 (Input RaggedTensors must have identical nested_row_splits. Assuming this implies same ragged_rank for two tensors.)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 2 (The operation op should preserve the size of the outermost dimension after application.)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) = shape(v_2, 0)
>>
Rule 3 (The input tensors should have at least one dimension.)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 4 (Shape along a dimension should be non-negative)
{v_1 : tensor, v_2 : int} |= v_2 ≥ 0 ∧ v_2 < ndim(v_1) ∧ shape(v_1, v_2) ≥ 0
>>
Rule 5 (Check for boolean tensor elements)
{v_1 : tensor} |= dtype_(v_1) = 0 ∨ dtype_(v_1) ≠ 0
>>
Rule 6 (Check that a given dimension has the desired size.)
{v_1 : tensor, v_2 : int, v_3 : int} |= v_2 ≥ 0 ∧ v_2 < ndim(v_1) ∧ shape(v_1, v_2) = v_3
>>
Rule 7 (The maximum of elements in a tensor should be larger than the minimum)
{v_1 : tensor} |= max(v_1) ≥ min(v_1)
>>
Rule 8 (Check type of element in tensor)
{v_1 : tensor} |= dtype_(v_1) ≠ 12
>>
Rule 10 (Check that type is within a certain range)
{v_1 : dtype} |= v_1 ≥ 0 ∧ v_1 ≤ 12
>>
Rule 11 (Minimum and Maximum of a tensor must exist)
{v_1 : tensor} |= ∃i ∈ [0, shape(v_1, 0) -1] : true ∧ ∃j ∈ [0, shape(v_1, 0) -1] : true
>>
Rule 12 (String length should be positive.)
{v_1 : str} |= v_1.len > 0
>>
Rule 13 (Check tensor type)
{v_1:tensor} |= dtype_(v_1) ≠ 13
>>
Rule 27 (Applying a scaling factor to a tensor )
{v_1 : tensor, v_2 : float} |= if v_2 > 1.0 then max(v_1) < max(v_1) * v_2 else max(v_1) > max(v_1) * v_2
>>
Rule 28 (Shape of the output tensor must be the same as input if the function is ones_like)
{v_1 : tensor, v_2 : str} |= if v_2 = "ones_like" then ndim(v_1) = ndim(v_1)
>>
Rule 30 (If op is constant the shape[0] of the output should match the shape[0] of any ragged tensor.)
{v_1: tensor, v_2: str, v_3 : tensor} |= if v_2 = "constant" then shape(v_1, 0) = shape(v_3, 0)
>>
Rule 34 (When op is a reduction function, the output tensor has fewer dimensions)
{v_1: tensor, v_2: str} |= if v_2 = "sum" ∨ v_2 = "mean" ∨ v_2 = "min" ∨ v_2 = "max" ∨ v_2 = "prod" then ndim(v_1) > 0
>>
Rule 36 (If elementwise op, the type of output matches type of input)
{v_1: tensor, v_2: str} |= if v_2 ≠ "sum" ∧ v_2 ≠ "mean" ∧ v_2 ≠ "min" ∧ v_2 ≠ "max" ∧ v_2 ≠ "prod" ∧ v_2 ≠ "constant" then dtype_(v_1) = dtype_(v_1)
>>
