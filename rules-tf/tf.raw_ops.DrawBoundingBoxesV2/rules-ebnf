{images : tensor} |= dtype_(images) = 7 ∨ dtype_(images) = 6
>>
Rule 8 (boxes tensor must be of type float32)
{boxes : tensor} |= dtype_(boxes) = 7
>>
Rule 9 (colors tensor must be of type float32)
{colors : tensor} |= dtype_(colors) = 7
