Rule 1 (input tensor x must be one of the supported dtypes: bfloat16, half, float32, float64, complex64, complex128)
{x : tensor} |= dtype_(x) = 6 ∨ dtype_(x) = 7 ∨ dtype_(x) = 8 ∨ dtype_(x) = 9 ∨ dtype_(x) = 10
>>
Rule 2 (input tensor x must have more than 0 dimensions)
{x : tensor} |= ndim(x) > 0
>>
Rule 4 (input tensor x must not be an integer type)
{x : tensor} |= dtype_(x) ≠ 1 ∧ dtype_(x) ≠ 2 ∧ dtype_(x) ≠ 3 ∧ dtype_(x) ≠ 4 ∧ dtype_(x) ≠ 5
>>
Rule 5 (input tensor x must not be a boolean type)
{x : tensor} |= dtype_(x) ≠ 0
>>
Rule 8 (If the input tensor x is complex, the output tensor has the same dtype as input)
{x : tensor} |= if dtype_(x) = 9 ∨ dtype_(x) = 10 then dtype_(x) = dtype_(x)
>>
Rule 18 (The output tensor should have float or complex dtype)
{x : tensor} |= (dtype_(x) = 6 ∨ dtype_(x) = 7 ∨ dtype_(x) = 8 ∨ dtype_(x) = 9 ∨ dtype_(x) = 10)
>>
Rule 22 (If input x is float, output should be float, if complex, then output should be complex)
{x : tensor} |= ((dtype_(x) = 6 ∨ dtype_(x) = 7 ∨ dtype_(x) = 8) ∧ (dtype_(x) = dtype_(x))) ∨ ((dtype_(x) = 9 ∨ dtype_(x) = 10) ∧ (dtype_(x) = dtype_(x)))
>>
Rule 25 (Input cannot be int8 tensor)
{x : tensor} |= dtype_(x) ≠ 1
>>
Rule 26 (Input cannot be int16 tensor)
{x : tensor} |= dtype_(x) ≠ 2
>>
Rule 27 (Input cannot be int32 tensor)
{x : tensor} |= dtype_(x) ≠ 3
>>
Rule 28 (Input cannot be int64 tensor)
{x : tensor} |= dtype_(x) ≠ 4
>>
Rule 29 (Input cannot be uint8 tensor)
{x : tensor} |= dtype_(x) ≠ 5
>>
Rule 30 (Input must be a scalar)
{x : tensor} |= ndim(x) = 0
