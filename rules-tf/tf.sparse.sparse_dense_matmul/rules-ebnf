Rule 4 (dtype of sp_a and b must be the same)
{sp_a : tensor, b : tensor} |= dtype_(sp_a) = dtype_(b)
>>
Rule 5 (sp_a must be a rank 2 tensor)
{sp_a : tensor} |= ndim(sp_a) = 2
>>
Rule 6 (b must be a rank 2 tensor)
{b : tensor} |= ndim(b) = 2
>>
Rule 8 (adjoint_a must be a boolean)
{adjoint_a : bool} |= adjoint_a = true ∨ adjoint_a = false
>>
Rule 9 (adjoint_b must be a boolean)
{adjoint_b : bool} |= adjoint_b = true ∨ adjoint_b = false
