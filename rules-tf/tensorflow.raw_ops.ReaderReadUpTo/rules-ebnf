{reader_handle: tensor, num_records: tensor} |= if ∃i ∈ [0, reader_handle.len - 1] : if reader_handle.len - i ≥ 8 then reader_handle[i] = "s" ∧ reader_handle[i+1] = "t" ∧ reader_handle[i+2] = "a" ∧ reader_handle[i+3] = "t" ∧ reader_handle[i+4] = "e" ∧ reader_handle[i+5] = "f" ∧ reader_handle[i+6] = "u" ∧ reader_handle[i+7] = "l" else false then max(num_records) < 1048576
