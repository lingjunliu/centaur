  >>> weights = [[2, 0.25, 15, 0.5], [2, 17, 3, 0.9]]
  >>> tf.sparse.bincount(data, weights=weights, axis=-1)
  SparseTensor(indices=tf.Tensor(
  [[    0    10]
   [    0    20]
   [    0    30]
   [    1    11]
   [    1   101]
