Rule 1 (input tensors must have dimensions greater than zero)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0
>>
Rule 2 (axes elements must be within the dimensions of the respective tensors)
{v_1 : tensor, v_2 : tensor, v_3 : list(int)} |= if v_3.len = 2 then v_3[0] ≥ 0 ∧ v_3[0] < ndim(v_1) ∧ v_3[1] ≥ 0 ∧ v_3[1] < ndim(v_2)
>>
Rule 3 (contracting dimensions must match)
{v_1 : tensor, v_2 : tensor, v_3 : list(int)} |= if v_3.len = 2 then shape(v_1, v_3[0]) = shape(v_2, v_3[1])
>>
Rule 4 (input tensors must be at least 1-dimensional)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1
>>
Rule 7 (the two input tensors must have the same data type)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 8 (axes must have a length of 2)
{v_3 : list(int) ⊎ list(list(int))} |= v_3.len = 2
>>
Rule 9 (name of the operation must be a non-empty string)
{v_4 : str} |= v_4 ≠ ""
>>
Rule 12 (all dimensions of the input tensors must be positive)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0)
>>
Rule 13 (axes list must have elements within the range of tensor dimensions)
{v_1 : tensor, v_3 : list(int)} |= ∀i ∈ [0, v_3.len - 1] : v_3[i] ≥ 0 ∧ v_3[i] < ndim(v_1)
>>
Rule 14 (axes must have length 2 if it is a list)
{v_1 : list(int)} |= v_1.len = 2
