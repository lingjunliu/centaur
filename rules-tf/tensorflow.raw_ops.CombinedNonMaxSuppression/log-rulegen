<arith_term> ::= <arith_term> <MULOP> <arith_factor> | <arith_factor>
<arith_factor> ::= <TUPLEVAR> <tuple_access> | <func_call> | <constant> | <PRIMVAR> | "(" <expr> ")"

<tuple_access>  ::= "[" <expr> "]" | ".len"
<func_call> ::= <FUNC> "(" <TENSORVAR> [ "," <expr> ] ")"
