Rule 1 (x and y must have the same type)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (x and y must be at least 2-dimensional)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2
>>
Rule 4 (shape of x and y must be positive)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0
>>
Rule 5 (If adj_x is true, then the last two dimensions of x are swapped in the multiplication.)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 then shape(v_1, ndim(v_1)-1) = shape(v_2, ndim(v_2)-2) else shape(v_1, ndim(v_1)-2) = shape(v_2, ndim(v_2)-2)
>>
Rule 6 (If adj_y is true, then the last two dimensions of y are swapped in the multiplication.)
{v_1 : tensor, v_2 : tensor, v_4 : bool} |= if v_4 then shape(v_1, ndim(v_1)-1) = shape(v_2, ndim(v_2)-2) else shape(v_1, ndim(v_1)-1) = shape(v_2, ndim(v_2)-1)
>>
Rule 7 (Type of x must be within allowed datatypes)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 10 ∨ dtype_(v_1) = 11
>>
Rule 8 (x and y tensors must have same number of batch dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) - 2 = ndim(v_2) - 2
>>
Rule 12 (adj_x and adj_y must be boolean values)
{v_1 : bool, v_2 : bool} |= v_1 = true ∨ v_1 = false ∧ v_2 = true ∨ v_2 = false
>>
Rule 17 (x and y tensors must have same number of batch dimensions if dimensions are greater than 2)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 2 ∧ ndim(v_2) > 2 then ndim(v_1) - 2 = ndim(v_2) - 2
>>
Rule 23 (If both are adjointed, their swapped last dimensions should match each other)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if v_3 ∧ v_4 then shape(v_1, ndim(v_1)-2) = shape(v_2, ndim(v_2)-1)
>>
Rule 24 (If one of the tensors is 1D, it becomes 2D by padding dimensions of size 1 to the left.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∨ ndim(v_2) = 1 then true
>>
Rule 26 (x can be bfloat16, half, float32, float64, int16, int32, int64, uint8, uint16, uint32, uint64, complex64, complex128)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 28 (x's last dimension must match y's second to last dimension if neither are adjointed)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if (v_3 = false) ∧ (v_4 = false) then shape(v_1, ndim(v_1)-1) = shape(v_2, ndim(v_2)-2)
>>
Rule 29 (If x is adjointed, its last two dimensions are swapped, therefore its new last dimension must match y's second to last)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if v_3 ∧ (v_4 = false) then shape(v_1, ndim(v_1)-2) = shape(v_2, ndim(v_2)-2)
>>
Rule 30 (If y is adjointed, its last two dimensions are swapped, therefore x's last dimension must match y's new second to last)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if (v_3 = false) ∧ v_4 then shape(v_1, ndim(v_1)-1) = shape(v_2, ndim(v_2)-1)
>>
Rule 39 (x and y should have same number of dimensions or one of them is scalar)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∨ ndim(v_1) = 0 ∨ ndim(v_2) = 0
>>
Rule 42 (If one of the tensors is 1D, then after expansion the inner dimensions must match)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if ndim(v_1) = 1 ∨ ndim(v_2) = 1 then if (v_3 = false) ∧ (v_4 = false) then shape(v_1, 0) = shape(v_2, ndim(v_2)-2)
>>
Rule 46 (If one of the tensors is 1D, then after expansion the inner dimensions must match)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if ndim(v_1) = 1 ∨ ndim(v_2) = 1 then if (v_3 = false) ∧ (v_4 = false) then if ndim(v_1) = 1 then shape(v_1, 0) = shape(v_2, ndim(v_2)-2) else shape(v_2, 0) = shape(v_1, ndim(v_1)-2)
>>
Rule 48 (Shapes of batch dimensions must match for tensors greater than rank 2)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 2 ∧ ndim(v_2) > 2 then ∀i ∈ [0, ndim(v_1) - 2] : shape(v_1, i) = shape(v_2, i)
>>
Rule 53 (When neither tensor is adjointed, their matrix multiplication dimensions must align)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if (v_3 = false) ∧ (v_4 = false) then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2)
>>
Rule 63 (If x is adjointed, and y is not, the shape must match)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if v_3 ∧ (v_4 = false) then shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 2)
>>
Rule 65 (If y is adjointed and x is not, then the shape must match)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if (v_3 = false) ∧ v_4 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1)
>>
Rule 66 (adj_x is a boolean value)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 71 (Data type of x should be one of allowed datatypes, and y must have the same type)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 ∧ dtype_(v_1) = dtype_(v_2)
>>
Rule 73 (Last two dimensions should not be the same)
{v_1 : tensor} |= shape(v_1, ndim(v_1)-1) ≠ shape(v_1, ndim(v_1) - 2)
