Rule 1 (image must be either a 3-D or 4-D Tensor)
{v_1 : tensor} |= ndim(v_1) = 3 ∨ ndim(v_1) = 4
>>
Rule 3 (central_fraction must be greater than 0)
{v_2 : float} |= v_2 > 0
>>
Rule 4 (central_fraction must be less than or equal to 1)
{v_2 : float} |= v_2 ≤ 1
>>
Rule 5 (image must have a floating-point dtype)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 6 (batch size must be greater than 0 if image is 4D)
{v_1 : tensor} |= if ndim(v_1) = 4 then shape(v_1, 0) > 0
>>
Rule 7 (central_fraction must be within (0, 1])
{v_2 : float} |= v_2 > 0 ∧ v_2 ≤ 1
>>
Rule 9 (if image is 3D, height and width must be positive)
{v_1 : tensor} |= if ndim(v_1) = 3 then shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0
>>
Rule 10 (if image is 4D, height and width must be positive)
{v_1 : tensor} |= if ndim(v_1) = 4 then shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0
>>
Rule 11 (central_fraction influences the output shape)
{v_1 : tensor, v_2 : float} |= if ndim(v_1) = 3 then shape(v_1, 0) * v_2 ≤ shape(v_1, 0) ∧ shape(v_1, 1) * v_2 ≤ shape(v_1, 1) else shape(v_1, 1) * v_2 ≤ shape(v_1, 1) ∧ shape(v_1, 2) * v_2 ≤ shape(v_1, 2)
>>
Rule 13 (central_fraction close to 0 will result in small or empty tensor)
{v_1 : tensor, v_2 : float} |= if v_2 < 0.1 then (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) ∨ min(v_1) < 1
>>
Rule 16 (central_fraction close to 1 will result output close to input tensor's data range)
{v_1 : tensor, v_2 : float} |= if v_2 > 0.9 then min(v_1) ≤ min(v_1) + 1 ∧ max(v_1) ≥ max(v_1) - 1
>>
Rule 17 (central_fraction between 0 and 1)
{v_2 : float} |= 0 < v_2 ∧ v_2 ≤ 1
>>
Rule 18 (output tensor has the same dtype as the input tensor)
{v_1 : tensor} |= dtype_(v_1) = dtype_(v_1)
>>
Rule 21 (Applying central crop to 3D tensor results in a 3D tensor and 4D tensor results in a 4D tensor)
{v_1 : tensor} |= (ndim(v_1) = 3) ∨ (ndim(v_1) = 4)
>>
Rule 22 (If central fraction is close to 1, shape of output is close to input)
{v_1 : tensor, v_2 : float} |= if v_2 > 0.9 then (∀i ∈ [0, ndim(v_1) -1] : shape(v_1, i) > 0)
>>
Rule 25 (If image has shape (H,W,D) and central_fraction is cf, then the depth of output equals input depth. If image has shape (B,H,W,D), the output depth equals input depth)
{v_1 : tensor} |= if ndim(v_1) = 3 then true else if ndim(v_1) = 4 then true
>>
Rule 26 (if cf is small the cropped area is smaller)
{v_1 : tensor, v_2 : float} |= if v_2 < 0.5 then shape(v_1, 0) * v_2 < shape(v_1, 0) ∧ shape(v_1, 1) * v_2 < shape(v_1, 1)
>>
Rule 27 (If image has shape (H,W,D) then H*cf, W*cf >= 1)
{v_1 : tensor, v_2 : float} |= if ndim(v_1) = 3 then shape(v_1, 0) * v_2 ≥ 1 ∧ shape(v_1, 1) * v_2 ≥ 1 else if ndim(v_1) = 4 then shape(v_1, 1) * v_2 ≥ 1 ∧ shape(v_1, 2) * v_2 ≥ 1
>>
Rule 28 (Output tensor rank is same as input)
{v_1 : tensor} |= ndim(v_1) = ndim(v_1)
>>
Rule 31 (The central_fraction should be a float between 0 and 1)
{v_1: float} |= 0 < v_1 ∧ v_1 ≤ 1
>>
Rule 33 (if input is 3D, then output is also 3D and the number of channels remain the same)
{v_1: tensor} |= if ndim(v_1) = 3 then shape(v_1, 2) = shape(v_1, 2)
