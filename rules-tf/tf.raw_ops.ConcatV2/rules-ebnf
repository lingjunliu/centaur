Rule 1 (The list of tensors to concatenate must contain at least 2 tensors)
{v_1 : list(tensor)} |= v_1.len ≥ 2
>>
Rule 2 (Axis tensor must be 0-dimensional and must have type int32 or int64)
{v_1 : tensor} |= ndim(v_1) = 0 ∧ (dtype_(v_1) = 3 ∨ dtype_(v_1) = 4)
>>
Rule 3 (The axis value must be within the range [-rank, rank) of the input tensors)
{v_1 : tensor, v_2 : tensor} |= ndim(v_2) = 0 ∧ min(v_2) ≥ 0 - ndim(v_1) ∧ min(v_2) < ndim(v_1)
>>
Rule 4 (All input tensors must have the same rank)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 5 (All input tensors must have the same data type)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 6 (Input tensors must match in all dimensions except the concatenation dimension)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ndim(v_3) = 0 ∧ (if min(v_3) < 0 then (∀i ∈ [0, ndim(v_1) - 1] : i = min(v_3) + ndim(v_1) ∨ shape(v_1, i) = shape(v_2, i)) else (∀i ∈ [0, ndim(v_1) - 1] : i = min(v_3) ∨ shape(v_1, i) = shape(v_2, i)))
>>
Rule 8 (The axis tensor must be 0-dimensional)
{v_1 : tensor} |= ndim(v_1) = 0
>>
Rule 9 (The axis tensor must have type int32 or int64)
{v_1 : tensor} |= dtype_(v_1) = 3 ∨ dtype_(v_1) = 4
>>
Rule 11 (All input tensors to be concatenated must have matching ranks and data types)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ dtype_(v_1) = dtype_(v_2)
>>
Rule 13 (The input tensors to concatenate must have a rank of at least 1)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 14 (When the axis is a non-negative integer, it must be less than the rank of the input tensor)
{v_1 : tensor, v_2 : int} |= v_2 ≥ 0 ∧ v_2 < ndim(v_1)
>>
Rule 15 (When the axis is a negative integer, its absolute value must not exceed the rank of the input tensor)
{v_1 : tensor, v_2 : int} |= v_2 < 0 ∧ v_2 ≥ 0 - ndim(v_1)
>>
Rule 16 (If the axis is non-negative, the sizes of the tensors must be equal along all dimensions other than the axis)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= ndim(v_1) = ndim(v_2) ∧ v_3 ≥ 0 ∧ v_3 < ndim(v_1) ∧ (∀i ∈ [0, ndim(v_1) - 1] : i = v_3 ∨ shape(v_1, i) = shape(v_2, i))
>>
Rule 17 (If the axis is negative, the sizes of the tensors must be equal along all dimensions other than the resolved non-negative axis)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= ndim(v_1) = ndim(v_2) ∧ v_3 < 0 ∧ v_3 ≥ 0 - ndim(v_1) ∧ (∀i ∈ [0, ndim(v_1) - 1] : i = v_3 + ndim(v_1) ∨ shape(v_1, i) = shape(v_2, i))
