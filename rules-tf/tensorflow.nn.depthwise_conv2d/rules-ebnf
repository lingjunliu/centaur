Rule 1 (input and filter must be 4-dimensional tensors)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 4 ∧ ndim(v_2) = 4
>>
Rule 2 (strides must be a 1-D tensor of size 4)
{v_1 : tensor} |= ndim(v_1) = 1 ∧ shape(v_1, 0) = 4
>>
Rule 3 (strides[0] and strides[3] must be 1)
{v_1 : tensor} |= v_1[0] = 1 ∧ v_1[3] = 1
>>
Rule 4 (dilations must be a 1-D tensor of size 2)
{v_1 : tensor} |= ndim(v_1) = 1 ∧ shape(v_1, 0) = 2
>>
Rule 5 (if any value in dilations is greater than 1, then all strides must be 1)
{v_1 : tensor, v_2 : tensor} |= if v_2[0] > 1 ∨ v_2[1] > 1 then v_1[0] = 1 ∧ v_1[1] = 1 ∧ v_1[2] = 1 ∧ v_1[3] = 1
>>
Rule 8 (data_format must be "NHWC" or "NCHW")
{v_1 : str} |= v_1 = "NHWC" ∨ v_1 = "NCHW"
>>
Rule 9 (channel_multiplier should be greater than 0)
{v_1 : tensor} |= shape(v_1, 3) > 0
>>
Rule 10 (in_channels should be greater than 0)
{v_1 : tensor} |= shape(v_1, 2) > 0
>>
Rule 21 (if padding is a list, its shape should be (4, 2))
{v_1 : list(list(int))} |= shape(v_1, 0) = 4 ∧ (shape(v_1, 1) = 2)
