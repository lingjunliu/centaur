Rule 1 (filters count must be positive)
{v_1 : int} |= v_1 > 0
>>
Rule 2 (kernel size must be a 2-element list with positive integers)
{v_1 : list(int)} |= v_1.len = 2 ∧ (∀i ∈ [0, v_1.len - 1] : v_1[i] > 0)
>>
Rule 5 (padding parameter must be "valid" or "same")
{v_1 : str} |= v_1 = "valid" ∨ v_1 = "same"
>>
Rule 6 (data format parameter must be "channels_last" or "channels_first")
{v_1 : str} |= v_1 = "channels_last" ∨ v_1 = "channels_first"
>>
Rule 8 (inputs tensor must be 4-dimensional)
{v_1 : tensor} |= ndim(v_1) = 4
>>
Rule 9 (dilation rate and strides constraint)
{v_1 : list(int), v_2 : list(int)} |= if (∃i ∈ [0, v_1.len - 1] : v_1[i] > 1) then (∀j ∈ [0, v_2.len - 1] : v_2[j] = 1)
>>
Rule 10 (activation parameter must be a valid activation function name)
{v_1 : str} |= v_1 = "relu" ∨ v_1 = "tanh" ∨ v_1 = "sigmoid" ∨ v_1 = "softmax" ∨ v_1 = "elu" ∨ v_1 = "selu" ∨ v_1 = "gelu" ∨ v_1 = "swish" ∨ v_1 = "softplus" ∨ v_1 = "linear"
>>
Rule 11 (input spatial dimensions must be at least as large as the kernel size)
{v_1 : tensor, v_2 : list(int), v_3 : str} |= ndim(v_1) = 4 ∧ (if v_3 = "channels_last" then shape(v_1, 1) ≥ v_2[0] ∧ shape(v_1, 2) ≥ v_2[1] else shape(v_1, 2) ≥ v_2[0] ∧ shape(v_1, 3) ≥ v_2[1])
>>
Rule 12 (input tensor channel size must be positive)
{v_1 : tensor, v_2 : str} |= ndim(v_1) = 4 ∧ (if v_2 = "channels_last" then shape(v_1, 3) > 0 else shape(v_1, 1) > 0)
>>
Rule 13 (input spatial dimensions must be large enough to accommodate the effective kernel size with dilation)
{v_1 : tensor, v_2 : list(int), v_3 : list(int), v_4 : str} |= ndim(v_1) = 4 ∧ v_2.len = 2 ∧ v_3.len = 2 ∧ (if v_4 = "channels_last" then shape(v_1, 1) ≥ (v_2[0] - 1) * v_3[0] + 1 ∧ shape(v_1, 2) ≥ (v_2[1] - 1) * v_3[1] + 1 else shape(v_1, 2) ≥ (v_2[0] - 1) * v_3[0] + 1 ∧ shape(v_1, 3) ≥ (v_2[1] - 1) * v_3[1] + 1)
>>
Rule 14 (filters and depth_multiplier parameters must be positive integers)
{v_1 : int, v_2 : int} |= v_1 > 0 ∧ v_2 > 0
>>
Rule 15 (strides and kernel_size lists must have a length of 2 and contain positive integers)
{v_1 : list(int), v_2 : list(int)} |= v_1.len = 2 ∧ v_2.len = 2 ∧ (∀i ∈ [0, 1] : v_1[i] > 0 ∧ v_2[i] > 0)
>>
Rule 16 (if any dilation rate is greater than 1, then all strides must be 1)
{v_1 : list(int), v_2 : list(int)} |= v_1.len = 2 ∧ v_2.len = 2 ∧ (if (∃i ∈ [0, 1] : v_1[i] > 1) then (∀j ∈ [0, 1] : v_2[j] = 1))
>>
Rule 17 (padding and data_format must be set to valid supported string choices)
{v_1 : str, v_2 : str} |= (v_1 = "valid" ∨ v_1 = "same") ∧ (v_2 = "channels_last" ∨ v_2 = "channels_first")
>>
Rule 21 (filters and depth_multiplier parameters must be positive integers)
{v_1 : int, v_2 : int} |= v_1 > 0 ∧ v_2 > 0 ∧ v_1 + v_2 ≥ 2
>>
Rule 24 (padding, data_format, and filters must be valid and positive)
{v_1 : str, v_2 : str, v_3 : int} |= (v_1 = "valid" ∨ v_1 = "same") ∧ (v_2 = "channels_last" ∨ v_2 = "channels_first") ∧ v_3 > 0
>>
Rule 25 (activation and depthwise_initializer must be valid non-empty configurations)
{v_1 : str, v_2 : str} |= (v_1 = "relu" ∨ v_1 = "tanh" ∨ v_1 = "sigmoid" ∨ v_1 = "softmax" ∨ v_1 = "elu" ∨ v_1 = "selu" ∨ v_1 = "gelu" ∨ v_1 = "swish" ∨ v_1 = "softplus" ∨ v_1 = "linear") ∧ v_2 ≠ ""
>>
Rule 26 (the total depthwise intermediate channels must be positive)
{v_1 : tensor, v_2 : int, v_3 : str} |= ndim(v_1) = 4 ∧ (if v_3 = "channels_last" then shape(v_1, 3) * v_2 > 0 else shape(v_1, 1) * v_2 > 0)
