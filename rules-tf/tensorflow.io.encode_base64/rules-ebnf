Rule 1 (input must be a tensor of type string)
{v_1 : tensor} |= dtype_(v_1) = 11
>>
Rule 2 (pad is a boolean)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 3 (input tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 5 (input tensor cannot have more than 8 dimensions)
{v_1 : tensor} |= ndim(v_1) ≤ 8
>>
Rule 6 (shape of the input tensor cannot be empty)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 7 (pad can only be true or false)
{v_1 : bool} |= (v_1 = true) ∨ (v_1 = false)
>>
Rule 9 (If padding is enabled then the length of the last dimension must be a multiple of 3 before encoding)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then shape(v_1, ndim(v_1) - 1) % 3 = 0
>>
Rule 10 (input tensor shape must not contain a zero dimension.)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≠ 0
>>
Rule 13 (If padding is disabled, the last dimension's size must be a multiple of 3)
{v_1 : tensor, v_2 : bool} |= if v_2 = false then shape(v_1, ndim(v_1) - 1) % 3 = 0
>>
Rule 19 (If pad is true, each string in the tensor must have a length that is a multiple of 3.)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then ∀i ∈ [0, shape(v_1,0) - 1] : (shape(v_1, i) % 3) = 0
>>
Rule 21 (If the input tensor is empty, then the pad parameter has no effect.)
{v_1 : tensor} |= if ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0 then true
>>
Rule 23 (If the input tensor is a scalar, then padding is not relevant)
{v_1 : tensor} |= if ndim(v_1) = 0 then true
>>
Rule 24 (If input is not padded, the final encoded output length needs to be a multiple of 4)
{v_1 : tensor, v_2 : bool} |= if v_2 = false then shape(v_1, ndim(v_1) -1) % 4 = 0
>>
Rule 25 (If the input tensor is not padded then the strings should have length multiple of 3)
{v_1 : tensor, v_2 : bool} |= if v_2 = false then ∀i ∈ [0, shape(v_1,0) - 1] : (shape(v_1, i) % 3) = 0
>>
Rule 26 (The size of the encoded string tensor will always be larger or equal to the size of the unencoded tensor)
{v_1 : tensor} |= shape(v_1, 0) <= shape(v_1, 0)
>>
Rule 29 (Strings in input tensor v_1 must all have the same length if pad=false and ndim=1)
{v_1 : tensor, v_2 : bool} |= if ndim(v_1) = 1 ∧ v_2 = false then ∀i ∈ [1, shape(v_1,0)-1] : shape(v_1,0) = shape(v_1, i)
