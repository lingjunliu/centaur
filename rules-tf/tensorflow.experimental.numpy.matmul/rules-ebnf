Rule 1 (Input tensors must have compatible dtypes for matrix multiplication)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = dtype_(v_2))
>>
Rule 2 (Input tensors must have at least one dimension)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) ≥ 1) ∧ (ndim(v_2) ≥ 1)
>>
Rule 3 (If one input is a scalar (0-dimensional tensor), the other must be a vector (1-dimensional tensor))
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 0) then (ndim(v_2) = 1) else if (ndim(v_2) = 0) then (ndim(v_1) = 1)
>>
Rule 4 (The number of dimensions of the resulting tensor must be less than or equal to 25)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) + ndim(v_2) ≤ 25
>>
Rule 5 (If either input is a complex type, the other input must also be a complex type.)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 10 ∨ dtype_(v_1) = 11) then (dtype_(v_2) = 10 ∨ dtype_(v_2) = 11) else if (dtype_(v_2) = 10 ∨ dtype_(v_2) = 11) then (dtype_(v_1) = 10 ∨ dtype_(v_1) = 11)
>>
Rule 6 (Shape of tensor must be smaller than 1000)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) < 1000
>>
Rule 7 (The size of the input tensors should be greater than 0)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 8 (The inner-most dimensions of the input tensors must be compatible.)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) > 1 ∧ ndim(v_2) > 1) then (shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2))
>>
Rule 9 (The dimensions of the input tensors must not be negative.)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 10 (If the first tensor has ndim=1 and the second tensor has ndim=1, the resulting tensor has ndim=1.)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 1 ∧ ndim(v_2) = 1) then true
>>
Rule 11 (If the first tensor has ndim=2 and the second tensor has ndim=2, the resulting tensor has ndim=2.)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 2 ∧ ndim(v_2) = 2) then true
>>
Rule 12 (If one of input tensor is empty, the output tensor is empty)
{v_1 : tensor, v_2 : tensor} |= (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) ∨ (∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = 0)
>>
Rule 13 (If either of the inputs is a scalar, the result is a scalar.)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 0) ∨ (ndim(v_2) = 0)
>>
Rule 14 (If first tensor is a matrix and second is a vector, then result is a vector.)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 2 ∧ ndim(v_2) = 1) then true
>>
Rule 15 (If first tensor is a vector and second is a matrix, then result is a vector.)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 1 ∧ ndim(v_2) = 2) then true
>>
Rule 17 (If the first tensor is 1D and second tensor is ND, the first dimension of the resulting tensor must be the same as the last dimension of the second tensor.)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 1 ∧ ndim(v_2) > 1) then (shape(v_1, 0) = shape(v_2, ndim(v_2)-2))
>>
Rule 18 (If the first tensor is ND and second tensor is 1D, the last dimension of the first tensor must be the same as the first dimension of the second tensor.)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) > 1 ∧ ndim(v_2) = 1) then (shape(v_1, ndim(v_1)-1) = shape(v_2, 0))
>>
Rule 19 (If both inputs are matrices, the number of columns in the first matrix must be equal to the number of rows in the second matrix.)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 2 ∧ ndim(v_2) = 2) then (shape(v_1, 1) = shape(v_2, 0))
>>
Rule 20 (If the number of dimensions for any of the input tensors is greater than 2, then it is treated as a stack of matrices residing in the last two indexes and broadcast accordingly.)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) > 2 ∨ ndim(v_2) > 2) then true
>>
Rule 21 (The number of dimensions of input tensors can not exceed 32)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≤ 32 ∧ ndim(v_2) ≤ 32
>>
Rule 22 (Input tensors can not be bool type)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 0 ∧ dtype_(v_2) ≠ 0
>>
Rule 25 (Minimum value in tensors must not be NaN)
{v_1 : tensor, v_2 : tensor} |= min(v_1) ≠ "none" ∧ min(v_2) ≠ "none"
>>
Rule 26 (At least one of the input tensors must have more than one element)
{v_1 : tensor, v_2 : tensor} |= (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 1) ∨ (∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 1)
>>
Rule 27 (The maximum value of input tensors must be positive.)
{v_1 : tensor, v_2 : tensor} |= max(v_1) > 0 ∨ max(v_2) > 0
>>
Rule 28 (The minimum value of input tensors must be smaller than the maximum value.)
{v_1 : tensor, v_2 : tensor} |= min(v_1) < max(v_1) ∧ min(v_2) < max(v_2)
>>
Rule 30 (The product of each dimension for at least one of the tensor must be less than 2^20 )
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) < 1048576) ∨ (∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) < 1048576)
>>
Rule 32 (The shape of the matrix should be less than or equal to 2048.)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≤ 2048
>>
Rule 33 (The sum of each dimension's size should be less than 4096)
{v_1 : tensor} |= (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) < 4096)
>>
Rule 34 (The tensors should not be strings)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 12 ∧ dtype_(v_2) ≠ 12
>>
Rule 35 (If ndim is 0 then both input tensors should have the same dtype)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 0 ∨ ndim(v_2) = 0) then (dtype_(v_1) = dtype_(v_2))
>>
Rule 36 (The minimum dimension size of each input tensors should be at least 1.)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 1) ∧ (∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) ≥ 1)
>>
Rule 37 (The difference between the number of dimensions should be less than or equal to 2)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) > ndim(v_2)) then (ndim(v_1) - ndim(v_2) ≤ 2) else (ndim(v_2) - ndim(v_1) ≤ 2)
>>
Rule 38 (If the input tensors are both 1-dimensional, their sizes must be equal)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 1 ∧ ndim(v_2) = 1) then (shape(v_1, 0) = shape(v_2, 0))
>>
Rule 39 (If one of the input tensor is a scalar, the other one should have the same dtype)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 0) then (dtype_(v_1) = dtype_(v_2)) else if (ndim(v_2) = 0) then (dtype_(v_1) = dtype_(v_2))
>>
Rule 40 (Minimum value of input tensor v1 should be less than or equal to maximum value of input tensor v2)
{v_1 : tensor, v_2 : tensor} |= min(v_1) ≤ max(v_2)
