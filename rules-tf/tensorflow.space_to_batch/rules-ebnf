>>
Rule 1 (block_shape must be a 1-D tensor)
{block_shape : tensor} |= ndim(block_shape) = 1
>>
Rule 2 (paddings must be a 2-D tensor)
{paddings : tensor} |= ndim(paddings) = 2
>>
Rule 3 (block_shape values must be >= 1)
{block_shape : tensor} |= ∀ i ∈ [0, shape(block_shape, 0) - 1] : shape(block_shape, i) ≥ 1
>>
Rule 4 (paddings values must be >= 0)
{paddings : tensor} |= ∀ i ∈ [0, shape(paddings, 0) - 1] : (shape(paddings, i) ≥ 0) ∧ (shape(paddings, i) ≥ 0)
>>
Rule 5 (paddings shape[1] must be 2)
{paddings : tensor} |= shape(paddings, 1) = 2
>>
Rule 6 (block_shape and paddings must have the same first dimension length)
{block_shape : tensor, paddings : tensor} |= shape(block_shape, 0) = shape(paddings, 0)
>>
Rule 7 (input must be a tensor)
{input : tensor} |= ndim(input) > 0
>>
Rule 8 (input shape[i+1] + pad_start + pad_end must be divisible by block_shape[i])
{input : tensor, block_shape : tensor, paddings : tensor} |= ∀ i ∈ [0, shape(block_shape, 0) - 1] : (shape(input, i + 1) + shape(paddings, i*2) + shape(paddings, i*2+1)) % shape(block_shape, i) = 0
>>
Rule 9 (block_shape's dtype should be int32 or int64)
{block_shape : tensor} |= dtype_(block_shape) = 2 ∨ dtype_(block_shape) = 4
>>
Rule 10 (paddings's dtype should be int32 or int64)
{paddings : tensor} |= dtype_(paddings) = 2 ∨ dtype_(paddings) = 4
>>
Rule 11 (input's dtype must be in the allowed list)
{input : tensor} |= dtype_(input) = 7 ∨ dtype_(input) = 8 ∨ dtype_(input) = 4 ∨ dtype_(input) = 5 ∨ dtype_(input) = 3 ∨ dtype_(input) = 2 ∨ dtype_(input) = 9 ∨ dtype_(input) = 1 ∨ dtype_(input) = 0 ∨ dtype_(input) = 6 ∨ dtype_(input) = 10
>>
Rule 12 (The length of paddings should not be greater than the input's number of spatial dimensions)
{input : tensor, paddings : tensor} |= shape(paddings, 0) <= ndim(input) - 1
>>
Rule 13 (block_shape's dimension should be equal to the number of spatial dimensions of the input)
{input : tensor, block_shape : tensor} |= shape(block_shape, 0) = ndim(input) - 1
