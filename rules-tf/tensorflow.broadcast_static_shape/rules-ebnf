>>
Rule 1 (The dimension of input tensors should be non-negative.)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 0 ∧ ndim(v_2) ≥ 0
>>
Rule 4 (If the dimensions are different, shapes of smaller dimension tensor should be prepended with 1 implicitly.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) < ndim(v_2) then ∃i ∈ [0, ndim(v_2) - ndim(v_1) - 1] : shape(v_2, i) ≥ 0 else if ndim(v_1) > ndim(v_2) then ∃i ∈ [0, ndim(v_1) - ndim(v_2) - 1] : shape(v_1, i) ≥ 0
>>
Rule 5 (All shapes are positive integers.)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0)
>>
Rule 8 (If one of the tensors is scalar then it can be broadcast to any shape)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 0 ∨ ndim(v_2) = 0
>>
Rule 10 (If v1's shape is [A, B, C, D] and v2's shape is [B, C], they are broadcastable)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 4 ∧ ndim(v_2) = 2 ∧ shape(v_1, 1) = shape(v_2, 0) ∧ shape(v_1, 2) = shape(v_2, 1)
>>
Rule 13 (The result's ndim will be equal or greater than the max of input ndims)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 0 ∧ ndim(v_2) ≥ 0 ∧ (if ndim(v_1) > ndim(v_2) then ndim(v_1) ≥ ndim(v_2) else ndim(v_2) ≥ ndim(v_1))
>>
Rule 14 (For broadcasting v1 and v2's shapes, if v1 is missing dimensions prepend it)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) < ndim(v_2) then (∀i ∈ [0, ndim(v_2) - ndim(v_1) - 1] : true)
>>
Rule 15 (For broadcasting v1 and v2's shapes, if v2 is missing dimensions prepend it)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) < ndim(v_1) then (∀i ∈ [0, ndim(v_1) - ndim(v_2) - 1] : true)
>>
Rule 19 (If the tensors can be broadcast, the output ndim is max of the input ndims.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > ndim(v_2) then true else if ndim(v_2) > ndim(v_1) then true
>>
Rule 20 (The number of dimensions should not be negative)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 22 (If the dimensions are not equal, add padding dimension to the tensor that is smaller)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) < ndim(v_2) then ∀i ∈ [0, ndim(v_2) - ndim(v_1) - 1] : shape(v_2, i) > 0 else if ndim(v_2) < ndim(v_1) then ∀i ∈ [0, ndim(v_1) - ndim(v_2) - 1] : shape(v_1, i) > 0
>>
Rule 23 (Shapes should not be negative)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0) ∧ (∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) ≥ 0)
>>
Rule 24 (At least one of the input tensors should have a dimension)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∨ ndim(v_2) > 0
>>
Rule 25 (If the shapes are different, the tensor of smaller dimension should be appended by one)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) < ndim(v_2) then shape(v_1, ndim(v_1)) = 1 else if ndim(v_2) < ndim(v_1) then shape(v_2, ndim(v_2)) = 1
>>
Rule 26 (If one tensor's shape has value one, it should be compatible with the other)
{v_1 : tensor, v_2 : tensor} |= (∃i ∈ [0, ndim(v_1)-1] : shape(v_1, i) = 1) ∨ (∃i ∈ [0, ndim(v_2)-1] : shape(v_2, i) = 1)
>>
Rule 31 (If v1 has no dimensions then v2 also must have no dimension)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then ndim(v_2) = 0
>>
Rule 32 (If shape is 1 in any dimension of v1, the corresponding dimension of output will be of v2)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1
>>
Rule 35 (If any input shape is negative, raise ValueError.)
{v_1 : tensor, v_2 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) < 0 ∨ ∃j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) < 0
>>
Rule 39 (Tensors with different dimensions must be able to prepend 1s to match dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) < ndim(v_2) then ∀i ∈ [0, ndim(v_2) - ndim(v_1) - 1] : true else if ndim(v_2) < ndim(v_1) then ∀i ∈ [0, ndim(v_1) - ndim(v_2) - 1] : true
