{v_1 : tensor} |= if (dtype_(v_1) < 9 ∨ dtype_(v_1) > 10) ∧ (ndim(v_1) > 1) ∧ (∀i ∈ [0, shape(v_1, 0) - 1] : v_1[i] < 0) then max(v_1) < 0
