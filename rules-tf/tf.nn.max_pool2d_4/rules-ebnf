Rule 2 (input tensor must have positive shape dimensions)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 3 (pooling window size elements must be positive)
{v_1 : list(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] > 0
>>
Rule 5 (padding elements must be non-negative)
{v_1 : list(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 6 (data_format must be a valid format)
{v_1 : str} |= v_1 = "channels_last" ∨ v_1 = "channels_first"
>>
Rule 9 (ksize and strides must both have positive elements and valid lengths of 1, 2, or 4)
{v_1 : list(int), v_2 : list(int)} |= (v_1.len = 1 ∨ v_1.len = 2 ∨ v_1.len = 4) ∧ (v_2.len = 1 ∨ v_2.len = 2 ∨ v_2.len = 4) ∧ (∀i ∈ [0, v_1.len - 1] : v_1[i] > 0) ∧ (∀j ∈ [0, v_2.len - 1] : v_2[j] > 0)
>>
Rule 12 (relationship between data_format and input channel dimension)
{v_1 : tensor, v_2 : str} |= if v_2 = "channels_last" then shape(v_1, 3) > 0 else if v_2 = "channels_first" then shape(v_1, 1) > 0 else false
>>
Rule 13 (input tensor must be of a supported numeric type)
{v_1 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 14 (4D input tensor must have numeric data type)
{v_1 : tensor} |= ndim(v_1) = 4 ∧ 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 15 (data format must be valid for the 4D input tensor)
{v_1 : tensor, v_2 : str} |= (v_2 = "channels_last" ∨ v_2 = "channels_first") ∧ ndim(v_1) = 4
>>
Rule 16 (ksize and strides must both be non-empty and have positive elements)
{v_1 : list(int), v_2 : list(int)} |= v_1.len > 0 ∧ v_2.len > 0 ∧ (∀i ∈ [0, v_1.len - 1] : v_1[i] > 0) ∧ (∀j ∈ [0, v_2.len - 1] : v_2[j] > 0)
>>
Rule 17 (if padding list is not empty, all its elements must be non-negative)
{v_1 : list(int)} |= if v_1.len > 0 then (∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0)
>>
Rule 18 (all shape dimensions of input tensor must be at least 1)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 1
