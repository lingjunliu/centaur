>>
Rule 3 (boxes must be a 3D tensor)
{v_2 : tensor} |= ndim(v_2) = 3
>>
Rule 4 (boxes must be of type float32: 7)
{v_2 : tensor} |= dtype_(v_2) = 7
>>
Rule 5 (boxes' shape must be [batch, num_bounding_boxes, 4])
{v_1 : tensor, v_2 : tensor} |= shape(v_2, 2) = 4 ∧ shape(v_2, 0) = shape(v_1, 0)
>>
Rule 6 (colors must be a 2D tensor)
{v_3 : tensor} |= ndim(v_3) = 2
>>
Rule 7 (colors must be of type float32: 7)
{v_3 : tensor} |= dtype_(v_3) = 7
>>
Rule 8 (colors' shape must be [num_bounding_boxes, 4])
{v_2 : tensor, v_3 : tensor} |= shape(v_3, 1) = 4 ∧ shape(v_3, 0) = shape(v_2, 1)
>>
Rule 9 (image height and width should be greater than 0)
{v_1 : tensor} |= shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0
>>
Rule 10 (The number of channels in images must be greater or equal to 1)
{v_1 : tensor} |= shape(v_1, 3) ≥ 1
