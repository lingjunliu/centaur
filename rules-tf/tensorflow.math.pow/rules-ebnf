Rule 2 (input tensors must have compatible shapes for Pow operation to avoid incompatible shape errors)
{x : tensor, y : tensor} |= shape(x) = shape(y)
>>
Rule 5 (if x is complex, then y should be real or complex)
{x : tensor, y : tensor} |= if (dtype_(x) = 9 ∨ dtype_(x) = 10) then (dtype_(y) = 6 ∨ dtype_(y) = 7 ∨ dtype_(y) = 8 ∨ dtype_(y) = 3 ∨ dtype_(y) = 4 ∨ dtype_(y) = 9 ∨ dtype_(y) = 10)
>>
Rule 8 (Check if all shape dimensions of x and y are non-zero)
{x : tensor, y : tensor} |= (∀i ∈ [0, ndim(x) - 1] : shape(x, i) > 0) ∧ (∀i ∈ [0, ndim(y) - 1] : shape(y, i) > 0)
>>
Rule 11 (x and y must have the same rank (number of dimensions) if their shapes don't match)
{x : tensor, y : tensor} |= if shape(x) ≠ shape(y) then ndim(x) = ndim(y)
>>
Rule 12 (If the dimensions of x are (a, b, c) and y is (b, c), then reduce to y having shape (1,b,c))
{x : tensor, y : tensor} |= if ndim(x) = 3 ∧ ndim(y) = 2 then shape(x,1) = shape(y,0) ∧ shape(x,2) = shape(y,1)
>>
Rule 13 (x's dtype must be in allowed list)
{x : tensor} |= dtype_(x) = 6 ∨ dtype_(x) = 7 ∨ dtype_(x) = 8 ∨ dtype_(x) = 3 ∨ dtype_(x) = 4 ∨ dtype_(x) = 9 ∨ dtype_(x) = 10
>>
Rule 14 (y's dtype must be in allowed list)
{y : tensor} |= dtype_(y) = 6 ∨ dtype_(y) = 7 ∨ dtype_(y) = 8 ∨ dtype_(y) = 3 ∨ dtype_(y) = 4 ∨ dtype_(y) = 9 ∨ dtype_(y) = 10
>>
Rule 15 (x and y must have compatible shapes or be broadcastable)
{x : tensor, y : tensor} |= (shape(x) = shape(y)) ∨ (ndim(x) = ndim(y) ∧ ∀i ∈ [0, ndim(x) - 1] : (shape(x, i) = shape(y, i) ∨ shape(x, i) = 1 ∨ shape(y, i) = 1))
>>
Rule 18 (If x and y have different number of dimensions then the smaller should be 1)
{x : tensor, y : tensor} |= if ndim(x) ≠ ndim(y) then (ndim(x) = 1 ∨ ndim(y) = 1)
>>
Rule 23 (x must have non-zero shape)
{x : tensor} |= ∀i ∈ [0, ndim(x) - 1] : shape(x, i) > 0
>>
Rule 24 (y must have non-zero shape)
{y : tensor} |= ∀i ∈ [0, ndim(y) - 1] : shape(y, i) > 0
>>
Rule 29 (if x is a scalar, y must have a valid dtype)
{x : tensor, y : tensor} |= if ndim(x) = 0 then (dtype_(y) = 6 ∨ dtype_(y) = 7 ∨ dtype_(y) = 8 ∨ dtype_(y) = 3 ∨ dtype_(y) = 4 ∨ dtype_(y) = 9 ∨ dtype_(y) = 10)
>>
Rule 32 (x and y dimensions must be > 0)
{x : tensor, y : tensor} |= ndim(x) ≥ 0 ∧ ndim(y) ≥ 0
>>
Rule 36 (At least one of the tensors should not be empty)
{x : tensor, y : tensor} |= (∃i ∈ [0, ndim(x) - 1] : shape(x, i) > 0) ∨ (∃i ∈ [0, ndim(y) - 1] : shape(y, i) > 0)
>>
Rule 40 (Ensure x or y dimension is greater than zero.)
{x : tensor, y : tensor} |= ndim(x) > 0 ∨ ndim(y) > 0
>>
Rule 41 (The difference between x and y's dimensions should be less than or equal to 1.)
{x : tensor, y : tensor} |= if ndim(x) > ndim(y) then ndim(x) - ndim(y) ≤ 1 else ndim(y) - ndim(x) ≤ 1
>>
Rule 44 (Shapes of x and y should be compatible for Pow.)
{x : tensor, y : tensor} |= if ndim(x) = ndim(y) then ∀i ∈ [0, ndim(x) - 1] : (shape(x, i) = shape(y, i) ∨ shape(x, i) = 1 ∨ shape(y, i) = 1)
>>
Rule 51 (x and y should have same number of dimensions or one of them should be scalar to allow broadcasting)
{x : tensor, y : tensor} |= ndim(x) = ndim(y) ∨ ndim(x) = 0 ∨ ndim(y) = 0
>>
Rule 81 (If one of X or Y is scalar then the other must be valid dtype for Pow)
{x : tensor, y : tensor} |= if ndim(x) = 0 then (dtype_(y) = 6 ∨ dtype_(y) = 7 ∨ dtype_(y) = 8 ∨ dtype_(y) = 3 ∨ dtype_(y) = 4 ∨ dtype_(y) = 9 ∨ dtype_(y) = 10) else if ndim(y) = 0 then (dtype_(x) = 6 ∨ dtype_(x) = 7 ∨ dtype_(x) = 8 ∨ dtype_(x) = 3 ∨ dtype_(x) = 4 ∨ dtype_(x) = 9 ∨ dtype_(x) = 10)
>>
Rule 84 (If at least one is scalar the scalar needs valid Pow dtype.)
{x : tensor, y : tensor} |= if (ndim(x) = 0) ∨ (ndim(y) = 0) then ((dtype_(x) = 6 ∨ dtype_(x) = 7 ∨ dtype_(x) = 8 ∨ dtype_(x) = 3 ∨ dtype_(x) = 4 ∨ dtype_(x) = 9 ∨ dtype_(x) = 10) ∨ (dtype_(y) = 6 ∨ dtype_(y) = 7 ∨ dtype_(y) = 8 ∨ dtype_(y) = 3 ∨ dtype_(y) = 4 ∨ dtype_(y) = 9 ∨ dtype_(y) = 10))
>>
