{v_1 : tensor} |= ndim(v_1) = 1

Rule 5 (index tensor (v_2) should be within the range of input tensor)
{v_1 : tensor, v_2 : tensor} |= min(v_2) ≥ 0 ∧ ∀i ∈ [0, ndim(v_1) − 1] : max(v_2) ≤ shape(v_1, i) − 1

Rule 11 (index tensor (v_3) is within the input tensor along the specified dimension)
{v_1 : tensor, v_2 : int, v_3 : tensor} |= min(v_3) ≥ 0 ∧ max(v_3) ≤ shape(v_1, v_2) − 1

Rule 17 (primitive type variable must be non-negative)
{v_1 : int ⊎ float} |= v_1 ≥ 0

Rule 22 (valid step size for a range)
{v_1 : int ⊎ float, v_2 : int ⊎ float, v_3 : int ⊎ float} |= if v_1 > 0 then v_2 ≤ v_3 else if v_1 < 0 then v_2 ≥ v_3 else true

