Rule 3 (The input tensor must have a floating-point data type)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 4 (If the mask value is non-zero, the input tensor must be of floating-point type to avoid precision loss)
{v_1 : float, v_2 : tensor} |= if v_1 ≠ 0 then dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8
>>
Rule 5 (All dimensions of the input tensor must have a size greater than zero)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0)
>>
Rule 6 (The input tensor must have at least 2 dimensions for batch and timesteps)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 9 (If the input tensor has an integer data type, the mask value must be a whole number)
{v_1 : float, v_2 : tensor} |= if dtype_(v_2) ≤ 5 then v_1 % 1 = 0
>>
Rule 11 (The input tensor must have at least 2 dimensions and at most 4 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ ndim(v_1) ≤ 4
>>
Rule 12 (The batch dimension and timestep dimension of the input tensor must be greater than zero)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0
>>
Rule 13 (The mask value should be within the range of the input tensor values)
{v_1 : float, v_2 : tensor} |= min(v_2) ≤ v_1 ∧ v_1 ≤ max(v_2)
>>
Rule 14 (If the input tensor is boolean, the mask value must represent False or True)
{v_1 : float, v_2 : tensor} |= if dtype_(v_2) = 0 then v_1 = 0 ∨ v_1 = 1
>>
Rule 15 (The datatype of the input tensor should not be a string or a generic numpy dtype)
{v_1 : tensor} |= dtype_(v_1) < 11
