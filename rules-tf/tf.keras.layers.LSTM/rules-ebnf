>>
Rule 1 (dimensionality of the output space must be a positive integer)
{v_1 : int} |= v_1 > 0
>>
Rule 2 (dropout rate must be between 0 and 1 inclusive)
{v_1 : int ⊎ float} |= v_1 ≥ 0 ∧ v_1 ≤ 1
>>
Rule 4 (activation function must be a valid predefined activation name)
{v_1 : str} |= v_1 = "tanh" ∨ v_1 = "sigmoid" ∨ v_1 = "relu" ∨ v_1 = "softmax" ∨ v_1 = "elu" ∨ v_1 = "selu" ∨ v_1 = "gelu" ∨ v_1 = "swish" ∨ v_1 = "softplus" ∨ v_1 = "linear" ∨ v_1 = "none"
>>
Rule 6 (input tensor must be 3-dimensional with non-empty dimensions)
{v_1 : tensor} |= ndim(v_1) = 3 ∧ shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0
>>
Rule 7 (mask tensor must be 2-dimensional and share the same batch and timestep dimensions as the inputs)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 3 ∧ ndim(v_2) = 2 ∧ shape(v_1, 0) = shape(v_2, 0) ∧ shape(v_1, 1) = shape(v_2, 1)
>>
Rule 8 (initial state must contain exactly two state tensors)
{v_1 : list(tensor)} |= v_1.len = 2
>>
Rule 10 (dropout and recurrent dropout rates must be between 0 and 1 inclusive)
{v_1 : int ⊎ float, v_2 : int ⊎ float} |= v_1 ≥ 0 ∧ v_1 ≤ 1 ∧ v_2 ≥ 0 ∧ v_2 ≤ 1
>>
Rule 11 (activation and recurrent activation must be valid strings)
{v_1 : str, v_2 : str} |= (v_1 = "tanh" ∨ v_1 = "sigmoid" ∨ v_1 = "relu" ∨ v_1 = "softmax" ∨ v_1 = "linear" ∨ v_1 = "none") ∧ (v_2 = "tanh" ∨ v_2 = "sigmoid" ∨ v_2 = "relu" ∨ v_2 = "softmax" ∨ v_2 = "linear" ∨ v_2 = "none")
>>
Rule 15 (inputs must have a floating-point dtype)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 16 (dimensionality of the output space must be a positive integer and the inputs must be 3-dimensional)
{v_1 : int, v_2 : tensor} |= v_1 > 0 ∧ ndim(v_2) = 3
>>
Rule 19 (mask tensor must be 2-dimensional and have a boolean data type)
{v_1 : tensor} |= ndim(v_1) = 2 ∧ dtype_(v_1) = 0
>>
Rule 20 (initial state must contain exactly two tensors and inputs must be 3-dimensional)
{v_1 : list(tensor), v_2 : tensor} |= v_1.len = 2 ∧ ndim(v_2) = 3
>>
Rule 21 (if unroll is enabled, inputs must have positive timestep dimension)
{v_1 : bool, v_2 : tensor} |= if v_1 then shape(v_2, 1) > 0
>>
Rule 23 (if unit forget bias is enabled, bias must be used)
{v_1 : bool, v_2 : bool} |= if v_1 then v_2 = true
