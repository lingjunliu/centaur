Rule 1 (RNN input tensor must be 3-dimensional)
{v_1 : tensor} |= ndim(v_1) = 3
>>
Rule 2 (Mask tensor dimensions and shapes must match input tensor)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 3 ∧ ndim(v_2) = 2 ∧ shape(v_1, 0) = shape(v_2, 0) ∧ shape(v_1, 1) = shape(v_2, 1)
>>
Rule 3 (Mask tensor must be a boolean tensor)
{v_1 : tensor} |= dtype_(v_1) = 0
>>
Rule 4 (Input tensor must have numeric data type)
{v_1 : tensor} |= dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 10
>>
Rule 5 (Zero output for mask can only be set when returning sequences)
{v_1 : bool, v_2 : bool} |= if v_1 = true then v_2 = true
>>
Rule 6 (RNN input tensor must be 3-dimensional with positive timesteps and features dimensions)
{v_1 : tensor} |= ndim(v_1) = 3 ∧ shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0
>>
Rule 7 (If stateful is True, the input batch size must be statically defined and positive)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then shape(v_1, 0) > 0
>>
Rule 10 (Input tensor of RNN must be of floating-point precision type)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 11 (RNN input tensor must be 3-dimensional with a positive features dimension)
{v_1 : tensor} |= ndim(v_1) = 3 ∧ shape(v_1, 2) > 0
>>
Rule 13 (If unroll is enabled, the timesteps dimension of the inputs must be statically defined and positive)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then shape(v_1, 1) > 0
>>
Rule 15 (The mask tensor must have a boolean or integer data type)
{v_1 : tensor} |= dtype_(v_1) = 0 ∨ dtype_(v_1) = 1 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4
