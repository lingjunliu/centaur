               | "∃" <PRIMVAR> "∈" "[" <expr> "," <expr> "]" ":" <expr>
               | <if_expr>
               | <compare_expr>

<if_expr> ::= "if" <expr> "then" <expr> [ "else" <expr> ]
<compare_expr> ::= <arith_expr> | <arith_expr> <COMPOP> <arith_expr>
