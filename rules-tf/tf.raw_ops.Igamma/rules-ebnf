Rule 2 (input tensor 'a' must be a floating-point type)
{a : tensor} |= dtype_(a) = 6 ∨ dtype_(a) = 7 ∨ dtype_(a) = 8
>>
Rule 3 (input tensors must have the same shape)
{a : tensor, x : tensor} |= ndim(a) = ndim(x) ∧ ∀i ∈ [0, ndim(a) - 1] : shape(a, i) = shape(x, i)
>>
Rule 4 (input tensor 'a' ndim must be greater than 0)
{a : tensor} |= ndim(a) > 0
>>
Rule 5 (shape of 'a' must be greater than 0)
{a : tensor} |= ∀i ∈ [0, ndim(a) - 1] : shape(a, i) > 0
>>
Rule 6 (a must be greater than 0)
{a : tensor} |= min(a) > 0
>>
Rule 7 (x must be non-negative)
{x : tensor} |= min(x) ≥ 0
>>
Rule 8 (if a is half, then x must be half)
{a : tensor, x : tensor} |= if dtype_(a) = 6 then dtype_(x) = 6
>>
Rule 9 (if a is bfloat16, then x must be bfloat16)
{a : tensor, x : tensor} |= if dtype_(a) = 7 then dtype_(x) = 7
>>
Rule 10 (if a is float32, then x must be float32)
{a : tensor, x : tensor} |= if dtype_(a) = 8 then dtype_(x) = 8
>>
Rule 11 (if a is float64, then x must be float64)
{a : tensor, x : tensor} |= if dtype_(a) = 9 then dtype_(x) = 9
>>
Rule 12 (The number of elements in 'a' and 'x' must be the same if both are 1D tensors.)
{a : tensor, x : tensor} |= if ndim(a) = 1 ∧ ndim(x) = 1 then shape(a, 0) = shape(x, 0)
>>
Rule 13 (If 'a' and 'x' are scalars, they must have compatible types.)
{a : tensor, x : tensor} |= if ndim(a) = 0 ∧ ndim(x) = 0 then dtype_(a) = dtype_(x)
>>
Rule 14 (If 'a' and 'x' are vectors, the elements of 'x' must be greater than or equal to 0)
{a : tensor, x : tensor} |= if ndim(a) = 1 ∧ ndim(x) = 1 then ∀i ∈ [0, shape(x,0)-1] : x[i] ≥ 0
>>
Rule 15 (If 'a' and 'x' are matrices, all elements of 'a' must be greater than 0)
{a : tensor, x : tensor} |= if ndim(a) = 2 ∧ ndim(x) = 2 then min(a) > 0
>>
Rule 16 (If 'a' and 'x' are matrices, all elements of 'x' must be non-negative)
{a : tensor, x : tensor} |= if ndim(a) = 2 ∧ ndim(x) = 2 then min(x) ≥ 0
>>
Rule 17 (if a and x are not scalars, their shapes must be broadcastable)
{a : tensor, x : tensor} |= if ndim(a) > 0 ∨ ndim(x) > 0 then (ndim(a) > 0 ∧ ndim(x) > 0 ∧ ∀i ∈ [0, if ndim(a) ≥ ndim(x) then ndim(a) - 1 else ndim(x) - 1] : ndim(a) - i - 1 < 0 ∨ ndim(x) - i - 1 < 0 ∨ shape(a, ndim(a) - i - 1) = 1 ∨ shape(x, ndim(x) - i - 1) = 1 ∨ shape(a, ndim(a) - i - 1) = shape(x, ndim(x) - i - 1))
