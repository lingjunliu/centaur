{v_1 : list(int), v_2 : list(int), v_3 : list(int)} |= (∀i ∈ [0, v_1.len - 1] : v_1[i] > 0) ∧ (∀i ∈ [0, v_2.len - 1] : v_2[i] > 0) ∧ (∀i ∈ [0, v_3.len - 1] : v_3[i] > 0)
>>
