{v_1 : str} |= v_1 = "valid" ∨ v_1 = "same"
>>
Rule 7 (data_format must be "channels_last" or "channels_first")
{v_1 : str} |= v_1 = "channels_last" ∨ v_1 = "channels_first"
>>
Rule 8 (activation function must be a valid supported string)
{v_1 : str} |= v_1 = "relu" ∨ v_1 = "tanh" ∨ v_1 = "sigmoid" ∨ v_1 = "softmax" ∨ v_1 = "elu" ∨ v_1 = "selu" ∨ v_1 = "gelu" ∨ v_1 = "swish" ∨ v_1 = "softplus" ∨ v_1 = "linear"
>>
Rule 10 (both input channels and filters must be divisible by groups)
{v_1 : tensor, v_2 : str, v_3 : int, v_4 : int} |= (if v_2 = "channels_last" then shape(v_1, 3) % v_3 = 0 else shape(v_1, 1) % v_3 = 0) ∧ (v_4 % v_3 = 0)
>>
Rule 11 (if dilation_rate is greater than 1, strides must be 1)
{v_1 : list(int), v_2 : list(int)} |= if (v_1[0] > 1 ∨ v_1[1] > 1) then (v_2[0] = 1 ∧ v_2[1] = 1)
