Rule 1 (x and y tensors must have the same data type)
{x : tensor, y : tensor} |= dtype_(x) = dtype_(y)
>>
Rule 2 (x tensor must be of a supported type: bfloat16, half, float32, float64, complex64, complex128 - represented by their corresponding integer type indexes)
{x : tensor} |= dtype_(x) = 6 ∨ dtype_(x) = 7 ∨ dtype_(x) = 8 ∨ dtype_(x) = 9 ∨ dtype_(x) = 10 ∨ dtype_(x) = 12
>>
Rule 3 (x and y tensors must have the same number of dimensions.)
{x : tensor, y : tensor} |= ndim(x) = ndim(y)
>>
Rule 4 (x and y tensors must have compatible shapes for broadcasting.)
{x : tensor, y : tensor} |= if ndim(x) ≥ ndim(y) then ∀i ∈ [0, ndim(y) - 1] : shape(y, i) = shape(x, ndim(x) - ndim(y) + i) ∨ shape(y, i) = 1 else ∀i ∈ [0, ndim(x) - 1] : shape(x, i) = shape(y, ndim(y) - ndim(x) + i) ∨ shape(x, i) = 1
>>
Rule 5 (Shape of x is not empty)
{x: tensor} |= ndim(x) > 0 ∨ (ndim(x) = 0 ∧ shape(x,0) > 0)
>>
Rule 6 (Shape of y is not empty)
{y: tensor} |= ndim(y) > 0 ∨ (ndim(y) = 0 ∧ shape(y,0) > 0)
>>
Rule 7 (x tensor must be of a supported type: bfloat16, half, float32, float64, complex64, complex128, represented by their corresponding integer type indexes 7, 8, 9, 10, 11, 12 from the encoding list)
{x : tensor} |= dtype_(x) = 7 ∨ dtype_(x) = 8 ∨ dtype_(x) = 9 ∨ dtype_(x) = 10 ∨ dtype_(x) = 11
>>
Rule 8 (y tensor must be of a supported type: bfloat16, half, float32, float64, complex64, complex128, represented by their corresponding integer type indexes 7, 8, 9, 10, 11, 12 from the encoding list)
{y : tensor} |= dtype_(y) = 7 ∨ dtype_(y) = 8 ∨ dtype_(y) = 9 ∨ dtype_(y) = 10 ∨ dtype_(y) = 11
>>
Rule 11 (if x is scalar, y must be scalar too.)
{x : tensor, y : tensor} |= if ndim(x) = 0 then ndim(y) = 0
>>
Rule 12 (if y is scalar, x must be scalar too.)
{x : tensor, y : tensor} |= if ndim(y) = 0 then ndim(x) = 0
>>
Rule 18 (x tensor must have at least one dimension)
{x : tensor} |= ndim(x) ≥ 0
>>
Rule 19 (x and y tensors must have compatible types)
{x : tensor, y : tensor} |= (dtype_(x) = 7 ∨ dtype_(x) = 8 ∨ dtype_(x) = 9 ∨ dtype_(x) = 10 ∨ dtype_(x) = 11) ∧ dtype_(x) = dtype_(y)
>>
Rule 20 (x and y tensors must be either both scalars or both non-scalars)
{x : tensor, y : tensor} |= (ndim(x) = 0 ∧ ndim(y) = 0) ∨ (ndim(x) > 0 ∧ ndim(y) > 0)
>>
Rule 21 (x has at least one dimension or it is a scalar)
{x : tensor} |= ndim(x) >= 0
>>
Rule 22 (y has at least one dimension or it is a scalar)
{y : tensor} |= ndim(y) >= 0
>>
Rule 23 (If x is a tensor with more than 0 dimensions, all dimensions should be greater than 0)
{x : tensor} |= if ndim(x) > 0 then ∀i ∈ [0, ndim(x) - 1] : shape(x, i) > 0
>>
Rule 26 (If y is a tensor with more than 0 dimensions, all dimensions should be greater than 0, and if it is not, the condition is true)
{y : tensor} |= if ndim(y) > 0 then ∀i ∈ [0, ndim(y) - 1] : shape(y, i) > 0
>>
Rule 29 (x and y must be of type bfloat16, half, float32, float64, complex64, complex128)
{x : tensor, y : tensor} |= (dtype_(x) = 7 ∨ dtype_(x) = 8 ∨ dtype_(x) = 9 ∨ dtype_(x) = 10 ∨ dtype_(x) = 11)
>>
Rule 32 (if the number of dimensions of x is 0, then the number of dimensions of y must also be 0)
{x : tensor, y : tensor} |= (ndim(x) = 0) = (ndim(y) = 0)
>>
Rule 33 (at least one of the input tensors must have more than 1 element)
{x : tensor, y : tensor} |= (ndim(x) > 0 ∧ shape(x, 0) > 1) ∨ (ndim(y) > 0 ∧ shape(y, 0) > 1)
>>
Rule 34 (x and y must be of type bfloat16, half, float32, float64, complex64, complex128 and have same dtype)
{x : tensor, y : tensor} |= (dtype_(x) = 7 ∨ dtype_(x) = 8 ∨ dtype_(x) = 9 ∨ dtype_(x) = 10 ∨ dtype_(x) = 11) ∧ (dtype_(x) = dtype_(y))
>>
Rule 38 (x or y cannot have a dimension equal to zero if not scalars)
{x : tensor, y : tensor} |= if ndim(x) > 0 ∧ ndim(y) > 0 then (∀i ∈ [0, ndim(x) - 1] : shape(x, i) ≠ 0) ∧ (∀i ∈ [0, ndim(y) - 1] : shape(y, i) ≠ 0)
>>
Rule 47 (Both tensors must have at least one dimension or both must be scalar)
{x : tensor, y : tensor} |= (ndim(x) > 0 ∧ ndim(y) > 0) ∨ (ndim(x) = 0 ∧ ndim(y) = 0)
>>
Rule 69 (Tensors cannot have more than 64 dimensions.)
{x : tensor, y: tensor} |= ndim(x) <= 64 ∧ ndim(y) <= 64
>>
Rule 75 (Valid shapes)
{x : tensor, y: tensor} |= (if ndim(x) > 0 then ∀i ∈ [0, ndim(x) - 1] : shape(x, i) > 0) ∧ (if ndim(y) > 0 then ∀i ∈ [0, ndim(y) - 1] : shape(y, i) > 0)
>>
Rule 78 (If one tensor is scalar the other must be scalar)
{x : tensor, y : tensor} |= if (ndim(x) = 0) then (ndim(y) = 0)
>>
Rule 79 (If the other tensor is scalar this tensor must be scalar.)
{x : tensor, y : tensor} |= if (ndim(y) = 0) then (ndim(x) = 0)
