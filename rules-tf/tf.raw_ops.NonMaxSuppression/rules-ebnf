>>
Rule 1 (boxes should be a 2D tensor)
{boxes : tensor} |= ndim(boxes) = 2
>>
Rule 2 (boxes shape[1] should be 4)
{boxes : tensor} |= shape(boxes, 1) = 4
>>
Rule 3 (scores should be a 1D tensor)
{scores : tensor} |= ndim(scores) = 1
>>
Rule 4 (scores and boxes should have the same number of boxes)
{boxes : tensor, scores : tensor} |= shape(boxes, 0) = shape(scores, 0)
>>
Rule 5 (max_output_size should be a scalar)
{max_output_size : tensor} |= ndim(max_output_size) = 0
>>
Rule 6 (iou_threshold should be between 0 and 1)
{iou_threshold : float} |= iou_threshold ≥ 0.0 ∧ iou_threshold ≤ 1.0
>>
Rule 7 (boxes dtype should be float32)
{boxes : tensor} |= dtype_(boxes) = 7
>>
Rule 8 (scores dtype should be float32)
{scores : tensor} |= dtype_(scores) = 7
>>
Rule 9 (max_output_size dtype should be int32)
{max_output_size : tensor} |= dtype_(max_output_size) = 3
>>
Rule 11 (number of boxes should be positive)
{boxes : tensor} |= shape(boxes, 0) > 0
>>
Rule 12 (max_output_size should be greater than 0)
{max_output_size : tensor} |= min(max_output_size) > 0
>>
Rule 13 (boxes values should be non-negative)
{boxes : tensor} |= ∀i ∈ [0, shape(boxes, 0) * shape(boxes, 1) - 1] : min(boxes) ≥ 0
>>
Rule 14 (boxes values should be finite)
{boxes : tensor} |= ∀i ∈ [0, shape(boxes, 0) * shape(boxes, 1) - 1] : min(boxes) > -10000000000.0 ∧ max(boxes) < 10000000000.0
>>
Rule 15 (scores values should be finite)
{scores : tensor} |= ∀i ∈ [0, shape(scores, 0) - 1] : min(scores) > -10000000000.0 ∧ max(scores) < 10000000000.0
>>
Rule 16 (max_output_size should be finite)
{max_output_size : tensor} |= min(max_output_size) > -100000 ∧ max(max_output_size) < 100000
>>
Rule 17 (max_output_size values should be non-negative)
{max_output_size : tensor} |= min(max_output_size) ≥ 0
>>
Rule 18 (iou_threshold should be a finite number)
{iou_threshold : float} |= iou_threshold > -100000.0 ∧ iou_threshold < 100000.0
>>
Rule 19 (boxes values are normalized or absolute, checking if between 0 and 1)
{boxes : tensor} |= (min(boxes) ≥ 0 ∧ max(boxes) ≤ 1) ∨ (min(boxes) < 0 ∨ max(boxes) > 1)
