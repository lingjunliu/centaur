Rule 1 (t, clip_value_min and clip_value_max must have the same dtype)
{t : tensor, clip_value_min : tensor, clip_value_max : tensor} |= dtype_(t) = dtype_(clip_value_min) ∧ dtype_(t) = dtype_(clip_value_max)
>>
Rule 2 (clip_value_min must be less than or equal to clip_value_max)
{clip_value_min : tensor, clip_value_max : tensor} |= min(clip_value_min) ≤ max(clip_value_max)
>>
Rule 3 (If t is an integer tensor, clip_value_min and clip_value_max cannot be float)
{t : tensor, clip_value_min : tensor, clip_value_max : tensor} |= if (dtype_(t) = 1 ∨ dtype_(t) = 2 ∨ dtype_(t) = 3 ∨ dtype_(t) = 4 ∨ dtype_(t) = 5) then (dtype_(clip_value_min) = 1 ∨ dtype_(clip_value_min) = 2 ∨ dtype_(clip_value_min) = 3 ∨ dtype_(clip_value_min) = 4 ∨ dtype_(clip_value_min) = 5) ∧ (dtype_(clip_value_max) = 1 ∨ dtype_(clip_value_max) = 2 ∨ dtype_(clip_value_max) = 3 ∨ dtype_(clip_value_max) = 4 ∨ dtype_(clip_value_max) = 5)
>>
Rule 4 (If t is float16/32/64, clip_value_min and clip_value_max cannot be int)
{t : tensor, clip_value_min : tensor, clip_value_max : tensor} |= if (dtype_(t) = 7 ∨ dtype_(t) = 8 ∨ dtype_(t) = 9) then (dtype_(clip_value_min) = 7 ∨ dtype_(clip_value_min) = 8 ∨ dtype_(clip_value_min) = 9) ∧ (dtype_(clip_value_max) = 7 ∨ dtype_(clip_value_max) = 8 ∨ dtype_(clip_value_max) = 9)
>>
Rule 5 (t, clip_value_min and clip_value_max have the same shape or clip_value_min and clip_value_max are scalars)
{t : tensor, clip_value_min : tensor, clip_value_max : tensor} |= (∀i ∈ [0, ndim(t) - 1] : shape(t, i) = shape(clip_value_min, i)) ∨ (ndim(clip_value_min) = 0) ∧ (∀i ∈ [0, ndim(t) - 1] : shape(t, i) = shape(clip_value_max, i)) ∨ (ndim(clip_value_max) = 0)
