>>
Rule 1 (Dimension of queue_ref must be non-negative)
{queue_ref : tensor} |= shape(queue_ref, 0) ≥ 0
>>
Rule 2 (Queue names must have the same length as dtypes)
{dtypes : list(dtype), names : list(str)} |= dtypes.len = names.len
>>
Rule 4 (Queue reference should be a scalar tensor)
{queue_ref : tensor} |= ndim(queue_ref) = 0
