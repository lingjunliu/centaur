                                     [7, 2, 7, 7],
                                     [7, 7, 3, 7]],
                                    [[4, 7, 7, 7],
                                     [7, 5, 7, 7],
                                     [7, 7, 6, 7]]]

  # A superdiagonal (per batch).
  tf.matrix_set_diag(diagonal, k = 1)
    ==> [[[7, 1, 7, 7],  # Output shape: (2, 3, 4)
          [7, 7, 2, 7],
