Rule 1 (Input tensor must have a supported dtype: float32, float64, qint8, quint8, or qint32. Assume types are encoded as indices 7, 8.)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 2 (ksize must be a list of ints with length 1, 2 or 4)
{v_1 : list(int)} |= v_1.len = 1 ∨ v_1.len = 2 ∨ v_1.len = 4
>>
Rule 4 (ksize must be an int, and greater than zero)
{v_1 : int} |= v_1 > 0
>>
Rule 6 (padding must be a string, either 'VALID' or 'SAME')
{v_1 : str} |= v_1 = "VALID" ∨ v_1 = "SAME"
>>
Rule 7 (data_format must be a string, either 'NHWC' or 'NCHW')
{v_1 : str} |= v_1 = "NHWC" ∨ v_1 = "NCHW"
>>
Rule 8 (If ksize is a list, all elements must be greater than zero)
{v_1 : list(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] > 0
>>
Rule 10 (Input tensor must be 4 dimensional)
{v_1 : tensor} |= ndim(v_1) = 4
>>
Rule 11 (If ksize is an int, it must be greater than zero and less than or equal to height and width of input)
{v_1 : tensor, v_2 : int} |= v_2 > 0 ∧ v_2 ≤ shape(v_1, 1) ∧ v_2 ≤ shape(v_1, 2)
>>
Rule 13 (If ksize is a list, then the length must be 1, 2, or 4 and each element must be greater than zero)
{v_1 : list(int)} |= (v_1.len = 1 ∨ v_1.len = 2 ∨ v_1.len = 4) ∧ ∀i ∈ [0, v_1.len - 1] : v_1[i] > 0
>>
Rule 15 (If ksize is a list of length 2, each element must be less than or equal to corresponding input dimension)
{v_1 : tensor, v_2 : list(int)} |= v_2.len = 2 ∧ v_2[0] ≤ shape(v_1, 1) ∧ v_2[1] ≤ shape(v_1, 2)
>>
Rule 17 (If ksize is a list of length 4, each element must be less than or equal to corresponding input dimension, considering NHWC data format)
{v_1 : tensor, v_2 : list(int), v_3 : str} |= v_3 = "NHWC" ∧ v_2.len = 4 ∧ v_2[1] ≤ shape(v_1, 1) ∧ v_2[2] ≤ shape(v_1, 2)
>>
Rule 19 (If ksize is a list of length 4, each element must be less than or equal to corresponding input dimension, considering NCHW data format)
{v_1 : tensor, v_2 : list(int), v_3 : str} |= v_3 = "NCHW" ∧ v_2.len = 4 ∧ v_2[2] ≤ shape(v_1, 2) ∧ v_2[3] ≤ shape(v_1, 3)
>>
Rule 21 (If data_format is NHWC, channel dimension should be last, i.e. shape(input, 3) > 0)
{v_1 : tensor, v_2 : str} |= v_2 = "NHWC" ∧ shape(v_1, 3) > 0
>>
Rule 22 (If data_format is NCHW, channel dimension should be second, i.e. shape(input, 1) > 0)
{v_1 : tensor, v_2 : str} |= v_2 = "NCHW" ∧ shape(v_1, 1) > 0
>>
Rule 23 (If ksize is a list of length 1, the value must be greater than zero)
{v_1 : list(int)} |= v_1.len = 1 ∧ v_1[0] > 0
>>
Rule 27 (If ksize and strides are lists of length 4, and data format is NHWC, then batch and channel dimensions should be 1)
{v_1 : list(int), v_2 : list(int), v_3 : str} |= v_1.len = 4 ∧ v_2.len = 4 ∧ v_3 = "NHWC" ∧ v_1[0] = 1 ∧ v_2[0] = 1 ∧ v_1[3] = 1 ∧ v_2[3] = 1
>>
Rule 28 (If ksize and strides are lists of length 4, and data format is NCHW, then batch and channel dimensions should be 1)
{v_1 : list(int), v_2 : list(int), v_3 : str} |= v_1.len = 4 ∧ v_2.len = 4 ∧ v_3 = "NCHW" ∧ v_1[0] = 1 ∧ v_2[0] = 1 ∧ v_1[1] = 1 ∧ v_2[1] = 1
>>
Rule 29 (If padding is VALID then the output size will be smaller than the input size.)
{v_1 : str, v_2 : tensor, v_3 : list(int)} |= v_1 = "VALID" ∧ shape(v_2, 1) > v_3[1] ∧ shape(v_2, 2) > v_3[2]
>>
Rule 30 (If padding is SAME then the output size will be same as the input size.)
{v_1 : str, v_2 : tensor, v_3 : list(int)} |= v_1 = "SAME" ∧ shape(v_2, 1) = v_3[1] ∧ shape(v_2, 2) = v_3[2]
>>
Rule 31 (If ksize and strides are lists of length 4, and data format is NHWC, then height and width dimensions must be greater than 0)
{v_1 : list(int), v_2 : list(int), v_3 : str} |= v_1.len = 4 ∧ v_2.len = 4 ∧ v_3 = "NHWC" ∧ v_1[1] > 0 ∧ v_2[1] > 0 ∧ v_1[2] > 0 ∧ v_2[2] > 0
>>
Rule 32 (If ksize and strides are lists of length 4, and data format is NCHW, then height and width dimensions must be greater than 0)
{v_1 : list(int), v_2 : list(int), v_3 : str} |= v_1.len = 4 ∧ v_2.len = 4 ∧ v_3 = "NCHW" ∧ v_1[2] > 0 ∧ v_2[2] > 0 ∧ v_1[3] > 0 ∧ v_2[3] > 0
>>
Rule 33 (ksize must be a list and it should have same length as that of strides list)
{v_1 : list(int), v_2 : list(int)} |= v_1.len = v_2.len
>>
Rule 34 (if ksize is an integer, then it should be positive and less than shape of input tensor for height and width, and strides must be an int)
{v_1: tensor, v_2: int, v_3 : int} |= v_2 > 0 ∧ v_2 <= shape(v_1, 1) ∧ v_2 <= shape(v_1, 2) ∧ v_3 > 0
>>
Rule 35 (If ksize is an int and strides is a list, then the first element of the list must be less than or equal to ksize)
{v_1 : int, v_2 : list(int)} |= v_2.len > 0 ∧ v_2[0] ≤ v_1
>>
Rule 36 (If ksize is a list and strides is an int, then the first element of ksize list must be greater than or equal to strides)
{v_1 : list(int), v_2 : int} |= v_1.len > 0 ∧ v_1[0] ≥ v_2
>>
Rule 39 (If data_format is not NHWC or NCHW, then it is invalid)
{v_1 : str} |= v_1 ≠ "NHWC" ∧ v_1 ≠ "NCHW"
>>
Rule 42 (If ksize and strides are lists of length 4, all elements of ksize and strides must be positive)
{v_1 : list(int), v_2 : list(int)} |= (v_1.len = 4 ∧ v_2.len = 4) ∧ (∀i ∈ [0, 3] : v_1[i] > 0 ∧ v_2[i] > 0)
>>
Rule 43 (If the padding is SAME, the spatial dimensions of input and output are the same)
{v_1 : str, v_2 : tensor} |= if v_1 = "SAME" then shape(v_2, 1) > 0 ∧ shape(v_2, 2) > 0
>>
Rule 44 (If ksize is an int, then the shape of the input tensor should not be zero.)
{v_1 : int, v_2 : tensor} |= v_1 > 0 ∧ shape(v_2, 1) > 0 ∧ shape(v_2, 2) > 0
>>
Rule 46 (If the datatype of input is qint8, quint8, or qint32, then it should have a valid value for integer data)
{v_1 : tensor} |= dtype_(v_1) = 1 ∨ dtype_(v_1) = 5
>>
Rule 47 (If data_format is NHWC or NCHW, then input must have 4 dimensions)
{v_1 : tensor, v_2 : str} |= (v_2 = "NHWC" ∨ v_2 = "NCHW") ∧ ndim(v_1) = 4
>>
Rule 48 (If ksize is an int and is greater than height or width of the input, the program can crash.)
{v_1 : int, v_2 : tensor} |= v_1 < shape(v_2, 1) ∧ v_1 < shape(v_2, 2)
