Rule 1 (mask tensor must be boolean type)
{v_1 : tensor} |= dtype_(v_1) = 0
>>
Rule 2 (mask must have the exact same shape as inputs)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (axis must be within the valid range of dimensions of inputs)
{v_1 : int, v_2 : tensor} |= v_1 ≥ 0 - ndim(v_2) ∧ v_1 < ndim(v_2)
>>
Rule 4 (inputs tensor must have at least 1 dimension and no empty dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 1 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 5 (inputs tensor must have a floating-point or complex data type)
{v_1 : tensor} |= dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 10
>>
Rule 9 (all tuple axes within valid rank limits)
{v_1 : tuple(int), v_2 : tensor} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0 - ndim(v_2) ∧ v_1[i] < ndim(v_2)
>>
Rule 11 (uniqueness of axes in a list)
{v_1 : list(int)} |= ∀i ∈ [0, v_1.len - 1] : ∀j ∈ [0, v_1.len - 1] : if i ≠ j then v_1[i] ≠ v_1[j]
>>
Rule 12 (the dimension size along the softmax axis must be positive)
{v_1 : tensor, v_2 : int} |= if v_2 ≥ 0 then shape(v_1, v_2) > 0 else shape(v_1, ndim(v_1) + v_2) > 0
>>
Rule 13 (inputs and mask must have different data types)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ dtype_(v_2)
>>
Rule 14 (the list of axes must not be empty)
{v_1 : list(int)} |= v_1.len ≥ 1
>>
Rule 15 (inputs and mask must have matching number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 16 (negative or positive axis bounds check using conditional expression)
{v_1 : int, v_2 : tensor} |= if v_1 < 0 then ndim(v_2) + v_1 ≥ 0 else v_1 < ndim(v_2)
>>
Rule 17 (mask values must be bounded between 0 and 1)
{v_1 : tensor} |= min(v_1) ≥ 0 ∧ max(v_1) ≤ 1
>>
Rule 18 (the batch dimension, i.e., shape at index 0, of inputs and mask must be equal)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 19 (if axis is specified as a list, its length cannot exceed the inputs dimension count)
{v_1 : list(int), v_2 : tensor} |= v_1.len ≤ ndim(v_2)
>>
Rule 20 (inputs tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
