>>> b = lambda i, m: [i+1, tf.concat([m, m], axis=0)]
>>> tf.while_loop(
...     c, b, loop_vars=[i0, m0],
...     shape_invariants=[i0.get_shape(), tf.TensorShape([None, 2])])[1]
