>>> b = lambda i, p: (i + 1, Pair((p.j + p.k), (p.j - p.k)))
>>> ijk_final = tf.while_loop(c, b, ijk_0)[1]
>>> ijk_final[0].numpy().item(), ijk_final[1].numpy().item()
(32, 64)

