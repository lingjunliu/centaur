Rule 1 (paddings tensor should have rank 2)
{v_1 : tensor} |= ndim(v_1) = 2
>>
Rule 2 (paddings tensor's second dimension should be of size 2)
{v_1 : tensor} |= shape(v_1, 1) = 2
>>
Rule 3 (mode string must be one of the allowed values)
{v_1 : str} |= v_1 = "CONSTANT" ∨ v_1 = "REFLECT" ∨ v_1 = "SYMMETRIC"
>>
Rule 4 (constant_values must have the same data type as the input tensor when mode is "CONSTANT")
{v_1 : tensor, v_2 : dtype, v_3 : str} |= if v_3 = "CONSTANT" then dtype_(v_1) = v_2
>>
Rule 5 (paddings tensor's data type should be int32)
{v_1 : tensor} |= dtype_(v_1) = 3
>>
Rule 9 (rank of paddings equals the rank of tensor)
{v_1 : tensor, v_2 : tensor} |= shape(v_2, 0) = ndim(v_1)
>>
Rule 13 (paddings must be non-negative.)
{v_1 : tensor} |= ∀i ∈ [0, shape(v_1, 0) - 1] : v_1[i [ 0 ]] ≥ 0 ∧ v_1[i [ 1 ]] ≥ 0
>>
Rule 14 (REFLECT mode condition check against tensor dimension size)
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "REFLECT" then ∀i ∈ [0, shape(v_2, 0) - 1] : v_1[i [ 0 ]] ≤ shape(v_2, i) - 1 ∧ v_1[i [ 1 ]] ≤ shape(v_2, i) - 1
>>
Rule 15 (SYMMETRIC mode condition check against tensor dimension size)
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "SYMMETRIC" then ∀i ∈ [0, shape(v_2, 0) - 1] : v_1[i [ 0 ]] ≤ shape(v_2, i) ∧ v_1[i [ 1 ]] ≤ shape(v_2, i)
>>
