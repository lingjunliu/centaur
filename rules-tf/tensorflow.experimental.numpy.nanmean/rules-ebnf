>>
Rule 1 (Input tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 2 (Axis parameter must be a non-negative integer or None. None is not covered in this grammar, only integer is considered)
{v_1 : int} |= v_1 ≥ 0
>>
Rule 6 (If an axis is specified, it must be within the bounds of the tensor's dimensions)
{v_1 : tensor, v_2 : int} |= v_2 ≥ (0 - ndim(v_1)) ∧ v_2 < ndim(v_1)
>>
Rule 7 (Shape of input tensor has to be greater than 0)
{v_1 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0)
>>
Rule 8 (If a tensor is a boolean type, all elements are boolean)
{v_1 : tensor} |= dtype_(v_1) = 0
>>
Rule 9 (if there are two tensors, their shapes must be equal)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 13 (Shape of input tensor has to be greater than 0 along a given axis)
{v_1 : tensor, v_2 : int} |= shape(v_1, v_2) > 0
>>
Rule 15 (If dtype is specified, it has to be a floating point dtype.)
{v_1 : dtype} |= v_1 = 6 ∨ v_1 = 7 ∨ v_1 = 8
>>
Rule 16 (If axis is a tuple, all elements within the tuple must be within bounds)
{v_1 : tensor, v_2 : tuple(int)} |= (∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ (0 - ndim(v_1)) ∧ v_2[i] < ndim(v_1))
>>
Rule 17 (String value representing the data type should be from the allowed list.)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "mean" ∨ v_1 = "sum" ∨ v_1 = "max" ∨ v_1 = "min" ∨ v_1 = "prod" ∨ v_1 = "relu" ∨ v_1 = "tanh" ∨ v_1 = "sigmoid" ∨ v_1 = "softmax" ∨ v_1 = "elu" ∨ v_1 = "selu" ∨ v_1 = "gelu" ∨ v_1 = "swish" ∨ v_1 = "constant" ∨ v_1 = "linear" ∨ v_1 = "softplus"
>>
Rule 18 (If an axis is specified as a list of integers, each integer must be a valid axis for the tensor)
{v_1 : tensor, v_2 : list(int)} |= (∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ (0 - ndim(v_1)) ∧ v_2[i] < ndim(v_1))
>>
Rule 19 (If dtype is specified, it should be a valid numerical dtype.)
{v_1 : dtype} |= v_1 = 1 ∨ v_1 = 2 ∨ v_1 = 3 ∨ v_1 = 4 ∨ v_1 = 5 ∨ v_1 = 6 ∨ v_1 = 7 ∨ v_1 = 8 ∨ v_1 = 9 ∨ v_1 = 10
>>
Rule 20 (If axis is int and tensor is 1D, then axis value should always be 0.)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then v_2 = 0
>>
Rule 21 (Input tensor's dtype should not be string)
{v_1 : tensor} |= dtype_(v_1) ≠ 11
>>
Rule 22 (The specified axis should not be out of range even if the input tensor is empty along other dimensions.)
{v_1 : tensor, v_2 : int} |= if (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) then true else v_2 ≥ (0 - ndim(v_1)) ∧ v_2 < ndim(v_1)
>>
Rule 23 (If a tuple of axes is specified, the tuple cannot be empty.)
{v_1 : tuple(int)} |= v_1.len > 0
>>
Rule 24 (Dtype must be either floating point or complex.)
{v_1 : dtype} |= v_1 = 6 ∨ v_1 = 7 ∨ v_1 = 8 ∨ v_1 = 9 ∨ v_1 = 10
>>
Rule 25 (If input is complex, output should be complex.)
{v_1 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then true
>>
Rule 26 (If input tensor is complex128, then the minimum value should not be less than -1000)
{v_1 : tensor} |= if dtype_(v_1) = 10 then min(v_1) ≥ -1000
>>
Rule 27 (If axis is specified as a list, its length must be less than the number of dimensions)
{v_1 : tensor, v_2 : list(int)} |= v_2.len < ndim(v_1)
>>
Rule 28 (If the tensor is complex64, maximum element should be less than 1000)
{v_1 : tensor} |= if dtype_(v_1) = 9 then max(v_1) ≤ 1000
>>
Rule 29 (If axis is none, number of dimensions of output will be zero)
{v_1 : tensor, v_2 : str} |= if v_2 = "none" then ndim(v_1) = 0
>>
Rule 30 (If axis is a tuple, it should not contain duplicate values.)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : ∀j ∈ [i + 1, v_1.len - 1] : v_1[i] ≠ v_1[j]
>>
Rule 32 (If axis is specified as a tuple, all elements must be integers.)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : (v_1[i] ≥ -1000 ∧ v_1[i] ≤ 1000)
>>
Rule 33 (If dtype is float16, then the minimum value of the tensor should be larger than -65500)
{v_1 : tensor} |= if dtype_(v_1) = 6 then min(v_1) > -65500
>>
Rule 34 (If dtype is float16, then the maximum value of the tensor should be smaller than 65500)
{v_1 : tensor} |= if dtype_(v_1) = 6 then max(v_1) < 65500
>>
Rule 35 (If the dtype of the tensor is float, then its minimum should be greater than -1.7976931348623157e+308)
{v_1 : tensor} |= if dtype_(v_1) = 8 then min(v_1) > -1.7976931348623157e+308
>>
Rule 38 (If input tensor has integer dtype and axis is none, then min and max should be > 0.)
{v_1 : tensor, v_2 : str} |= if (dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5) ∧ v_2 = "none" then min(v_1) > 0 ∧ max(v_1) > 0
>>
Rule 39 (if the tensor is complex, then the real part and imaginary part should not exceed max float value)
{v_1 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then min(v_1) < 3.4028235e+38 ∧ max(v_1) < 3.4028235e+38
>>
Rule 41 (If keepdims is true and an axis is specified as an integer, the output tensor should have at least one dimension.)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then ndim(v_1) ≥ 1
>>
Rule 43 (If input tensor has integer dtype and axis is none, then min and max should be > 0 or min and max are < 0.)
{v_1 : tensor, v_2 : str} |= if (dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5) ∧ v_2 = "none" then (min(v_1) > 0 ∧ max(v_1) > 0) ∨ (min(v_1) < 0 ∧ max(v_1) < 0)
>>
Rule 44 (if the tensor is complex, then the min should be less than max.)
{v_1 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then min(v_1) ≤ max(v_1)
>>
Rule 45 (If axis is a tuple, the maximum value cannot be greater than number of dimensions)
{v_1 : tensor, v_2 : tuple(int)} |= (∀i ∈ [0, v_2.len - 1] : v_2[i] < ndim(v_1))
>>
Rule 46 (If keepdims is true and the dtype is int32 then the maximum dimension length can only be 256.)
{v_1 : tensor, v_2 : bool} |= if v_2 = true ∧ dtype_(v_1) = 3 then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≤ 256)
>>
Rule 47 (If keepdims is false, then the shape of the resulting tensor will be different, given axis)
{v_1 : tensor, v_2 : bool, v_3 : int} |= if v_2 = false then shape(v_1, v_3) = 0
>>
Rule 48 (If input tensor has integer dtype and axis is none, then min must be less than or equal to max.)
{v_1 : tensor, v_2 : str} |= if (dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5) ∧ v_2 = "none" then min(v_1) ≤ max(v_1)
>>
Rule 49 (If the tensor is complex, the square of min should not be greater than 1e+10)
{v_1 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then min(v_1) * min(v_1) ≤ 1e+10
>>
Rule 54 (if the tensor is complex, the square of min should not be greater than 1e+10 or the square of max should not be greater than 1e+10)
{v_1 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then (min(v_1) * min(v_1) ≤ 1e+10) ∨ (max(v_1) * max(v_1) ≤ 1e+10)
>>
Rule 55 (If axis is a tuple and a dimension is reduced, ensure it has a size bigger than 0)
{v_1 : tensor, v_2 : tuple(int)} |= (∀i ∈ [0, v_2.len - 1] : shape(v_1, v_2[i]) > 0)
>>
Rule 56 (If keepdims is false and axis is an int and its value equals number of dimensions, it should be false)
{v_1 : bool, v_2 : int, v_3 : tensor} |= if v_1 = false ∧ v_2 = ndim(v_3) then v_1 = false
>>
Rule 57 (If tensor and axis are the same type, shape must be equal)
{v_1 : tensor, v_2 : tensor} |=  if dtype_(v_1) = dtype_(v_2) then shape(v_1,0) = shape(v_2,0)
>>
Rule 58 (Dtype tensor can be int or float or complex)
{v_1 : tensor} |=  (dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5) ∨ (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∨ (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10)
>>
Rule 59 (If there is an axis, max needs to be more than zero)
{v_1 : int, v_2 : tensor} |= if v_1 > 0 then max(v_2) > 0
