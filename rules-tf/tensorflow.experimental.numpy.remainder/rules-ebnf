Rule 1 (The two input tensors should have the same number of dimensions.)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 7 (The size of each dimension of the tensors should be positive.)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 8 (Ensure that the result of shape function is a valid integer)
{v_1 : tensor, v_2 : int} |= v_2 ≥ 0 ∧ v_2 < ndim(v_1)
>>
Rule 10 (Tensors with dimension 0 are disallowed)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≠ 0
>>
Rule 13 (Input tensors should have numeric dtypes (not string or bool))
{v_1 : tensor} |= dtype_(v_1) ≠ 11 ∧ dtype_(v_1) ≠ 0
>>
Rule 14 (If one input is an integer type, the other must also be an integer type)
{v_1 : tensor, v_2 : tensor} |= if (1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5) then (1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5)
>>
Rule 15 (If one input is a floating-point type, the other must also be a floating-point or integer type.)
{v_1 : tensor, v_2 : tensor} |= if (6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8) then ((1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5) ∨ (6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8))
>>
Rule 16 (If one input is a complex type, the other must also be a complex or numeric type.)
{v_1 : tensor, v_2 : tensor} |= if (9 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10) then ((1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8) ∨ (9 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 10))
>>
Rule 19 (The output data type should be at least as precise as the input data types)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) < 6 ∧ dtype_(v_2) > 5) then false
>>
Rule 21 (Input tensors must have compatible data types for the remainder operation, v_1's dtype is int)
{v_1 : tensor, v_2 : tensor} |= if 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5 then ((1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5) ∨ (6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8))
>>
Rule 22 (Input tensors must have compatible data types for the remainder operation, v_1's dtype is float)
{v_1 : tensor, v_2 : tensor} |= if 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8 then ((1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5) ∨ (6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8))
>>
Rule 23 (Input tensors must have compatible data types for the remainder operation, v_1's dtype is complex)
{v_1 : tensor, v_2 : tensor} |= if 9 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10 then ((1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5) ∨ (6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8) ∨ (9 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 10))
>>
Rule 24 (Input tensors must have compatible data types for the remainder operation, v_2's dtype is int)
{v_1 : tensor, v_2 : tensor} |= if 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5 then ((1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5) ∨ (6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8))
>>
Rule 25 (Input tensors must have compatible data types for the remainder operation, v_2's dtype is float)
{v_1 : tensor, v_2 : tensor} |= if 6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8 then ((1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5) ∨ (6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8))
>>
Rule 26 (Input tensors must have compatible data types for the remainder operation, v_2's dtype is complex)
{v_1 : tensor, v_2 : tensor} |= if 9 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 10 then ((1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5) ∨ (6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8) ∨ (9 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10))
>>
Rule 27 (If v_1 is bool, v_2 should also be bool)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 0 then dtype_(v_2) = 0
>>
Rule 28 (If v_2 is bool, v_1 should also be bool)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_2) = 0 then dtype_(v_1) = 0
>>
Rule 31 (If v1 and v2 are both integer tensors, and v2 contains 0, then v1 must contain 0.)
{v_1 : tensor, v_2 : tensor} |= if (1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5) ∧ (1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5) then (∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = 0) ∨ (∃j ∈ [0, ndim(v_1) - 1] : shape(v_1, j) = 0)
>>
Rule 32 (If v1 is an int tensor and v2 is float tensor, v2 can't contain inf or nan)
{v_1 : tensor, v_2 : tensor} |= if (1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5) ∧ (6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8) then min(v_2) ≠ "inf" ∧ max(v_2) ≠ "inf" ∧ min(v_2) ≠ "nan" ∧ max(v_2) ≠ "nan"
>>
Rule 34 (if v1 is bool tensor, v2 also should be bool tensor, otherwise both shouldn't be bool tensor)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 0 ∧ dtype_(v_2) = 0) ∨ (dtype_(v_1) ≠ 0 ∧ dtype_(v_2) ≠ 0)
>>
Rule 35 (dtype of the tensors cannot be string)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 11 ∧ dtype_(v_2) ≠ 11
>>
Rule 36 (dtype of the tensors cannot be dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 12 ∧ dtype_(v_2) ≠ 12
>>
Rule 37 (v_1 and v_2's shape should be at least 1)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1
>>
Rule 38 (v_1's min value is not greater than v_2's max value)
{v_1 : tensor, v_2 : tensor} |= min(v_1) ≤ max(v_2)
>>
Rule 39 (v_2's min value is not greater than v_1's max value)
{v_1 : tensor, v_2 : tensor} |= min(v_2) ≤ max(v_1)
>>
Rule 41 (v1's and v2's elements' absolute values should be less than a limit)
{v_1 : tensor, v_2 : tensor} |= max(v_1) < 1000 ∧ max(v_2) < 1000 ∧ min(v_1) > -1000 ∧ min(v_2) > -1000
>>
Rule 42 (if v1's dimension is greater than 1, then the sizes of the first two dims should be different)
{v_1 : tensor} |= if ndim(v_1) > 1 then shape(v_1, 0) ≠ shape(v_1, 1)
>>
Rule 43 (If the tensors are 1D, their sizes should be the same)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 44 (If v1 and v2 are int tensors and v1's min value is 0, then v2's min value must be greater or equal than 0)
{v_1 : tensor, v_2 : tensor} |= if (1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5) ∧ (1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5) ∧ min(v_1) = 0 then min(v_2) ≥ 0
>>
Rule 45 (If v1 and v2 are float tensors and v1's max value is 1, then v2's max value must be less or equal than 1)
{v_1 : tensor, v_2 : tensor} |= if (6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8) ∧ (6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8) ∧ max(v_1) = 1 then max(v_2) ≤ 1
>>
Rule 46 (If one of the tensors' ndim is zero, the other's ndim should also be zero)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then ndim(v_2) = 0 else if ndim(v_2) = 0 then ndim(v_1) = 0
>>
Rule 48 (If v1 is a tuple then its length should be greater or equal to 1)
{v_1 : tuple(int)} |= v_1.len ≥ 1
>>
Rule 49 (If v2 is a tuple then its length should be greater or equal to 1)
{v_2 : tuple(int)} |= v_2.len ≥ 1
>>
Rule 50 (If v1 is a tuple of int then all its values should be smaller than 100)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] < 100
