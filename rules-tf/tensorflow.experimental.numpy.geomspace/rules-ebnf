{v_1 : tensor, v_2 : tensor, v_3 : dtype} |= if min(v_1) < 0 ∧ max(v_2) > 0 then v_3 ≠ 1 ∧ v_3 ≠ 2 ∧ v_3 ≠ 3 ∧ v_3 ≠ 4 ∧ v_3 ≠ 5
