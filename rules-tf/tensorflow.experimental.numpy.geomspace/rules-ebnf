{v_1 : tensor, v_2 : tensor, v_3 : dtype} |= if (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) ∨ (dtype_(v_2) = 9 ∨ dtype_(v_2) = 10) then v_3 = 9 ∨ v_3 = 10 ∨ v_3 = 0
