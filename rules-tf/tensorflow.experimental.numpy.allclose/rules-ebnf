>>
Rule 1 (rtol should be non-negative)
{v_1 : float} |= v_1 ≥ 0.0
>>
Rule 4 (input tensors should have the same dtype if equal_nan is false)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 = false then dtype_(v_1) = dtype_(v_2)
>>
Rule 5 (input tensors should have the same shape)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 7 (shapes should be compatible if one of the tensors has dimension 0)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 ∨ ndim(v_2) = 0 then true
>>
Rule 8 (If one tensor has dimension 0, the other must also have dimension 0, or be broadcastable)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then (ndim(v_2) = 0 ∨ ndim(v_2) > 0)
>>
Rule 9 (If the shapes of the tensors are different, they must be broadcastable)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≠ ndim(v_2) then (∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : (if (ndim(v_1) - i - 1) < 0 then shape(v_2, ndim(v_2) - i - 1) = 1 else if (ndim(v_2) - i - 1) < 0 then shape(v_1, ndim(v_1) - i - 1) = 1 else shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1) ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1))
>>
Rule 10 (equal_nan must be a boolean)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 12 (If either input is complex, the other input must also be complex.)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then dtype_(v_2) = 9 ∨ dtype_(v_2) = 10
>>
Rule 16 (If the shapes of the tensors are different, they must be broadcastable or at least one of them must be a scalar.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 ∨ ndim(v_2) = 0 then true else (∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : (if (ndim(v_1) - i - 1) < 0 then shape(v_2, ndim(v_2) - i - 1) = 1 else if (ndim(v_2) - i - 1) < 0 then shape(v_1, ndim(v_1) - i - 1) = 1 else shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1) ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1))
>>
Rule 18 (The shapes of the two tensors must be broadcastable.)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : (if (ndim(v_1) - i - 1) < 0 then shape(v_2, ndim(v_2) - i - 1) = 1 else if (ndim(v_2) - i - 1) < 0 then shape(v_1, ndim(v_1) - i - 1) = 1 else shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1) ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1))
>>
Rule 19 (rtol and atol must be non-negative)
{v_1 : float, v_2 : float} |= v_1 ≥ 0 ∧ v_2 ≥ 0
>>
Rule 22 (If one of the inputs is a scalar, its dtype should match the other one.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then dtype_(v_1) = dtype_(v_2) else if ndim(v_2) = 0 then dtype_(v_2) = dtype_(v_1)
>>
Rule 24 (If equal_nan is true, both tensors must have a floating point or complex dtype.)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 = true then (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) ∧ (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)
>>
Rule 26 (When equal_nan is set to True, at least one of the inputs must have a floating point or complex dtype.)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 = true then (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 ∨ dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)
>>
Rule 27 (If inputs have different floating point precision, higher precision should be used)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 6 ∧ dtype_(v_2) = 7) ∨ (dtype_(v_1) = 6 ∧ dtype_(v_2) = 8) ∨ (dtype_(v_1) = 7 ∧ dtype_(v_2) = 8) then true
>>
Rule 28 (If inputs are of different type, and equal_nan is False, conversion is required. Conversion to complex is not allowed)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 = false then if (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ (dtype_(v_2) = 9 ∨ dtype_(v_2) = 10) then false else if (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8) ∧ (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) then false
