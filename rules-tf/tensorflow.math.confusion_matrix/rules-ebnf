{labels: tensor, predictions:tensor, weights: tensor, dtype:dtype} |= if (dtype ≥ 6 ∧ dtype ≤ 9) then dtype_(labels) = dtype_(predictions) ∧ dtype_(labels) = dtype_(weights)
