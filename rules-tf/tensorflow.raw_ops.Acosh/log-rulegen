{v_1 : tensor} |= (∃i ∈ [0, ndim(v_1) − 1] : shape(v_1, i) = 0) ∨ min(v_1) ≥ 0

Rule 4 (tensor data types should match)
{v_1 : tensor, v_2 : tensor} |= dtype(v_1) = dtype(v_2)

Rule 3 (input tensors must have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)

Rule 12 (a primitive type variable is smaller than the other)
{v_1 : int ⊎ float, v_2 : int ⊎ float} |= v_1 ≤ v_2

