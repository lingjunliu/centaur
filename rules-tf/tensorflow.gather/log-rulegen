>>> batched_result_shape(
...     p_shape=params.shape.as_list(),
...     i_shape=indices.shape.as_list(),
...     axis=1,
...     batch_dims=1)
[3, 2]

>>> tf.gather(params, indices, axis=1, batch_dims=1).shape.as_list()
[3, 2]

