{v_1 : tensor, v_2 : tensor, v_3 : int, v_4 : int} |= ndim(v_1) = 4 ∧ ndim(v_2) = 4 ∧ v_3 ≥ 1 ∧ v_4 ≥ 0 ∧ v_3 × (shape(v_1, 2) − 1) + shape(v_2, 2) − 2 × v_4 > 0 ∧ v_3 × (shape(v_1, 3) − 1) + shape(v_2, 3) − 2 × v_4 > 0

Rule 22 (valid step size for a range)
{v_1 : int ⊎ float, v_2 : int ⊎ float, v_3 : int ⊎ float} |= if v_1 > 0 then v_2 ≤ v_3 else if v_1 < 0 then v_2 ≥ v_3 else true

Rule 12 (a primitive type variable is smaller than the other)
{v_1 : int ⊎ float, v_2 : int ⊎ float} |= v_1 ≤ v_2

Rule 4 (tensor data types should match)
{v_1 : tensor, v_2 : tensor} |= dtype(v_1) = dtype(v_2)

Rule 9 (4D tensor with all shape dimensions positive)
{v_1 : tensor} |= ndim(v_1) = 4 ∧ ∀i ∈ [0, 3] : shape(v_1, i) > 0

