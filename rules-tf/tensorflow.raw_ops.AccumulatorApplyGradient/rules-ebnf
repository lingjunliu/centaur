{v_1 : int, v_2 : str} |= if v_1 > 1000 then (∃i ∈ [0, v_2.len - 3] : (v_2[i] = "m" ∧ v_2[i+1] = "e" ∧ v_2[i+2] = "a" ∧ v_2[i+3] = "n") ∨ (v_2[i] = "s" ∧ v_2[i+1] = "u" ∧ v_2[i+2] = "m") ∨ (v_2[i] = "m" ∧ v_2[i+1] = "a" ∧ v_2[i+2] = "x") ∨ (v_2[i] = "m" ∧ v_2[i+1] = "i" ∧ v_2[i+2] = "n") ∨ (v_2[i] = "p" ∧ v_2[i+1] = "r" ∧ v_2[i+2] = "o" ∧ v_2[i+3] = "d"))
