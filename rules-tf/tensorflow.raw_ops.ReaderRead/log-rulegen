<tuple_access>  ::= "[" <expr> "]" | ".len"
<func_call> ::= <FUNC> "(" <TENSORVAR> [ "," <expr> ] ")"
<constant> ::= <NUMBER> | "true" | "false" | <STRING>
<COMPOP> ::= "=" | "≠" | ">" | "<" | "≥" | "≤"
<ADDOP> ::= "+" | "-"
<MULOP> ::= "*" | "/" | "%"
<FUNC> ::= "ndim" | "shape" | "dtype_" | "min" | "max"
<PRIMVAR> ::= any variable name (e.g., matches [a-zA-Z_][a-zA-Z_0-9]*)
