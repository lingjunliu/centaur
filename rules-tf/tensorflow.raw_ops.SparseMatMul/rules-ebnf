Rule 2 (The inner dimension of 'a' must match the outer dimension of 'b')
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 1) = shape(v_2, 0)
>>
Rule 3 (transpose_a must be a boolean)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 7 (If a_is_sparse is true, then at least one of 'a' or 'b' must be sparse.)
{v_1 : bool, v_2 : bool, v_3 : bool} |= if v_1 = true then v_2 = true ∨ v_3 = true
>>
Rule 8 (if transpose_a is true, the shape of 'a' is transposed before multiplication)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then shape(v_1, 0) = shape(v_1, 1)
>>
Rule 14 (If transpose_a is true, the outer dimension of transposed 'a' must match the outer dimension of 'b')
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 = true then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 15 (If transpose_b is true, the inner dimension of 'a' must match the outer dimension of transposed 'b')
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 = true then shape(v_1, 1) = shape(v_2, 1)
>>
Rule 18 (Data type of tensor 'a' must be either float32 (7) or bfloat16 (6))
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 6
>>
Rule 23 (The inner dimension of 'a' must match the outer dimension of 'b', if neither is transposed.)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if v_3 = false ∧ v_4 = false then shape(v_1, 1) = shape(v_2, 0)
>>
Rule 26 (If transpose_a is true, the outer dimension of the transposed 'a' matches the outer dimension of 'b' if transpose_b is false.)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4: bool} |= if v_3 = true ∧ v_4 = false then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 27 (If transpose_b is true, the inner dimension of 'a' matches the outer dimension of the transposed 'b'.)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4: bool} |= if v_4 = true ∧ v_3 = false then shape(v_1, 1) = shape(v_2, 1)
>>
Rule 32 (If transpose_a is true and transpose_b is false, outer dimension of A should match outer dimension of B.)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if v_3 = true ∧ v_4 = false then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 33 (If transpose_a is false and transpose_b is true, inner dimension of A should match inner dimension of B.)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if v_3 = false ∧ v_4 = true then shape(v_1, 1) = shape(v_2, 1)
>>
Rule 34 (If transpose_a and transpose_b are true, outer dimension of A should match inner dimension of B.)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if v_3 = true ∧ v_4 = true then shape(v_1, 0) = shape(v_2, 1)
>>
Rule 40 (If transpose_a is true, the condition of inner and outer dimension must be met)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if v_3 = true ∧ v_4 = false then shape(v_1, 0) = shape(v_2, 0) else if v_3 = true ∧ v_4 = true then shape(v_1, 0) = shape(v_2, 1)
