   array([[4400, 4730],
       [4532, 4874],
       [4664, 5018],
       [4796, 5162],
       [4928, 5306]])>
  
  # Another example
  d = tf.random.uniform((3,4,5))
  e = tf.random.uniform((5,3,2))
  f = tf.tensordot(d,e, axes=([2,0],[0,1]))
  f
  
