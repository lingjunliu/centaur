Rule 1 (axes parameter must be a tuple of length 2)
{v_1 : tuple(int)} |= v_1.len = 2
>>
Rule 2 (axes elements must be valid dimension indices of the inputs tensor)
{v_1 : tuple(int), v_3 : tensor} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] < ndim(v_3) ∧ v_1[i] ≥ 0 - ndim(v_3)
>>
Rule 3 (inputs tensor must be at least 2-dimensional)
{v_3 : tensor} |= ndim(v_3) ≥ 2
>>
Rule 4 (all shape dimensions of the inputs tensor must be positive)
{v_3 : tensor} |= ∀i ∈ [0, ndim(v_3) - 1] : shape(v_3, i) > 0
>>
Rule 6 (the input tensor must have a floating-point data type)
{v_3 : tensor} |= dtype_(v_3) ≥ 6 ∧ dtype_(v_3) ≤ 8
>>
Rule 9 (if normalization is enabled, the inputs tensor must have a floating-point data type)
{v_2 : bool, v_3 : tensor} |= if v_2 = true then dtype_(v_3) ≥ 6 ∧ dtype_(v_3) ≤ 8
>>
Rule 10 (the axes tuple must contain either 1 or 2 elements)
{v_1 : tuple(int)} |= v_1.len > 0 ∧ v_1.len ≤ 2
>>
Rule 11 (the size of the input tensor along the specified axes must be equal when 2 axes are provided)
{v_1 : tuple(int), v_3 : tensor} |= if v_1.len = 2 then shape(v_3, v_1[0]) = shape(v_3, v_1[1])
>>
Rule 12 (the dimensions of the input tensor must be between 2 and 5 inclusive)
{v_3 : tensor} |= ndim(v_3) ≥ 2 ∧ ndim(v_3) ≤ 5
