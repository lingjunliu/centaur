>>
Rule 1 (x must be int32 or int64 tensor)
{x : tensor} |= dtype_(x) = 3 ∨ dtype_(x) = 4
>>
Rule 2 (x values should be in range [-4, 4))
{x : tensor} |= min(x) ≥ -4 ∧ max(x) < 4
>>
Rule 3 (src_format and dst_format must be a valid string)
{src_format : str, dst_format : str} |= (src_format = "ii" ∨ src_format = "ii->i" ∨ src_format = "i,j->ij" ∨ src_format = "bij,bjk->bik" ∨ src_format = "...ij->...ji" ∨ src_format = "bn,anm,bm->ba" ∨ src_format = "none" ∨ src_format = "sum" ∨ src_format = "max" ∨ src_format = "min" ∨ src_format = "prod" ∨ src_format = "relu" ∨ src_format = "tanh" ∨ src_format = "sigmoid" ∨ src_format = "softmax" ∨ src_format = "elu" ∨ src_format = "selu" ∨ src_format = "gelu" ∨ src_format = "swish" ∨ src_format = "softplus" ∨ src_format = "linear" ∨ src_format = "valid" ∨ src_format = "same" ∨ src_format = "causal" ∨ src_format = "channels_last" ∨ src_format = "channels_first") ∧ (dst_format = "ii" ∨ dst_format = "ii->i" ∨ dst_format = "i,j->ij" ∨ dst_format = "bij,bjk->bik" ∨ dst_format = "...ij->...ji" ∨ dst_format = "bn,anm,bm->ba" ∨ dst_format = "none" ∨ dst_format = "sum" ∨ dst_format = "max" ∨ dst_format = "min" ∨ dst_format = "prod" ∨ dst_format = "relu" ∨ dst_format = "tanh" ∨ dst_format = "sigmoid" ∨ dst_format = "softmax" ∨ dst_format = "elu" ∨ dst_format = "selu" ∨ dst_format = "gelu" ∨ dst_format = "swish" ∨ dst_format = "softplus" ∨ dst_format = "linear" ∨ dst_format = "valid" ∨ dst_format = "same" ∨ dst_format = "causal" ∨ dst_format = "channels_last" ∨ dst_format = "channels_first")
>>
Rule 4 (src_format and dst_format must be different)
{src_format : str, dst_format : str} |= src_format ≠ dst_format
>>
Rule 6 (x ndim should be less than or equal to 5)
{x : tensor} |= ndim(x) ≤ 5
>>
Rule 7 (x tensor has a positive shape)
{x : tensor} |= ∀i ∈ [0, ndim(x) - 1] : shape(x, i) > 0
>>
Rule 8 (src_format and dst_format should be valid)
{src_format : str, dst_format : str} |= (src_format = "NHWC" ∨ src_format = "NCHW") ∧ (dst_format = "NHWC" ∨ dst_format = "NCHW")
>>
Rule 9 (If src_format is NHWC, then dst_format is not NHWC)
{src_format : str, dst_format : str} |= if src_format = "NHWC" then dst_format ≠ "NHWC"
>>
Rule 10 (x shape should match the src_format and dst_format)
{x : tensor, src_format : str, dst_format : str} |= if src_format = "NHWC" then (if dst_format = "NCHW" then ndim(x) = 1)
>>
Rule 11 (x tensor elements should be unique)
{x : tensor} |= ∀i ∈ [0, ndim(x)-1] : ∀j ∈ [i+1, ndim(x)-1] : x[i] ≠ x[j]
>>
Rule 12 (If src_format is channels_first then dst_format is channels_last)
{src_format : str, dst_format : str} |= if src_format = "channels_first" then dst_format = "channels_last"
>>
Rule 13 (If x is a scalar, src_format and dst_format must be equal)
{x : tensor, src_format : str, dst_format : str} |= if ndim(x) = 0 then src_format = dst_format
>>
Rule 16 (x values depending on src_format)
{x : tensor, src_format : str} |= ∀i ∈ [0, ndim(x) - 1] : if src_format = "NHWC" then -4 ≤ x[i] ∧ x[i] < 4
>>
Rule 17 (x values depending on dst_format)
{x : tensor, dst_format : str} |= ∀i ∈ [0, ndim(x) - 1] : if dst_format = "NCHW" then -4 ≤ x[i] ∧ x[i] < 4
>>
Rule 18 (x must be a 1D tensor if src_format or dst_format contains '...'))
{x : tensor, src_format : str, dst_format : str} |= if src_format = "...ij->...ji" ∨ dst_format = "...ij->...ji" then ndim(x) = 1
>>
Rule 19 (x values are only 0 and 1)
{x : tensor} |= ∀i ∈ [0, ndim(x) - 1] : x[i] = 0 ∨ x[i] = 1
>>
Rule 20 (x values must be valid indices in the format strings)
{x : tensor, src_format : str} |= ∀i ∈ [0, ndim(x) - 1] : if src_format = "channels_last" then x[i] ≥ 0 ∧ x[i] ≤ 3
>>
Rule 21 (if dst_format is none, then x values should be zero)
{x : tensor, dst_format : str} |= if dst_format = "none" then ∀i ∈ [0, ndim(x) - 1] : x[i] = 0
>>
Rule 22 (if src_format and dst_format are the same, then x should not change)
{x : tensor, src_format : str, dst_format : str} |= if src_format = dst_format then ∀i ∈ [0, ndim(x) - 1] : x[i] = i
>>
Rule 23 (src_format length should be greater than or equal to dst_format)
{src_format : str, dst_format : str} |= src_format.len ≥ dst_format.len
>>
Rule 24 (if src_format is 'none', dst_format must also be 'none')
{src_format : str, dst_format : str} |= if src_format = "none" then dst_format = "none"
>>
Rule 26 (if x contains duplicate values)
{x : tensor} |= ∃i ∈ [0, ndim(x) - 1] : ∃j ∈ [i+1, ndim(x) - 1] : x[i] = x[j]
>>
Rule 27 (if x has the same value for all indices, all dims are mapped to the same dim in target)
{x : tensor} |= ∀i ∈ [0, ndim(x)-1] : ∀j ∈ [i+1, ndim(x)-1] : x[i] = x[j]
>>
Rule 28 (if the src_format or dst_format contain 'b' then the ndim(x) has to be 3 )
{x : tensor, src_format : str, dst_format : str} |= if src_format = "bij,bjk->bik" ∨ dst_format = "bij,bjk->bik" ∨ src_format = "bn,anm,bm->ba" ∨ dst_format = "bn,anm,bm->ba" then ndim(x) = 1
>>
Rule 29 (x values are sequential, starting from 0)
{x : tensor} |= ∀i ∈ [0, ndim(x) - 1] : x[i] = i
>>
Rule 30 (if src_format is "channels_last" then dst_format should not be 'ii' or 'ii->i')
{src_format : str, dst_format : str} |= if src_format = "channels_last" then dst_format ≠ "ii" ∧ dst_format ≠ "ii->i"
>>
Rule 31 (If src_format is channels_first, the values in x can only be 0, 1, 2, 3)
{x : tensor, src_format : str} |= if src_format = "channels_first" then ∀i ∈ [0, ndim(x) - 1] : (x[i] ≥ 0 ∧ x[i] ≤ 3)
>>
Rule 32 (dst_format must have unique characters)
{dst_format : str} |= ∀i ∈ [0, dst_format.len - 1] : ∀j ∈ [i+1, dst_format.len - 1] : dst_format[i] ≠ dst_format[j]
>>
Rule 33 (If dst_format length is not equal to 0, then the number of dims in x must be less than the length of the format)
{x : tensor, dst_format : str} |= if dst_format.len ≠ 0 then ndim(x) ≤ dst_format.len
>>
Rule 34 (If dst_format is an empty string, x should also be an empty tensor, i.e., ndim = 0)
{x : tensor, dst_format : str} |= if dst_format = "" then ndim(x) = 0
>>
Rule 36 (This API does not support bool tensors)
{x : tensor} |= dtype_(x) ≠ 0
>>
Rule 37 (If the src_format or dst_format is "none", then the shape of the result tensor equals the shape of the input tensor.)
{x : tensor, src_format : str, dst_format : str} |= if src_format = "none" ∨ dst_format = "none" then ∀i ∈ [0, ndim(x) - 1] : shape(x, i) = shape(x, i)
>>
Rule 38 (if ndim(x) > 0 then both src_format and dst_format can not be "none" )
{x : tensor, src_format : str, dst_format : str} |= if ndim(x) > 0 then (src_format ≠ "none" ∨ dst_format ≠ "none")
>>
Rule 40 (The length of src_format and dst_format should be the same.)
{src_format : str, dst_format : str} |= src_format.len = dst_format.len
>>
Rule 42 (If x values are greater than 3, raise an exception )
{x : tensor} |= ∀i ∈ [0, ndim(x)-1] : x[i] ≤ 3
>>
Rule 43 (If the tensor 'x' has values that are out of range [-4,3], return a tensor filled with -1.)
{x : tensor} |= ∀i ∈ [0, ndim(x)-1] : if x[i] < -4 ∨ x[i] > 3 then x[i] = -1
>>
Rule 44 (if src_format includes 'i,j->ij' and x is two dimensional, it should be a valid matrix multiplication)
{x : tensor, src_format : str} |= if src_format = "i,j->ij" then (ndim(x) = 1 ∧ shape(x,0) = 2)
>>
Rule 45 (When using formats that use '...', all dimensions except the last two are mapped to themselves.)
{x : tensor, src_format : str} |= if src_format = "...ij->...ji" then ∀i ∈ [0, ndim(x)-3] : x[i] = i
>>
Rule 46 (If dst_format contains a character not in src_format, then raise an exception)
{src_format : str, dst_format : str} |= ∀i ∈ [0, dst_format.len - 1] : ∃j ∈ [0, src_format.len - 1] : dst_format[i] = src_format[j]
>>
Rule 47 (if src_format includes 'bn,anm,bm->ba' and x is three dimensional, then map dim 0 -> 0, dim 1 -> 1 and dim 2 -> 1)
{x : tensor, src_format : str} |= if src_format = "bn,anm,bm->ba" then (ndim(x) = 1 ∧ x[0] = 0 ∧ x[1] = 1 ∧ x[2] = 1)
>>
Rule 51 (if src_format or dst_format is None, x values should all be 0.)
{x : tensor, src_format : str, dst_format : str} |= if src_format = "none" ∨ dst_format = "none" then ∀i ∈ [0, ndim(x) - 1] : x[i] = 0
>>
Rule 52 (If src_format is "ii", then x should only have the value 0 or 1.)
{x : tensor, src_format : str} |= if src_format = "ii" then ∀i ∈ [0, ndim(x) - 1] : x[i] = 0 ∨ x[i] = 1
>>
Rule 53 (If dst_format is "ii", then x should only have the value 0 or 1.)
{x : tensor, dst_format : str} |= if dst_format = "ii" then ∀i ∈ [0, ndim(x) - 1] : x[i] = 0 ∨ x[i] = 1
>>
Rule 54 (If both formats have a character that corresponds to the index, keep its index)
{x : tensor, src_format : str, dst_format : str} |= ∀i ∈ [0, ndim(x) - 1] : ∃j ∈ [0, src_format.len - 1] : ∃k ∈ [0, dst_format.len - 1] : if src_format[j] = dst_format[k] ∧ x[i] = j then x[i] = k
>>
Rule 57 ( If src_format and dst_format have same character set then the transformation matrix should be identity)
{x : tensor, src_format: str, dst_format:str} |= if (∀i ∈ [0, src_format.len -1] : ∃j ∈ [0, dst_format.len -1]: src_format[i] = dst_format[j]) ∧ (∀k ∈ [0, dst_format.len -1]: ∃l ∈ [0, src_format.len -1]: dst_format[k] = src_format[l]) then  ∀m ∈ [0, ndim(x) -1]: x[m] = m
>>
Rule 59 (If src_format is "NHWC" and dst_format is "NCHW", the mapping is [0, 3, 1, 2])
{x : tensor, src_format : str, dst_format : str} |= if src_format = "NHWC" ∧ dst_format = "NCHW" then (x[0] = 0 ∧ x[1] = 3 ∧ x[2] = 1 ∧ x[3] = 2)
>>
Rule 60 (If src_format is "NCHW" and dst_format is "NHWC", the mapping is [0, 2, 3, 1])
{x : tensor, src_format : str, dst_format : str} |= if src_format = "NCHW" ∧ dst_format = "NHWC" then (x[0] = 0 ∧ x[1] = 2 ∧ x[2] = 3 ∧ x[3] = 1)
>>
Rule 61 (x's values are a permutation of 0, 1, 2, 3)
{x : tensor} |= ndim(x) = 1 ∧ shape(x, 0) = 4 ∧ (x[0] ≠ x[1] ∧ x[0] ≠ x[2] ∧ x[0] ≠ x[3] ∧ x[1] ≠ x[2] ∧ x[1] ≠ x[3] ∧ x[2] ≠ x[3]) ∧ (x[0] ≥ 0 ∧ x[0] ≤ 3 ∧ x[1] ≥ 0 ∧ x[1] ≤ 3 ∧ x[2] ≥ 0 ∧ x[2] ≤ 3 ∧ x[3] ≥ 0 ∧ x[3] ≤ 3)
