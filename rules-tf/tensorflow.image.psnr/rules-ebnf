{a : tensor, b : tensor} |= (dtype_(a) = 7 ∧ dtype_(b) = 7) ∨ (dtype_(a) = 8 ∧ dtype_(b) = 8) ∨ (dtype_(a) = 5 ∧ dtype_(b) = 5) ∨ (dtype_(a) = 1 ∧ dtype_(b) = 1) ∨ (dtype_(a) = 2 ∧ dtype_(b) = 2) ∨ (dtype_(a) = 3 ∧ dtype_(b) = 3) ∨ (dtype_(a) = 4 ∧ dtype_(b) = 4)
