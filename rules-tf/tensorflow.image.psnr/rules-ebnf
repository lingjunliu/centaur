{a : tensor, b : tensor, max_val : float} |= (∀i ∈ [0, shape(a,0)-1] : min(a) ≥ 0 ∧ max(a) ≤ max_val) ∧ (∀i ∈ [0, shape(b,0)-1] : min(b) ≥ 0 ∧ max(b) ≤ max_val)
