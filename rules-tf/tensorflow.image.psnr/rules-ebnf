Rule 9 (if a is an integer tensor, max_val should be an integer without decimal part.)
{a : tensor, max_val : float} |= if dtype_(a) = 1 ∨ dtype_(a) = 2 ∨ dtype_(a) = 3 ∨ dtype_(a) = 4 ∨ dtype_(a) = 5 then max_val % 1 = 0
>>
Rule 10 (The dtype of a and b should be float if max_val is less than 1)
{a : tensor, b : tensor, max_val : float} |= if max_val < 1 then dtype_(a) = 7 ∧ dtype_(b) = 7 ∨ dtype_(a) = 8 ∧ dtype_(b) = 8
