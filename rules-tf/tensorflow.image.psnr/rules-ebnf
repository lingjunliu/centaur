{a : tensor, b : tensor} |= (dtype_(a) = 5 ∧ dtype_(b) = 5) ∨ (dtype_(a) = 7 ∧ dtype_(b) = 7) ∨ (dtype_(a) = 8 ∧ dtype_(b) = 8)
