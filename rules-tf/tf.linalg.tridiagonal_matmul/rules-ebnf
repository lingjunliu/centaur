Rule 23 (when diagonals_format is compact, the shape of rhs must match M in diagonals [..., 3, M])
{v_1 : tensor, v_2 : str, v_3 : tensor} |= if v_2 = "compact" then shape(v_1, ndim(v_1) - 1) = shape(v_3, ndim(v_3) - 2)
