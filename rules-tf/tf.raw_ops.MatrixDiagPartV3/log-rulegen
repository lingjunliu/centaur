          [4, 3, 8],
          [5, 2, 7],
          [0, 1, 6]]]

  # max_diag_len can be shorter than the main diagonal.
  tf.matrix_diag_part(input, k = (-2, -1))
    ==> [[[5, 8],
          [9, 0]],
         [[1, 6],
          [5, 0]]]

