Rule 1 (Input tensor should have at least two dimensions to represent a matrix)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (The last two dimensions of the input tensor should be equal to represent a square matrix)
{v_1 : tensor} |= shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 3 (If the input tensor has more than 2 dimensions, the batch dimensions should be positive.)
{v_1 : tensor} |= if ndim(v_1) > 2 then ∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) > 0
>>
Rule 4 (Input tensor must not contain NaN or Inf values)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : min(v_1) > -10000000 ∧ max(v_1) < 10000000
>>
Rule 5 (The shape of a second tensor should be compatible with the first one for matmul operation)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2) else false
>>
Rule 7 (If `is_non_singular` is true, then determinant should be non-zero)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then min(v_1) ≠ 0 ∧ max(v_1) ≠ 0
>>
Rule 8 (Shape of input tensor should not be an empty tuple.)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 9 (If the rank of a tensor is 2 and the shape is (N, N), then N should be positive)
{v_1 : tensor} |= if ndim(v_1) = 2 then shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0
>>
Rule 10 (Check if the datatype of the tensor is a floating-point or complex type.)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
>>
Rule 15 (The shape of a second tensor should be compatible with the first one for matmul operation)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 1 ∧ ndim(v_2) > 0 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2)
>>
Rule 18 (If a boolean flag is given for `is_square`, it must align with the shape of the input tensor being square)
{v_1 : tensor, v_2 : bool} |= if v_2 = true then shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
