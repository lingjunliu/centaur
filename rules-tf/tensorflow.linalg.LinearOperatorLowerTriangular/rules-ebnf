{v_1 : tensor, v_2 : bool} |= if v_2 = true ∧ shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2) then min(v_1) ≠ 0 ∧ max(v_1) ≠ 0
