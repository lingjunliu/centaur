Rule 1 (Add layer requires at least two input tensors)
{v_1 : list(tensor)} |= v_1.len ≥ 2
>>
Rule 2 (Inputs can be a list or tuple of tensors and must have at least two elements)
{v_1 : list(tensor) ⊎ tuple(tensor)} |= v_1.len ≥ 2
>>
Rule 3 (The input list of tensors must not be empty)
{v_1 : list(tensor)} |= v_1.len > 0
>>
Rule 4 (Input list must contain a reasonable number of tensors)
{v_1 : list(tensor)} |= v_1.len ≥ 2 ∧ v_1.len ≤ 64
>>
Rule 5 (Layer name parameter must be a non-empty string)
{v_1 : str} |= v_1 ≠ ""
>>
Rule 6 (Layer dtype parameter represented as an integer must be a floating-point type)
{v_1 : int} |= 6 ≤ v_1 ∧ v_1 ≤ 8
>>
Rule 7 (two input tensors to Add must have exactly the same shape)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 8 (two input tensors to Add must have the same data type)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 9 (input tensors to Add must have numeric data types)
{v_1 : tensor} |= dtype_(v_1) ≤ 10
>>
Rule 10 (three input tensors to Add must have matching shapes)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ndim(v_2) = ndim(v_3) ∧ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∧ shape(v_2, i) = shape(v_3, i))
>>
Rule 11 (input tensors must have at least 1 dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 12 (input tensors to Add cannot be of boolean type)
{v_1 : tensor} |= dtype_(v_1) ≥ 1
>>
Rule 13 (batch sizes of the two input tensors to Add must match)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ shape(v_1, 0) = shape(v_2, 0)
>>
Rule 14 (if both input tensors have at least two dimensions, their second dimensions must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2 then shape(v_1, 1) = shape(v_2, 1)
>>
Rule 15 (if both input tensors have integer datatypes, they must have the same datatype index)
{v_1 : tensor, v_2 : tensor} |= if 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5 ∧ 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5 then dtype_(v_1) = dtype_(v_2)
