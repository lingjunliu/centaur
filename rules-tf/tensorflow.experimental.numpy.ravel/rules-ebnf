Rule 1 (ravel only accepts a single tensor input)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 2 (Shape of the raveled tensor is the product of the original tensor's dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) = 1 ∧ shape(v_2, 0) = (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i))
>>
Rule 3 (Raveling a 0-dimensional tensor results in a 1-dimensional tensor of size 1)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 0 ∧ ndim(v_2) = 1 ∧ shape(v_2, 0) = 1
>>
Rule 4 (Dtype of the raveled tensor matches the original tensor)
{v_1 : tensor} |= dtype_(v_1) = dtype_(v_1)
>>
Rule 5 (Raveling a tensor does not change the dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 6 (Raveling a tensor with one element results in the same value)
{v_1 : tensor} |= if (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1) then true else false
>>
Rule 7 (Ravel preserves the total number of elements)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i)) = shape(v_2, 0)
>>
Rule 9 (If the input is a scalar (0-dimensional tensor), the output is a 1-dimensional tensor with a single element)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then ndim(v_2) = 1 ∧ shape(v_2, 0) = 1
>>
Rule 10 (Raveling a tensor with a boolean dtype is allowed)
{v_1 : tensor} |= dtype_(v_1) = 0
>>
Rule 11 (If input tensor's dtype is string, it's allowed)
{v_1 : tensor} |= dtype_(v_1) = 11
>>
Rule 12 (If input tensor's dtype is complex64 or complex128, it's allowed)
{v_1 : tensor} |= dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 13 (Raveling a tensor with an integer dtype is allowed)
{v_1 : tensor} |= dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5
>>
Rule 14 (Raveling a tensor with a float dtype is allowed)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 17 (If the input is a 1D tensor, ravel does nothing)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 then shape(v_1, 0) = shape(v_2, 0)
