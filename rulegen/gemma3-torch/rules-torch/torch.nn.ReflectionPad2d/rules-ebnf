Rule 5 (padding length is less than input dimension)
{padding : int, input : tensor} |= padding < shape(input, 0) ∧ padding < shape(input, 1)
>>
Rule 6 (padding values less than input dimensions for tuple)
{padding : tuple(int), input : tensor} |= padding[0] < shape(input, 1) ∧ padding[1] < shape(input, 1) ∧ padding[2] < shape(input, 0) ∧ padding[3] < shape(input, 0)
>>
Rule 12 (input dimension check - avoiding negative output dimensions)
{padding : int, input : tensor} |= shape(input, 0) + 2 * padding >= 0 ∧ shape(input, 1) + 2 * padding >= 0
>>
Rule 13 (tuple padding dimension check)
{padding : tuple(int), input : tensor} |= shape(input, 0) + padding[2] + padding[3] >= 0 ∧ shape(input, 1) + padding[0] + padding[1] >= 0
>>
Rule 15 (padding tuple value range check)
{padding : tuple(int), input : tensor} |= padding[0] <= 2 * shape(input,1) ∧ padding[1] <= 2 * shape(input,1) ∧ padding[2] <= 2 * shape(input,0) ∧ padding[3] <= 2 * shape(input,0)
