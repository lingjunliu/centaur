>>
Rule 1 (valid reduction mode string)
{v_4 : str} |= v_4 = "none" ∨ v_4 = "mean" ∨ v_4 = "sum"
>>
Rule 2 (input and target must have identical shapes to avoid size mismatch)
{v_5 : tensor, v_6 : tensor} |= ndim(v_5) = ndim(v_6) ∧ ∀i ∈ [0, ndim(v_5) - 1] : shape(v_5, i) = shape(v_6, i)
>>
Rule 3 (float input required when using mean reduction to avoid dtype inference error)
{v_4 : str, v_5 : tensor} |= if v_4 = "mean" then (dtype_(v_5) = 6 ∨ dtype_(v_5) = 7 ∨ dtype_(v_5) = 8)
>>
Rule 4 (input tensor must not be complex to avoid clamp unsupported error)
{v_5 : tensor} |= dtype_(v_5) ≠ 9 ∧ dtype_(v_5) ≠ 10
>>
Rule 5 (input tensor must not be boolean to avoid boolean subtraction error)
{v_5 : tensor} |= dtype_(v_5) ≠ 0
>>
Rule 6 (if input is float16, margin must be within fp16 range to avoid overflow)
{v_1 : float, v_5 : tensor} |= if dtype_(v_5) = 6 then (v_1 ≥ -65504 ∧ v_1 ≤ 65504)
>>
Rule 7 (target labels restricted to -1 or 1)
{v_6 : tensor} |= (min(v_6) = -1 ∨ min(v_6) = 1) ∧ (max(v_6) = -1 ∨ max(v_6) = 1)
>>
Rule 8 (reduce=False implies no reduction)
{v_3 : bool, v_4 : str} |= if v_3 = false then v_4 = "none"
>>
Rule 9 (reduce=True with size_average=True implies mean reduction)
{v_2 : bool, v_3 : bool, v_4 : str} |= if (v_3 = true ∧ v_2 = true) then v_4 = "mean"
>>
Rule 10 (reduce=True with size_average=False implies sum reduction)
{v_2 : bool, v_3 : bool, v_4 : str} |= if (v_3 = true ∧ v_2 = false) then v_4 = "sum"
