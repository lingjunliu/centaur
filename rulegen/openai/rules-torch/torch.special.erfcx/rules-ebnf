>>
Rule 1 (input dtype must be float32 or float64)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 2 (suppress Half not implemented: input cannot be float16)
{v_1 : tensor} |= dtype_(v_1) ≠ 6
>>
Rule 3 (out tensor must match input dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_2) = dtype_(v_1)
>>
Rule 4 (out tensor must have the same shape as input)
{v_1 : tensor, v_2 : tensor} |= ndim(v_2) = ndim(v_1) ∧ (if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) = shape(v_1, i))
