Rule 1 (A must be 2D+ and of supported dtype (float32/float64/complex64/complex128))
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10)
>>
Rule 2 (Hermitian=True requires square matrices on the last two dims)
{v_1 : tensor, v_2 : bool} |= ndim(v_1) ≥ 2 ∧ (if v_2 then shape(v_1, -2) = shape(v_1, -1))
>>
Rule 3 (Valid float tolerances with out: shape/batch-compatible and nonnegative tolerances)
{v_1 : tensor, v_2 : float, v_3 : float, v_4 : bool, v_5 : tensor} |= ndim(v_1) ≥ 2 ∧ v_2 ≥ 0 ∧ v_3 ≥ 0 ∧ ndim(v_5) = ndim(v_1) ∧ shape(v_5, -2) = shape(v_1, -1) ∧ shape(v_5, -1) = shape(v_1, -2) ∧ (if ndim(v_1) ≥ 3 then ∀i ∈ [0, ndim(v_1) - 3] : shape(v_5, i) = shape(v_1, i)) ∧ (v_4 = true ∨ v_4 = false)
>>
Rule 4 (Valid tensor tolerances: rtol/atol are 0-D tensors and hermitian is bool)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : bool} |= ndim(v_1) ≥ 2 ∧ ndim(v_2) = 0 ∧ ndim(v_3) = 0 ∧ (v_4 = true ∨ v_4 = false)
>>
Rule 5 (out dtype must match the computation dtype to avoid unsafe casts)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 7 ∧ dtype_(v_2) = 7) ∨ (dtype_(v_1) = 8 ∧ dtype_(v_2) = 8) ∨ (dtype_(v_1) = 9 ∧ dtype_(v_2) = 9) ∨ (dtype_(v_1) = 10 ∧ dtype_(v_2) = 10)
