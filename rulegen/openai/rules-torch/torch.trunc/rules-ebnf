>>
Rule 1 (input dtype must be real-valued)
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 2 (input dtype must not be bool)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 3 (out tensor, if provided, must have the same dtype as input)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_2) = dtype_(v_1)
>>
Rule 4 (out tensor, if provided, must match input shape)
{v_1 : tensor, v_2 : tensor} |= ndim(v_2) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) = shape(v_1, i)
>>
Rule 5 (scalar input implies scalar out when out is provided)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then ndim(v_2) = 0
>>
Rule 6 (integer inputs are copied unchanged when writing to out)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5) then (min(v_2) = min(v_1) ∧ max(v_2) = max(v_1))
