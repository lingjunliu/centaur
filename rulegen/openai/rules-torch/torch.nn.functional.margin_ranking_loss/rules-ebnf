Rule 1 (inputs and target must have the same number of dimensions — suppresses “All input tensors should have same dimension...”)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ndim(v_1) = ndim(v_3)
>>
Rule 2 (all shapes must match across input1, input2, and target — suppresses both size-mismatch errors)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∧ shape(v_1, i) = shape(v_3, i)
>>
Rule 3 (leading dimension sizes must match when tensors are non-scalar — suppresses “The size of tensor a (...) must match ... at non-singleton dimension 0”)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_1) > 0 then shape(v_1, 0) = shape(v_2, 0) ∧ shape(v_1, 0) = shape(v_3, 0)
>>
Rule 4 (input and target tensor dtypes must match pairwise)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= dtype_(v_1) = dtype_(v_2) ∧ dtype_(v_1) = dtype_(v_3)
>>
Rule 5 (target values are in {-1, 1})
{v_3 : tensor} |= (min(v_3) = -1 ∨ min(v_3) = 1) ∧ (max(v_3) = -1 ∨ max(v_3) = 1)
>>
Rule 6 (margin must be non-negative)
{v_4 : float} |= v_4 ≥ 0
>>
Rule 7 (reduction must be one of the valid options — suppresses “0 is not a valid value for reduction”)
{v_7 : str} |= v_7 = "none" ∨ v_7 = "mean" ∨ v_7 = "sum"
>>
Rule 8 (legacy reduce/size_average consistent with reduction)
{v_5 : bool, v_6 : bool, v_7 : str} |= if v_6 = false then v_7 = "none" else if v_5 = true then v_7 = "mean" else v_7 = "sum"
