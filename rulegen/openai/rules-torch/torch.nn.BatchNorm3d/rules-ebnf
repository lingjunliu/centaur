{v_7 : tensor} |= ndim(v_7) = 5 ∧ (∀i ∈ [0, 4] : 1 ≤ shape(v_7, i) ∧ shape(v_7, i) ≤ 1000000) ∧ ((shape(v_7, 0) * shape(v_7, 1) * shape(v_7, 2) * shape(v_7, 3) * shape(v_7, 4)) ≤ 200000000)
