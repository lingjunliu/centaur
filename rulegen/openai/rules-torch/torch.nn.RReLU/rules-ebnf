>>
Rule 1 (lower bound must be less than or equal to upper bound)
{v_1 : float, v_2 : float} |= v_1 ≤ v_2
>>
Rule 2 (input tensor must be a supported floating dtype; avoids Half kernel error)
{v_4 : tensor} |= dtype_(v_4) = 7 ∨ dtype_(v_4) = 8
>>
Rule 3 (explicitly disallow Half input dtype to suppress CPU "not implemented for 'Half'")
{v_4 : tensor} |= dtype_(v_4) ≠ 6
>>
Rule 4 (lower and upper must lie within a safe finite numeric range)
{v_1 : float, v_2 : float} |= (-10000000000 ≤ v_1 ∧ v_1 ≤ 10000000000) ∧ (-10000000000 ≤ v_2 ∧ v_2 ≤ 10000000000)
