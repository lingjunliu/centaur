>>
Rule 1 (split_size (int) must be non-negative)
{v_2 : int} |= v_2 ≥ 0
>>
Rule 2 (zero split_size allowed only when the selected dimension has size 0)
{v_1 : tensor, v_2 : int, v_3 : int} |= if v_2 = 0 then ((v_3 ≥ 0 ∧ shape(v_1, v_3) = 0) ∨ (v_3 < 0 ∧ shape(v_1, ndim(v_1) + v_3) = 0))
>>
Rule 3 (dim must be within valid range)
{v_1 : tensor, v_3 : int} |= v_3 ≥ 0 - ndim(v_1) ∧ v_3 ≤ ndim(v_1) - 1
>>
Rule 4 (split sizes list must be non-empty and contain only non-negative integers)
{v_2 : list(int)} |= v_2.len ≥ 1 ∧ ∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0
>>
Rule 5 (split sizes list must contain only concrete integers)
{v_2 : list(int)} |= ∀i ∈ [0, v_2.len - 1] : (v_2[i] ≥ 0 ∨ v_2[i] ≤ 0)
