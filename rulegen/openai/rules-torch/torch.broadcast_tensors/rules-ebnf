>>
Rule 1 (at least one tensor must be provided)
{v_1 : tuple(tensor)} |= v_1.len ≥ 1
>>
Rule 2 (two tensors must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (two tensors must be broadcastable along trailing dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ ndim(v_2) then ∀a ∈ [0, ndim(v_1) - 1] : shape(v_1, ndim(v_1) - 1 - a) = (if a < ndim(v_2) then shape(v_2, ndim(v_2) - 1 - a) else 1) ∨ shape(v_1, ndim(v_1) - 1 - a) = 1 ∨ (if a < ndim(v_2) then shape(v_2, ndim(v_2) - 1 - a) else 1) = 1 else ∀a ∈ [0, ndim(v_2) - 1] : (if a < ndim(v_1) then shape(v_1, ndim(v_1) - 1 - a) else 1) = shape(v_2, ndim(v_2) - 1 - a) ∨ (if a < ndim(v_1) then shape(v_1, ndim(v_1) - 1 - a) else 1) = 1 ∨ shape(v_2, ndim(v_2) - 1 - a) = 1
>>
Rule 4 (three tensors must share the same dtype)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= dtype_(v_1) = dtype_(v_2) ∧ dtype_(v_1) = dtype_(v_3)
>>
Rule 5 (three tensors must be mutually broadcastable pairwise)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= (if ndim(v_1) ≥ ndim(v_2) then ∀a ∈ [0, ndim(v_1) - 1] : shape(v_1, ndim(v_1) - 1 - a) = (if a < ndim(v_2) then shape(v_2, ndim(v_2) - 1 - a) else 1) ∨ shape(v_1, ndim(v_1) - 1 - a) = 1 ∨ (if a < ndim(v_2) then shape(v_2, ndim(v_2) - 1 - a) else 1) = 1 else ∀a ∈ [0, ndim(v_2) - 1] : (if a < ndim(v_1) then shape(v_1, ndim(v_1) - 1 - a) else 1) = shape(v_2, ndim(v_2) - 1 - a) ∨ (if a < ndim(v_1) then shape(v_1, ndim(v_1) - 1 - a) else 1) = 1 ∨ shape(v_2, ndim(v_2) - 1 - a) = 1) ∧ (if ndim(v_1) ≥ ndim(v_3) then ∀a ∈ [0, ndim(v_1) - 1] : shape(v_1, ndim(v_1) - 1 - a) = (if a < ndim(v_3) then shape(v_3, ndim(v_3) - 1 - a) else 1) ∨ shape(v_1, ndim(v_1) - 1 - a) = 1 ∨ (if a < ndim(v_3) then shape(v_3, ndim(v_3) - 1 - a) else 1) = 1 else ∀a ∈ [0, ndim(v_3) - 1] : (if a < ndim(v_1) then shape(v_1, ndim(v_1) - 1 - a) else 1) = shape(v_3, ndim(v_3) - 1 - a) ∨ (if a < ndim(v_1) then shape(v_1, ndim(v_1) - 1 - a) else 1) = 1 ∨ shape(v_3, ndim(v_3) - 1 - a) = 1) ∧ (if ndim(v_2) ≥ ndim(v_3) then ∀a ∈ [0, ndim(v_2) - 1] : shape(v_2, ndim(v_2) - 1 - a) = (if a < ndim(v_3) then shape(v_3, ndim(v_3) - 1 - a) else 1) ∨ shape(v_2, ndim(v_2) - 1 - a) = 1 ∨ (if a < ndim(v_3) then shape(v_3, ndim(v_3) - 1 - a) else 1) = 1 else ∀a ∈ [0, ndim(v_3) - 1] : (if a < ndim(v_2) then shape(v_2, ndim(v_2) - 1 - a) else 1) = shape(v_3, ndim(v_3) - 1 - a) ∨ (if a < ndim(v_2) then shape(v_2, ndim(v_2) - 1 - a) else 1) = 1 ∨ shape(v_3, ndim(v_3) - 1 - a) = 1)
>>
Rule 6 (each tensor’s dimension sizes are non-negative)
{v_1 : tensor} |= ∀a ∈ [0, ndim(v_1) - 1] : shape(v_1, a) ≥ 0
