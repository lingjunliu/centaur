>>
Rule 1 (inputs must have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 2 (inputs must have identical shapes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 4 (selected cross-product dimension must have length 3)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= if v_3 ≥ 0 then (shape(v_1, v_3) = 3 ∧ shape(v_2, v_3) = 3) else (shape(v_1, v_3 + ndim(v_1)) = 3 ∧ shape(v_2, v_3 + ndim(v_2)) = 3)
>>
Rule 5 (a dimension of size 3 must exist when using default dim)
{v_1 : tensor, v_2 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 3 ∧ shape(v_2, i) = 3
>>
Rule 6 (inputs dtypes must be supported and identical)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) ∧ dtype_(v_2) = dtype_(v_1)
