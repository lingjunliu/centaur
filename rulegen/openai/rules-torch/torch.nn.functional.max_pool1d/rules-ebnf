>>
Rule 1 (valid 2D or 3D input tensor with optional zero-sized batch)
{v_1 : tensor} |= (ndim(v_1) = 2 ∧ shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0) ∨ (ndim(v_1) = 3 ∧ shape(v_1, 0) ≥ 0 ∧ shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0)
>>
Rule 2 (input dtype must not be int8/Char)
{v_1 : tensor} |= dtype_(v_1) ≠ 1
>>
Rule 3 (kernel_size as integer must be positive)
{v_1 : int} |= v_1 > 0
>>
Rule 4 (kernel_size as tuple must have length 1 and be positive)
{v_1 : tuple(int)} |= v_1.len = 1 ∧ v_1[0] > 0
>>
Rule 9 (padding as integer must be non-negative)
{v_1 : int} |= v_1 ≥ 0
>>
Rule 10 (padding as tuple must have length 1 and be non-negative)
{v_1 : tuple(int)} |= v_1.len = 1 ∧ v_1[0] ≥ 0
>>
Rule 11 (padding at most half of kernel size when dilation = 1, integer signature)
{v_1 : int, v_2 : int, v_3 : int} |= if v_3 = 1 then v_2 ≤ v_1 / 2
>>
Rule 12 (padding at most half of kernel size when dilation = 1, tuple signature)
{v_1 : tuple(int), v_2 : tuple(int), v_3 : tuple(int)} |= if v_3[0] = 1 then v_2[0] ≤ v_1[0] / 2
>>
Rule 13 (padding at most half of effective kernel size, integer signature)
{v_1 : int, v_2 : int, v_3 : int} |= v_2 ≤ (((v_1 - 1) * v_3) + 1) / 2
>>
Rule 14 (padding at most half of effective kernel size, tuple signature)
{v_1 : tuple(int), v_2 : tuple(int), v_3 : tuple(int)} |= v_2[0] ≤ (((v_1[0] - 1) * v_3[0]) + 1) / 2
>>
Rule 15 (non-negative output size, integer signature)
{v_1 : tensor, v_2 : int, v_3 : int, v_4 : int, v_5 : int} |= v_3 > 0 ∧ v_5 > 0 ∧ ((ndim(v_1) = 2 ∧ shape(v_1, 1) + 2 * v_4 ≥ ((v_2 - 1) * v_5 + 1)) ∨ (ndim(v_1) = 3 ∧ shape(v_1, 2) + 2 * v_4 ≥ ((v_2 - 1) * v_5 + 1)))
>>
Rule 16 (non-negative output size, tuple signature)
{v_1 : tensor, v_2 : tuple(int), v_3 : tuple(int), v_4 : tuple(int), v_5 : tuple(int)} |= v_3[0] > 0 ∧ v_5[0] > 0 ∧ ((ndim(v_1) = 2 ∧ shape(v_1, 1) + 2 * v_4[0] ≥ ((v_2[0] - 1) * v_5[0] + 1)) ∨ (ndim(v_1) = 3 ∧ shape(v_1, 2) + 2 * v_4[0] ≥ ((v_2[0] - 1) * v_5[0] + 1)))
>>
Rule 17 (bound total input elements to avoid excessive memory allocation)
{v_1 : tensor} |= if ndim(v_1) = 2 then shape(v_1, 0) * shape(v_1, 1) ≤ 10000000 else if ndim(v_1) = 3 then shape(v_1, 0) * shape(v_1, 1) * shape(v_1, 2) ≤ 10000000 else false
