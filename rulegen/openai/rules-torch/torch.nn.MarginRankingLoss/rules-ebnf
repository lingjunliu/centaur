Rule 1 (inputs and target must be either scalars or 1D vectors, and share the same dimensionality)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= (ndim(v_1) = ndim(v_2) ∧ ndim(v_2) = ndim(v_3)) ∧ (ndim(v_1) = 0 ∨ ndim(v_1) = 1)
>>
Rule 2 (if inputs/target are 1D, their batch sizes must match)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_1) = 1 then shape(v_1, 0) = shape(v_2, 0) ∧ shape(v_1, 0) = shape(v_3, 0)
>>
Rule 3 (input tensors must not be boolean to allow subtraction)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 0 ∧ dtype_(v_2) ≠ 0
>>
Rule 4 (inputs and target should be floating tensors and share the same dtype)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ dtype_(v_2) = dtype_(v_1) ∧ dtype_(v_3) = dtype_(v_1)
>>
Rule 5 (reduction must be a valid option)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "mean" ∨ v_1 = "sum"
>>
Rule 6 (reduce and reduction must be consistent)
{v_1 : bool, v_2 : str} |= (v_1 = false ∧ v_2 = "none") ∨ (v_1 = true ∧ (v_2 = "none" ∨ v_2 = "mean" ∨ v_2 = "sum"))
>>
Rule 7 (target values must be ±1)
{v_1 : tensor} |= (min(v_1) = -1 ∨ min(v_1) = 1) ∧ (max(v_1) = -1 ∨ max(v_1) = 1)
