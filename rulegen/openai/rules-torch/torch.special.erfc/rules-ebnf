>>
Rule 1 (input must not be ComplexDouble (complex128) to avoid implementation error)
{v_1 : tensor} |= dtype_(v_1) ≠ 10
>>
Rule 2 (out dtype must match input dtype to avoid invalid cast to Bool)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_2) = dtype_(v_1)
>>
Rule 3 (out tensor shape must match input tensor shape)
{v_1 : tensor, v_2 : tensor} |= ndim(v_2) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) = shape(v_1, i)
