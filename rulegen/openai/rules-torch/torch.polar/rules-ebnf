Rule 1 (abs and angle must be float32/float64 and share the same dtype)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ dtype_(v_2) = dtype_(v_1)
>>
Rule 2 (abs and angle must have identical shapes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (when inputs are float32, out must be complex64)
{v_1 : tensor, v_3 : tensor} |= if dtype_(v_1) = 7 then dtype_(v_3) = 9
>>
Rule 4 (when inputs are float64, out must be complex128)
{v_1 : tensor, v_3 : tensor} |= if dtype_(v_1) = 8 then dtype_(v_3) = 10
>>
Rule 5 (out shape must match abs and angle shapes)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ndim(v_2) = ndim(v_3) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = shape(v_1, i) ∧ shape(v_2, i) = shape(v_1, i)
>>
Rule 6 (out must be a complex tensor)
{v_3 : tensor} |= dtype_(v_3) = 9 ∨ dtype_(v_3) = 10
>>
Rule 7 (absolute values should be non-negative)
{v_1 : tensor} |= min(v_1) ≥ 0
