Rule 1 (input must be a Tensor argument)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 2 (bool inputs are not supported for relu6/hardtanh)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 3 (complex inputs are not supported by clamp)
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 4 (inplace must be a boolean)
{v_2 : bool} |= v_2 = true ∨ v_2 = false
>>
Rule 5 (tensor dimensions, if any, are valid)
{v_1 : tensor} |= if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 10 (when inplace is used, input dtype must not be bool or complex)
{v_1 : tensor, v_2 : bool} |= if v_2 then (dtype_(v_1) ≠ 0 ∧ dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10)
