Rule 1 (out tensor must have the same dtype as input to avoid dtype mismatch)
{v_1 : tensor, v_3 : tensor} |= dtype_(v_1) = dtype_(v_3)
>>
Rule 2 (output tensor shape must equal input tensor shape)
{v_1 : tensor, v_3 : tensor} |= ndim(v_1) = ndim(v_3) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_3, i)
>>
Rule 3 (numeric max must be convertible to Half without overflow)
{v_2 : int ⊎ float} |= v_2 ≥ -65504 ∧ v_2 ≤ 65504
>>
Rule 4 (input tensor must be real-valued; complex dtypes are not supported)
{v_1 : tensor} |= max(v_1) ≥ min(v_1)
>>
Rule 5 (max as tensor: dtypes must match and both tensors must be real)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2) ∧ max(v_1) ≥ min(v_1) ∧ max(v_2) ≥ min(v_2)
>>
Rule 6 (broadcasting compatibility when max is a tensor)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1)
>>
Rule 7 (number overload validity: out must be a tensor and share dtype with input)
{v_1 : tensor, v_2 : int ⊎ float, v_3 : tensor} |= dtype_(v_1) = dtype_(v_3) ∧ v_2 = v_2
