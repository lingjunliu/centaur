>>
Rule 1 (input must be non-empty when dim is omitted; prevents "Expected reduction dim to be specified for input.numel() == 0")
{v_1 : tensor} |= if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 2 (input tensor dtype must not be bool; prevents '"argmax_cpu" not implemented for Bool')
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 4 (dim must be within valid index range [-ndim, ndim-1]; prevents "Dimension out of range")
{v_1 : tensor, v_2 : int} |= v_2 ≥ 0 - ndim(v_1) ∧ v_2 ≤ ndim(v_1) - 1
