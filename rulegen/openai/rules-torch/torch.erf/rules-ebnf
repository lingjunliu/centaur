Rule 1 (input must be a tensor to avoid non-tensor TypeError)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 2 (input dtype must be real floating; complex not implemented)
{v_1 : tensor} |= (dtype_(v_1) ≠ 9) ∧ (dtype_(v_1) ≠ 10)
>>
Rule 3 (when out is provided, shapes must match input)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 4 (when out is provided, dtype must match input to avoid invalid cast)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_2) = dtype_(v_1)
>>
Rule 6 (input dtype must be real floating; complex not implemented)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
