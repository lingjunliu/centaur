Rule 1 (input and target must be floating-point tensors: dtypes 6–8; suppresses “kl_div: Integral inputs not supported.”)
{v_1 : tensor, v_2 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8 ∧ 6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8
>>
Rule 2 (input and target must have identical shape; suppresses size-mismatch error)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (reduction must be a valid option for KLDivLoss)
{v_3 : str} |= v_3 = "none" ∨ v_3 = "mean" ∨ v_3 = "sum"
>>
Rule 4 (deprecated flags reduce/size_average map consistently to reduction)
{v_3 : str, v_4 : bool, v_5 : bool} |= if v_4 then if v_5 then v_3 = "mean" else v_3 = "sum" else v_3 = "none"
>>
Rule 5 (reduce flag should agree with reduction choice)
{v_3 : str, v_4 : bool} |= if v_3 = "none" then v_4 = false else v_4 = true
>>
Rule 6 (when log_target=True, target must be floating-point)
{v_2 : tensor, v_6 : bool} |= if v_6 then 6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8
