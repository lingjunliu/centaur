>>
Rule 1 (input tensor must have a floating-point dtype to avoid 'Char' error)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 2 (inplace must be a boolean value)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 3 (each dimension size is non-negative if there are any dimensions)
{v_1 : tensor} |= if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 4 (minimum value of the tensor is not greater than the maximum)
{v_1 : tensor} |= min(v_1) ≤ max(v_1)
>>
Rule 5 (first dimension size is valid when the tensor is at least 1-D)
{v_1 : tensor} |= if ndim(v_1) ≥ 1 then shape(v_1, 0) ≥ 0
>>
Rule 7 (input tensor must not be Char/int8)
{v_1 : tensor} |= dtype_(v_1) ≠ 1
>>
Rule 9 (if inplace is true, input must be floating-point and non-empty if it has dimensions)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then (6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8 ∧ (if ndim(v_2) = 0 then true else ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0))
