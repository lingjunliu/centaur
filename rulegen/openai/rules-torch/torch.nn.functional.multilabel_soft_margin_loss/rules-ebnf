>>
Rule 1 (input and target must have identical shapes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 2 (input must be at least 1D)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 3 (input must have floating-point dtype to avoid Char/Bool errors)
{v_1 : tensor} |= (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 4 (target dtype must match input dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_2) = dtype_(v_1)
>>
Rule 5 (weight, if provided, must be 1D and match the class dimension of input)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_1) = 1 then (ndim(v_3) = 1 ∧ shape(v_3, 0) = shape(v_1, 0) ∧ shape(v_2, 0) = shape(v_1, 0)) else (ndim(v_3) = 1 ∧ shape(v_3, 0) = shape(v_1, 1) ∧ shape(v_2, 1) = shape(v_1, 1))
>>
Rule 6 (weight dtype should match floating input dtype)
{v_1 : tensor, v_3 : tensor} |= dtype_(v_3) = dtype_(v_1) ∧ (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 7 (valid reduction string)
{v_6 : str} |= (v_6 = "none" ∨ v_6 = "mean" ∨ v_6 = "sum")
>>
Rule 8 (consistency between reduce/size_average and reduction)
{v_4 : bool, v_5 : bool, v_6 : str} |= if v_5 = false then v_6 = "none" else if v_4 = true then v_6 = "mean" else v_6 = "sum"
>>
Rule 9 (target values should be in [0, 1] for multilabel targets)
{v_2 : tensor} |= (min(v_2) ≥ 0) ∧ (max(v_2) ≤ 1)
>>
Rule 10 (positive batch/class sizes where applicable)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 then (shape(v_1, 0) > 0 ∧ shape(v_2, 0) > 0) else (shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0 ∧ shape(v_2, 0) > 0 ∧ shape(v_2, 1) > 0)
