Rule 1 (dim must be within the valid range [-ndim(input), ndim(input) - 1])
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 1 ∧ 0 - ndim(v_1) ≤ v_2 ∧ v_2 ≤ ndim(v_1) - 1
>>
Rule 2 (avoid bool negation: effective dtype must not be bool)
{v_1 : tensor, v_3 : dtype} |= dtype_(v_1) ≠ 0 ∨ (v_3 = 6 ∨ v_3 = 7 ∨ v_3 = 8)
>>
Rule 3 (avoid 'Char' kernel: effective dtype must not be int8)
{v_1 : tensor, v_3 : dtype} |= dtype_(v_1) ≠ 1 ∨ (v_3 = 6 ∨ v_3 = 7 ∨ v_3 = 8)
>>
Rule 4 (if casting is requested, cast only to floating dtype)
{v_3 : dtype} |= v_3 = 6 ∨ v_3 = 7 ∨ v_3 = 8
>>
Rule 5 (the axis specified by dim must be non-empty)
{v_1 : tensor, v_2 : int} |= if v_2 ≥ 0 then shape(v_1, v_2) ≥ 1 else shape(v_1, ndim(v_1) + v_2) ≥ 1
>>
Rule 6 (float input is acceptable without casting)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
