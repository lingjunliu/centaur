>>
Rule 1 (tensor must have at least 2 dimensions to avoid "Only tensors with 2 or more dimensions are supported")
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (disallow float16/Half to avoid "geqrf_cpu" not implemented for 'Half')
{v_1 : tensor} |= dtype_(v_1) ≠ 6
>>
Rule 3 (disallow int16/Short to avoid "normal_kernel_cpu" not implemented for 'Short')
{v_1 : tensor} |= dtype_(v_1) ≠ 2
>>
Rule 4 (disallow complex dtypes to avoid "torch.sign is not intended to support complex numbers")
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 5 (last two dimensions must be positive for valid QR-based orthogonalization)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ shape(v_1, ndim(v_1) - 1) ≥ 1 ∧ shape(v_1, ndim(v_1) - 2) ≥ 1
>>
Rule 6 (gain should be a reasonable finite scalar)
{v_2 : float} |= v_2 ≤ 1000000000000 ∧ v_2 ≥ -1000000000000
