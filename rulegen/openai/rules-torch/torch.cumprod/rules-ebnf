Rule 1 (valid dim index for non-scalar input)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 1 ∧ -1 * ndim(v_1) ≤ v_2 ∧ v_2 ≤ ndim(v_1) - 1
>>
Rule 2 (1D input allows only dim = 0 or dim = -1)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then (v_2 = 0 ∨ v_2 = -1)
>>
Rule 3 (out must be a tensor with the same shape as input)
{v_1 : tensor, v_4 : tensor} |= ndim(v_4) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_4, i) = shape(v_1, i)
>>
Rule 4 (when dtype is provided, the output tensor uses that dtype)
{v_3 : dtype, v_4 : tensor} |= dtype_(v_4) = v_3
>>
Rule 5 (when dtype is not provided, the output tensor keeps input dtype)
{v_1 : tensor, v_4 : tensor} |= dtype_(v_4) = dtype_(v_1)
>>
Rule 6 (input tensor must have a numeric or boolean dtype)
{v_1 : tensor} |= 0 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
