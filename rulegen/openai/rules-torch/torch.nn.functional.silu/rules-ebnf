>>
Rule 1 (input must be a Tensor to avoid non-Tensor TypeError)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 2 (input dtype must be floating: float16/float32/float64)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 3 (disallow Char/int8 to suppress "silu_cpu not implemented for 'Char'")
{v_1 : tensor} |= dtype_(v_1) ≠ 1
>>
Rule 4 (inplace must be a boolean)
{v_2 : bool} |= v_2 = true ∨ v_2 = false
>>
Rule 5 (if inplace, input must be non-empty)
{v_1 : tensor, v_2 : bool} |= if v_2 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
