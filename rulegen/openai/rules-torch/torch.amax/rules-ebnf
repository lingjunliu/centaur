>>
Rule 1 (integer dim is within valid range [-ndim, ndim-1] to avoid IndexError: Dimension out of range)
{v_1 : tensor, v_2 : int} |= 0 - ndim(v_1) ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 2 (tuple dims are in-range and unique to avoid IndexError: Dimension out of range and RuntimeError: dim appears multiple times)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : 0 ≤ v_2[i] ∧ v_2[i] < ndim(v_1) ∧ ∀j ∈ [0, v_2.len - 1] : if i ≠ j then v_2[i] ≠ v_2[j]
>>
Rule 3 (integer dim to reduce must have non-zero size to avoid IndexError: Expected reduction dim ... to have non-zero size)
{v_1 : tensor, v_2 : int} |= 0 ≤ v_2 ∧ v_2 < ndim(v_1) ∧ shape(v_1, v_2) > 0
>>
Rule 4 (every tuple dim to reduce must have non-zero size to avoid IndexError: Expected reduction dim ... to have non-zero size)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : 0 ≤ v_2[i] ∧ v_2[i] < ndim(v_1) ∧ shape(v_1, v_2[i]) > 0
>>
Rule 7 (keepdim=True with integer dim: out shape matches input except reduced dim is size 1)
{v_1 : tensor, v_2 : int, v_3 : bool, v_4 : tensor} |= if v_3 then (ndim(v_4) = ndim(v_1) ∧ 0 ≤ v_2 ∧ v_2 < ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : if i = v_2 then shape(v_4, i) = 1 else shape(v_4, i) = shape(v_1, i))
>>
Rule 9 (keepdim=True with tuple dims: out shape matches input except each reduced dim is size 1)
{v_1 : tensor, v_2 : tuple(int), v_3 : bool, v_4 : tensor} |= if v_3 then (ndim(v_4) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : if (∃k ∈ [0, v_2.len - 1] : v_2[k] = i) then shape(v_4, i) = 1 else shape(v_4, i) = shape(v_1, i))
>>
Rule 10 (keepdim=False with tuple dims: out loses len(dim) dimensions)
{v_1 : tensor, v_2 : tuple(int), v_3 : bool, v_4 : tensor} |= if v_3 = false then ndim(v_4) = ndim(v_1) - v_2.len
>>
Rule 11 (no-dim signature, keepdim=True: out keeps ndim and all sizes become 1)
{v_1 : tensor, v_2 : bool, v_3 : tensor} |= if v_2 then (ndim(v_3) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = 1)
>>
Rule 13 (dim can be int or tuple(int) via union type; keepdim is boolean)
{v_1 : tensor, v_2 : int ⊎ tuple(int), v_3 : bool} |= (0 ≤ ndim(v_1)) ∧ (v_2 = v_2) ∧ (v_3 = true ∨ v_3 = false)
