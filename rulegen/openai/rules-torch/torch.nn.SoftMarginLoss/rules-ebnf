Rule 1 (input and target must have identical shapes)
{v_4 : tensor, v_5 : tensor} |= ndim(v_4) = ndim(v_5) ∧ ∀i ∈ [0, ndim(v_4) - 1] : shape(v_4, i) = shape(v_5, i)
>>
Rule 2 (input and target must be floating tensors of the same dtype)
{v_4 : tensor, v_5 : tensor} |= (6 ≤ dtype_(v_4) ∧ dtype_(v_4) ≤ 8) ∧ dtype_(v_5) = dtype_(v_4)
>>
Rule 3 (target tensor must not be bool or uint8 to avoid invalid negation/casting)
{v_5 : tensor} |= dtype_(v_5) ≠ 0 ∧ dtype_(v_5) ≠ 5
>>
Rule 4 (valid reduction string)
{v_3 : str} |= (v_3 = "none") ∨ (v_3 = "mean") ∨ (v_3 = "sum")
>>
Rule 5 (when reduce is False, reduction must be 'none')
{v_2 : bool, v_3 : str} |= if v_2 = false then v_3 = "none"
>>
Rule 6 (when reduce is True and size_average is True, reduction should be 'mean')
{v_1 : bool, v_2 : bool, v_3 : str} |= if (v_2 = true ∧ v_1 = true) then v_3 = "mean"
>>
Rule 7 (when reduce is True and size_average is False, reduction should be 'sum')
{v_1 : bool, v_2 : bool, v_3 : str} |= if (v_2 = true ∧ v_1 = false) then v_3 = "sum"
>>
Rule 8 (input tensor must not be complex)
{v_4 : tensor} |= (dtype_(v_4) ≠ 9) ∧ (dtype_(v_4) ≠ 10)
