>>
Rule 1 (input must be 3D or 4D to satisfy pooling rank requirements)
{v_1 : tensor} |= (ndim(v_1) = 3) ∨ (ndim(v_1) = 4)
>>
Rule 2 (input dimension should be at least 3)
{v_1 : tensor} |= ndim(v_1) ≥ 3
>>
Rule 3 (input dimension should be at least 2)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 4 (input dtype must not be Char/int8)
{v_1 : tensor} |= dtype_(v_1) ≠ 1
>>
Rule 8 (all input tensor dimensions must be positive)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
