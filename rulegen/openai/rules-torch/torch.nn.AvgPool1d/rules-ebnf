>>
Rule 1 (input must be 2D or 3D tensor)
{v_1 : tensor} |= ndim(v_1) = 2 ∨ ndim(v_1) = 3
>>
Rule 2 (input dtype must not be int8/'Char')
{v_1 : tensor} |= dtype_(v_1) ≠ 1
>>
Rule 3 (int params: positive kernel_size/stride, non-negative padding, and padding ≤ half kernel)
{v_1 : int, v_2 : int, v_3 : int} |= v_1 > 0 ∧ v_2 > 0 ∧ v_3 ≥ 0 ∧ 2 * v_3 ≤ v_1
>>
Rule 4 (kernel_size given as a tuple must contain exactly one positive int)
{v_1 : tuple(int)} |= v_1.len = 1 ∧ v_1[0] > 0
>>
Rule 5 (all tuple params: each length 1; positive kernel_size/stride, non-negative padding, padding ≤ half kernel)
{v_1 : tuple(int), v_2 : tuple(int), v_3 : tuple(int)} |= v_1.len = 1 ∧ v_2.len = 1 ∧ v_3.len = 1 ∧ v_1[0] > 0 ∧ v_2[0] > 0 ∧ v_3[0] ≥ 0 ∧ 2 * v_3[0] ≤ v_1[0]
>>
Rule 6 (kernel_size int, stride tuple: stride tuple length 1 and positive)
{v_1 : int, v_2 : tuple(int)} |= v_1 > 0 ∧ v_2.len = 1 ∧ v_2[0] > 0
>>
Rule 7 (kernel_size int, padding tuple: padding tuple length 1, non-negative, and ≤ half kernel)
{v_1 : int, v_2 : tuple(int)} |= v_1 > 0 ∧ v_2.len = 1 ∧ v_2[0] ≥ 0 ∧ 2 * v_2[0] ≤ v_1
>>
Rule 8 (kernel_size tuple, stride int: kernel tuple length 1 and positive; stride positive)
{v_1 : tuple(int), v_2 : int} |= v_1.len = 1 ∧ v_1[0] > 0 ∧ v_2 > 0
>>
Rule 9 (kernel_size tuple, stride tuple, padding int: lengths 1; positive ks/stride; non-negative padding; padding ≤ half kernel)
{v_1 : tuple(int), v_2 : tuple(int), v_3 : int} |= v_1.len = 1 ∧ v_2.len = 1 ∧ v_1[0] > 0 ∧ v_2[0] > 0 ∧ v_3 ≥ 0 ∧ 2 * v_3 ≤ v_1[0]
>>
Rule 10 (output size must be at least 1 for int params)
{v_1 : int, v_2 : int, v_3 : int, v_4 : tensor} |= v_2 > 0 ∧ (shape(v_4, if ndim(v_4) = 3 then 2 else 1) + 2 * v_3 - v_1) ≥ 0
>>
Rule 11 (output size must be at least 1 for tuple params)
{v_1 : tuple(int), v_2 : tuple(int), v_3 : tuple(int), v_4 : tensor} |= v_1.len = 1 ∧ v_2.len = 1 ∧ v_3.len = 1 ∧ v_2[0] > 0 ∧ (shape(v_4, if ndim(v_4) = 3 then 2 else 1) + 2 * v_3[0] - v_1[0]) ≥ 0
