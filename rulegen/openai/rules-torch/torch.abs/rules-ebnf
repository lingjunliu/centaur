>>
Rule 1 (input must be a tensor)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 2 (bool dtype is not supported for abs)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 3 (out dtype must match abs result dtype, including complex-to-float mapping)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 then dtype_(v_2) = 7 else if dtype_(v_1) = 10 then dtype_(v_2) = 8 else dtype_(v_2) = dtype_(v_1)
>>
Rule 5 (out tensor must have the same shape as input)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
