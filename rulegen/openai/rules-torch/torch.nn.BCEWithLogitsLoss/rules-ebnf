>>
Rule 1 (input and target must have identical shapes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ if ndim(v_1) > 0 then ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 2 (no zero-sized dimensions in input or target)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 then ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 ∧ shape(v_2, i) > 0
>>
Rule 3 (input logits must have floating-point dtype)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 5 (weight must be a 1D floating tensor matching batch size)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ if ndim(v_2) ≥ 1 then ndim(v_1) = 1 ∧ shape(v_1, 0) = shape(v_2, 0)
>>
Rule 6 (pos_weight can fully match target shape; must be floating dtype)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ ndim(v_1) = ndim(v_2) ∧ if ndim(v_2) > 0 then ∀ i ∈ [0, ndim(v_2) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 7 (pos_weight can ignore batch dimension; must be floating dtype)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ ndim(v_2) ≥ 2 ∧ ndim(v_1) = ndim(v_2) - 1 ∧ ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i + 1)
>>
Rule 8 (valid reduction values)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "mean" ∨ v_1 = "sum"
>>
Rule 9 (consistency between reduce/size_average and reduction)
{v_1 : bool, v_2 : bool, v_3 : str} |= if v_1 = false then v_3 = "none" else if v_2 = true then v_3 = "mean" else v_3 = "sum"
