>>
Rule 1 (input must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (input must be batches of square matrices)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 3 (negative power requires floating or complex dtype to allow inversion)
{v_1 : tensor, v_2 : int} |= if v_2 < 0 then (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10)
>>
Rule 4 (negative power disallows low-precision Half dtype)
{v_1 : tensor, v_2 : int} |= if v_2 < 0 then dtype_(v_1) ≠ 6
>>
Rule 5 (avoid inversion-related singular errors by restricting to nonnegative powers)
{v_2 : int} |= v_2 ≥ 0
>>
Rule 6 (out tensor must match result’s shape and dtype)
{v_1 : tensor, v_3 : tensor} |= ndim(v_1) ≥ 2 ∧ dtype_(v_3) = dtype_(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = shape(v_1, i)
