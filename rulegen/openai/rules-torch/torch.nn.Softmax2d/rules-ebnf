>>
Rule 1 (input must be 3D or 4D to match Softmax2d requirements)
{v_1 : tensor} |= ndim(v_1) = 3 ∨ ndim(v_1) = 4
>>
Rule 2 (input dtype must be floating to avoid unsupported 'Char' kernel)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 3 (spatial dimensions must be positive)
{v_1 : tensor} |= if ndim(v_1) = 3 then shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0 else if ndim(v_1) = 4 then shape(v_1, 2) > 0 ∧ shape(v_1, 3) > 0 else false
>>
Rule 4 (channel dimension must be positive; batch size positive when present)
{v_1 : tensor} |= if ndim(v_1) = 3 then shape(v_1, 0) > 0 else if ndim(v_1) = 4 then shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0 else false
