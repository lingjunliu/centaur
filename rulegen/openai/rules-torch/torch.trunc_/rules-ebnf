>>
Rule 1 (input tensor must not be bool dtype; avoids "trunc_vml_cpu not implemented for 'Bool'")
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 2 (input tensor must not be complex; avoids "trunc is not supported for complex inputs")
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 3 (well-defined shapes for any dimensional tensor)
{v_1 : tensor} |= if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : 0 ≤ shape(v_1, i)
>>
Rule 6 (input tensor has a supported real numeric dtype)
{v_1 : tensor} |= dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 7 (tensor shape well-defined for any dimension count)
{v_1 : tensor} |= if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
