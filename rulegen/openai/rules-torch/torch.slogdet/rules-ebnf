>>
Rule 1 (input tensor must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (input must be batches of square matrices: last two dims equal)
{v_1 : tensor} |= if ndim(v_1) ≥ 2 then shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 3 (matrix dimensions must be positive in the last two axes)
{v_1 : tensor} |= if ndim(v_1) ≥ 2 then ∀i ∈ [ndim(v_1) - 2, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 4 (dtype must be floating-point or complex)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 5 (low precision float16 (Half) dtype is not supported)
{v_1 : tensor} |= dtype_(v_1) ≠ 6
