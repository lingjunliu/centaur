Rule 1 (input must be 4D or 5D)
{v_2 : tensor} |= ndim(v_2) = 4 ∨ ndim(v_2) = 5
>>
Rule 2 (valid non-batch dimensions; only batch may be zero)
{v_2 : tensor} |= if ndim(v_2) = 5 then shape(v_2, 1) > 0 ∧ shape(v_2, 2) > 0 ∧ shape(v_2, 3) > 0 ∧ shape(v_2, 4) > 0 ∧ shape(v_2, 0) ≥ 0 else shape(v_2, 0) > 0 ∧ shape(v_2, 1) > 0 ∧ shape(v_2, 2) > 0 ∧ shape(v_2, 3) > 0
>>
Rule 3 (input dtype cannot be bool)
{v_2 : tensor} |= dtype_(v_2) ≠ 0
>>
Rule 4 (scalar padding must be non-negative)
{v_1 : int} |= v_1 ≥ 0
>>
Rule 5 (tuple padding must have 6 elements and even length)
{v_1 : tuple(int)} |= v_1.len = 6 ∧ (v_1.len % 2) = 0
>>
Rule 6 (tuple padding length must not exceed twice the input dimension)
{v_1 : tuple(int), v_2 : tensor} |= v_1.len ≤ 2 * ndim(v_2)
>>
Rule 7 (tuple padding elements must be non-negative)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 8 (scalar padding yields positive output D/H/W)
{v_1 : int, v_2 : tensor} |= if ndim(v_2) = 5 then (shape(v_2, 2) + 2 * v_1) > 0 ∧ (shape(v_2, 3) + 2 * v_1) > 0 ∧ (shape(v_2, 4) + 2 * v_1) > 0 else (shape(v_2, 1) + 2 * v_1) > 0 ∧ (shape(v_2, 2) + 2 * v_1) > 0 ∧ (shape(v_2, 3) + 2 * v_1) > 0
>>
Rule 9 (6-tuple padding yields positive output D/H/W)
{v_1 : tuple(int), v_2 : tensor} |= if ndim(v_2) = 5 then (shape(v_2, 2) + v_1[4] + v_1[5]) > 0 ∧ (shape(v_2, 3) + v_1[2] + v_1[3]) > 0 ∧ (shape(v_2, 4) + v_1[0] + v_1[1]) > 0 else (shape(v_2, 1) + v_1[4] + v_1[5]) > 0 ∧ (shape(v_2, 2) + v_1[2] + v_1[3]) > 0 ∧ (shape(v_2, 3) + v_1[0] + v_1[1]) > 0
