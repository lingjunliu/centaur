>>
Rule 1 (input must be real-valued to avoid erfc_vml_cpu complex error)
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 2 (out dtype must match erfc result dtype to avoid invalid cast, e.g., Float -> Short)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 8 then dtype_(v_2) = 8 else dtype_(v_2) = 7
>>
Rule 3 (out tensor must have the same shape as input)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
