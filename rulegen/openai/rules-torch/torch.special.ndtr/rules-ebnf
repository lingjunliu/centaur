>>
Rule 1 (input must be a tensor; suppresses TypeError on non-tensor input)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 2 (input dtype must be real; suppresses RuntimeError for complex dtypes like ComplexDouble)
{v_1 : tensor} |= min(v_1) ≤ max(v_1)
>>
Rule 3 (out, if provided, must be a tensor)
{v_2 : tensor} |= ndim(v_2) ≥ 0
>>
Rule 4 (out shape must exactly match input shape)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then ndim(v_2) = 0 else ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 5 (out dtype must match input dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_2) = dtype_(v_1)
>>
Rule 6 (out dtype must be real)
{v_2 : tensor} |= min(v_2) ≤ max(v_2)
