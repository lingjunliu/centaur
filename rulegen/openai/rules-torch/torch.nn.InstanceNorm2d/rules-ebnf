Rule 1 (input must be 3D or 4D to avoid “expected 3D or 4D input”)
{v_1 : tensor} |= (ndim(v_1) = 3 ∨ ndim(v_1) = 4)
>>
Rule 2 (all input dimensions must be positive to avoid negative/zero dims and symbolic sizes)
{v_1 : tensor} |= (ndim(v_1) = 4 ∧ ∀i ∈ [0, 3] : shape(v_1, i) > 0) ∨ (ndim(v_1) = 3 ∧ ∀i ∈ [0, 2] : shape(v_1, i) > 0)
>>
Rule 3 (num_features must be at least 1 to avoid negative dimension and zero-size stats)
{v_1 : int} |= v_1 ≥ 1
>>
Rule 4 (for 4D input, channel dimension must match num_features to avoid dim=1 mismatch)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 4 then shape(v_1, 1) = v_2
>>
Rule 5 (for 3D input, channel dimension must match num_features to avoid mismatch)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 3 then shape(v_1, 0) = v_2
>>
Rule 6 (eps must be strictly positive for numerical stability)
{v_1 : float} |= v_1 > 0
>>
Rule 7 (momentum must be within [0, 1] as defined for running statistics)
{v_1 : float} |= 0 ≤ v_1 ∧ v_1 ≤ 1
>>
Rule 8 (avoid mixed dtype: input dtype must match provided dtype)
{v_1 : tensor, v_2 : dtype} |= dtype_(v_1) = v_2
>>
Rule 9 (when affine is enabled, enforce dtype consistency to avoid mixed dtype)
{v_1 : tensor, v_2 : dtype, v_3 : bool} |= if v_3 then dtype_(v_1) = v_2
>>
Rule 10 (when tracking running stats, require valid C matching num_features to avoid running_mean size errors)
{v_1 : tensor, v_2 : int, v_3 : bool} |= if v_3 then ((ndim(v_1) = 4 ∧ shape(v_1, 1) = v_2) ∨ (ndim(v_1) = 3 ∧ shape(v_1, 0) = v_2))
>>
Rule 11 (limit total number of elements for 4D input to avoid OOM and storage overflow)
{v_1 : tensor} |= if ndim(v_1) = 4 then (shape(v_1, 0) * shape(v_1, 1) * shape(v_1, 2) * shape(v_1, 3)) ≤ 100000000
>>
Rule 12 (limit total number of elements for 3D input to avoid OOM and storage overflow)
{v_1 : tensor} |= if ndim(v_1) = 3 then (shape(v_1, 0) * shape(v_1, 1) * shape(v_1, 2)) ≤ 100000000
