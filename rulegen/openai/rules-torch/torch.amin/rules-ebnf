Rule 1 (valid integer dim index range)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 1 ∧ v_2 ≥ 0 - ndim(v_1) ∧ v_2 ≤ ndim(v_1) - 1
>>
Rule 2 (valid tuple dim indices and length)
{v_1 : tensor, v_2 : tuple(int)} |= ndim(v_1) ≥ 1 ∧ v_2.len ≥ 1 ∧ v_2.len ≤ ndim(v_1) ∧ ∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0 - ndim(v_1) ∧ v_2[i] ≤ ndim(v_1) - 1
>>
Rule 3 (tuple dims must be unique)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : ∀j ∈ [i + 1, v_1.len - 1] : v_1[i] ≠ v_1[j]
>>
Rule 4 (reduction dim must have non-zero size for integer dim)
{v_1 : tensor, v_2 : int} |= shape(v_1, v_2) > 0
>>
Rule 5 (reduction dims must have non-zero size for tuple dims)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : shape(v_1, v_2[i]) > 0
>>
Rule 6 (out tensor dtype must match input dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 7 (out must be a Tensor when provided)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 8 (keepdim must be boolean)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
