>>
Rule 1 (A must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (A must be a batch of square matrices: last two dims equal)
{v_1 : tensor} |= shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 3 (A must have floating or complex floating dtype)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 4 (out, when provided, must match A in shape and dtype)
{v_1 : tensor, v_3 : tensor} |= ndim(v_3) = ndim(v_1) ∧ dtype_(v_3) = dtype_(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = shape(v_1, i)
>>
Rule 5 (matrix dimensions must be positive in the last two axes)
{v_1 : tensor} |= shape(v_1, ndim(v_1) - 1) > 0 ∧ shape(v_1, ndim(v_1) - 2) > 0
>>
Rule 6 (n = 0 case: result well-defined for square matrices)
{v_1 : tensor, v_2 : int} |= if v_2 = 0 then shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
