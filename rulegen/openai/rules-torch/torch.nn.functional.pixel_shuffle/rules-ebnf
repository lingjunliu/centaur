>>
Rule 1 (input must have at least 3 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 3
>>
Rule 2 (upscale_factor must be positive)
{v_2 : int} |= v_2 > 0
>>
Rule 3 (channel dimension divisible by square of upscale_factor)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 3 ∧ shape(v_1, ndim(v_1) - 3) % (v_2 * v_2) = 0
>>
Rule 4 (spatial dimensions must be positive when present)
{v_1 : tensor} |= if ndim(v_1) ≥ 3 then shape(v_1, ndim(v_1) - 2) > 0 ∧ shape(v_1, ndim(v_1) - 1) > 0
>>
Rule 5 (all batch dimensions, if any, must be positive)
{v_1 : tensor} |= if ndim(v_1) ≥ 4 then ∀i ∈ [0, ndim(v_1) - 4] : shape(v_1, i) > 0
>>
Rule 6 (tensor dtype index is valid)
{v_1 : tensor} |= 0 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 12
