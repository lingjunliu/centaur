Rule 1 (out tensor dtype must match torch.any semantics: bool except uint8)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 5 then dtype_(v_2) = 5 else dtype_(v_2) = 0
>>
Rule 2 (integer dim is within valid range)
{v_1 : tensor, v_2 : int} |= v_2 ≥ 0 - ndim(v_1) ∧ v_2 ≤ ndim(v_1) - 1
>>
Rule 3 (each tuple dim is within valid range)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : (v_2[i] ≥ 0 - ndim(v_1) ∧ v_2[i] ≤ ndim(v_1) - 1)
>>
Rule 7 (int dim, keepdim = true keeps rank and sets reduced size to 1)
{v_1 : tensor, v_2 : int, v_3 : bool, v_4 : tensor} |= (v_3 = true) ∧ ∀i ∈ [0, ndim(v_1) - 1] : (if i = (if v_2 ≥ 0 then v_2 else ndim(v_1) + v_2) then shape(v_4, i) = 1 else shape(v_4, i) = shape(v_1, i))
>>
Rule 8 (tuple dims, keepdim = false reduces rank by number of dims)
{v_1 : tensor, v_2 : tuple(int), v_3 : bool, v_4 : tensor} |= (v_3 = false) ∧ ndim(v_4) = ndim(v_1) - v_2.len
>>
Rule 9 (tuple dims, keepdim = true keeps rank and sets each reduced size to 1)
{v_1 : tensor, v_2 : tuple(int), v_3 : bool, v_4 : tensor} |= (v_3 = true) ∧ ∀i ∈ [0, ndim(v_1) - 1] : (if (∃k ∈ [0, v_2.len - 1] : i = (if v_2[k] ≥ 0 then v_2[k] else ndim(v_1) + v_2[k])) then shape(v_4, i) = 1 else shape(v_4, i) = shape(v_1, i))
