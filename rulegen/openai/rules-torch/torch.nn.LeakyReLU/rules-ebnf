Rule 2 (In-place usage requires float input; otherwise constrain slope magnitude)
{v_1 : float, v_2 : bool, v_3 : tensor} |= if v_2 then 6 ≤ dtype_(v_3) ∧ dtype_(v_3) ≤ 8 else -1000000.0 ≤ v_1 ∧ v_1 ≤ 1000000.0
>>
Rule 3 (Tensor dimensions are valid and non-negative)
{v_3 : tensor} |= ndim(v_3) ≥ 0 ∧ ∀i ∈ [0, ndim(v_3) - 1] : 0 ≤ shape(v_3, i)
>>
Rule 4 (Input minimum is not greater than maximum)
{v_3 : tensor} |= min(v_3) ≤ max(v_3)
>>
Rule 5 (Inplace flag is a boolean literal)
{v_2 : bool} |= v_2 = true ∨ v_2 = false
