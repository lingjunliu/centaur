Rule 1 (desired ordering length must match input dimensionality)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len = ndim(v_1)
>>
Rule 2 (each dim index is within [0, ndim(input) - 1])
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : 0 ≤ v_2[i] ∧ v_2[i] < ndim(v_1)
>>
Rule 4 (dims cover all axes exactly once)
{v_1 : tensor, v_2 : tuple(int)} |= ∀k ∈ [0, ndim(v_1) - 1] : ∃i ∈ [0, v_2.len - 1] : v_2[i] = k
>>
Rule 7 (duplicate dims are not allowed)
{v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : ∀j ∈ [0, v_2.len - 1] : if i ≠ j then v_2[i] ≠ v_2[j]
