Rule 1 (dimension index must be within [-ndim(input), ndim(input) - 1])
{v_1 : tensor, v_3 : int} |= (0 - ndim(v_1)) ≤ v_3 ∧ v_3 ≤ ndim(v_1) - 1
>>
Rule 2 (split_sizes list must contain only non-negative integers)
{v_2 : list(int)} |= if v_2.len > 0 then ∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0
>>
Rule 3 (split_sizes tuple must contain only non-negative integers)
{v_2 : tuple(int)} |= if v_2.len > 0 then ∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0
>>
Rule 4 (if the selected dimension has size 0, split_sizes must be empty)
{v_1 : tensor, v_2 : list(int) ⊎ tuple(int), v_3 : int} |= if (v_3 ≥ 0 ∧ v_3 ≤ ndim(v_1) - 1 ∧ shape(v_1, v_3) = 0) then v_2.len = 0
>>
Rule 5 (when all split_sizes are 1, their count must match the size of the dimension)
{v_1 : tensor, v_2 : list(int) ⊎ tuple(int), v_3 : int} |= if (v_2.len > 0 ∧ ∀i ∈ [0, v_2.len - 1] : v_2[i] = 1) then (0 ≤ v_3 ∧ v_3 ≤ ndim(v_1) - 1 ∧ v_2.len = shape(v_1, v_3))
