>>
Rule 1 (dim must index an existing dimension of input)
{v_1 : int, v_2 : tensor} |= (0 - ndim(v_2) ≤ v_1) ∧ (v_1 ≤ ndim(v_2) - 1)
>>
Rule 2 (input must have at least one dimension)
{v_2 : tensor} |= ndim(v_2) ≥ 1
>>
Rule 3 (size along the split dimension must be even)
{v_1 : int, v_2 : tensor} |= if v_1 ≥ 0 then (shape(v_2, v_1) % 2 = 0) else (shape(v_2, v_1 + ndim(v_2)) % 2 = 0)
>>
Rule 4 (input tensor must have floating-point dtype)
{v_2 : tensor} |= (6 ≤ dtype_(v_2)) ∧ (dtype_(v_2) ≤ 8)
>>
Rule 5 (for 1D input, dim must be 0 or -1)
{v_1 : int, v_2 : tensor} |= if ndim(v_2) = 1 then (v_1 = 0 ∨ v_1 = 0 - 1)
