Rule 1 (dimension index must be within the valid range for the input tensor)
{v_1 : tensor, v_2 : int} |= (0 - ndim(v_1)) ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 2 (non-negative dimension index must be less than the number of dimensions)
{v_1 : tensor, v_2 : int} |= if v_2 ≥ 0 then v_2 < ndim(v_1)
>>
Rule 3 (negative dimension index must be no smaller than -ndim(input))
{v_1 : tensor, v_2 : int} |= if v_2 < 0 then (0 - ndim(v_1)) ≤ v_2
>>
Rule 4 (input tensor must have at least one dimension to sort along)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 5 (descending and stable must be boolean flags)
{v_3 : bool, v_4 : bool} |= (v_3 = true ∨ v_3 = false) ∧ (v_4 = true ∨ v_4 = false)
