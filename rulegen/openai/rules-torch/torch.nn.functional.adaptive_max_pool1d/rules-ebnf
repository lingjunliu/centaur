Rule 1 (input must be 2D or 3D and non-empty)
{v_1 : tensor} |= (ndim(v_1) = 2 ∨ ndim(v_1) = 3) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 2 (disallow unsupported Char dtype for pooling)
{v_1 : tensor} |= dtype_(v_1) ≠ 1
>>
Rule 3 (positive integer output_size)
{v_2 : int} |= v_2 > 0
>>
Rule 4 (tuple output_size must contain exactly one integer)
{v_2 : tuple(int)} |= v_2.len = 1
>>
Rule 5 (tuple output_size element must be positive)
{v_2 : tuple(int)} |= v_2[0] > 0
>>
Rule 6 (limit input sizes to avoid out-of-memory)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≤ 1000000
>>
Rule 7 (bound integer output_size to prevent storage overflow; tighter if returning indices)
{v_2 : int, v_3 : bool} |= if v_3 then v_2 ≤ 10000000 else v_2 ≤ 100000000
>>
Rule 8 (bound tuple output_size to prevent storage overflow; tighter if returning indices)
{v_2 : tuple(int), v_3 : bool} |= v_2.len = 1 ∧ (if v_3 then v_2[0] ≤ 10000000 else v_2[0] ≤ 100000000)
