Rule 1 (dimension must be within valid range for input)
{v_1 : tensor, v_2 : int} |= (-1) * ndim(v_1) ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 2 (input and src must have matching dtypes)
{v_1 : tensor, v_4 : tensor} |= dtype_(v_1) = dtype_(v_4)
>>
Rule 3 (index values are in-bounds along dim and ranks match)
{v_1 : tensor, v_2 : int, v_3 : tensor} |= (-1) * ndim(v_1) ≤ v_2 ∧ v_2 < ndim(v_1) ∧ ndim(v_3) = ndim(v_1) ∧ min(v_3) ≥ 0 ∧ max(v_3) < shape(v_1, v_2)
>>
Rule 4 (index and src must have identical shapes)
{v_3 : tensor, v_4 : tensor} |= ndim(v_3) = ndim(v_4) ∧ ∀i ∈ [0, ndim(v_3) - 1] : shape(v_3, i) = shape(v_4, i)
>>
Rule 5 (index matches input on all non-scatter dimensions)
{v_1 : tensor, v_2 : int, v_3 : tensor} |= ndim(v_3) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : if i = v_2 then true else shape(v_3, i) = shape(v_1, i)
>>
Rule 6 (value variant: index shape matches input shape)
{v_1 : tensor, v_3 : tensor} |= ndim(v_3) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = shape(v_1, i)
>>
Rule 7 (reduce must be an allowed mode)
{v_5 : str} |= v_5 = "none" ∨ v_5 = "sum"
>>
Rule 8 (value must not be NaN)
{v_4 : float} |= v_4 = v_4
