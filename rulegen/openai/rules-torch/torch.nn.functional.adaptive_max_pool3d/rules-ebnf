>>
Rule 1 (input must be 4D or 5D)
{v_1 : tensor} |= ndim(v_1) = 4 ∨ ndim(v_1) = 5
>>
Rule 2 (non-batch dimensions must have non-zero size)
{v_1 : tensor} |= if ndim(v_1) = 5 then (∀i ∈ [1, 4] : shape(v_1, i) > 0) else if ndim(v_1) = 4 then (∀i ∈ [0, 3] : shape(v_1, i) > 0) else false
>>
Rule 3 (input dtype must not be Byte/uint8)
{v_1 : tensor} |= dtype_(v_1) ≠ 5
>>
Rule 4 (tuple output_size must have length 3)
{v_2 : tuple(int)} |= v_2.len = 3
>>
Rule 5 (tuple output_size elements must be positive)
{v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : v_2[i] > 0
>>
Rule 6 (integer output_size must be positive)
{v_2 : int} |= v_2 > 0
>>
Rule 7 (return_indices must be a boolean)
{v_3 : bool} |= v_3 = true ∨ v_3 = false
