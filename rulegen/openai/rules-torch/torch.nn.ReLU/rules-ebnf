>>
Rule 1 (input tensor must not be boolean)
{v_2 : tensor} |= dtype_(v_2) ≠ 0
>>
Rule 2 (input tensor must not be complex)
{v_2 : tensor} |= dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10
>>
Rule 3 (valid ReLU input dtypes are integer or floating)
{v_2 : tensor} |= 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8
>>
Rule 4 (inplace flag is a boolean literal)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 5 (inplace does not relax dtype restrictions)
{v_1 : bool, v_2 : tensor} |= if v_1 then (dtype_(v_2) ≠ 0 ∧ dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10) else (dtype_(v_2) ≠ 0 ∧ dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10)
>>
Rule 10 (tensor has non-negative sizes along all dimensions)
{v_2 : tensor} |= ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) ≥ 0
>>
Rule 11 (inplace mode preserves dtype restrictions)
{v_1 : bool, v_2 : tensor} |= if v_1 then (1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8) else (1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8)
