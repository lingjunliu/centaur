>>
Rule 1 (input and end must have the same dtype to avoid dtype mismatch)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (tensor weight must have the same dtype as input to avoid “Found dtype Double but expected Float”)
{v_1 : tensor, v_3 : tensor} |= dtype_(v_3) = dtype_(v_1)
>>
Rule 3 (input and end must be broadcastable to avoid size mismatch at any dimension)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≤ ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = 1 ∨ shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i)) else ∀i ∈ [0, ndim(v_2) - 1] : (shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = 1 ∨ shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i))
>>
Rule 4 (tensor weight must be broadcastable with both input and end)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= (if ndim(v_1) ≤ ndim(v_3) then ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_3, ndim(v_3) - 1 - i) = 1 ∨ shape(v_1, ndim(v_1) - 1 - i) = shape(v_3, ndim(v_3) - 1 - i)) else ∀i ∈ [0, ndim(v_3) - 1] : (shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_3, ndim(v_3) - 1 - i) = 1 ∨ shape(v_1, ndim(v_1) - 1 - i) = shape(v_3, ndim(v_3) - 1 - i))) ∧ (if ndim(v_2) ≤ ndim(v_3) then ∀i ∈ [0, ndim(v_2) - 1] : (shape(v_2, ndim(v_2) - 1 - i) = 1 ∨ shape(v_3, ndim(v_3) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = shape(v_3, ndim(v_3) - 1 - i)) else ∀i ∈ [0, ndim(v_3) - 1] : (shape(v_2, ndim(v_2) - 1 - i) = 1 ∨ shape(v_3, ndim(v_3) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = shape(v_3, ndim(v_3) - 1 - i)))
>>
Rule 6 (out dtype must match input dtype)
{v_1 : tensor, v_4 : tensor} |= dtype_(v_4) = dtype_(v_1)
