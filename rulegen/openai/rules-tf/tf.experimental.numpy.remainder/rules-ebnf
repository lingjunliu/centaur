>>
Rule 1 (operands must have identical dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (broadcasting when ranks are equal)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 4 (broadcasting from the trailing axes when v_1 has greater or equal rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ ndim(v_2) then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i) ∨ shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = 1
>>
Rule 5 (broadcasting from the trailing axes when v_2 has greater or equal rank)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) ≥ ndim(v_1) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i) ∨ shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = 1
>>
Rule 6 (broadcastable shapes with positive matched dimensions)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ (shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1) ∧ shape(v_1, ndim(v_1) - i - 1) > 0)
>>
Rule 7 (no zero-length dimensions)
{v_1 : tensor, v_2 : tensor} |= (if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (if ndim(v_2) = 0 then true else ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0)
>>
Rule 10 (exactly equal shapes imply matching dtypes)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) then dtype_(v_1) = dtype_(v_2)
>>
Rule 11 (extra leading axes must be size 1 for broadcasting)
{v_1 : tensor, v_2 : tensor} |= (if ndim(v_1) > ndim(v_2) then ∀i ∈ [0, ndim(v_1) - ndim(v_2) - 1] : shape(v_1, i) = 1) ∧ (if ndim(v_2) > ndim(v_1) then ∀i ∈ [0, ndim(v_2) - ndim(v_1) - 1] : shape(v_2, i) = 1)
