>>
Rule 1 (x and y must have the same dtype)
{v_2 : tensor, v_3 : tensor} |= dtype_(v_2) = dtype_(v_3)
>>
Rule 2 (broadcasting compatibility between x and y)
{v_2 : tensor, v_3 : tensor} |= ∀i ∈ [0, if ndim(v_2) ≥ ndim(v_3) then ndim(v_2) - 1 else ndim(v_3) - 1] : ndim(v_2) - i - 1 < 0 ∨ ndim(v_3) - i - 1 < 0 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_3, ndim(v_3) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = shape(v_3, ndim(v_3) - i - 1)
>>
Rule 3 (valid op name string from allowed set)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "linear" ∨ v_1 = "sum"
>>
Rule 4 (if ranks match, enforce per-dimension compatibility)
{v_2 : tensor, v_3 : tensor} |= if ndim(v_2) = ndim(v_3) then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = 1 ∨ shape(v_3, i) = 1 ∨ shape(v_2, i) = shape(v_3, i)
