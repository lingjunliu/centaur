>>
Rule 2 (each input tensor must have positive extents along all dimensions)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0)
>>
Rule 3 (inputs must be broadcastable under NumPy/TF broadcasting)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ ndim(v_2) then (∀i ∈ [0, ndim(v_1) - ndim(v_2) - 1] : shape(v_2, i) = 1) ∧ (∀j ∈ [0, ndim(v_2) - 1] : (shape(v_1, (ndim(v_1) - ndim(v_2)) + j) = shape(v_2, j) ∨ shape(v_1, (ndim(v_1) - ndim(v_2)) + j) = 1 ∨ shape(v_2, j) = 1)) else (∀i ∈ [0, ndim(v_2) - ndim(v_1) - 1] : shape(v_1, i) = 1) ∧ (∀j ∈ [0, ndim(v_1) - 1] : (shape(v_2, (ndim(v_2) - ndim(v_1)) + j) = shape(v_1, j) ∨ shape(v_2, (ndim(v_2) - ndim(v_1)) + j) = 1 ∨ shape(v_1, j) = 1))
>>
Rule 4 (input tensors must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 5 (x1 and x2 must be broadcast-compatible across aligned trailing axes)
{v_1 : tensor, v_2 : tensor} |= if (if ndim(v_1) ≤ ndim(v_2) then ndim(v_1) else ndim(v_2)) = 0 then true else ∀i ∈ [0, (if ndim(v_1) ≤ ndim(v_2) then ndim(v_1) else ndim(v_2)) - 1] : shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1)
>>
Rule 6 (each explicit dimension size must be non-negative)
{v_1 : tensor, v_2 : tensor} |= (if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0) ∧ (if ndim(v_2) = 0 then true else ∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) ≥ 0)
