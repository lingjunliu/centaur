>>
Rule 1 (checkpoint_dir must be a path-like string, not a reserved keyword)
{v_1 : str} |= v_1 ≠ "none" ∧ v_1 ≠ "relu" ∧ v_1 ≠ "tanh" ∧ v_1 ≠ "sigmoid" ∧ v_1 ≠ "softmax" ∧ v_1 ≠ "sum" ∧ v_1 ≠ "max" ∧ v_1 ≠ "min" ∧ v_1 ≠ "prod"
>>
Rule 2 (latest_filename may be omitted; otherwise it must not be a reserved keyword)
{v_2 : str} |= (v_2 = "none") ∨ (v_2 ≠ "relu" ∧ v_2 ≠ "tanh" ∧ v_2 ≠ "sigmoid" ∧ v_2 ≠ "softmax" ∧ v_2 ≠ "sum" ∧ v_2 ≠ "max" ∧ v_2 ≠ "min" ∧ v_2 ≠ "prod")
>>
Rule 3 (latest_filename, when provided, must differ from checkpoint_dir)
{v_1 : str, v_2 : str} |= if v_2 = "none" then true else v_2 ≠ v_1
>>
Rule 4 (checkpoint_dir should not be a layout or padding keyword)
{v_1 : str} |= v_1 ≠ "channels_last" ∧ v_1 ≠ "channels_first" ∧ v_1 ≠ "valid" ∧ v_1 ≠ "same" ∧ v_1 ≠ "causal"
>>
Rule 5 (latest_filename should not be an einsum-like spec unless omitted)
{v_2 : str} |= (v_2 = "none") ∨ (v_2 ≠ "ii" ∧ v_2 ≠ "ii->i" ∧ v_2 ≠ "i,j->ij" ∧ v_2 ≠ "...ij->...ji" ∧ v_2 ≠ "bij,bjk->bik" ∧ v_2 ≠ "bn,anm,bm->ba")
