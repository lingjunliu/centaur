>>
Rule 1 (values must be a numeric tensor dtype: 1–10)
{v_1 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
>>
Rule 2 (tensor value_range must match values dtype and be shape [2])
{v_1 : tensor, v_2 : tensor} |= dtype_(v_2) = dtype_(v_1) ∧ ndim(v_2) = 1 ∧ shape(v_2, 0) = 2
>>
Rule 3 (nbins must be a positive integer)
{v_3 : int} |= v_3 > 0
>>
Rule 4 (output dtype must be an integer index type for bin indices)
{v_4 : dtype} |= v_4 = 3 ∨ v_4 = 4
>>
Rule 6 (tuple value_range must have exactly two elements in increasing order)
{v_2 : tuple(int ⊎ float)} |= v_2.len = 2 ∧ v_2[0] < v_2[1]
>>
Rule 9 (name is any valid string)
{v_5 : str} |= v_5 = v_5
