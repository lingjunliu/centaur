Rule 4 (tuple axis: no duplicate entries)
{v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : ∀j ∈ [0, v_2.len - 1] : if i ≠ j then v_2[i] ≠ v_2[j]
>>
Rule 6 (list axis: no duplicate entries)
{v_2 : list(int)} |= ∀i ∈ [0, v_2.len - 1] : ∀j ∈ [0, v_2.len - 1] : if i ≠ j then v_2[i] ≠ v_2[j]
>>
Rule 7 (tuple axis: if all specified axes are non-negative, they must be strictly increasing)
{v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : ∀j ∈ [0, v_2.len - 1] : if i < j ∧ v_2[i] ≥ 0 ∧ v_2[j] ≥ 0 then v_2[i] < v_2[j]
>>
Rule 8 (list axis: if all specified axes are non-negative, they must be strictly increasing)
{v_2 : list(int)} |= ∀i ∈ [0, v_2.len - 1] : ∀j ∈ [0, v_2.len - 1] : if i < j ∧ v_2[i] ≥ 0 ∧ v_2[j] ≥ 0 then v_2[i] < v_2[j]
