>>
Rule 1 (broadcasting compatibility for input tensors)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1)
>>
Rule 2 (rtol and atol must be non-negative)
{v_3 : float, v_4 : float} |= v_3 ≥ 0 ∧ v_4 ≥ 0
>>
Rule 3 (equal_nan true requires floating-point or complex inputs)
{v_1 : tensor, v_2 : tensor, v_5 : bool} |= if v_5 then ((dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) ∧ (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10))
>>
Rule 4 (inputs must not be string tensors)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 11 ∧ dtype_(v_2) ≠ 11
>>
Rule 6 (inputs must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 7 (either one input is scalar or shapes must match exactly)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 0 ∨ ndim(v_2) = 0) then true else (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 8 (if both are non-scalars, their trailing dimensions must match)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) > 0 ∧ ndim(v_2) > 0) then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1)
>>
Rule 9 (if NaNs are not treated as equal, both inputs must be NaN-free)
{v_1 : tensor, v_2 : tensor, v_5 : bool} |= if v_5 = false then (min(v_1) = min(v_1) ∧ min(v_2) = min(v_2))
>>
Rule 10 (tolerances must not be NaN)
{v_3 : float, v_4 : float} |= (v_3 = v_3) ∧ (v_4 = v_4)
>>
Rule 11 (boolean flag is explicitly true or false)
{v_5 : bool} |= (v_5 = true) ∨ (v_5 = false)
