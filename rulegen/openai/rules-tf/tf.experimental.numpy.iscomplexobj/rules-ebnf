>>
Rule 1 (input tensor must have a defined, non-negative rank)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 2 (all shape dimensions must be non-negative)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 3 (scalar tensors are supported)
{v_1 : tensor} |= if ndim(v_1) = 0 then true else shape(v_1, 0) ≥ 0
>>
Rule 4 (input tensor must have a valid dtype)
{v_1 : tensor} |= dtype_(v_1) = dtype_(v_1)
>>
Rule 5 (last axis size must be defined if rank > 0)
{v_1 : tensor} |= if ndim(v_1) > 0 then shape(v_1, ndim(v_1) - 1) ≥ 0
>>
Rule 7 (each dimension size is a non-negative integer)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0 ∧ (shape(v_1, i) % 1 = 0)
>>
Rule 8 (zero-sized dimensions only occur when rank is at least 1)
{v_1 : tensor} |= if (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) then ndim(v_1) ≥ 1
>>
Rule 9 (scalar or higher-rank tensors are both acceptable)
{v_1 : tensor} |= (ndim(v_1) = 0) ∨ (ndim(v_1) ≥ 1)
>>
Rule 10 (first dimension size is valid whenever rank ≥ 1)
{v_1 : tensor} |= if ndim(v_1) ≥ 1 then shape(v_1, 0) ≥ 0
>>
Rule 12 (shape indices are integers)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) % 1) = 0
>>
Rule 14 (second dimension is valid when rank ≥ 2)
{v_1 : tensor} |= if ndim(v_1) ≥ 2 then shape(v_1, 1) ≥ 0
>>
Rule 15 (non-empty integer tensors have integral extrema)
{v_1 : tensor} |= if (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) then true else ( if (1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5) then ((min(v_1) % 1) = 0 ∧ (max(v_1) % 1) = 0) )
>>
Rule 16 (non-empty float tensors have ordered extrema)
{v_1 : tensor} |= if (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) then true else ( if (6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8) then (max(v_1) - min(v_1) ≥ 0) )
>>
Rule 17 (tensor dtype is not a meta-dtype index)
{v_1 : tensor} |= dtype_(v_1) ≠ 12
>>
Rule 18 (either the tensor is empty or all dimensions are positive)
{v_1 : tensor} |= (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) ∨ (∀j ∈ [0, ndim(v_1) - 1] : shape(v_1, j) > 0)
>>
Rule 19 (non-empty boolean tensors have extrema within [0, 1])
{v_1 : tensor} |= if (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) then true else ( if dtype_(v_1) = 0 then (min(v_1) ≥ 0 ∧ max(v_1) ≤ 1) )
