Rule 1 (Tensor inputs must have boolean dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = 0 ∧ dtype_(v_2) = 0
>>
Rule 2 (Tensor-tensor broadcasting: equal shapes or one scalar)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2) ∨ ndim(v_1) = 0 ∨ ndim(v_2) = 0
>>
Rule 5 (Boolean-boolean inputs are valid booleans)
{v_1 : bool, v_2 : bool} |= (v_1 = true ∨ v_1 = false) ∧ (v_2 = true ∨ v_2 = false)
>>
Rule 6 (Name, if provided, must be a valid string from the allowed set)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "sum" ∨ v_1 = "max" ∨ v_1 = "min"
>>
Rule 7 (If ranks match, require exact shape match to ensure safe broadcasting)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then shape(v_1) = shape(v_2)
