>>
Rule 1 (input tensor rank must be non-negative and reasonably bounded)
{v_1 : tensor} |= 0 ≤ ndim(v_1) ∧ ndim(v_1) ≤ 8
>>
Rule 2 (non-scalar input must have positive sizes in every dimension)
{v_1 : tensor} |= if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 3 (name must be one of allowed operation-name strings)
{v_2 : str} |= v_2 = "none" ∨ v_2 = "relu" ∨ v_2 = "tanh" ∨ v_2 = "softmax" ∨ v_2 = "linear"
>>
Rule 4 (dtype of the input tensor is well-defined)
{v_1 : tensor} |= dtype_(v_1) = dtype_(v_1)
>>
Rule 5 (if name suggests a data-format, require at least 3D input)
{v_1 : tensor, v_2 : str} |= if v_2 = "channels_last" ∨ v_2 = "channels_first" then ndim(v_1) ≥ 3
