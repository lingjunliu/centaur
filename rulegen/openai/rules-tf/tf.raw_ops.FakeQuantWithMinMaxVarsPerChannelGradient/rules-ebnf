Rule 1 (tensor dtypes must match across all tensor parameters)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : tensor} |= dtype_(v_1) = dtype_(v_2) ∧ dtype_(v_2) = dtype_(v_3) ∧ dtype_(v_3) = dtype_(v_4)
>>
Rule 2 (inputs and gradients must have identical shapes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (allowed ranks for inputs/gradients are 1, 2, or 4)
{v_1 : tensor} |= ndim(v_1) = 1 ∨ ndim(v_1) = 2 ∨ ndim(v_1) = 4
>>
Rule 4 (min and max must be rank-1 vectors of equal, positive length)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 1 ∧ ndim(v_2) = 1 ∧ shape(v_1, 0) = shape(v_2, 0) ∧ shape(v_1, 0) > 0
>>
Rule 5 (channel count equals last dimension of inputs and gradients)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= shape(v_1, 0) = shape(v_2, ndim(v_2) - 1) ∧ shape(v_1, 0) = shape(v_3, ndim(v_3) - 1)
>>
Rule 6 (all dimensions of gradients must be positive)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 7 (num_bits must be between 2 and 16 inclusive)
{v_1 : int} |= 2 ≤ v_1 ∧ v_1 ≤ 16
>>
Rule 8 (narrow_range condition relates to a valid num_bits range)
{v_1 : bool, v_2 : int} |= if v_1 then (2 ≤ v_2 ∧ v_2 ≤ 16) else (2 ≤ v_2 ∧ v_2 ≤ 16)
>>
Rule 9 (name, if provided, should be from the allowed string set)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "linear" ∨ v_1 = "relu"
