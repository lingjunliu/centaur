>>
Rule 1 (images must be floating-point: float16/float32/float64)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 2 (images must be at least 1-D)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 3 (last dimension of images must be size 3)
{v_1 : tensor} |= ndim(v_1) ≥ 1 ∧ (∀i ∈ [ndim(v_1) - 1, ndim(v_1) - 1] : shape(v_1, i) = 3)
>>
Rule 4 (HSV values should lie within [0, 1] for well-defined output)
{v_1 : tensor} |= min(v_1) ≥ 0 ∧ max(v_1) ≤ 1
>>
Rule 5 (vector case: a 1-D images tensor must have length 3)
{v_1 : tensor} |= if ndim(v_1) = 1 then shape(v_1, 0) = 3
>>
Rule 6 (name, if provided, is chosen from the allowed string set)
{v_2 : str} |= v_2 = "none" ∨ v_2 = "linear" ∨ v_2 = "relu" ∨ v_2 = "tanh" ∨ v_2 = "softmax" ∨ v_2 = "valid" ∨ v_2 = "same" ∨ v_2 = "channels_last" ∨ v_2 = "channels_first"
>>
Rule 7 (channels_last name implies the trailing channel-size constraint)
{v_1 : tensor, v_2 : str} |= if v_2 = "channels_last" then ndim(v_1) ≥ 1 ∧ shape(v_1, ndim(v_1) - 1) = 3
