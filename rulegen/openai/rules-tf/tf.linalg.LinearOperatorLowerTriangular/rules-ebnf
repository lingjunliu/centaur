Rule 1 (tril must be at least rank-2: a matrix or a batch of matrices)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (trailing two dimensions of tril must be square)
{v_1 : tensor} |= shape(v_1, ndim(v_1) - 2) = shape(v_1, ndim(v_1) - 1)
>>
Rule 3 (square hint must be true and consistent with the shape)
{v_1 : tensor, v_5 : bool} |= v_5 = true ∧ shape(v_1, ndim(v_1) - 2) = shape(v_1, ndim(v_1) - 1)
>>
Rule 4 (positive definite implies non-singular)
{v_2 : bool, v_4 : bool} |= if v_4 then v_2
>>
Rule 5 (self-adjoint implies square)
{v_3 : bool, v_5 : bool} |= if v_3 then v_5
>>
Rule 6 (optional name choices are valid strings)
{v_6 : str} |= v_6 = "none" ∨ v_6 = "linear" ∨ v_6 = "sum" ∨ v_6 = "min" ∨ v_6 = "max"
