>>
Rule 1 (inputs must have identical dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (shapes must match exactly across all dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (0-D tensors compare only with 0-D tensors)
{v_1 : tensor, v_2 : tensor} |= (if ndim(v_1) = 0 then ndim(v_2) = 0) ∧ (if ndim(v_2) = 0 then ndim(v_1) = 0)
>>
Rule 4 (complex comparisons require both inputs to be complex)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10 then (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) ∧ (dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)
>>
Rule 5 (string comparisons require both inputs to be string dtype)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 11 ∨ dtype_(v_2) = 11 then dtype_(v_1) = 11 ∧ dtype_(v_2) = 11
>>
Rule 6 (tensor dtypes are within the supported range)
{v_1 : tensor, v_2 : tensor} |= 0 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 11 ∧ 0 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 11
