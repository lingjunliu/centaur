>>
Rule 1 (filename must be a scalar tensor)
{filename : tensor} |= ndim(filename) = 0
>>
Rule 2 (contents must be a scalar tensor)
{contents : tensor} |= ndim(contents) = 0
>>
Rule 3 (filename and contents must have the same dtype)
{filename : tensor, contents : tensor} |= dtype_(filename) = dtype_(contents)
>>
Rule 4 (filename and contents must have identical rank and shape)
{filename : tensor, contents : tensor} |= ndim(filename) = ndim(contents) ∧ ∀i ∈ [0, ndim(filename) - 1] : shape(filename, i) = shape(contents, i)
>>
Rule 5 (all shape dimensions, if any, are non-negative)
{filename : tensor, contents : tensor} |= ∀i ∈ [0, ndim(filename) - 1] : shape(filename, i) ≥ 0 ∧ ∀j ∈ [0, ndim(contents) - 1] : shape(contents, j) ≥ 0
>>
Rule 6 (name is chosen from the allowed string set)
{name : str} |= name = "ii" ∨ name = "ii->i" ∨ name = "i,j->ij" ∨ name = "bij,bjk->bik" ∨ name = "...ij->...ji" ∨ name = "bn,anm,bm->ba" ∨ name = "none" ∨ name = "sum" ∨ name = "max" ∨ name = "min" ∨ name = "prod" ∨ name = "relu" ∨ name = "tanh" ∨ name = "sigmoid" ∨ name = "softmax" ∨ name = "elu" ∨ name = "selu" ∨ name = "gelu" ∨ name = "swish" ∨ name = "softplus" ∨ name = "linear" ∨ name = "valid" ∨ name = "same" ∨ name = "causal" ∨ name = "channels_last" ∨ name = "channels_first"
