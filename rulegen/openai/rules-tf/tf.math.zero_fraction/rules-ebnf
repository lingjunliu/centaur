>>
Rule 1 (value must be a numeric tensor dtype)
{v_1 : tensor} |= dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 10
>>
Rule 2 (scalar numeric tensor is allowed)
{v_1 : tensor} |= ndim(v_1) = 0 ∧ dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 10
>>
Rule 3 (empty numeric tensor is allowed)
{v_1 : tensor} |= dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 10 ∧ ndim(v_1) ≥ 1 ∧ ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0
>>
Rule 4 (non-empty 2D+ numeric tensor is allowed)
{v_1 : tensor} |= dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 10 ∧ ndim(v_1) ≥ 2 ∧ shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0
>>
Rule 5 (name is any supported string exemplar)
{v_2 : str} |= v_2 = "none" ∨ v_2 = "linear" ∨ v_2 = "relu"
>>
Rule 6 (if name is 'causal', require at least 1-D tensor; always numeric dtype)
{v_1 : tensor, v_2 : str} |= dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 10 ∧ if v_2 = "causal" then ndim(v_1) ≥ 1
