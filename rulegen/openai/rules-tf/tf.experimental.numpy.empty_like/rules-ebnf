Rule 1 (dtype must be interpretable as a NumPy dtype)
{v_2 : dtype} |= v_2 = v_2
>>
Rule 2 (explicit dtype matches the input tensor dtype)
{v_1 : tensor, v_2 : dtype} |= v_2 = dtype_(v_1)
>>
Rule 3 (valid rank and non-negative dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 0 ∧ if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 4 (scalar tensor or all extents positive)
{v_1 : tensor} |= (ndim(v_1) = 0) ∨ (ndim(v_1) ≥ 1 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0)
>>
Rule 5 (min ≤ max for non-empty tensors)
{v_1 : tensor} |= if (ndim(v_1) ≥ 1 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) then min(v_1) ≤ max(v_1)
