Rule 1 (inputs must be at least rank-2 to avoid index errors)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2
>>
Rule 2 (batch ranks and outer batch dimensions must match)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ (if ndim(v_1) > 2 then ∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) = shape(v_2, i))
>>
Rule 3 (shared M dimension for least-squares: matrix[..., M, N] and rhs[..., M, K])
{v_1 : tensor, v_2 : tensor} |= shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 2)
>>
Rule 4 (allowed numeric dtypes and dtype consistency between inputs)
{v_1 : tensor, v_2 : tensor} |= (7 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10) ∧ dtype_(v_2) = dtype_(v_1)
>>
Rule 6 (l2_regularizer tensor must be a 0-D float64 scalar)
{v_3 : tensor} |= ndim(v_3) = 0 ∧ dtype_(v_3) = 8
>>
Rule 7 (complex128 requires zero l2_regularizer for tensor signature)
{v_1 : tensor, v_3 : tensor} |= if dtype_(v_1) = 10 then v_3 = 0
>>
Rule 8 (non-negative l2_regularizer when fast path is used; works for float or 0-D tensor)
{v_3 : float ⊎ tensor, v_4 : bool} |= if v_4 = true then v_3 ≥ 0
>>
Rule 9 (fast is a boolean flag)
{v_4 : bool} |= v_4 = true ∨ v_4 = false
