>>
Rule 1 (axis must be within [-rank(values), rank(values)) for single-tensor input)
{v_1 : tensor, v_2 : int} |= (0 - ndim(v_1) ≤ v_2) ∧ (v_2 < ndim(v_1))
>>
Rule 2 (negative axis is normalized to a valid 0-based index)
{v_1 : tensor, v_2 : int} |= if v_2 < 0 then (0 ≤ v_2 + ndim(v_1) ∧ v_2 + ndim(v_1) < ndim(v_1)) else (0 ≤ v_2 ∧ v_2 < ndim(v_1))
>>
Rule 3 (only axis 0 or -1 is valid for 1-D inputs)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then (v_2 = 0 ∨ v_2 = 0 - 1)
>>
Rule 4 (axis cannot equal the rank for single-tensor input)
{v_1 : tensor, v_2 : int} |= v_2 ≠ ndim(v_1)
>>
Rule 5 (values list must be non-empty for multi-tensor input)
{v_1 : tuple(tensor)} |= v_1.len ≥ 1
>>
Rule 6 (name, if provided, is chosen from supported strings)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "sum" ∨ v_1 = "max" ∨ v_1 = "min" ∨ v_1 = "prod" ∨ v_1 = "relu" ∨ v_1 = "tanh" ∨ v_1 = "sigmoid" ∨ v_1 = "softmax" ∨ v_1 = "elu" ∨ v_1 = "selu" ∨ v_1 = "gelu" ∨ v_1 = "swish" ∨ v_1 = "softplus" ∨ v_1 = "linear" ∨ v_1 = "valid" ∨ v_1 = "same" ∨ v_1 = "causal" ∨ v_1 = "channels_last" ∨ v_1 = "channels_first"
>>
Rule 7 (non-negative axis uses 0-based indexing)
{v_1 : tensor, v_2 : int} |= if v_2 ≥ 0 then (0 ≤ v_2 ∧ v_2 ≤ ndim(v_1) - 1)
>>
Rule 8 (axis = -1 refers to the last dimension; requires at least 1-D)
{v_1 : tensor, v_2 : int} |= if v_2 = 0 - 1 then ndim(v_1) ≥ 1
