Rule 1 (dtype must be a TensorFlow/NumPy numeric, boolean, or complex dtype)
{v_2 : dtype} |= v_2 = 0 ∨ v_2 = 1 ∨ v_2 = 2 ∨ v_2 = 3 ∨ v_2 = 4 ∨ v_2 = 5 ∨ v_2 = 6 ∨ v_2 = 7 ∨ v_2 = 8 ∨ v_2 = 9 ∨ v_2 = 10
>>
Rule 2 (input tensor must have an interpretable numeric/boolean/complex dtype)
{v_1 : tensor} |= dtype_(v_1) = 0 ∨ dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 3 (dtype cannot be a string or an uninterpretable dtype handle)
{v_2 : dtype} |= v_2 ≠ 11 ∧ v_2 ≠ 12
>>
Rule 4 (tensor rank is non-negative and each dimension size is non-negative)
{v_1 : tensor} |= if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 5 (if output dtype is complex, the input dtype must be floating-point or complex)
{v_1 : tensor, v_2 : dtype} |= if v_2 = 9 ∨ v_2 = 10 then (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10)
>>
Rule 6 (input must be a tensor-like object)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 8 (dtype argument must be an interpretable NumPy dtype; suppresses "Cannot interpret 'torch.int64' as a data type")
{v_2 : dtype} |= v_2 = v_2
>>
Rule 9 (conservative dtype override: for non-scalar inputs, keep the original dtype)
{v_1 : tensor, v_2 : dtype} |= (ndim(v_1) = 0) ∨ (v_2 = dtype_(v_1))
>>
Rule 11 (do not override dtype when input is string-like)
{v_1 : tensor, v_2 : dtype} |= if v_2 ≠ dtype_(v_1) then dtype_(v_1) ≠ 11
>>
Rule 12 (scalar inputs keep their original dtype)
{v_1 : tensor, v_2 : dtype} |= if ndim(v_1) = 0 then v_2 = dtype_(v_1)
>>
Rule 13 (tensor rank is reasonably bounded)
{v_1 : tensor} |= ndim(v_1) ≤ 32
>>
Rule 14 (first dimension is valid when present)
{v_1 : tensor} |= if ndim(v_1) ≥ 1 then shape(v_1, 0) ≥ 0
