>>
Rule 1 (x and y must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (x and y must be broadcast-compatible along trailing dimensions)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) ≥ ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, ndim(v_1) - 1 - i) = (if i < ndim(v_2) then shape(v_2, ndim(v_2) - 1 - i) else 1) ∨ shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ (if i < ndim(v_2) then shape(v_2, ndim(v_2) - 1 - i) else 1) = 1)) ∨ (ndim(v_2) ≥ ndim(v_1) ∧ ∀i ∈ [0, ndim(v_2) - 1] : (shape(v_2, ndim(v_2) - 1 - i) = (if i < ndim(v_1) then shape(v_1, ndim(v_1) - 1 - i) else 1) ∨ shape(v_2, ndim(v_2) - 1 - i) = 1 ∨ (if i < ndim(v_1) then shape(v_1, ndim(v_1) - 1 - i) else 1) = 1))
>>
Rule 3 (all tensor shape dimensions are non-negative)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) ≥ 0)
>>
Rule 4 (name is an unconstrained string parameter)
{v_1 : str} |= v_1 = v_1
>>
Rule 5 (input tensors must be of supported data types)
{v_1 : tensor, v_2 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10 ∧ 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 10
>>
Rule 7 (broadcasting compatibility of x and y)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 ∨ ndim(v_2) = 0 then true else if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1 else if ndim(v_1) > ndim(v_2) then (∀i ∈ [0, ndim(v_1) - ndim(v_2) - 1] : shape(v_1, i) = 1) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_1, j + (ndim(v_1) - ndim(v_2))) = shape(v_2, j) ∨ shape(v_1, j + (ndim(v_1) - ndim(v_2))) = 1 ∨ shape(v_2, j) = 1) else (∀i ∈ [0, ndim(v_2) - ndim(v_1) - 1] : shape(v_2, i) = 1) ∧ (∀j ∈ [0, ndim(v_1) - 1] : shape(v_1, j) = shape(v_2, j + (ndim(v_2) - ndim(v_1))) ∨ shape(v_1, j) = 1 ∨ shape(v_2, j + (ndim(v_2) - ndim(v_1))) = 1)
>>
Rule 8 (valid values for the optional name)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "sum" ∨ v_1 = "max" ∨ v_1 = "min" ∨ v_1 = "prod"
