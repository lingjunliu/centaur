Rule 1 (a and b must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (a and b must have identical shape)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (the innermost dimension of a must be 3)
{v_1 : tensor} |= 1 ≤ ndim(v_1) ∧ shape(v_1, ndim(v_1) - 1) = 3
>>
Rule 4 (the innermost dimension of b must be 3)
{v_2 : tensor} |= 1 ≤ ndim(v_2) ∧ shape(v_2, ndim(v_2) - 1) = 3
>>
Rule 5 (a is either a 3-vector or has last dimension 3)
{v_1 : tensor} |= if ndim(v_1) = 1 then shape(v_1, 0) = 3 else shape(v_1, ndim(v_1) - 1) = 3
>>
Rule 6 (name is an unconstrained string parameter)
{v_3 : str} |= v_3 = v_3
