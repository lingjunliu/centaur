>>
Rule 1 (input dtype must be float or complex supported by expm)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
>>
Rule 2 (input tensor must not be boolean)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 3 (input must have at least two dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 4 (innermost two dimensions must be square)
{v_1 : tensor} |= shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 5 (name is any valid string)
{v_2 : str} |= v_2 = v_2
