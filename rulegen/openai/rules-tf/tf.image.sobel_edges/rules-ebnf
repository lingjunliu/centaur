>>
Rule 1 (image must be a 4-D tensor shaped [batch, height, width, channels])
{v_1 : tensor} |= ndim(v_1) = 4
>>
Rule 2 (height and width must be at least 2)
{v_1 : tensor} |= ∀i ∈ [1, 2] : shape(v_1, i) ≥ 2
>>
Rule 3 (channels dimension must be at least 1)
{v_1 : tensor} |= shape(v_1, 3) ≥ 1
>>
Rule 4 (image dtype must be float32 or float64)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 5 (ensure tensor supports shape introspection to avoid 'get_shape' errors)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
