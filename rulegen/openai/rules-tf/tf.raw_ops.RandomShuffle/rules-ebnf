>>
Rule 1 (input tensor must be at least 1-dimensional)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 2 (first dimension size is defined and non-negative when rank ≥ 1)
{v_1 : tensor} |= if ndim(v_1) ≥ 1 then shape(v_1, 0) ≥ 0 else false
>>
Rule 3 (seeds are arbitrary integers; zero or non-zero are both allowed)
{v_1 : int, v_2 : int} |= (v_1 = 0 ∨ v_1 ≠ 0) ∧ (v_2 = 0 ∨ v_2 ≠ 0)
>>
Rule 4 (name is a string identifier)
{v_1 : str} |= v_1 = v_1
>>
Rule 6 (all dimensions of value must be non-negative)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 7 (for 1-D value, the first dimension must be non-empty)
{v_1 : tensor} |= if ndim(v_1) = 1 then shape(v_1, 0) ≥ 1
>>
Rule 8 (seed and seed2 must lie within 32-bit signed integer range)
{v_1 : int, v_2 : int} |= (-2147483648 ≤ v_1 ∧ v_1 ≤ 2147483647) ∧ (-2147483648 ≤ v_2 ∧ v_2 ≤ 2147483647)
>>
Rule 9 (avoid both seeds being negative simultaneously)
{v_1 : int, v_2 : int} |= (v_1 ≥ 0) ∨ (v_2 ≥ 0)
>>
Rule 10 (value must have a supported dtype)
{v_1 : tensor} |= 0 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 11
>>
Rule 11 (name should not be the reserved string "none")
{v_1 : str} |= v_1 ≠ "none"
