>>
Rule 1 (x and y must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (if ranks are equal, per-dimension broadcast compatibility is required)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
>>
Rule 3 (if x has lower rank than y, all x dimensions must be singleton to broadcast)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) < ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1
>>
Rule 4 (if y has lower rank than x, all y dimensions must be singleton to broadcast)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) < ndim(v_1) then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = 1
