{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 1 ∧ ndim(v_2) ≥ 1 ∧ (shape(v_1, 0) = shape(v_2, ndim(v_2) - 1) ∨ shape(v_1, 0) = 1)) ∨ (ndim(v_2) = 1 ∧ ndim(v_1) ≥ 1 ∧ (shape(v_2, 0) = shape(v_1, ndim(v_1) - 1) ∨ shape(v_2, 0) = 1))
