Rule 1 (indices must be 1-D and int32/int64)
{v_2 : tensor} |= ndim(v_2) = 1 ∧ (dtype_(v_2) = 3 ∨ dtype_(v_2) = 4)
>>
Rule 2 (values must have rank at least 1)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 3 (number of slices equals number of indices)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) = shape(v_2, 0)
>>
Rule 4 (indices are non-negative)
{v_2 : tensor} |= min(v_2) ≥ 0
>>
Rule 5 (tensor dense_shape must be 1-D int32/int64 with length equal to values rank)
{v_1 : tensor, v_3 : tensor} |= ndim(v_3) = 1 ∧ (dtype_(v_3) = 3 ∨ dtype_(v_3) = 4) ∧ shape(v_3, 0) = ndim(v_1)
>>
Rule 6 (list dense_shape length equals values rank and dimensions are non-negative)
{v_1 : tensor, v_3 : list(int)} |= v_3.len = ndim(v_1) ∧ ∀i ∈ [0, v_3.len - 1] : v_3[i] ≥ 0
>>
Rule 7 (tuple dense_shape length equals values rank and inner dims match values)
{v_1 : tensor, v_3 : tuple(int)} |= v_3.len = ndim(v_1) ∧ (if ndim(v_1) > 1 then ∀i ∈ [1, ndim(v_1) - 1] : v_3[i] = shape(v_1, i))
>>
Rule 8 (with list dense_shape, first dimension must cover all indices)
{v_2 : tensor, v_3 : list(int)} |= if shape(v_2, 0) > 0 then v_3[0] ≥ max(v_2) + 1
>>
Rule 9 (with tuple dense_shape, first dimension must be at least number of slices)
{v_1 : tensor, v_3 : tuple(int)} |= v_3[0] ≥ shape(v_1, 0)
>>
Rule 10 (with tuple dense_shape, indices must lie within [0, dense_shape[0) )
{v_2 : tensor, v_3 : tuple(int)} |= if shape(v_2, 0) > 0 then (min(v_2) ≥ 0 ∧ max(v_2) ≤ v_3[0] - 1)
>>
Rule 11 (with list dense_shape, inner dimensions match values)
{v_1 : tensor, v_3 : list(int)} |= if ndim(v_1) > 1 then ∀i ∈ [1, ndim(v_1) - 1] : v_3[i] = shape(v_1, i)
