>>
Rule 1 (output shape must be a 1-D non-negative shape vector with at least one dimension)
{v_1 : tensor} |= ndim(v_1) = 1 ∧ shape(v_1, 0) ≥ 1 ∧ min(v_1) ≥ 0
>>
Rule 2 (distribution parameter tensors share the same dtype)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : tensor} |= dtype_(v_1) = dtype_(v_2) ∧ dtype_(v_1) = dtype_(v_3) ∧ dtype_(v_1) = dtype_(v_4)
>>
Rule 3 (standard deviations are strictly positive)
{v_1 : tensor} |= min(v_1) > 0
>>
Rule 4 (minimum cutoffs do not exceed maximum cutoffs)
{v_1 : tensor, v_2 : tensor} |= max(v_1) ≤ min(v_2)
>>
Rule 5 (each of means, stdevs, minvals, maxvals is either a scalar or a 1-D batch vector)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : tensor} |= (ndim(v_1) = 0 ∨ ndim(v_1) = 1) ∧ (ndim(v_2) = 0 ∨ ndim(v_2) = 1) ∧ (ndim(v_3) = 0 ∨ ndim(v_3) = 1) ∧ (ndim(v_4) = 0 ∨ ndim(v_4) = 1)
>>
Rule 6 (batch vector lengths align across parameters when vectors are used)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : tensor} |= (ndim(v_1) = 0 ∨ ndim(v_2) = 0 ∨ shape(v_1, 0) = shape(v_2, 0)) ∧ (ndim(v_1) = 0 ∨ ndim(v_3) = 0 ∨ shape(v_1, 0) = shape(v_3, 0)) ∧ (ndim(v_1) = 0 ∨ ndim(v_4) = 0 ∨ shape(v_1, 0) = shape(v_4, 0)) ∧ (ndim(v_2) = 0 ∨ ndim(v_3) = 0 ∨ shape(v_2, 0) = shape(v_3, 0)) ∧ (ndim(v_2) = 0 ∨ ndim(v_4) = 0 ∨ shape(v_2, 0) = shape(v_4, 0)) ∧ (ndim(v_3) = 0 ∨ ndim(v_4) = 0 ∨ shape(v_3, 0) = shape(v_4, 0))
>>
Rule 7 (non-empty batch vectors when provided)
{v_1 : tensor, v_2 : tensor, v_3 : tensor, v_4 : tensor} |= (ndim(v_1) = 0 ∨ shape(v_1, 0) > 0) ∧ (ndim(v_2) = 0 ∨ shape(v_2, 0) > 0) ∧ (ndim(v_3) = 0 ∨ shape(v_3, 0) > 0) ∧ (ndim(v_4) = 0 ∨ shape(v_4, 0) > 0)
>>
Rule 8 (shape tensor dtype differs from distribution parameter dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ dtype_(v_2)
