Rule 1 (axis must be within valid range [-rank, rank) for inputs)
{v_1 : tensor, v_3 : int} |= 0 - ndim(v_1) ≤ v_3 ∧ v_3 < ndim(v_1)
>>
Rule 2 (inputs must be at least rank-1)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 3 (inputs must have floating-point dtype)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 4 (length of the selected axis must be positive)
{v_1 : tensor, v_3 : int} |= if v_3 ≥ 0 then shape(v_1, v_3) ≥ 1 else shape(v_1, ndim(v_1) + v_3) ≥ 1
>>
Rule 5 (decreasing must be a boolean)
{v_2 : bool} |= v_2 = true ∨ v_2 = false
>>
Rule 6 (all tensor dimensions, if any, must be non-empty)
{v_1 : tensor} |= if ndim(v_1) = 0 then false else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 1
