>>
Rule 2 (normalized axes are within [0, ndim(a) - 1])
{v_1 : tensor, v_2 : int, v_3 : int} |= (v_2 + (if v_2 < 0 then ndim(v_1) else 0)) ≥ 0 ∧ (v_2 + (if v_2 < 0 then ndim(v_1) else 0)) < ndim(v_1) ∧ (v_3 + (if v_3 < 0 then ndim(v_1) else 0)) ≥ 0 ∧ (v_3 + (if v_3 < 0 then ndim(v_1) else 0)) < ndim(v_1)
>>
Rule 3 (distinct axes require rank at least 2)
{v_1 : tensor, v_2 : int, v_3 : int} |= if (v_2 + (if v_2 < 0 then ndim(v_1) else 0)) ≠ (v_3 + (if v_3 < 0 then ndim(v_1) else 0)) then ndim(v_1) ≥ 2
>>
Rule 4 (for 1-D input, only axis 0 or -1 are allowed)
{v_1 : tensor, v_2 : int, v_3 : int} |= if ndim(v_1) = 1 then ((v_2 = 0 ∨ v_2 = -1) ∧ (v_3 = 0 ∨ v_3 = -1))
>>
Rule 5 (shape access at normalized axes must be defined)
{v_1 : tensor, v_2 : int, v_3 : int} |= shape(v_1, v_2 + (if v_2 < 0 then ndim(v_1) else 0)) ≥ 0 ∧ shape(v_1, v_3 + (if v_3 < 0 then ndim(v_1) else 0)) ≥ 0
>>
Rule 6 (raw axes correspond when normalized axes are equal)
{v_1 : tensor, v_2 : int, v_3 : int} |= if (v_2 + (if v_2 < 0 then ndim(v_1) else 0)) = (v_3 + (if v_3 < 0 then ndim(v_1) else 0)) then (v_2 = v_3 ∨ v_2 = v_3 + ndim(v_1) ∨ v_3 = v_2 + ndim(v_1))
