>>
Rule 1 (data dtype must be one of the allowed numeric/complex types)
{v_1 : tensor} |= (1 ≤ dtype_(v_1)) ∧ (dtype_(v_1) ≤ 10)
>>
Rule 2 (segment_ids must have integer dtype: int16/int32/int64)
{v_2 : tensor} |= (dtype_(v_2) = 2) ∨ (dtype_(v_2) = 3) ∨ (dtype_(v_2) = 4)
>>
Rule 3 (num_segments as a tensor must be int32/int64 and scalar)
{v_3 : tensor} |= ((dtype_(v_3) = 3) ∨ (dtype_(v_3) = 4)) ∧ (ndim(v_3) = 0)
>>
Rule 4 (segment_ids shape must be a prefix of data shape)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_2) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 5 (segment_ids rank cannot exceed data rank)
{v_1 : tensor, v_2 : tensor} |= ndim(v_2) ≤ ndim(v_1)
>>
Rule 7 (optional name, if provided, is a string from the allowed list)
{v_4 : str} |= v_4 = "none"
