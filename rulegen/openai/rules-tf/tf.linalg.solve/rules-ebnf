{v_1 : tensor, v_2 : tensor} |= ndim(v_2) = ndim(v_1) ∧ ndim(v_1) ≥ 2 ∧ shape(v_2, ndim(v_2) - 2) = shape(v_1, ndim(v_1) - 2) ∧ ∀i ∈ [0, if ndim(v_1) ≥ 3 then ndim(v_1) - 3 else -1] : shape(v_2, i) = shape(v_1, i)
