Rule 2 (Tout must be a complex dtype)
{v_1 : dtype} |= v_1 = 9 ∨ v_1 = 10
>>
Rule 3 (Tout must correspond to the input float dtype)
{v_1 : tensor, v_2 : dtype} |= if dtype_(v_1) = 7 then v_2 = 9 else v_2 = 10
>>
Rule 4 (real and imag must have the same rank)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 5 (real and imag must have the same shape elementwise)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 then ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 6 (input dtype implied by Tout)
{v_1 : dtype, v_2 : tensor} |= if v_1 = 9 then dtype_(v_2) = 7 else dtype_(v_2) = 8
