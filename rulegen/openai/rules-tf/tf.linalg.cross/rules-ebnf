Rule 1 (input tensors must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (dtype must be a supported numeric type: int8/int16/int32/int64/uint8/float16/float32/float64)
{v_1 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 3 (input tensors must have identical shapes across all dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 4 (innermost dimension of each input must be 3)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, ndim(v_1) - 1) = 3 ∧ shape(v_2, ndim(v_2) - 1) = 3
>>
Rule 5 (each input must be at least 1-dimensional)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1
>>
Rule 6 (name, if provided, should not be the sentinel string "none")
{v_3 : str} |= v_3 ≠ "none"
>>
Rule 8 (inputs must have identical shapes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ndim(v_1) ≥ 1 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 9 (innermost dimension must be 3)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1 ∧ shape(v_1, ndim(v_1) - 1) = 3 ∧ shape(v_2, ndim(v_2) - 1) = 3
>>
Rule 10 (dtype must not be boolean)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 0 ∧ dtype_(v_2) ≠ 0
