>>
Rule 1 (image must have 3 or 4 dimensions)
{v_1 : tensor} |= ndim(v_1) = 3 ∨ ndim(v_1) = 4
>>
Rule 2 (height, width, and channels must be positive)
{v_1 : tensor} |= ndim(v_1) ≥ 3 ∧ shape(v_1, -3) > 0 ∧ shape(v_1, -2) > 0 ∧ shape(v_1, -1) > 0
>>
Rule 3 (image dtype must be numeric or complex, not bool)
{v_1 : tensor} |= dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 10
>>
Rule 4 (seed is an integer)
{v_2 : int} |= v_2 % 1 = 0
