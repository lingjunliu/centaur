Rule 1 (variant must be a scalar tensor)
{v_1 : tensor} |= ndim(v_1) = 0
>>
Rule 2 (structure as a list of dtypes must be non-empty)
{v_2 : list(dtype)} |= v_2.len ≥ 1
>>
Rule 3 (numeric structure values are non-negative and non-decreasing)
{v_2 : list(int ⊎ float)} |= (∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0) ∧ (∀i ∈ [1, v_2.len - 1] : v_2[i] ≥ v_2[i - 1])
>>
Rule 4 (string structure must use valid channel layout names)
{v_2 : list(str)} |= ∀i ∈ [0, v_2.len - 1] : v_2[i] = "channels_last" ∨ v_2[i] = "channels_first"
>>
Rule 5 (all dtype entries in structure must agree)
{v_2 : list(dtype)} |= ∀i ∈ [0, v_2.len - 1] : ∀j ∈ [0, v_2.len - 1] : v_2[i] = v_2[j]
>>
Rule 6 (boolean structure must contain at least one true flag)
{v_2 : list(bool)} |= if v_2.len = 0 then false else ∃i ∈ [0, v_2.len - 1] : v_2[i] = true
>>
Rule 7 (structure as a list of int-tuples has a bounded size)
{v_2 : list(tuple(int))} |= 1 ≤ v_2.len ∧ v_2.len ≤ 8
