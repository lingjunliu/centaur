>>
Rule 1 (inputs must have identical dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (inputs must be of supported numeric dtypes)
{v_1 : tensor} |= dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 3 (name, if provided, is chosen from allowed strings)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "max" ∨ v_1 = "min" ∨ v_1 = "linear" ∨ v_1 = "valid" ∨ v_1 = "same" ∨ v_1 = "channels_last" ∨ v_1 = "channels_first"
>>
Rule 4 (boolean and complex dtypes are not allowed)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 0 ∧ dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_2) ≠ 0 ∧ dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10
>>
Rule 5 (dtype must be integer or floating type)
{v_1 : tensor} |= if dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 then true else dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 7 (broadcasting compatibility from trailing axes)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) + ndim(v_2) = 0 then true else ∀i ∈ [0, ndim(v_1) + ndim(v_2) - 1] : if i < ndim(v_1) then (if i < ndim(v_2) then (shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i) ∨ shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = 1) else shape(v_1, ndim(v_1) - 1 - i) = 1) else (if i < ndim(v_2) then shape(v_2, ndim(v_2) - 1 - i) = 1)
>>
Rule 8 (non-singleton aligned dimensions must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) + ndim(v_2) = 0 then true else ∀i ∈ [0, ndim(v_1) + ndim(v_2) - 1] : if i < ndim(v_1) ∧ i < ndim(v_2) ∧ shape(v_1, ndim(v_1) - 1 - i) > 1 ∧ shape(v_2, ndim(v_2) - 1 - i) > 1 then shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i)
>>
Rule 9 (name, if provided, is one of the allowed strings)
{v_3 : str} |= v_3 = "ii" ∨ v_3 = "ii->i" ∨ v_3 = "i,j->ij" ∨ v_3 = "bij,bjk->bik" ∨ v_3 = "...ij->...ji" ∨ v_3 = "bn,anm,bm->ba" ∨ v_3 = "none" ∨ v_3 = "sum" ∨ v_3 = "max" ∨ v_3 = "min" ∨ v_3 = "prod" ∨ v_3 = "relu" ∨ v_3 = "tanh" ∨ v_3 = "sigmoid" ∨ v_3 = "softmax" ∨ v_3 = "elu" ∨ v_3 = "selu" ∨ v_3 = "gelu" ∨ v_3 = "swish" ∨ v_3 = "softplus" ∨ v_3 = "linear" ∨ v_3 = "valid" ∨ v_3 = "same" ∨ v_3 = "causal" ∨ v_3 = "channels_last" ∨ v_3 = "channels_first"
>>
Rule 10 (each dimension size of x is non-negative)
{v_1 : tensor} |= if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 11 (each dimension size of y is non-negative)
{v_2 : tensor} |= if ndim(v_2) = 0 then true else ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) ≥ 0
>>
Rule 13 (x and y must be broadcast-compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ ndim(v_2) then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_1, ndim(v_1) - ndim(v_2) + i) = shape(v_2, i) ∨ shape(v_1, ndim(v_1) - ndim(v_2) + i) = 1 ∨ shape(v_2, i) = 1 else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, ndim(v_2) - ndim(v_1) + i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, ndim(v_2) - ndim(v_1) + i) = 1
>>
Rule 14 (for equal ranks, non-unit dimensions must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : if shape(v_1, i) ≠ 1 ∧ shape(v_2, i) ≠ 1 then shape(v_1, i) = shape(v_2, i)
>>
Rule 15 (x must have an orderable element type)
{v_1 : tensor} |= min(v_1) ≤ max(v_1)
>>
Rule 17 (all shape dimensions are non-negative for both inputs)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) ≥ 0)
