{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : if i < ndim(v_1) - ndim(v_2) then true else (shape(v_1, i) = shape(v_2, i - (ndim(v_1) - ndim(v_2))) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i - (ndim(v_1) - ndim(v_2))) = 1)) ∧ (∀j ∈ [0, ndim(v_2) - 1] : if j < ndim(v_2) - ndim(v_1) then true else (shape(v_2, j) = shape(v_1, j - (ndim(v_2) - ndim(v_1))) ∨ shape(v_2, j) = 1 ∨ shape(v_1, j - (ndim(v_2) - ndim(v_1))) = 1))
