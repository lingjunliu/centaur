>>
Rule 1 (input tensor must be numeric, i.e., not boolean)
{v_1 : tensor} |= dtype_(v_1) ≠ true ∧ dtype_(v_1) ≠ false
>>
Rule 2 (single integer axis within valid range [-rank, rank))
{v_1 : tensor, v_2 : int} |= 0 - ndim(v_1) ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 3 (list axis: every index within valid range and entries may be empty to reduce all dims)
{v_1 : tensor, v_2 : list(int)} |= (v_2.len = 0) ∨ (∀i ∈ [0, v_2.len - 1] : 0 - ndim(v_1) ≤ v_2[i] ∧ v_2[i] < ndim(v_1))
>>
Rule 4 (tuple axis: every index within valid range and entries may be empty to reduce all dims)
{v_1 : tensor, v_2 : tuple(int)} |= (v_2.len = 0) ∨ (∀i ∈ [0, v_2.len - 1] : 0 - ndim(v_1) ≤ v_2[i] ∧ v_2[i] < ndim(v_1))
>>
Rule 7 (the number of reduced axes (list) cannot exceed the tensor rank)
{v_1 : tensor, v_2 : list(int)} |= v_2.len ≤ ndim(v_1)
>>
Rule 8 (the number of reduced axes (tuple) cannot exceed the tensor rank)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len ≤ ndim(v_1)
>>
Rule 9 (unified axis validity for all signatures: int or list or tuple)
{v_1 : tensor, v_2 : int ⊎ list(int) ⊎ tuple(int)} |= (0 - ndim(v_1) ≤ v_2 ∧ v_2 < ndim(v_1)) ∨ (v_2.len = 0) ∨ (∀i ∈ [0, v_2.len - 1] : 0 - ndim(v_1) ≤ v_2[i] ∧ v_2[i] < ndim(v_1))
>>
Rule 10 (keepdims must be a boolean value)
{v_3 : bool} |= v_3 = true ∨ v_3 = false
>>
Rule 11 (name is a string parameter; no semantic restriction by API)
{v_4 : str} |= v_4 = v_4
