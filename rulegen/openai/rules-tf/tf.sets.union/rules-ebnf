Rule 2 (operands must use supported element dtypes; suppresses "has invalid dtype" TypeError)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 11) ∧ (dtype_(v_2) = 1 ∨ dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 ∨ dtype_(v_2) = 5 ∨ dtype_(v_2) = 11)
>>
Rule 3 (operands must have identical dtypes; suppresses "Types don't match" TypeError)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 4 (validate_indices is a boolean flag)
{v_3 : bool} |= v_3 = true ∨ v_3 = false
>>
Rule 5 (a and b must have the same rank ≥ 1 and match in all leading dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_1) = ndim(v_2) ∧ if ndim(v_1) ≥ 2 then ∀i ∈ [0, ndim(v_1) - 2] : shape(v_1, i) = shape(v_2, i)
>>
Rule 6 (dtype of a must be a supported set type: int8/int16/int32/int64/uint8/string)
{v_1 : tensor} |= dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 11
>>
Rule 7 (dtype of b must be a supported set type: int8/int16/int32/int64/uint8/string)
{v_2 : tensor} |= dtype_(v_2) = 1 ∨ dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 ∨ dtype_(v_2) = 5 ∨ dtype_(v_2) = 11
>>
Rule 12 (a and b dtypes must match)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = dtype_(v_2) then true else false
>>
Rule 13 (when validate_indices is true, inputs must be at least rank-1)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 then (ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1)
