Rule 1 (shape must be an integer tensor: int32 or int64)
{v_1 : tensor} |= dtype_(v_1) = 3 ∨ dtype_(v_1) = 4
>>
Rule 2 (shape must be a 1-D vector)
{v_1 : tensor} |= ndim(v_1) = 1
>>
Rule 3 (shape dimensions must be non-negative)
{v_1 : tensor} |= min(v_1) ≥ 0
>>
Rule 4 (dtype must be a floating type: float16, float32, or float64)
{v_1 : dtype} |= (v_1 = 6) ∨ (v_1 = 7) ∨ (v_1 = 8)
>>
Rule 5 (shape integer dtype and output dtype jointly valid)
{v_1 : tensor, v_2 : dtype} |= (dtype_(v_1) = 3 ∨ dtype_(v_1) = 4) ∧ ((v_2 = 6) ∨ (v_2 = 7) ∨ (v_2 = 8))
