Rule 1 (scalar size must be non-negative and memory-safe)
{v_1 : int} |= v_1 ≥ 0 ∧ v_1 ≤ 10000000
>>
Rule 2 (tuple size: all dimensions are non-negative)
{v_1 : tuple(int)} |= if v_1.len = 0 then true else ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 3 (list size: all dimensions are non-negative)
{v_1 : list(int)} |= if v_1.len = 0 then true else ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 4 (tuple size: prevent OOM by capping dimensions by rank)
{v_1 : tuple(int)} |= if v_1.len ≤ 1 then ∀i ∈ [0, v_1.len - 1] : v_1[i] ≤ 1000000 else if v_1.len ≤ 2 then ∀i ∈ [0, v_1.len - 1] : v_1[i] ≤ 4096 else (v_1.len ≤ 4 ∧ ∀i ∈ [0, v_1.len - 1] : v_1[i] ≤ 64)
>>
Rule 5 (list size: prevent OOM by capping dimensions by rank)
{v_1 : list(int)} |= if v_1.len ≤ 1 then ∀i ∈ [0, v_1.len - 1] : v_1[i] ≤ 1000000 else if v_1.len ≤ 2 then ∀i ∈ [0, v_1.len - 1] : v_1[i] ≤ 4096 else (v_1.len ≤ 4 ∧ ∀i ∈ [0, v_1.len - 1] : v_1[i] ≤ 64)
