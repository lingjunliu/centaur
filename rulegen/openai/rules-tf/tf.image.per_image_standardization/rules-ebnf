Rule 1 (image tensor must be at least three-dimensional)
{v_1 : tensor} |= ndim(v_1) ≥ 3
>>
Rule 2 (inner 3 dimensions of image must be positive)
{v_1 : tensor} |= ∀i ∈ [ndim(v_1) - 3, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 3 (image tensor must have a real numeric dtype: int/uint8/float)
{v_1 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 4 (the product of the last three dims must be positive)
{v_1 : tensor} |= shape(v_1, ndim(v_1) - 3) * shape(v_1, ndim(v_1) - 2) * shape(v_1, ndim(v_1) - 1) > 0
>>
Rule 6 (last three dimensions of image must be positive)
{v_1 : tensor} |= ndim(v_1) ≥ 3 ∧ ∀i ∈ [ndim(v_1) - 3, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 9 (image dtype must be numeric or boolean: indices 0–10)
{v_1 : tensor} |= 0 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
>>
Rule 10 (each image must have a positive number of elements: product of last three dims > 0)
{v_1 : tensor} |= (shape(v_1, ndim(v_1) - 1) * shape(v_1, ndim(v_1) - 2) * shape(v_1, ndim(v_1) - 3)) > 0
>>
Rule 11 (image tensor rank must be greater than 2)
{v_1 : tensor} |= ndim(v_1) > 2
>>
Rule 12 (each of the last three dimensions must be strictly positive)
{v_1 : tensor} |= shape(v_1, ndim(v_1) - 1) > 0 ∧ shape(v_1, ndim(v_1) - 2) > 0 ∧ shape(v_1, ndim(v_1) - 3) > 0
>>
Rule 13 (image dtype must be numeric: exclude bool, complex, str, and dtype objects)
{v_1 : tensor} |= dtype_(v_1) ≠ 0 ∧ dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_1) ≠ 11 ∧ dtype_(v_1) ≠ 12
>>
Rule 15 (the last three dimensions must be strictly positive)
{v_1 : tensor} |= if ndim(v_1) ≥ 3 then (∀i ∈ [ndim(v_1) - 3, ndim(v_1) - 1] : shape(v_1, i) > 0) else false
>>
Rule 17 (for exactly 3-D input, all axes must be positive)
{v_1 : tensor} |= if ndim(v_1) = 3 then shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0
