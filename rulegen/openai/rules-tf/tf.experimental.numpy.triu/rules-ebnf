>>
Rule 1 (input tensor must have a supported numeric/boolean dtype)
{v_1 : tensor} |= 0 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
>>
Rule 2 (if rank ≥ 2, the last two dimensions must be positive)
{v_1 : tensor} |= if ndim(v_1) ≥ 2 then shape(v_1, ndim(v_1) - 2) > 0 ∧ shape(v_1, ndim(v_1) - 1) > 0
>>
Rule 3 (for rank ≥ 2, k is within a typical band range defined by the last two dims)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) ≥ 2 then 0 - shape(v_1, ndim(v_1) - 2) ≤ v_2 ∧ v_2 ≤ shape(v_1, ndim(v_1) - 1)
>>
Rule 4 (for 1D input, k should be within the length of the vector)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then 0 - shape(v_1, 0) ≤ v_2 ∧ v_2 ≤ shape(v_1, 0)
>>
Rule 5 (all batch dimensions, if any, must be positive)
{v_1 : tensor} |= if ndim(v_1) ≥ 3 then ∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) > 0
>>
Rule 6 (either 1D input or k lies within the band range for the last two axes)
{v_1 : tensor, v_2 : int} |= (ndim(v_1) = 1) ∨ (0 - shape(v_1, ndim(v_1) - 2) ≤ v_2 ∧ v_2 ≤ shape(v_1, ndim(v_1) - 1))
>>
Rule 7 (input tensor must be at least 1-D)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 8 (input dtype must be numeric or boolean, not string or dtype object)
{v_1 : tensor} |= dtype_(v_1) ≠ 11 ∧ dtype_(v_1) ≠ 12
>>
Rule 11 (all shape dimensions are non-negative)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 14 (k bounds for 1-D input relative to its only axis)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then v_2 ≥ 0 - shape(v_1, 0) ∧ v_2 ≤ shape(v_1, 0)
>>
Rule 15 (k lower bound for 2-D or higher input relative to the row dimension)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) ≥ 2 then v_2 ≥ 0 - shape(v_1, ndim(v_1) - 2)
>>
Rule 16 (k upper bound for 2-D or higher input relative to the column dimension)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) ≥ 2 then v_2 ≤ shape(v_1, ndim(v_1) - 1)
>>
Rule 17 (input tensor must be at least 2-dimensional)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 18 (last two axes for triangular operation exist and have valid (non-negative) sizes)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ ∀i ∈ [ndim(v_1) - 2, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 19 (offset k is an integer scalar)
{v_2 : int} |= v_2 % 1 = 0
>>
Rule 20 (both parameters present; rank condition holds and k is any integer)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 2 ∧ (v_2 ≥ 0 ∨ v_2 < 0)
