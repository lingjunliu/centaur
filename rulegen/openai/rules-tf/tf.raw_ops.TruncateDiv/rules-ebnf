{v_1 : tensor, v_2 : tensor} |= (if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : if i < ndim(v_2) then (shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = 1 ∨ shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i))) ∧ (if ndim(v_2) = 0 then true else ∀j ∈ [0, ndim(v_2) - 1] : if j < ndim(v_1) then (shape(v_2, ndim(v_2) - 1 - j) = 1 ∨ shape(v_1, ndim(v_1) - 1 - j) = 1 ∨ shape(v_2, ndim(v_2) - 1 - j) = shape(v_1, ndim(v_1) - 1 - j)))
