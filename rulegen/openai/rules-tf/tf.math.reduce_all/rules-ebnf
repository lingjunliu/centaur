Rule 1 (integer axis must be a valid reduction dimension)
{v_1 : tensor, v_2 : int} |= -1 * ndim(v_1) ≤ v_2 ∧ v_2 ≤ ndim(v_1) - 1
>>
Rule 2 (tensor axis must be 0-D or 1-D and all indices within valid range)
{v_1 : tensor, v_2 : tensor} |= ndim(v_2) ≤ 1 ∧ -1 * ndim(v_1) ≤ min(v_2) ∧ max(v_2) ≤ ndim(v_1) - 1
>>
Rule 3 (tuple axis indices are within range and unique)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len ≤ ndim(v_1) ∧ (if v_2.len = 0 then true else (∀i ∈ [0, v_2.len - 1] : (-1 * ndim(v_1) ≤ v_2[i] ∧ v_2[i] ≤ ndim(v_1) - 1)) ∧ (∀i ∈ [0, v_2.len - 1] : ∀j ∈ [0, v_2.len - 1] : if i ≠ j then v_2[i] ≠ v_2[j]))
>>
Rule 4 (list axis length cannot exceed the input rank)
{v_1 : tensor, v_2 : list(int)} |= v_2.len ≤ ndim(v_1)
>>
Rule 5 (keepdims must be a boolean flag)
{v_3 : bool} |= (v_3 = true) ∨ (v_3 = false)
>>
Rule 6 (operation name, if provided, must be an allowed string)
{v_4 : str} |= (v_4 = "none") ∨ (v_4 = "sum") ∨ (v_4 = "max") ∨ (v_4 = "min")
