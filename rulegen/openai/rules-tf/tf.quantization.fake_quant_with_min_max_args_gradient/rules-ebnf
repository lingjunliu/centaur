>>
Rule 1 (gradients and inputs must be float32 tensors)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = 7 ∧ dtype_(v_2) = 7
>>
Rule 2 (gradients and inputs must have identical rank and shape)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (num_bits must be within the 32-bit signed integer range)
{v_3 : int} |= -2147483648 ≤ v_3 ∧ v_3 ≤ 2147483647
>>
Rule 4 (min must be strictly smaller than max)
{v_4 : float, v_5 : float} |= v_4 < v_5
>>
Rule 5 (typical quantization bitwidth for FakeQuant)
{v_3 : int} |= 2 ≤ v_3 ∧ v_3 ≤ 16
>>
Rule 6 (narrow_range implies a range that crosses zero)
{v_4 : float, v_5 : float, v_6 : bool} |= if v_6 then v_4 < 0 ∧ 0 < v_5
>>
Rule 7 (allowed simple operation names for the op)
{v_7 : str} |= v_7 = "none" ∨ v_7 = "linear" ∨ v_7 = "valid" ∨ v_7 = "same"
