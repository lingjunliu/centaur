Rule 1 (input tensor x must not be boolean)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 2 (integer axis must be within valid range; booleans and name are well-formed)
{v_1 : tensor, v_2 : int, v_3 : bool, v_4 : bool, v_5 : str} |= (0 - ndim(v_1)) ≤ v_2 ∧ v_2 < ndim(v_1) ∧ (v_3 = true ∨ v_3 = false) ∧ (v_4 = true ∨ v_4 = false) ∧ v_5 = v_5
>>
Rule 3 (tensor axis must be scalar int32/int64 and within valid range)
{v_1 : tensor, v_2 : tensor} |= ndim(v_2) = 0 ∧ (dtype_(v_2) = 3 ∨ dtype_(v_2) = 4) ∧ min(v_2) ≥ (0 - ndim(v_1)) ∧ max(v_2) < ndim(v_1)
>>
Rule 4 (x must have at least one dimension to allow a valid axis)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 5 (x must have a supported numeric or complex dtype)
{v_1 : tensor} |= dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 7 (axis as tensor must be a scalar of int32 or int64)
{v_2 : tensor} |= ndim(v_2) = 0 ∧ (dtype_(v_2) = 3 ∨ dtype_(v_2) = 4)
>>
Rule 8 (exclusive and reverse must be booleans)
{v_3 : bool, v_4 : bool} |= (v_3 = true ∨ v_3 = false) ∧ (v_4 = true ∨ v_4 = false)
>>
Rule 9 (name is a string parameter)
{v_5 : str} |= v_5 = v_5
