>>
Rule 1 (integer shape must be non-negative)
{v_1 : int, v_2 : dtype} |= v_1 ≥ 0 ∧ v_2 = v_2
>>
Rule 2 (tuple shape dimensions must be non-negative)
{v_1 : tuple(int), v_2 : dtype} |= (if v_1.len = 0 then true else ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0) ∧ v_2 = v_2
>>
Rule 3 (list shape with a valid dtype object; dtype must not be a string token)
{v_1 : list(int), v_2 : dtype} |= v_1 = v_1 ∧ v_2 ≠ "sum" ∧ v_2 ≠ "max" ∧ v_2 ≠ "min" ∧ v_2 ≠ "prod"
