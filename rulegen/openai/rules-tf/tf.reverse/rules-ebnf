Rule 1 (input tensor rank must be within supported range [0, 8])
{v_1 : tensor} |= 0 ≤ ndim(v_1) ∧ ndim(v_1) ≤ 8
>>
Rule 3 (axis tensor values must be within valid range per input rank)
{v_1 : tensor, v_2 : tensor} |= ndim(v_2) = 1 ∧ (if shape(v_2, 0) = 0 then true else (-1 * ndim(v_1) ≤ min(v_2) ∧ max(v_2) ≤ ndim(v_1) - 1))
>>
Rule 4 (axis list values must be within [-rank, rank-1])
{v_1 : tensor, v_2 : list(int)} |= ∀i ∈ [0, v_2.len - 1] : -1 * ndim(v_1) ≤ v_2[i] ∧ v_2[i] ≤ ndim(v_1) - 1
>>
Rule 5 (axis list must not contain duplicate indices)
{v_2 : list(int)} |= ∀i ∈ [0, v_2.len - 1] : ∀j ∈ [i + 1, v_2.len - 1] : v_2[i] ≠ v_2[j]
>>
Rule 6 (axis tuple values must be within [-rank, rank-1])
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : -1 * ndim(v_1) ≤ v_2[i] ∧ v_2[i] ≤ ndim(v_1) - 1
>>
Rule 7 (axis tuple must not contain duplicate indices)
{v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : ∀j ∈ [i + 1, v_2.len - 1] : v_2[i] ≠ v_2[j]
>>
Rule 8 (for scalar input, list/tuple axis must be empty)
{v_1 : tensor, v_2 : list(int) ⊎ tuple(int)} |= if ndim(v_1) = 0 then v_2.len = 0
>>
Rule 9 (for scalar input, tensor axis must be empty)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then shape(v_2, 0) = 0
>>
Rule 10 (name is an unconstrained optional string)
{v_3 : str} |= v_3 = v_3
>>
Rule 17 (scalar tensor: tensor-form axis must be empty and 1-D)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_2) = 1) ∧ (if ndim(v_1) = 0 then shape(v_2, 0) = 0)
