Rule 3 (broadcasting compatibility for element-wise division)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_2) - 1] : if i < ndim(v_1) then (shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i) ∨ shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = 1)
>>
Rule 4 (inputs must not be empty tensors)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0)
>>
Rule 5 (if ranks are equal, shapes must match exactly)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀k ∈ [0, ndim(v_1) - 1] : shape(v_1, k) = shape(v_2, k)
>>
Rule 6 (name, if provided, should be a simple valid identifier from the allowed set)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "linear" ∨ v_1 = "valid"
>>
Rule 7 (for uint8 denominators, disallow zero to avoid invalid division)
{v_1 : tensor} |= if dtype_(v_1) = 5 then min(v_1) ≥ 1
>>
Rule 8 (x and y must share an allowed numeric dtype and be equal)
{v_1 : tensor, v_2 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10 ∧ dtype_(v_2) = dtype_(v_1)
>>
Rule 9 (trailing-axis broadcast compatibility is required when both are non-scalars)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 0) ∨ (ndim(v_2) = 0) ∨ (ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ (shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) ∨ shape(v_1, ndim(v_1) - 1) = 1 ∨ shape(v_2, ndim(v_2) - 1) = 1))
>>
Rule 10 (when ranks match, all axes must be broadcast-compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
