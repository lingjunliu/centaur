>>
Rule 1 (dtype argument must be a TensorFlow DType; suppresses TypeError about non-TF dtype)
{v_2 : dtype} |= v_2 = v_2
>>
Rule 2 (value must be a Tensor with a well-defined rank)
{v_1 : tensor} |= 0 ≤ ndim(v_1)
>>
Rule 3 (tensor has consistent extrema)
{v_1 : tensor} |= min(v_1) ≤ max(v_1)
>>
Rule 4 (name, when provided, should be a valid string token)
{v_3 : str} |= v_3 = "none" ∨ v_3 = "linear" ∨ v_3 = "sum" ∨ v_3 = "max" ∨ v_3 = "min"
>>
Rule 5 (neutral name convention when no actual cast occurs)
{v_1 : tensor, v_2 : dtype, v_3 : str} |= if dtype_(v_1) = v_2 then v_3 = "none" else v_3 = v_3
