>>
Rule 1 (inputs must be boolean tensors)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = 0 ∧ dtype_(v_2) = 0
>>
Rule 4 (both inputs must have identical dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 5 (broadcast compatibility across trailing axes)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 ∨ ndim(v_2) = 0 then true else if ndim(v_1) ≥ ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : i < (ndim(v_1) - ndim(v_2)) ∨ shape(v_1, i) = shape(v_2, i - (ndim(v_1) - ndim(v_2))) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i - (ndim(v_1) - ndim(v_2))) = 1 else ∀i ∈ [0, ndim(v_2) - 1] : i < (ndim(v_2) - ndim(v_1)) ∨ shape(v_2, i) = shape(v_1, i - (ndim(v_2) - ndim(v_1))) ∨ shape(v_2, i) = 1 ∨ shape(v_1, i - (ndim(v_2) - ndim(v_1))) = 1
>>
Rule 6 (last dimensions must be broadcast-compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) ∨ shape(v_1, ndim(v_1) - 1) = 1 ∨ shape(v_2, ndim(v_2) - 1) = 1
>>
Rule 7 (exact shape match when ranks are equal)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) ∧ ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 9 (broadcastable shapes to avoid Incompatible shapes error)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)) ∨ (ndim(v_1) = 0 ∨ ndim(v_2) = 0)
