>>
Rule 1 (image must be 3-D or 4-D)
{v_1 : tensor} |= ndim(v_1) = 3 ∨ ndim(v_1) = 4
>>
Rule 2 (offset_height must be non-negative)
{v_2 : int} |= v_2 ≥ 0
>>
Rule 3 (offset_width must be non-negative)
{v_3 : int} |= v_3 ≥ 0
>>
Rule 4 (target dimensions must be non-negative)
{v_4 : int, v_5 : int} |= v_4 ≥ 0 ∧ v_5 ≥ 0
>>
Rule 5 (input height must fit within target_height minus offset_height)
{v_1 : tensor, v_2 : int, v_4 : int} |= (if ndim(v_1) = 3 then shape(v_1, 0) ≤ v_4 - v_2) ∧ (if ndim(v_1) = 4 then shape(v_1, 1) ≤ v_4 - v_2)
>>
Rule 6 (input width must fit within target_width minus offset_width)
{v_1 : tensor, v_3 : int, v_5 : int} |= (if ndim(v_1) = 3 then shape(v_1, 1) ≤ v_5 - v_3) ∧ (if ndim(v_1) = 4 then shape(v_1, 2) ≤ v_5 - v_3)
>>
Rule 7 (inner three dimensions [H, W, C] must be strictly positive)
{v_1 : tensor} |= (if ndim(v_1) = 3 then shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0) ∧ (if ndim(v_1) = 4 then shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0 ∧ shape(v_1, 3) > 0)
>>
Rule 8 (suppress overflow by bounding total element count of padded output)
{v_1 : tensor, v_4 : int, v_5 : int} |= (if ndim(v_1) = 3 then v_4 * v_5 * shape(v_1, 2) ≤ 9223372036854775807) ∧ (if ndim(v_1) = 4 then shape(v_1, 0) * v_4 * v_5 * shape(v_1, 3) ≤ 9223372036854775807)
>>
Rule 9 (targets must be at least as large as offsets)
{v_2 : int, v_3 : int, v_4 : int, v_5 : int} |= v_4 ≥ v_2 ∧ v_5 ≥ v_3
>>
Rule 10 (image dtype must not be string)
{v_1 : tensor} |= dtype_(v_1) ≠ 11
