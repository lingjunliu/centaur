>>
Rule 1 (x1 must be float32 or float64)
{v_1 : tensor} |= 7 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 2 (x2 must have the same dtype as x1)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (shapes of x1 and x2 must be compatible to avoid "Incompatible shapes" error)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 0) ∨ (ndim(v_2) = 0) ∨ (ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 4 (name is a string parameter; any string is acceptable)
{v_3 : str} |= v_3 = v_3
