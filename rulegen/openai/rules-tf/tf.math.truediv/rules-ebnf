Rule 1 (x and y must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (x and y dtypes must be numeric; bool not allowed)
{v_1 : tensor, v_2 : tensor} |= (1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10) ∧ (1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 10)
>>
Rule 3 (broadcastable shapes for elementwise division)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then true else ∀k ∈ [0, ndim(v_1) - 1] : if k ≤ ndim(v_2) - 1 then (shape(v_1, ndim(v_1) - 1 - k) = shape(v_2, ndim(v_2) - 1 - k) ∨ shape(v_1, ndim(v_1) - 1 - k) = 1 ∨ shape(v_2, ndim(v_2) - 1 - k) = 1)
>>
Rule 4 (name is a string parameter)
{v_3 : str} |= v_3 = v_3
