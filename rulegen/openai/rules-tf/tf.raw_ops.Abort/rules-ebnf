>>
Rule 1 (if exit_without_error is true, error_msg must be "none"; otherwise it must not be "none")
{v_1 : str, v_2 : bool} |= if v_2 then v_1 = "none" else v_1 ≠ "none"
>>
Rule 2 (operation name should not be an ambiguous or reserved string)
{v_3 : str} |= v_3 ≠ "none" ∧ v_3 ≠ "sum" ∧ v_3 ≠ "max"
>>
Rule 3 (error message should be different from the operation name)
{v_1 : str, v_3 : str} |= v_1 ≠ v_3
>>
Rule 4 (fatal aborts must be explicitly named)
{v_2 : bool, v_3 : str} |= if v_2 = false then v_3 ≠ "none"
>>
Rule 5 (normal exits should use a conventional non-fatal name)
{v_2 : bool, v_3 : str} |= if v_2 then (v_3 = "valid" ∨ v_3 = "same")
>>
Rule 6 (error_msg must be one of the supported string tokens)
{v_1 : str} |= v_1 = "ii" ∨ v_1 = "ii->i" ∨ v_1 = "i,j->ij" ∨ v_1 = "bij,bjk->bik" ∨ v_1 = "...ij->...ji" ∨ v_1 = "bn,anm,bm->ba" ∨ v_1 = "none" ∨ v_1 = "sum" ∨ v_1 = "max" ∨ v_1 = "min" ∨ v_1 = "prod" ∨ v_1 = "relu" ∨ v_1 = "tanh" ∨ v_1 = "sigmoid" ∨ v_1 = "softmax" ∨ v_1 = "elu" ∨ v_1 = "selu" ∨ v_1 = "gelu" ∨ v_1 = "swish" ∨ v_1 = "softplus" ∨ v_1 = "linear" ∨ v_1 = "valid" ∨ v_1 = "same" ∨ v_1 = "causal" ∨ v_1 = "channels_last" ∨ v_1 = "channels_first"
>>
Rule 8 (normal exit implies no error message)
{v_1 : str, v_2 : bool} |= if v_2 then v_1 = "none"
>>
Rule 9 (abort with error requires a non-"none" message)
{v_1 : str, v_2 : bool} |= if v_2 then true else v_1 ≠ "none"
>>
Rule 10 (error message should not be identical to the op name)
{v_1 : str, v_2 : str} |= v_1 ≠ v_2
