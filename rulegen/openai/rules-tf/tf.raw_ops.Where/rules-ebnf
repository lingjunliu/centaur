>>
Rule 1 (operation name should be a simple identifier or explicitly "none")
{v_1 : str} |= v_1 = "none" ∨ v_1 = "sum" ∨ v_1 = "max" ∨ v_1 = "min" ∨ v_1 = "prod" ∨ v_1 = "linear"
>>
Rule 2 (operation name should not be an einsum-style pattern)
{v_1 : str} |= v_1 ≠ "ii" ∧ v_1 ≠ "ii->i" ∧ v_1 ≠ "i,j->ij" ∧ v_1 ≠ "bij,bjk->bik" ∧ v_1 ≠ "...ij->...ji" ∧ v_1 ≠ "bn,anm,bm->ba"
>>
Rule 3 (condition tensor has a defined, non-negative rank)
{v_1 : tensor} |= 0 ≤ ndim(v_1)
>>
Rule 4 (all condition tensor dimensions are non-negative if rank > 0)
{v_1 : tensor} |= if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : 0 ≤ shape(v_1, i)
>>
Rule 5 (name provided or not, condition tensor rank must still be well-defined)
{v_1 : str, v_2 : tensor} |= if v_1 = "none" then true else 0 ≤ ndim(v_2)
>>
Rule 6 (condition dtype must be supported by Where)
{v_1 : tensor} |= dtype_(v_1) = 0 ∨ dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 7 (name, if provided, must be one of the allowed strings)
{v_1 : str} |= v_1 = "ii" ∨ v_1 = "ii->i" ∨ v_1 = "i,j->ij" ∨ v_1 = "bij,bjk->bik" ∨ v_1 = "...ij->...ji" ∨ v_1 = "bn,anm,bm->ba" ∨ v_1 = "none" ∨ v_1 = "sum" ∨ v_1 = "max" ∨ v_1 = "min" ∨ v_1 = "prod" ∨ v_1 = "relu" ∨ v_1 = "tanh" ∨ v_1 = "sigmoid" ∨ v_1 = "softmax" ∨ v_1 = "elu" ∨ v_1 = "selu" ∨ v_1 = "gelu" ∨ v_1 = "swish" ∨ v_1 = "softplus" ∨ v_1 = "linear" ∨ v_1 = "valid" ∨ v_1 = "same" ∨ v_1 = "causal" ∨ v_1 = "channels_last" ∨ v_1 = "channels_first"
>>
Rule 8 (condition tensor dimensions must be non-negative)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 9 (boolean condition tensors have values within {0, 1})
{v_1 : tensor} |= if dtype_(v_1) = 0 then (min(v_1) ≥ 0 ∧ max(v_1) ≤ 1)
>>
Rule 10 (each dimension size fits within int64 indexing)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≤ 9223372036854775807
