Rule 1 (input tensor dtype must be one of the supported numeric/complex types)
{v_1 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
>>
Rule 2 (input tensor dtype explicitly enumerated to allowed set)
{v_1 : tensor} |= dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 3 (name, if provided, must be one of the allowed strings)
{v_1 : str} |= v_1 = "ii" ∨ v_1 = "ii->i" ∨ v_1 = "i,j->ij" ∨ v_1 = "bij,bjk->bik" ∨ v_1 = "...ij->...ji" ∨ v_1 = "bn,anm,bm->ba" ∨ v_1 = "none" ∨ v_1 = "sum" ∨ v_1 = "max" ∨ v_1 = "min" ∨ v_1 = "prod" ∨ v_1 = "relu" ∨ v_1 = "tanh" ∨ v_1 = "sigmoid" ∨ v_1 = "softmax" ∨ v_1 = "elu" ∨ v_1 = "selu" ∨ v_1 = "gelu" ∨ v_1 = "swish" ∨ v_1 = "softplus" ∨ v_1 = "linear" ∨ v_1 = "valid" ∨ v_1 = "same" ∨ v_1 = "causal" ∨ v_1 = "channels_last" ∨ v_1 = "channels_first"
>>
Rule 4 (tensor has valid non-negative dimensions)
{v_1 : tensor} |= if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 6 (tensor rank is non-negative)
{v_1 : tensor} |= 0 ≤ ndim(v_1)
>>
Rule 7 (all dimension sizes are non-negative)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 9 (real-valued inputs have an ordered range)
{v_1 : tensor} |= if (dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) then min(v_1) ≤ max(v_1)
>>
Rule 10 (tensor dtype cannot be bool, string, or dtype object)
{v_1 : tensor} |= dtype_(v_1) ≠ 0 ∧ dtype_(v_1) ≠ 11 ∧ dtype_(v_1) ≠ 12
>>
Rule 12 (scalar input has a well-defined min/max)
{v_1 : tensor} |= if ndim(v_1) = 0 then min(v_1) = max(v_1)
>>
Rule 13 (non-scalar tensors have non-negative dimension sizes)
{v_1 : tensor} |= if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 14 (name is unconstrained optional string)
{v_1 : str} |= v_1 = v_1
>>
Rule 15 (for floating-point inputs, values are orderable)
{v_1 : tensor} |= if (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) then min(v_1) ≤ max(v_1)
>>
Rule 17 (if name is "linear", require all dimensions to be strictly positive)
{v_1 : tensor, v_2 : str} |= if v_2 = "linear" then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 18 (name should not be the literal "none")
{v_2 : str} |= v_2 ≠ "none"
>>
Rule 19 (if channels_last is specified and rank > 0, the last dimension must exist)
{v_1 : tensor, v_2 : str} |= if (v_2 = "channels_last" ∧ ndim(v_1) > 0) then shape(v_1, ndim(v_1) - 1) ≥ 0
>>
Rule 20 (if channels_first is specified and rank > 0, the first dimension must exist)
{v_1 : tensor, v_2 : str} |= if (v_2 = "channels_first" ∧ ndim(v_1) > 0) then shape(v_1, 0) ≥ 0
>>
Rule 21 (tensor is either a scalar or its leading dimension is defined)
{v_1 : tensor} |= (ndim(v_1) = 0) ∨ (shape(v_1, 0) ≥ 0)
