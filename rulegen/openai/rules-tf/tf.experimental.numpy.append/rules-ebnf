Rule 1 (input and values tensors must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (axis must be within valid range for arr, supporting negative indexing)
{v_1 : tensor, v_3 : int} |= (0 - ndim(v_1)) ≤ v_3 ∧ v_3 ≤ ndim(v_1) - 1
>>
Rule 4 (non-axis dimensions must match when axis is provided; negative axis is normalized)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= ∀i ∈ [0, ndim(v_1) - 1] : if i = (if v_3 < 0 then v_3 + ndim(v_1) else v_3) then true else shape(v_1, i) = shape(v_2, i)
>>
Rule 6 (axis must also be within the valid range for values)
{v_2 : tensor, v_3 : int} |= (0 - ndim(v_2)) ≤ v_3 ∧ v_3 ≤ ndim(v_2) - 1
>>
Rule 7 (dtype meta-type is not allowed for tensor elements)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 12 ∧ dtype_(v_2) ≠ 12
>>
Rule 10 (with axis, all non-axis dimensions must match; negative axis supported)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= ∀i ∈ [0, ndim(v_1) - 1] : if (if v_3 ≥ 0 then i = v_3 else i = v_3 + ndim(v_1)) then true else shape(v_1, i) = shape(v_2, i)
>>
Rule 12 (tensor dtypes must be concrete tensor dtypes, not np.dtype objects)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≤ 11 ∧ dtype_(v_2) ≤ 11
>>
Rule 13 (either both tensors are string dtype or both are non-string)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 11 ∧ dtype_(v_2) = 11) ∨ (dtype_(v_1) ≤ 10 ∧ dtype_(v_2) ≤ 10)
>>
Rule 14 (axis must be within valid range; negative axes allowed)
{v_1 : tensor, v_3 : int} |= ndim(v_1) ≥ 1 ∧ 0 ≤ v_3 + ndim(v_1) ∧ v_3 + ndim(v_1) ≤ 2 * ndim(v_1) - 1
>>
Rule 15 (with axis, arr and values must have the same rank)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= 0 ≤ v_3 + ndim(v_1) ∧ v_3 + ndim(v_1) ≤ 2 * ndim(v_1) - 1 ∧ ndim(v_1) = ndim(v_2)
>>
Rule 17 (normalized axis index is within [0, ndim(arr) - 1])
{v_1 : tensor, v_3 : int} |= (if v_3 ≥ 0 then v_3 else v_3 + ndim(v_1)) ≥ 0 ∧ (if v_3 ≥ 0 then v_3 else v_3 + ndim(v_1)) ≤ ndim(v_1) - 1
>>
Rule 18 (with axis, both inputs must be at least 1-D)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1 ∧ 0 ≤ v_3 + ndim(v_1)
>>
Rule 21 (if either input is complex, the other cannot be string)
{v_1 : tensor, v_2 : tensor} |= (if 9 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10 then dtype_(v_2) ≤ 10) ∧ (if 9 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 10 then dtype_(v_1) ≤ 10)
>>
Rule 24 (shape compatibility on all non-axis dimensions, handling negative axis)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= ∀i ∈ [0, ndim(v_1) - 1] : if v_3 ≥ 0 then if i = v_3 then true else shape(v_1, i) = shape(v_2, i) else if i = v_3 + ndim(v_1) then true else shape(v_1, i) = shape(v_2, i)
>>
Rule 27 (when axis is omitted, shapes must be non-negative for both tensors)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) ≥ 0)
