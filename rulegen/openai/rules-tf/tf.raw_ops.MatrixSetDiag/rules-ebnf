Rule 1 (input and diagonal must have identical dtype)
{v_2 : tensor, v_3 : tensor} |= dtype_(v_2) = dtype_(v_3)
>>
Rule 2 (input must have rank at least 2)
{v_2 : tensor} |= ndim(v_2) ≥ 2
>>
Rule 3 (diagonal must have rank at least 1)
{v_3 : tensor} |= ndim(v_3) ≥ 1
>>
Rule 4 (input rank is diagonal rank plus one)
{v_2 : tensor, v_3 : tensor} |= ndim(v_2) = ndim(v_3) + 1
>>
Rule 5 (batch dimensions of input and diagonal must match)
{v_2 : tensor, v_3 : tensor} |= if ndim(v_3) ≥ 2 then ∀ i ∈ [0, ndim(v_3) - 2] : shape(v_3, i) = shape(v_2, i)
>>
Rule 6 (diagonal length equals the minimum of the last two input dimensions)
{v_2 : tensor, v_3 : tensor} |= if shape(v_2, -2) ≤ shape(v_2, -1) then shape(v_3, ndim(v_3) - 1) = shape(v_2, -2) else shape(v_3, ndim(v_3) - 1) = shape(v_2, -1)
>>
Rule 7 (for square innermost matrices, diagonal length equals that size)
{v_2 : tensor, v_3 : tensor} |= if shape(v_2, -2) = shape(v_2, -1) then shape(v_3, -1) = shape(v_2, -1)
>>
