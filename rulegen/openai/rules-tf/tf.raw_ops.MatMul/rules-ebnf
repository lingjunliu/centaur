Rule 1 (inputs must be 2-dimensional matrices)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 2 ∧ ndim(v_2) = 2
>>
Rule 2 (inputs must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (inner/outer dimension compatibility under transposition flags)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if v_3 then if v_4 then shape(v_1, 0) = shape(v_2, 1) else shape(v_1, 0) = shape(v_2, 0) else if v_4 then shape(v_1, 1) = shape(v_2, 1) else shape(v_1, 1) = shape(v_2, 0)
>>
Rule 4 (matrix dimensions must be positive)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 2 ∧ ndim(v_2) = 2 ∧ ∀i ∈ [0, 1] : shape(v_1, i) > 0 ∧ shape(v_2, i) > 0
>>
Rule 7 (inner-outer dimension alignment with transpose flags)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= shape(v_1, if v_3 then 0 else 1) = shape(v_2, if v_4 then 1 else 0)
>>
Rule 8 (non-negative dimensions for both matrices)
{v_1 : tensor, v_2 : tensor} |= ∀ i ∈ [0, 1] : shape(v_1, i) ≥ 0 ∧ shape(v_2, i) ≥ 0
>>
Rule 9 (alignment when neither input is transposed)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if v_3 = false ∧ v_4 = false then shape(v_1, 1) = shape(v_2, 0)
>>
Rule 10 (alignment when both inputs are transposed)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if v_3 = true ∧ v_4 = true then shape(v_1, 0) = shape(v_2, 1)
>>
Rule 11 (grad flags must be boolean values)
{v_5 : bool, v_6 : bool} |= (v_5 = true ∨ v_5 = false) ∧ (v_6 = true ∨ v_6 = false)
>>
Rule 12 (restrict name to allowed string set)
{v_7 : str} |= v_7 = "none" ∨ v_7 = "linear" ∨ v_7 = "relu" ∨ v_7 = "tanh" ∨ v_7 = "sigmoid"
>>
Rule 13 (allowed dtype for input a)
{v_1 : tensor} |= dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 14 (only a is transposed: inner-outer dimension alignment)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if v_3 = true ∧ v_4 = false then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 15 (only b is transposed: inner-outer dimension alignment)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if v_3 = false ∧ v_4 = true then shape(v_1, 1) = shape(v_2, 1)
>>
Rule 16 (requesting gradients requires floating-point or complex dtype)
{v_1 : tensor, v_2 : bool, v_3 : bool} |= if v_2 = true ∨ v_3 = true then (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10)
>>
Rule 17 (integer/uint dtypes forbid gradient computation flags)
{v_1 : tensor, v_2 : bool, v_3 : bool} |= if (dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5) then (v_2 = false ∧ v_3 = false)
>>
Rule 18 (name must be chosen from the allowed string set)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "linear" ∨ v_1 = "sum" ∨ v_1 = "max" ∨ v_1 = "min" ∨ v_1 = "prod" ∨ v_1 = "relu" ∨ v_1 = "tanh" ∨ v_1 = "sigmoid" ∨ v_1 = "softmax" ∨ v_1 = "elu" ∨ v_1 = "selu" ∨ v_1 = "gelu" ∨ v_1 = "swish" ∨ v_1 = "softplus" ∨ v_1 = "valid" ∨ v_1 = "same" ∨ v_1 = "causal" ∨ v_1 = "channels_last" ∨ v_1 = "channels_first"
>>
Rule 19 (both inputs must have individually allowed dtypes)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) ∧ (dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 ∨ dtype_(v_2) = 5 ∨ dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)
>>
