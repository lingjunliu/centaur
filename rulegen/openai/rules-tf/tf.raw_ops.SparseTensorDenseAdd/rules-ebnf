{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 1 ∧ (dtype_(v_1) = 3 ∨ dtype_(v_1) = 4) ∧ dtype_(v_1) = dtype_(v_2) ∧ ndim(v_2) = 2 ∧ shape(v_2, 1) = shape(v_1, 0)
