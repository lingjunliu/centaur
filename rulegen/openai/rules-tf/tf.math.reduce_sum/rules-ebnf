{v_1 : tensor, v_2 : tensor} |= (dtype_(v_2) = 3 ∨ dtype_(v_2) = 4) ∧ ndim(v_2) ≤ 1 ∧ if ndim(v_2) = 1 then shape(v_2, 0) ≤ ndim(v_1)
