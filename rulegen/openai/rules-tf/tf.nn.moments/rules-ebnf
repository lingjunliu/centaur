>>
Rule 1 (x must be numeric or complex; bool/string tensors are not allowed by Mean)
{v_1 : tensor} |= dtype_(v_1) ≠ 0 ∧ dtype_(v_1) ≠ 11
>>
Rule 2 (integer axis must be within valid reduction range)
{v_1 : tensor, v_2 : int} |= (0 - ndim(v_1)) ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 3 (tuple axes are non-empty, within range, and pairwise distinct)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len > 0 ∧ ∀i ∈ [0, v_2.len - 1] : ((0 - ndim(v_1)) ≤ v_2[i] ∧ v_2[i] < ndim(v_1) ∧ ∀j ∈ [i + 1, v_2.len - 1] : v_2[i] ≠ v_2[j])
>>
Rule 4 (input must be at least 1-D)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 5 (shift tensor, if provided, should have the same dtype as x)
{v_1 : tensor, v_3 : tensor} |= dtype_(v_1) = dtype_(v_3)
>>
Rule 6 (keepdims must be a boolean literal)
{v_4 : bool} |= v_4 = true ∨ v_4 = false
