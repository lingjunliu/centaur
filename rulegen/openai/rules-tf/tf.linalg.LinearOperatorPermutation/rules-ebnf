Rule 1 (perm tensor must be a (batch) vector with positive last dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1 ∧ shape(v_1, ndim(v_1) - 1) > 0
>>
Rule 2 (is_square must be true for a permutation matrix)
{v_1 : bool} |= v_1 = true
>>
Rule 4 (list/tuple perm indices are in range)
{v_1 : list(int) ⊎ tuple(int)} |= v_1.len > 0 ∧ ∀i ∈ [0, v_1.len - 1] : 0 ≤ v_1[i] ∧ v_1[i] < v_1.len
>>
Rule 5 (list/tuple perm values are unique)
{v_1 : list(int) ⊎ tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : ∀j ∈ [0, i - 1] : v_1[i] ≠ v_1[j]
>>
Rule 6 (self_adjoint hint requires an involutive permutation)
{v_1 : list(int) ⊎ tuple(int), v_2 : bool} |= if v_2 = true then ∀i ∈ [0, v_1.len - 1] : 0 ≤ v_1[i] ∧ v_1[i] < v_1.len ∧ v_1[v_1[i]] = i
>>
Rule 7 (non-involution forces self_adjoint hint to be false)
{v_1 : list(int) ⊎ tuple(int), v_2 : bool} |= if ∃i ∈ [0, v_1.len - 1] : 0 ≤ v_1[i] ∧ v_1[i] < v_1.len ∧ v_1[v_1[i]] ≠ i then v_2 = false
>>
Rule 8 (positive_definite hint only allowed for identity permutation)
{v_1 : list(int) ⊎ tuple(int), v_2 : bool} |= if v_2 = true then ∀i ∈ [0, v_1.len - 1] : v_1[i] = i
>>
Rule 9 (non-identity forces positive_definite hint to be false)
{v_1 : list(int) ⊎ tuple(int), v_2 : bool} |= if ∃i ∈ [0, v_1.len - 1] : v_1[i] ≠ i then v_2 = false
>>
Rule 10 (name is a string parameter)
{v_1 : str} |= v_1 = v_1
>>
Rule 11 (dtype parameter is well-typed)
{v_1 : dtype} |= v_1 = v_1
>>
Rule 12 (positive_definite hint implies self_adjoint hint)
{v_1 : bool, v_2 : bool} |= if v_1 = true then v_2 = true
