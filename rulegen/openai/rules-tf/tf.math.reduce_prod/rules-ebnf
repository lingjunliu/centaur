>>
Rule 1 (input_tensor must have a numeric, non-bool dtype)
{v_1 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
>>
Rule 2 (integer axis is within valid range; special-case for scalars)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 0 then (v_2 = 0 ∨ v_2 = -1) else ((0 - ndim(v_1)) ≤ v_2 ∧ v_2 < ndim(v_1))
>>
Rule 3 (list of axes: each axis is valid and axes are distinct)
{v_1 : tensor, v_2 : list(int)} |= ∀i ∈ [0, v_2.len - 1] : (0 - ndim(v_1) ≤ v_2[i] ∧ v_2[i] < ndim(v_1)) ∧ ∀j ∈ [i + 1, v_2.len - 1] : v_2[i] ≠ v_2[j]
>>
Rule 4 (list or tuple of axes: bounds valid; when keepdims is false, length ≤ rank)
{v_1 : tensor, v_2 : list(int) ⊎ tuple(int), v_3 : bool} |= (∀i ∈ [0, v_2.len - 1] : (0 - ndim(v_1) ≤ v_2[i] ∧ v_2[i] < ndim(v_1))) ∧ (if v_3 then true else v_2.len ≤ ndim(v_1))
>>
Rule 5 (tensor axis: dtype must be int32 or int64; scalar or 1-D; all values in range)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_2) = 3 ∨ dtype_(v_2) = 4) ∧ ( (ndim(v_2) = 0 ∧ (0 - ndim(v_1) ≤ min(v_2) ∧ max(v_2) < ndim(v_1))) ∨ (ndim(v_2) = 1 ∧ (if shape(v_2, 0) = 0 then true else (0 - ndim(v_1) ≤ min(v_2) ∧ max(v_2) < ndim(v_1)))) )
>>
Rule 6 (name is an arbitrary string parameter)
{v_4 : str} |= v_4 = v_4
