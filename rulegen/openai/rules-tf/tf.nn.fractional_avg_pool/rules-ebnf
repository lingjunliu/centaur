>>
Rule 1 (input must be a 4-D tensor [batch, height, width, channels])
{v_1 : tensor} |= ndim(v_1) = 4
>>
Rule 2 (pooling_ratio must have length at least 4)
{v_2 : list(float)} |= v_2.len ≥ 4
>>
Rule 3 (pooling_ratio length matches the input tensor rank)
{v_1 : tensor, v_2 : list(float)} |= v_2.len = ndim(v_1)
>>
Rule 4 (no pooling on batch and channel dimensions: first and last ratios are exactly 1.0)
{v_2 : list(float)} |= v_2[0] = 1.0 ∧ v_2[v_2.len - 1] = 1.0
>>
Rule 5 (all pooling ratios must be at least 1.0)
{v_2 : list(float)} |= ∀ i ∈ [0, v_2.len - 1] : v_2[i] ≥ 1.0
>>
Rule 6 (supported dtypes for value are int32, int64, float32, or float64)
{v_1 : tensor} |= dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 7 (all input tensor dimensions must be positive)
{v_1 : tensor} |= ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
