Rule 1 (input tensor must have boolean dtype)
{v_1 : tensor} |= dtype_(v_1) = 0
>>
Rule 2 (all dimensions are non-negative when rank > 0)
{v_1 : tensor} |= if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 3 (boolean tensor values are bounded between 0 and 1)
{v_1 : tensor} |= if dtype_(v_1) = 0 then (0 ≤ min(v_1) ∧ max(v_1) ≤ 1)
>>
Rule 4 (unsupported dtypes: string and complex are invalid)
{v_1 : tensor} |= dtype_(v_1) ≠ 11 ∧ dtype_(v_1) ≠ 12 ∧ dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 6 (non-boolean input dtypes are invalid)
{v_1 : tensor} |= if 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 11 then false
>>
Rule 8 (boolean tensor values lie within [0, 1] and are ordered)
{v_1 : tensor} |= if dtype_(v_1) = 0 then (0 ≤ min(v_1) ∧ min(v_1) ≤ max(v_1) ∧ max(v_1) ≤ 1)
>>
Rule 9 (idempotent product property for boolean tensors)
{v_1 : tensor} |= if dtype_(v_1) = 0 then min(v_1) * max(v_1) = min(v_1)
