>>
Rule 1 (input must be at least a matrix)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (input and diagonal must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 4 (scalar k at main diagonal: diagonal length bounded by M and N)
{v_1 : tensor, v_2 : tensor, v_3 : int} |= ndim(v_1) ≥ 2 ∧ ndim(v_2) = ndim(v_1) - 1 ∧ (if v_3 = 0 then shape(v_2, ndim(v_2) - 1) ≤ shape(v_1, ndim(v_1) - 2) ∧ shape(v_2, ndim(v_2) - 1) ≤ shape(v_1, ndim(v_1) - 1))
>>
Rule 6 (tuple k: diagonal rank depends on band width)
{v_1 : tensor, v_2 : tensor, v_3 : tuple(int)} |= ndim(v_1) ≥ 2 ∧ (if v_3[0] = v_3[1] then ndim(v_2) = ndim(v_1) - 1 else ndim(v_2) = ndim(v_1))
>>
Rule 9 (diagonal must have a non-empty last dimension)
{v_2 : tensor} |= ndim(v_2) ≥ 1 ∧ shape(v_2, ndim(v_2) - 1) > 0
