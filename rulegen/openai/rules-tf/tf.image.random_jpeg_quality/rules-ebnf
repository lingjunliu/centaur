>>
Rule 1 (image must be 3-dimensional)
{v_1 : tensor} |= ndim(v_1) = 3
>>
Rule 2 (image channels must be 1 or 3)
{v_1 : tensor} |= shape(v_1, 2) = 1 ∨ shape(v_1, 2) = 3
>>
Rule 3 (image dtype must be integer or floating point)
{v_1 : tensor} |= dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 8
>>
Rule 4 (jpeg quality bounds must each be within [0, 100])
{v_2 : int, v_3 : int} |= 0 ≤ v_2 ∧ v_2 ≤ 100 ∧ 0 ≤ v_3 ∧ v_3 ≤ 100
>>
Rule 5 (min_jpeg_quality must be less than max_jpeg_quality)
{v_2 : int, v_3 : int} |= v_2 < v_3
