Rule 1 (data must be floating type (fp16/fp32/fp64) and have rank at least 1)
{v_1 : tensor} |= ((dtype_(v_1) = 6 ∨ dtype_(v_1) = 7) ∨ dtype_(v_1) = 8) ∧ ndim(v_1) ≥ 1
>>
Rule 2 (indices must be a 1-D tensor of int32 or int64)
{v_1 : tensor} |= ndim(v_1) = 1 ∧ (dtype_(v_1) = 3 ∨ dtype_(v_1) = 4)
>>
Rule 4 (indices and segment_ids are both 1-D and have the same length)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 1 ∧ ndim(v_2) = 1 ∧ shape(v_1, 0) = shape(v_2, 0)
>>
Rule 5 (lengths of indices and segment_ids do not exceed data’s first dimension)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) = 1 ∧ ndim(v_3) = 1 ∧ shape(v_2, 0) ≤ shape(v_1, 0) ∧ shape(v_3, 0) ≤ shape(v_1, 0)
>>
Rule 6 (valid name strings)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "sum" ∨ v_1 = "max" ∨ v_1 = "min" ∨ v_1 = "relu" ∨ v_1 = "tanh" ∨ v_1 = "sigmoid" ∨ v_1 = "softmax" ∨ v_1 = "linear" ∨ v_1 = "valid" ∨ v_1 = "same" ∨ v_1 = "channels_last" ∨ v_1 = "channels_first"
>>
Rule 7 (sparse_gradient is a boolean flag)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 8 (indices values must be within data’s first-dimension bounds)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) = 1 ∧ (dtype_(v_2) = 3 ∨ dtype_(v_2) = 4) ∧ min(v_2) ≥ 0 ∧ max(v_2) < shape(v_1, 0)
