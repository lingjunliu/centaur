Rule 1 (input tensors must have matching dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (broadcasting compatibility across trailing dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 ∨ ndim(v_2) = 0 then true else ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_2) - 1 else ndim(v_1) - 1] : shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1) ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1
>>
Rule 3 (equal-rank tensors must be broadcastable dimension-wise)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, if ndim(v_1) > 0 then ndim(v_1) - 1 else -1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 4 (vector inputs are broadcastable)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 5 (last two dimensions are broadcastable for matrices or higher)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2 then (shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) ∨ shape(v_1, ndim(v_1) - 1) = 1 ∨ shape(v_2, ndim(v_2) - 1) = 1) ∧ (shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 2) ∨ shape(v_1, ndim(v_1) - 2) = 1 ∨ shape(v_2, ndim(v_2) - 2) = 1)
>>
Rule 6 (broadcast-compatible shapes between x1 and x2)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : if i < ndim(v_2) then (shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i) ∨ shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = 1) ∧ ∀j ∈ [0, ndim(v_2) - 1] : if j < ndim(v_1) then (shape(v_2, ndim(v_2) - 1 - j) = shape(v_1, ndim(v_1) - 1 - j) ∨ shape(v_2, ndim(v_2) - 1 - j) = 1 ∨ shape(v_1, ndim(v_1) - 1 - j) = 1)
>>
Rule 8 (non-empty inputs contain no NaNs)
{v_1 : tensor, v_2 : tensor} |= (if ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0 then true else (min(v_1) = min(v_1) ∧ max(v_1) = max(v_1))) ∧ (if ∃j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) = 0 then true else (min(v_2) = min(v_2) ∧ max(v_2) = max(v_2)))
>>
Rule 9 (all shape dimensions are non-negative)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0 ∧ ∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) ≥ 0
>>
Rule 10 (values are within a finite numeric range for stable computation)
{v_1 : tensor, v_2 : tensor} |= (if ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0 then true else (min(v_1) ≥ -1000000 ∧ max(v_1) ≤ 1000000)) ∧ (if ∃j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) = 0 then true else (min(v_2) ≥ -1000000 ∧ max(v_2) ≤ 1000000))
>>
Rule 11 (inputs must be real numeric tensors: integer or float dtypes only)
{v_1: tensor, v_2: tensor} |= (1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8) ∧ (1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8)
>>
Rule 12 (broadcastability: scalar or per-dimension broadcasting with equal ranks)
{v_1: tensor, v_2: tensor} |= (ndim(v_1) = 0) ∨ (ndim(v_2) = 0) ∨ (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i)) ∨ (shape(v_1, i) = 1) ∨ (shape(v_2, i) = 1))
>>
Rule 13 (all shape dimensions are non-negative for both inputs)
{v_1: tensor, v_2: tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) ≥ 0)
>>
Rule 14 (inputs should not contain NaNs; min ≤ max must hold)
{v_1: tensor, v_2: tensor} |= (min(v_1) ≤ max(v_1)) ∧ (min(v_2) ≤ max(v_2))
