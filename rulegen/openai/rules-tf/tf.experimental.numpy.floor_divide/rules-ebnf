>>
Rule 1 (operands must be integer or floating dtypes)
{v_1 : tensor, v_2 : tensor} |= if 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5 then 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8 else if 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8 then 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8 else false
>>
Rule 3 (broadcasting compatibility when ranks are equal)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 4 (when ranks differ, allow only scalar broadcasting)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≠ ndim(v_2) then ndim(v_1) = 0 ∨ ndim(v_2) = 0
>>
Rule 5 (all dimensions of both tensors must be positive)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 ∧ ∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0
>>
Rule 6 (complex, string, and boolean dtypes are not supported)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 0 ∧ dtype_(v_2) ≠ 0 ∧ dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10 ∧ dtype_(v_1) ≠ 11 ∧ dtype_(v_2) ≠ 11
>>
Rule 7 (denominator tensor must not contain zeros)
{v_2 : tensor} |= (min(v_2) > 0) ∨ (max(v_2) < 0)
>>
Rule 8 (exact shape match or one operand is scalar)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 0) ∨ (ndim(v_2) = 0) ∨ (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 9 (broadcastable per-dimension when ranks are equal)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i)) ∨ (shape(v_1, i) = 1) ∨ (shape(v_2, i) = 1)
>>
Rule 10 (x1 has only positive dimension sizes)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 11 (x2 has only positive dimension sizes)
{v_2 : tensor} |= ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0
>>
Rule 12 (operands have identical dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 13 (1-D divisor matches last dimension of dividend or is singleton)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_2) = 1) ∧ (ndim(v_1) ≥ 1) then (shape(v_2, 0) = shape(v_1, ndim(v_1) - 1)) ∨ (shape(v_2, 0) = 1)
>>
Rule 15 (broadcasting compatibility from v_1’s perspective)
{v_1 : tensor, v_2 : tensor} |= ∀k ∈ [0, ndim(v_1) - 1] : (shape(v_1, k) = (if k < ndim(v_1) - ndim(v_2) then 1 else shape(v_2, k - (ndim(v_1) - ndim(v_2))))) ∨ (shape(v_1, k) = 1) ∨ ((if k < ndim(v_1) - ndim(v_2) then 1 else shape(v_2, k - (ndim(v_1) - ndim(v_2)))) = 1)
>>
Rule 16 (broadcasting compatibility from v_2’s perspective)
{v_1 : tensor, v_2 : tensor} |= ∀k ∈ [0, ndim(v_2) - 1] : (shape(v_2, k) = (if k < ndim(v_2) - ndim(v_1) then 1 else shape(v_1, k - (ndim(v_2) - ndim(v_1))))) ∨ (shape(v_2, k) = 1) ∨ ((if k < ndim(v_2) - ndim(v_1) then 1 else shape(v_1, k - (ndim(v_2) - ndim(v_1)))) = 1)
