>>
Rule 1 (input must be a floating-point tensor)
{v_1 : tensor} |= dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 8
>>
Rule 2 (name can be any string)
{v_2 : str} |= v_2 = "none" ∨ v_2 ≠ "none"
>>
Rule 3 (non-negative shape dimensions when rank > 0)
{v_1 : tensor} |= if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 4 (if a specific name is chosen, dtype must still be floating)
{v_1 : tensor, v_2 : str} |= if v_2 = "linear" then (dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 8)
>>
Rule 5 (if any dimension is zero-length, use a neutral name)
{v_1 : tensor, v_2 : str} |= if ndim(v_1) = 0 then true else if ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0 then v_2 = "none"
