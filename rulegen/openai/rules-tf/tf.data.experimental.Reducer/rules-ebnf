>>
Rule 1 (Reducer init and reduce tensors must have equal rank)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 2 (Reducer reduce tensor must match init tensor shape per dimension)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) = shape(v_1, i)
>>
Rule 3 (All non-scalar reducer tensors must have strictly positive dimensions)
{v_1 : tensor, v_2 : tensor} |= (if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (if ndim(v_2) > 0 then ∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0)
>>
Rule 4 (Finalize tensor must be scalar or match init tensor shape)
{v_1 : tensor, v_3 : tensor} |= if ndim(v_3) = 0 then true else ndim(v_1) = ndim(v_3) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = shape(v_1, i)
>>
Rule 5 (Reducer tensors must use numeric dtypes)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= (1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10) ∧ (1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 10) ∧ (1 ≤ dtype_(v_3) ∧ dtype_(v_3) ≤ 10)
>>
Rule 6 (Reduce tensor dtype family must match init tensor dtype family)
{v_1 : tensor, v_2 : tensor} |= if 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5 then 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5 else if 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10 then 6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 10 else false
>>
Rule 7 (Finalize tensor dtype family must match init tensor dtype family)
{v_1 : tensor, v_3 : tensor} |= if 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5 then 1 ≤ dtype_(v_3) ∧ dtype_(v_3) ≤ 5 else if 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10 then 6 ≤ dtype_(v_3) ∧ dtype_(v_3) ≤ 10 else false
>>
Rule 8 (Complex state requires finalize tensor to keep full shape)
{v_1 : tensor, v_3 : tensor} |= if 9 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10 then ndim(v_3) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = shape(v_1, i)
