Rule 1 (integer axis within valid insertion range)
{v_1 : tensor, v_2 : int} |= (0 - ndim(v_1) - 1) ≤ v_2 ∧ v_2 ≤ ndim(v_1)
>>
Rule 2 (normalized integer axis is within [0, ndim(a)])
{v_1 : tensor, v_2 : int} |= 0 ≤ (if v_2 ≥ 0 then v_2 else v_2 + ndim(v_1) + 1) ∧ (if v_2 ≥ 0 then v_2 else v_2 + ndim(v_1) + 1) ≤ ndim(v_1)
>>
Rule 3 (0-D tensor special case for integer axis)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 0 then (v_2 = -1 ∨ v_2 = 0)
>>
Rule 4 (tuple axis: length bounds and each axis in valid range)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len ≥ 1 ∧ v_2.len ≤ ndim(v_1) + 1 ∧ ∀ i ∈ [0, v_2.len - 1] : ((0 - ndim(v_1) - 1) ≤ v_2[i] ∧ v_2[i] ≤ ndim(v_1))
>>
Rule 5 (tuple axis: no duplicate axes after normalization)
{v_1 : tensor, v_2 : tuple(int)} |= ∀ i ∈ [0, v_2.len - 1] : ∀ j ∈ [i + 1, v_2.len - 1] : ((if v_2[i] ≥ 0 then v_2[i] else v_2[i] + ndim(v_1) + 1) ≠ (if v_2[j] ≥ 0 then v_2[j] else v_2[j] + ndim(v_1) + 1))
>>
Rule 6 (0-D tensor special case for tuple axis)
{v_1 : tensor, v_2 : tuple(int)} |= if ndim(v_1) = 0 then (v_2.len ≤ 1 ∧ (v_2.len = 0 ∨ (v_2[0] = -1 ∨ v_2[0] = 0)))
>>
Rule 7 (tensor must have a concrete dtype, not np.dtype sentinel)
{v_1 : tensor} |= dtype_(v_1) ≠ 12
