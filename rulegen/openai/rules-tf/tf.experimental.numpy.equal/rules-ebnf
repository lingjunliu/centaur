>>
Rule 1 (inputs must be broadcastable along aligned trailing dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ ndim(v_2) then (if ndim(v_2) > 0 then ∀k ∈ [0, ndim(v_2) - 1] : (shape(v_1, ndim(v_1) - 1 - k) = shape(v_2, ndim(v_2) - 1 - k) ∨ shape(v_1, ndim(v_1) - 1 - k) = 1 ∨ shape(v_2, ndim(v_2) - 1 - k) = 1)) else (if ndim(v_1) > 0 then ∀k ∈ [0, ndim(v_1) - 1] : (shape(v_1, ndim(v_1) - 1 - k) = shape(v_2, ndim(v_2) - 1 - k) ∨ shape(v_1, ndim(v_1) - 1 - k) = 1 ∨ shape(v_2, ndim(v_2) - 1 - k) = 1))
>>
Rule 2 (string inputs must be compared only with string inputs)
{v_1 : tensor, v_2 : tensor} |= (if dtype_(v_1) = 11 then dtype_(v_2) = 11) ∧ (if dtype_(v_2) = 11 then dtype_(v_1) = 11)
>>
Rule 3 (dtype object tensors are not allowed)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 12 ∧ dtype_(v_2) ≠ 12
>>
Rule 4 (complex inputs cannot be compared with strings or dtype objects)
{v_1 : tensor, v_2 : tensor} |= (if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then (dtype_(v_2) ≠ 11 ∧ dtype_(v_2) ≠ 12)) ∧ (if dtype_(v_2) = 9 ∨ dtype_(v_2) = 10 then (dtype_(v_1) ≠ 11 ∧ dtype_(v_1) ≠ 12))
>>
Rule 5 (each dimension size of the first input must be non-negative)
{v_1 : tensor} |= if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 6 (each dimension size of the second input must be non-negative)
{v_2 : tensor} |= if ndim(v_2) > 0 then ∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) ≥ 0
>>
Rule 7 (boolean inputs cannot be compared with strings or dtype objects)
{v_1 : tensor, v_2 : tensor} |= (if dtype_(v_1) = 0 then (dtype_(v_2) ≠ 11 ∧ dtype_(v_2) ≠ 12)) ∧ (if dtype_(v_2) = 0 then (dtype_(v_1) ≠ 11 ∧ dtype_(v_1) ≠ 12))
