>>
Rule 1 (inputs must be 2-D matrices)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 2 ∧ ndim(v_2) = 2
>>
Rule 2 (matmul dimension compatibility considering transposes)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if v_3 then (if v_4 then shape(v_1, 0) = shape(v_2, 1) else shape(v_1, 0) = shape(v_2, 0)) else (if v_4 then shape(v_1, 1) = shape(v_2, 1) else shape(v_1, 1) = shape(v_2, 0))
>>
Rule 3 (input tensor data types must match)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 4 (matrix dimension sizes are non-negative)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) ≥ 0 ∧ shape(v_1, 1) ≥ 0 ∧ shape(v_2, 0) ≥ 0 ∧ shape(v_2, 1) ≥ 0
