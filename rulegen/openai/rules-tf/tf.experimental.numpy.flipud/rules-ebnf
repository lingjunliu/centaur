>>
Rule 1 (input tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 2 (allow zero-sized dimensions but require all dimension sizes to be non-negative)
{v_1 : tensor} |= if ndim(v_1) ≥ 1 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 3 (axis-0 must be a valid axis for flipping)
{v_1 : tensor} |= ∃i ∈ [0, 0] : i < ndim(v_1)
>>
Rule 5 (axis 0 must exist to flip along it)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : i = 0
>>
Rule 6 (all shape dimensions are non-negative when defined)
{v_1 : tensor} |= if ndim(v_1) ≥ 1 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0 else false
>>
Rule 7 (input dtype is well-defined)
{v_1 : tensor} |= dtype_(v_1) = dtype_(v_1)
