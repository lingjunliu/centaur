>>
Rule 1 (valid single-axis index is within [-ndim(a), ndim(a) - 1])
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 1 ∧ v_2 ≥ 0 - ndim(v_1) ∧ v_2 < ndim(v_1)
>>
Rule 2 (valid tuple of axes: size ≤ ndim(a), each in range, unique modulo ndim(a); keepdims is boolean)
{v_1 : tensor, v_2 : tuple(int), v_3 : bool} |= v_2.len ≤ ndim(v_1) ∧ (if v_2.len > 0 then (∀ i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0 - ndim(v_1) ∧ v_2[i] < ndim(v_1))) ∧ (if v_2.len > 1 then (∀ i ∈ [0, v_2.len - 2] : ∀ j ∈ [i + 1, v_2.len - 1] : (if v_2[i] < 0 then v_2[i] + ndim(v_1) else v_2[i]) ≠ (if v_2[j] < 0 then v_2[j] + ndim(v_1) else v_2[j]))) ∧ (v_3 = true ∨ v_3 = false)
>>
Rule 3 (valid list of axes: size ≤ ndim(a), each in range, unique modulo ndim(a))
{v_1 : tensor, v_2 : list(int)} |= v_2.len ≤ ndim(v_1) ∧ (if v_2.len > 0 then (∀ i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0 - ndim(v_1) ∧ v_2[i] < ndim(v_1))) ∧ (if v_2.len > 1 then (∀ i ∈ [0, v_2.len - 2] : ∀ j ∈ [i + 1, v_2.len - 1] : (if v_2[i] < 0 then v_2[i] + ndim(v_1) else v_2[i]) ≠ (if v_2[j] < 0 then v_2[j] + ndim(v_1) else v_2[j])))
>>
Rule 4 (keepdims must be a boolean flag)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
>>
Rule 5 (numeric or boolean tensor input for ptp)
{v_1 : tensor} |= (0 ≤ dtype_(v_1)) ∧ (dtype_(v_1) ≤ 8)
>>
Rule 7 (integer axis reduces a non-empty dimension)
{v_1 : tensor, v_2 : int} |= if v_2 ≥ 0 then shape(v_1, v_2) > 0 else shape(v_1, v_2 + ndim(v_1)) > 0
>>
Rule 10 (tuple axis reduces only non-empty dimensions)
{v_1 : tensor, v_2 : tuple(int)} |= if v_2.len = 0 then true else ∀ i ∈ [0, v_2.len - 1] : if v_2[i] ≥ 0 then shape(v_1, v_2[i]) > 0 else shape(v_1, v_2[i] + ndim(v_1)) > 0
>>
Rule 13 (list axis reduces only non-empty dimensions)
{v_1 : tensor, v_2 : list(int)} |= if v_2.len = 0 then true else ∀ i ∈ [0, v_2.len - 1] : if v_2[i] ≥ 0 then shape(v_1, v_2[i]) > 0 else shape(v_1, v_2[i] + ndim(v_1)) > 0
>>
Rule 14 (input tensor dtype must be real/integer for ptp)
{v_1 : tensor} |= dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 15 (input must have at least one dimension when an axis is provided)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 20 (every reduced dimension in tuple/list of axes must be non-empty)
{v_1 : tensor, v_2 : tuple(int) ⊎ list(int)} |= if v_2.len > 0 then ∀k ∈ [0, v_2.len - 1] : if v_2[k] ≥ 0 then shape(v_1, v_2[k]) > 0 else shape(v_1, v_2[k] + ndim(v_1)) > 0
>>
Rule 22 (max is at least min for ordered dtypes)
{v_1 : tensor} |= max(v_1) ≥ min(v_1)
