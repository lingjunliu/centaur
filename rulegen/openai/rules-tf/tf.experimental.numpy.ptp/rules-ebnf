Rule 1 (valid single-axis index is within [-ndim(a), ndim(a) - 1])
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 1 ∧ v_2 ≥ 0 - ndim(v_1) ∧ v_2 < ndim(v_1)
>>
Rule 2 (valid tuple of axes: size ≤ ndim(a), each in range, unique modulo ndim(a); keepdims is boolean)
{v_1 : tensor, v_2 : tuple(int), v_3 : bool} |= v_2.len ≤ ndim(v_1) ∧ (if v_2.len > 0 then (∀ i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0 - ndim(v_1) ∧ v_2[i] < ndim(v_1))) ∧ (if v_2.len > 1 then (∀ i ∈ [0, v_2.len - 2] : ∀ j ∈ [i + 1, v_2.len - 1] : (if v_2[i] < 0 then v_2[i] + ndim(v_1) else v_2[i]) ≠ (if v_2[j] < 0 then v_2[j] + ndim(v_1) else v_2[j]))) ∧ (v_3 = true ∨ v_3 = false)
>>
Rule 3 (valid list of axes: size ≤ ndim(a), each in range, unique modulo ndim(a))
{v_1 : tensor, v_2 : list(int)} |= v_2.len ≤ ndim(v_1) ∧ (if v_2.len > 0 then (∀ i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0 - ndim(v_1) ∧ v_2[i] < ndim(v_1))) ∧ (if v_2.len > 1 then (∀ i ∈ [0, v_2.len - 2] : ∀ j ∈ [i + 1, v_2.len - 1] : (if v_2[i] < 0 then v_2[i] + ndim(v_1) else v_2[i]) ≠ (if v_2[j] < 0 then v_2[j] + ndim(v_1) else v_2[j])))
>>
Rule 4 (keepdims must be a boolean flag)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
