>>
Rule 1 (input must be a 4D tensor with all dimensions positive)
{v_1 : tensor} |= ndim(v_1) = 4 ∧ ∀i ∈ [0, 3] : shape(v_1, i) > 0
>>
Rule 2 (input dtype must be one of float32, float64, int32, int64)
{v_1 : tensor} |= (dtype_(v_1) = 3 ∨ dtype_(v_1) = 4) ∨ (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 3 (pooling_ratio must have length at least 4)
{v_2 : list(float)} |= v_2.len ≥ 4
>>
Rule 4 (no pooling on batch and channel dimensions: first and last ratios are 1.0)
{v_2 : list(float)} |= v_2[0] = 1.0 ∧ v_2[v_2.len - 1] = 1.0
>>
Rule 5 (pooling ratios on spatial dimensions are at least 1.0)
{v_2 : list(float)} |= (v_2.len ≥ 3) ∧ ∀i ∈ [1, v_2.len - 2] : v_2[i] ≥ 1.0
>>
Rule 6 (all pooling_ratio entries must be positive)
{v_2 : list(float)} |= (v_2.len ≥ 1) ∧ ∀i ∈ [0, v_2.len - 1] : v_2[i] > 0
>>
Rule 7 (boolean flags are booleans)
{v_3 : bool, v_4 : bool, v_5 : bool} |= (v_3 = true ∨ v_3 = false) ∧ (v_4 = true ∨ v_4 = false) ∧ (v_5 = true ∨ v_5 = false)
>>
Rule 8 (seed behavior allows zero or non-zero values)
{v_6 : int, v_7 : int} |= (v_6 ≠ 0 ∨ v_7 ≠ 0) ∨ (v_6 = 0 ∧ v_7 = 0)
