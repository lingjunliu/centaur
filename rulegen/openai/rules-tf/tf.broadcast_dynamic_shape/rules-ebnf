Rule 15 (tuple shape entries must be non-negative)
{v_1 : tuple(int), v_2 : tuple(int)} |= (v_1.len = 0 ∨ ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0) ∧ (v_2.len = 0 ∨ ∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0)
