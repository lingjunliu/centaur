{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 1 ∧ ndim(v_2) = 1 ∧ shape(v_1, 0) = shape(v_2, 0) ∧ min(v_1) = max(v_1) ∧ min(v_2) = max(v_2) ∧ min(v_1) = min(v_2)
