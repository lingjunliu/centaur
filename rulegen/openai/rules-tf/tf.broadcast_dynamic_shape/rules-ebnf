{v_1 : list(int) ⊎ tuple(int), v_2 : list(int) ⊎ tuple(int)} |= ((v_1.len = 0) ∨ ∀i ∈ [0, v_1.len - 1] : v_1[i] = 1) ∨ ((v_2.len = 0) ∨ ∀i ∈ [0, v_2.len - 1] : v_2[i] = 1)
