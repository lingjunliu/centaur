Rule 3 (tuple axis: each index is in range and all are unique)
{v_1 : tensor, v_2 : tuple(int)} |= (∀i ∈ [0, v_2.len - 1] : (0 - ndim(v_1)) ≤ v_2[i] ∧ v_2[i] < ndim(v_1)) ∧ (if v_2.len ≥ 2 then ∀i ∈ [0, v_2.len - 2] : ∀j ∈ [i + 1, v_2.len - 1] : v_2[i] ≠ v_2[j])
>>
Rule 4 (tensor axis: dtype must be int32 or int64, and values are in range)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_2) = 3 ∨ dtype_(v_2) = 4) ∧ min(v_2) ≥ (0 - ndim(v_1)) ∧ max(v_2) < ndim(v_1)
>>
Rule 5 (keepdims is a boolean flag)
{v_3 : bool} |= v_3 = true ∨ v_3 = false
>>
Rule 6 (name is a benign non-sentinel string)
{v_4 : str} |= v_4 ≠ "none"
>>
Rule 7 (axis may be provided as scalar int or tensor in supported signatures)
{v_2 : int ⊎ tensor} |= v_2 = v_2
