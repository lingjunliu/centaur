Rule 3 (target_height must be positive)
{v_2 : int} |= v_2 > 0
>>
Rule 4 (target_width must be positive)
{v_3 : int} |= v_3 > 0
>>
Rule 5 (avoid overflow by capping target dimensions)
{v_2 : int, v_3 : int} |= v_2 ≤ 2147483647 ∧ v_3 ≤ 2147483647
>>
Rule 6 (avoid OOM by bounding total output elements)
{v_1 : tensor, v_2 : int, v_3 : int} |= if ndim(v_1) = 3 then v_2 * v_3 * shape(v_1, 2) ≤ 100000000 else if ndim(v_1) = 4 then shape(v_1, 0) * v_2 * v_3 * shape(v_1, 3) ≤ 100000000 else false
