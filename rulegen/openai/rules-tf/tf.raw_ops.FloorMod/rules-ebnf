{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1 else if ndim(v_1) > ndim(v_2) then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_1, i + (ndim(v_1) - ndim(v_2))) = shape(v_2, i) ∨ shape(v_1, i + (ndim(v_1) - ndim(v_2))) = 1 ∨ shape(v_2, i) = 1 else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i + (ndim(v_2) - ndim(v_1))) = shape(v_1, i) ∨ shape(v_2, i + (ndim(v_2) - ndim(v_1))) = 1 ∨ shape(v_1, i) = 1
