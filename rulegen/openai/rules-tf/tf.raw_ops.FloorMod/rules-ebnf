>>
Rule 1 (inputs must have the same supported dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2) ∧ (dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 2 (trailing axes must be broadcast-compatible)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : if i < ndim(v_2) then (shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i) ∨ shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = 1)) ∧ (∀j ∈ [0, ndim(v_2) - 1] : if j < ndim(v_1) then (shape(v_1, ndim(v_1) - 1 - j) = shape(v_2, ndim(v_2) - 1 - j) ∨ shape(v_1, ndim(v_1) - 1 - j) = 1 ∨ shape(v_2, ndim(v_2) - 1 - j) = 1))
>>
Rule 3 (leading extra dimensions of the higher-rank tensor must be 1)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > ndim(v_2) then ∀i ∈ [0, ndim(v_1) - ndim(v_2) - 1] : shape(v_1, i) = 1 else if ndim(v_2) > ndim(v_1) then ∀j ∈ [0, ndim(v_2) - ndim(v_1) - 1] : shape(v_2, j) = 1
>>
Rule 4 (name is either omitted-like or a simple label)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "linear"
>>
Rule 5 (if ranks are equal and no singleton dimensions, shapes must match exactly)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) ∧ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≠ 1 ∧ shape(v_2, i) ≠ 1) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 6 (unsupported dtypes are disallowed for inputs)
{v_1 : tensor} |= dtype_(v_1) ≠ 0 ∧ dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_1) ≠ 11 ∧ dtype_(v_1) ≠ 12
