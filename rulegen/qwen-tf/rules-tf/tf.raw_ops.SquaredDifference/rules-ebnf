Rule 1 (tensor type consistency)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (tensor shape compatibility for broadcasting)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 3 (tensor dimensionality)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 4 (tensor element-wise operation)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 5 (tensor types are real)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ complex64 ∧ dtype_(v_2) ≠ complex128
>>
Rule 6 (tensor element-wise squared difference)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∧ dtype_(v_1) = dtype_(v_2)
>>
Rule 10 (tensor element-wise operation with compatible shapes)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) = shape(v_2, 0)
