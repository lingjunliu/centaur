Rule 1 (inputs must be floating tensors of the same dtype — suppresses dtype ‘bool’ error)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2) ∧ (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 2 (inputs must be broadcastable in shape — suppresses incompatible shapes error)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≤ ndim(v_2) then (if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i) ∨ shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = 1)) else (if ndim(v_2) = 0 then true else ∀i ∈ [0, ndim(v_2) - 1] : (shape(v_2, ndim(v_2) - 1 - i) = shape(v_1, ndim(v_1) - 1 - i) ∨ shape(v_2, ndim(v_2) - 1 - i) = 1 ∨ shape(v_1, ndim(v_1) - 1 - i) = 1))
>>
Rule 3 (name is a valid string identifier)
{v_3 : str} |= v_3 = "none" ∨ v_3 = "sum" ∨ v_3 = "max" ∨ v_3 = "min" ∨ v_3 = "linear"
