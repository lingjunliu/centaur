Rule 5 (v_2 should be a valid dimension of input tensor)
{v_1 : tensor, v_2 : int} |= -1 × ndim(v_1) ≤ v_2 ∧ v_2 ≤ ndim(v_1) - 1
>>
Rule 6 (tensor must be non-empty)
{v_1 : tensor} |= ndim(v_1) > 0 ∧ shape(v_1, 0) > 0
>>
Rule 7 (tensor has at least one element)
{v_1 : tensor} |= ndim(v_1) ≥ 1 ∧ shape(v_1, 0) ≥ 1
>>
Rule 9 (tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 10 (tensor should be a scalar)
{v_1 : tensor} |= ndim(v_1) = 0
>>
Rule 11 (tensor should be a vector)
{v_1 : tensor} |= ndim(v_1) = 1
