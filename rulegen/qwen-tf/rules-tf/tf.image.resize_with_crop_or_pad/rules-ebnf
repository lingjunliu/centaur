Rule 1 (tensor shapes should be the same)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 2 (input tensors must have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 3 (first dimension of a tensor matches second dimension of the other)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 2 ∧ shape(v_1, 0) = shape(v_2, 1)
>>
Rule 4 (shape alignment for matrix multiplication)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2)) ∨ (ndim(v_1) ≥ 2 ∧ ndim(v_2) = 1 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_2, 0))
>>
Rule 5 (reduction over valid dimensions)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : 0 ≤ v_2[i] ∧ v_2[i] < ndim(v_1)
>>
Rule 6 (primitive type variable should not be zero)
{v_1 : int ⊎ float} |= v_1 ≠ 0
>>
Rule 7 (tensor must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 8 (tensor dimensions must be positive)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 9 (tensor should have valid dimensionality)
{v_1 : tensor} |= ndim(v_1) ≥ 3 ∧ ndim(v_1) ≤ 4
>>
Rule 10 (image dimensions must be positive)
{v_1 : tensor} |= shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0
>>
Rule 11 (tensor shape should match target dimensions)
{v_1 : tensor, v_2 : int, v_3 : int} |= shape(v_1, 0) = v_2 ∧ shape(v_1, 1) = v_3
>>
Rule 12 (tensor must have valid shape for resize operation)
{v_1 : tensor, v_2 : int, v_3 : int} |= shape(v_1, 0) ≥ v_2 ∧ shape(v_1, 1) ≥ v_3
>>
Rule 14 (tensor must not have zero dimensions)
{v_1 : tensor} |= shape(v_1, 0) ≠ 0 ∧ shape(v_1, 1) ≠ 0 ∧ shape(v_1, 2) ≠ 0
