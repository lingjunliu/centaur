>>
Rule 1 (input must be a Tensor)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 2 (index must be a LongTensor)
{v_2 : tensor} |= dtype_(v_2) = 4
>>
Rule 3 (do not take from an empty input tensor)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 4 (indices within bounds for 1-D input)
{v_1 : tensor, v_2 : tensor} |= (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0) ∧ ndim(v_1) = 1 ∧ min(v_2) ≥ 0 ∧ max(v_2) ≤ shape(v_1, 0) - 1
>>
Rule 5 (indices valid for scalar input)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then min(v_2) = 0 ∧ max(v_2) = 0
