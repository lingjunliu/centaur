>>
Rule 1 (tensor must be 2D with positive dimensions)
{v_1 : tensor} |= ndim(v_1) = 2 ∧ shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0
>>
Rule 2 (tensor dtype must not be bool)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 3 (sparsity must be finite, not NaN, and in [0, 1))
{v_2 : float} |= (v_2 = v_2) ∧ 0 ≤ v_2 ∧ v_2 < 1
>>
Rule 4 (std must be non-negative and not NaN)
{v_3 : float} |= (v_3 = v_3) ∧ v_3 ≥ 0
