    >>> A = torch.randn(5, 3)
    >>> S = torch.linalg.svdvals(A)
    >>> S
    tensor([2.5139, 2.1087, 1.1066])

    >>> torch.dist(S, torch.linalg.svd(A, full_matrices=False).S)
