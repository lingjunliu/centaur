Rule 1 (input shape must be valid; scalars allowed; otherwise all dims ≥ 1)
{v_1 : tensor} |= if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 1
>>
Rule 2 (requires_grad disabled to avoid invalid dtype gradients)
{v_1 : bool} |= v_1 = false
>>
Rule 3 (memory_format must be None-like to avoid TypeError)
{v_1 : str} |= v_1 = "none"
>>
Rule 5 (when dtype is provided, keep it identical to input.dtype)
{v_1 : tensor, v_2 : dtype} |= v_2 = dtype_(v_1)
>>
Rule 7 (numeric fill_value should be within a safe bounded range)
{v_1 : int ⊎ float} |= (v_1 ≥ -1000000) ∧ (v_1 ≤ 1000000)
>>
Rule 8 (boolean fill_value: gradients must be disabled)
{v_1 : bool, v_2 : bool} |= if v_1 = true ∨ v_1 = false then v_2 = false
