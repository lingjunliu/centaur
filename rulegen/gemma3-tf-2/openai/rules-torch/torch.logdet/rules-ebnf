>>
Rule 1 (input must have at least two dimensions)
{v_1 : tensor} |= 2 ≤ ndim(v_1)
>>
Rule 2 (input dtype must be floating point or complex)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 3 (low precision float16 is not supported)
{v_1 : tensor} |= dtype_(v_1) ≠ 6
>>
Rule 4 (last two dimensions must form non-empty square matrices)
{v_1 : tensor} |= if 2 ≤ ndim(v_1) then (shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)) ∧ (shape(v_1, ndim(v_1) - 1) > 0) else false
