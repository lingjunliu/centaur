>>
Rule 1 (real and imag must be tensors)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 0 ∧ ndim(v_2) ≥ 0
>>
Rule 2 (inputs must be Half, Float, or Double)
{v_1 : tensor, v_2 : tensor} |= (6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8) ∧ (6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8)
>>
Rule 3 (imag must have the same dtype as real)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_2) = dtype_(v_1)
>>
Rule 4 (real and imag must have identical shapes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 5 (out dtype must match input dtype: float32→complex64, float64→complex128)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if (dtype_(v_1) = 7 ∧ dtype_(v_2) = 7) then dtype_(v_3) = 9 else if (dtype_(v_1) = 8 ∧ dtype_(v_2) = 8) then dtype_(v_3) = 10 else 0 = 0
>>
Rule 6 (out shape must match inputs)
{v_1 : tensor, v_3 : tensor} |= ndim(v_3) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = shape(v_1, i)
