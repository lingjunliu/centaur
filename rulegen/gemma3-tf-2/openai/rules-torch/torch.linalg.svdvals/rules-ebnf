>>
Rule 1 (A must be at least 2D to be a matrix or batch of matrices)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (A must have a floating-point or complex dtype)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 3 (Half precision (float16) is not supported)
{v_1 : tensor} |= dtype_(v_1) ≠ 6
>>
Rule 4 (driver must not be used unless on CUDA with cuSOLVER; require None)
{v_2 : str} |= v_2 = "none"
>>
Rule 5 (out must be a Tensor)
{v_3 : tensor} |= ndim(v_3) ≥ 0
>>
Rule 6 (out dtype must match the real-valued result corresponding to A’s dtype)
{v_1 : tensor, v_3 : tensor} |= (dtype_(v_1) = 7 ∧ dtype_(v_3) = 7) ∨ (dtype_(v_1) = 8 ∧ dtype_(v_3) = 8) ∨ (dtype_(v_1) = 9 ∧ dtype_(v_3) = 7) ∨ (dtype_(v_1) = 10 ∧ dtype_(v_3) = 8)
>>
Rule 7 (out shape must match the singular values shape)
{v_1 : tensor, v_3 : tensor} |= ndim(v_3) = ndim(v_1) - 1 ∧ (if ndim(v_1) ≥ 3 then ∀i ∈ [0, ndim(v_1) - 3] : shape(v_3, i) = shape(v_1, i)) ∧ ((shape(v_1, ndim(v_1) - 2) ≤ shape(v_1, ndim(v_1) - 1) ∧ shape(v_3, ndim(v_3) - 1) = shape(v_1, ndim(v_1) - 2)) ∨ (shape(v_1, ndim(v_1) - 2) > shape(v_1, ndim(v_1) - 1) ∧ shape(v_3, ndim(v_3) - 1) = shape(v_1, ndim(v_1) - 1)))
