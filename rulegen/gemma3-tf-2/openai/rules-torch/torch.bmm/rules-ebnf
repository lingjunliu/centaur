>>
Rule 1 (input must be a 3D tensor)
{v_1 : tensor} |= ndim(v_1) = 3
>>
Rule 2 (mat2 must be a 3D tensor)
{v_2 : tensor} |= ndim(v_2) = 3
>>
Rule 3 (batch dimensions must match)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) = shape(v_2, 0)
>>
Rule 4 (inner matrix dimensions must align)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 2) = shape(v_2, 1)
>>
Rule 5 (input and mat2 dtypes must match)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 6 (out tensor must be 3D and have the correct batch-matmul shape)
{v_1 : tensor, v_2 : tensor, v_4 : tensor} |= ndim(v_4) = 3 ∧ shape(v_4, 0) = shape(v_1, 0) ∧ shape(v_4, 1) = shape(v_1, 1) ∧ shape(v_4, 2) = shape(v_2, 2)
>>
Rule 7 (out tensor dtype must match input dtype)
{v_1 : tensor, v_4 : tensor} |= dtype_(v_4) = dtype_(v_1)
>>
Rule 8 (out_dtype must match the dtype of out)
{v_3 : dtype, v_4 : tensor} |= v_3 = dtype_(v_4)
