Rule 1 (boolean dtype is not supported for input)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 3 (out must have the same shape as input)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 4 (out dtype must equal the result dtype of absolute)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 then dtype_(v_2) = 7 else if dtype_(v_1) = 10 then dtype_(v_2) = 8 else dtype_(v_2) = dtype_(v_1)
>>
Rule 6 (when out is Float, input must yield Float result — not Double)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_2) = 7 then dtype_(v_1) = 7 ∨ dtype_(v_1) = 9
