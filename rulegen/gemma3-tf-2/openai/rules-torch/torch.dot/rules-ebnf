Rule 1 (both arguments must be 1D vectors of equal length)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 1 ∧ ndim(v_2) = 1 ∧ shape(v_1, 0) = shape(v_2, 0)
>>
Rule 2 (both vectors must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (out tensor, when provided, must be a 0D tensor whose dtype matches the inputs)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_3) = 0 ∧ dtype_(v_3) = dtype_(v_1) ∧ dtype_(v_1) = dtype_(v_2)
>>
Rule 4 (vector lengths must be positive)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, 0] : shape(v_1, i) > 0 ∧ shape(v_2, i) > 0
>>
Rule 5 (dot supports only numeric/complex dtypes; exclude bool/str/dtype objects)
{v_1 : tensor, v_2 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10 ∧ dtype_(v_2) = dtype_(v_1)
