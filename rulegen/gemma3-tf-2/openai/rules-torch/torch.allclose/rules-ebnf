>>
Rule 1 (input and other must have identical shapes across all dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 2 (input and other must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (rtol and atol must be non-negative)
{v_1 : float, v_2 : float} |= v_1 ≥ 0 ∧ v_2 ≥ 0
>>
Rule 4 (equal_nan is a boolean flag)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
