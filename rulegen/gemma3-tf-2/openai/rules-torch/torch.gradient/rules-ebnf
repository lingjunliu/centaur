Rule 1 (edge_order must be 1 or 2)
{v_1 : int} |= v_1 = 1 ∨ v_1 = 2
>>
Rule 2 (dim as an integer must be a valid dimension of the input)
{v_1 : tensor, v_2 : int} |= (0 - ndim(v_1)) ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 3 (each dim in a list must be a valid dimension of the input)
{v_1 : tensor, v_2 : list(int)} |= ∀i ∈ [0, v_2.len - 1] : (0 - ndim(v_1)) ≤ v_2[i] ∧ v_2[i] < ndim(v_1)
>>
Rule 4 (input dtype must not be uint8)
{v_1 : tensor} |= dtype_(v_1) ≠ 5
>>
Rule 6 (when dim is a list and spacing is a list of scalars, their lengths must match)
{v_1 : list(int ⊎ float), v_2 : list(int)} |= v_1.len = v_2.len
>>
Rule 7 (when dim is a list and spacing is a list of tensors, their lengths must match)
{v_1 : list(tensor), v_2 : list(int)} |= v_1.len = v_2.len
>>
Rule 9 (when dim is unspecified and spacing is a list of scalars, its length must equal input.ndim)
{v_1 : tensor, v_2 : list(int ⊎ float)} |= v_2.len = ndim(v_1)
>>
Rule 10 (when dim is unspecified and spacing is a list of tensors, its length must equal input.ndim)
{v_1 : tensor, v_2 : list(tensor)} |= v_2.len = ndim(v_1)
