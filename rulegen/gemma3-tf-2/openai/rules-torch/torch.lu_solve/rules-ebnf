>>
Rule 1 (RHS tensor and LU_data must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (LU_pivots must be int32)
{v_3 : tensor} |= dtype_(v_3) = 3
>>
Rule 3 (Inputs must be floating or complex tensors)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) ∧ (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)
>>
Rule 4 (All pivot indices must be >= 1)
{v_3 : tensor} |= min(v_3) ≥ 1
>>
Rule 5 (LU_data must be square and batch dimensions of LU_data and LU_pivots must match)
{v_2 : tensor, v_3 : tensor} |= ndim(v_2) ≥ 2 ∧ ndim(v_3) ≥ 1 ∧ shape(v_2, ndim(v_2) - 2) = shape(v_2, ndim(v_2) - 1) ∧ ndim(v_3) = ndim(v_2) - 1 ∧ ∀i ∈ [0, ndim(v_3) - 1] : shape(v_3, i) = shape(v_2, i)
>>
Rule 6 (Pivots length must match the LU_data matrix size m)
{v_2 : tensor, v_3 : tensor} |= shape(v_3, ndim(v_3) - 1) = shape(v_2, ndim(v_2) - 1)
>>
Rule 7 (B must be batch-compatible with LU_data and share the same m dimension)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 2) ∧ ∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) = shape(v_2, i)
>>
Rule 8 (If provided, out must match B in shape and dtype)
{v_1 : tensor, v_4 : tensor} |= ndim(v_4) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_4, i) = shape(v_1, i) ∧ dtype_(v_4) = dtype_(v_1)
