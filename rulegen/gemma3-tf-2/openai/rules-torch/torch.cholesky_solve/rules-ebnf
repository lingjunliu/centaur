Rule 1 (B must be at least 2D to represent matrices)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (L must represent batches of square matrices)
{v_2 : tensor} |= ndim(v_2) ≥ 2 ∧ shape(v_2, ndim(v_2) - 1) = shape(v_2, ndim(v_2) - 2)
>>
Rule 3 (B’s row dimension matches L’s matrix size n)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2 ∧ shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 2)
>>
Rule 4 (B and L must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 5 (Only supported dtypes are allowed: float32, float64, complex64, complex128)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) ∧ dtype_(v_2) = dtype_(v_1)
>>
Rule 6 (out, if provided, must be a tensor with the same shape and dtype as the result B)
{v_1 : tensor, v_4 : tensor} |= ndim(v_4) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_4, i) = shape(v_1, i) ∧ dtype_(v_4) = dtype_(v_1)
>>
Rule 7 (Batch dimensions of B and L must be broadcastable; the shared n dimension must match)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2 ∧ shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 2) ∧ ∀i ∈ [0, if ndim(v_1) - 2 ≥ ndim(v_2) - 2 then ndim(v_1) - 2 - 1 else ndim(v_2) - 2 - 1] : ndim(v_1) - i - 3 < 0 ∨ ndim(v_2) - i - 3 < 0 ∨ shape(v_1, ndim(v_1) - i - 3) = 1 ∨ shape(v_2, ndim(v_2) - i - 3) = 1 ∨ shape(v_1, ndim(v_1) - i - 3) = shape(v_2, ndim(v_2) - i - 3)
>>
Rule 8 (upper flag must be boolean)
{v_3 : bool} |= v_3 = true ∨ v_3 = false
