>>
Rule 1 (input and other tensors must be broadcastable)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≤ ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i + (ndim(v_2) - ndim(v_1))) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i + (ndim(v_2) - ndim(v_1))) = 1 else ∀i ∈ [0, ndim(v_2) - 1] : shape(v_1, i + (ndim(v_1) - ndim(v_2))) = shape(v_2, i) ∨ shape(v_1, i + (ndim(v_1) - ndim(v_2))) = 1 ∨ shape(v_2, i) = 1
>>
Rule 2 (out tensor for tensor–tensor comparison must be bool and have the broadcasted shape)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= dtype_(v_3) = 0 ∧ if ndim(v_1) ≤ ndim(v_2) then ndim(v_3) = ndim(v_2) ∧ (if ndim(v_2) - ndim(v_1) > 0 then ∀k ∈ [0, ndim(v_2) - ndim(v_1) - 1] : shape(v_3, k) = shape(v_2, k)) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_3, i + (ndim(v_2) - ndim(v_1))) = shape(v_2, i + (ndim(v_2) - ndim(v_1))) ∨ shape(v_3, i + (ndim(v_2) - ndim(v_1))) = shape(v_1, i) else ndim(v_3) = ndim(v_1) ∧ (if ndim(v_1) - ndim(v_2) > 0 then ∀k ∈ [0, ndim(v_1) - ndim(v_2) - 1] : shape(v_3, k) = shape(v_1, k)) ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_3, i + (ndim(v_1) - ndim(v_2))) = shape(v_1, i + (ndim(v_1) - ndim(v_2))) ∨ shape(v_3, i + (ndim(v_1) - ndim(v_2))) = shape(v_2, i)
>>
Rule 5 (tensor–number comparison not implemented for complex input)
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 6 (tensor–tensor comparison not implemented for complex dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10
