>>
Rule 1 (input and other must be broadcastable)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)) ∨ (ndim(v_1) > ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - ndim(v_2) - 1] : shape(v_2, i) = 1 ∧ ∀j ∈ [0, ndim(v_2) - 1] : (shape(v_1, j + (ndim(v_1) - ndim(v_2))) = shape(v_2, j) ∨ shape(v_1, j + (ndim(v_1) - ndim(v_2))) = 1 ∨ shape(v_2, j) = 1)) ∨ (ndim(v_2) > ndim(v_1) ∧ ∀i ∈ [0, ndim(v_2) - ndim(v_1) - 1] : shape(v_1, i) = 1 ∧ ∀j ∈ [0, ndim(v_1) - 1] : (shape(v_2, j + (ndim(v_2) - ndim(v_1))) = shape(v_1, j) ∨ shape(v_2, j + (ndim(v_2) - ndim(v_1))) = 1 ∨ shape(v_1, j) = 1))
>>
Rule 2 (out shape matches the broadcasted shape when ranks are equal)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ndim(v_3) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : if shape(v_1, i) = shape(v_2, i) then shape(v_3, i) = shape(v_1, i) else if shape(v_1, i) = 1 then shape(v_3, i) = shape(v_2, i) else shape(v_2, i) = 1 ∧ shape(v_3, i) = shape(v_1, i)
>>
Rule 3 (out, if provided, must be a Tensor object)
{v_3 : tensor} |= ndim(v_3) ≥ 0
>>
Rule 4 (when input and other share the same dtype, out must use that dtype)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if dtype_(v_1) = dtype_(v_2) then dtype_(v_3) = dtype_(v_1)
>>
Rule 5 (when input and other dtypes differ, out must use one of them to avoid unsafe casts)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if dtype_(v_1) ≠ dtype_(v_2) then (dtype_(v_3) = dtype_(v_1) ∨ dtype_(v_3) = dtype_(v_2))
