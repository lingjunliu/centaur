Rule 1 (inputs must be 1D or 2D and have the same dimensionality)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 1 ∧ ndim(v_2) = 1) ∨ (ndim(v_1) = 2 ∧ ndim(v_2) = 2)
>>
Rule 2 (input1 and input2 must have identical shapes for subtraction)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 then shape(v_1, 0) = shape(v_2, 0) else if ndim(v_1) = 2 then shape(v_1, 0) = shape(v_2, 0) ∧ shape(v_1, 1) = shape(v_2, 1) else false
>>
Rule 3 (inputs must not be boolean tensors to allow subtraction)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 0 ∧ dtype_(v_2) ≠ 0
>>
Rule 4 (eps must be non-negative)
{v_1 : float} |= v_1 ≥ 0
>>
Rule 5 (if p is negative, eps must be strictly positive)
{v_1 : float, v_2 : float} |= if v_1 < 0 then v_2 > 0
>>
Rule 6 (keepdim must be a boolean flag)
{v_1 : bool} |= (v_1 = true) ∨ (v_1 = false)
