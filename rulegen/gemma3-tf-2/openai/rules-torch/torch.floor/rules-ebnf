>>
Rule 1 (input must not have boolean dtype)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 2 (input must not have complex dtype)
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 3 (out tensor, if provided, must have the same dtype as input to avoid dtype mismatch)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_2) = dtype_(v_1)
>>
Rule 4 (out tensor, if provided, must have the same shape as input)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 5 (input dtype must be integer or floating)
{v_1 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
