>>
Rule 1 (suppress ComplexDouble input: entr not implemented for complex128)
{v_1 : tensor} |= dtype_(v_1) ≠ 10
>>
Rule 2 (no complex inputs for numerical stability)
{v_1 : tensor} |= dtype_(v_1) ≤ 8
>>
Rule 3 (out tensor, if provided, must match input shape exactly)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 4 (out dtype coherence with input)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 8 then dtype_(v_2) = dtype_(v_1) else dtype_(v_2) ≥ 6 ∧ dtype_(v_2) ≤ 8
>>
Rule 5 (avoid ComplexDouble for out as well)
{v_2 : tensor} |= dtype_(v_2) ≠ 10
