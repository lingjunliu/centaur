>>
Rule 1 (input tensor must not be complex)
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 2 (other tensor must not be complex)
{v_2 : tensor} |= dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10
>>
Rule 3 (out, if provided, must be a tensor)
{v_3 : tensor} |= ndim(v_3) ≥ 0
>>
Rule 4 (tensor-tensor operands must be broadcastable)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) ≥ ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : if i < ndim(v_1) - ndim(v_2) then shape(v_1, i) = 1 else (shape(v_1, i) = shape(v_2, i - (ndim(v_1) - ndim(v_2))) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i - (ndim(v_1) - ndim(v_2))) = 1)) ∨ (ndim(v_2) ≥ ndim(v_1) ∧ ∀i ∈ [0, ndim(v_2) - 1] : if i < ndim(v_2) - ndim(v_1) then shape(v_2, i) = 1 else (shape(v_2, i) = shape(v_1, i - (ndim(v_2) - ndim(v_1))) ∨ shape(v_2, i) = 1 ∨ shape(v_1, i - (ndim(v_2) - ndim(v_1))) = 1))
>>
Rule 5 (out shape must equal the broadcasted shape of input and other)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= (ndim(v_1) ≥ ndim(v_2) ∧ ndim(v_3) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : if i < ndim(v_1) - ndim(v_2) then shape(v_3, i) = shape(v_1, i) else if shape(v_1, i) = 1 then shape(v_3, i) = shape(v_2, i - (ndim(v_1) - ndim(v_2))) else shape(v_3, i) = shape(v_1, i)) ∨ (ndim(v_2) ≥ ndim(v_1) ∧ ndim(v_3) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_2) - 1] : if i < ndim(v_2) - ndim(v_1) then shape(v_3, i) = shape(v_2, i) else if shape(v_2, i) = 1 then shape(v_3, i) = shape(v_1, i - (ndim(v_2) - ndim(v_1))) else shape(v_3, i) = shape(v_2, i))
>>
Rule 6 (out dtype must align with an operand dtype for tensor-tensor)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= dtype_(v_3) = dtype_(v_1) ∨ dtype_(v_3) = dtype_(v_2)
