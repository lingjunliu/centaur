Rule 7 (reduction must be a valid option)
{v_6 : str} |= v_6 = "none" ∨ v_6 = "mean" ∨ v_6 = "sum"
>>
Rule 8 (reduce = false implies no reduction)
{v_5 : bool, v_6 : str} |= if v_5 = false then v_6 = "none"
