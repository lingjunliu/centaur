>>
Rule 1 (input must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (num_groups must be positive)
{v_2 : int} |= v_2 > 0
>>
Rule 3 (channels divisible by num_groups and valid)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 2 ∧ shape(v_1, 1) > 0 ∧ v_2 ≥ 1 ∧ v_2 ≤ shape(v_1, 1) ∧ shape(v_1, 1) % v_2 = 0
>>
Rule 4 (weight must be a 1D vector matching the number of channels)
{v_1 : tensor, v_3 : tensor} |= ndim(v_3) = 1 ∧ shape(v_3, 0) = shape(v_1, 1)
>>
Rule 5 (bias must be a 1D vector matching the number of channels)
{v_1 : tensor, v_4 : tensor} |= ndim(v_4) = 1 ∧ shape(v_4, 0) = shape(v_1, 1)
>>
Rule 6 (weight and bias dtypes should match input dtype)
{v_1 : tensor, v_3 : tensor, v_4 : tensor} |= dtype_(v_1) = dtype_(v_3) ∧ dtype_(v_1) = dtype_(v_4)
>>
Rule 7 (epsilon must be positive)
{v_5 : float} |= v_5 > 0
