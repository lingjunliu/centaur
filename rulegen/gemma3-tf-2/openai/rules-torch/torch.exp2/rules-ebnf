>>
Rule 1 (input must be a Tensor to avoid TypeError)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 2 (when out is provided, its shape must exactly match input’s shape)
{v_1 : tensor, v_2 : tensor} |= ndim(v_2) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) = shape(v_1, i)
>>
Rule 3 (when out is provided, its dtype must match input’s dtype to avoid unsafe casts)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_2) = dtype_(v_1)
>>
Rule 4 (rank match implies both dtype and per-dimension shape must match; otherwise reject)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) = ndim(v_1) then (dtype_(v_2) = dtype_(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) = shape(v_1, i)) else false
