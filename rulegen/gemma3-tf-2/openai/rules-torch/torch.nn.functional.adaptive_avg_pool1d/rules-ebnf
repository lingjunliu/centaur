>>
Rule 1 (input must be 2D or 3D)
{v_1 : tensor} |= (ndim(v_1) = 2) ∨ (ndim(v_1) = 3)
>>
Rule 2 (input dtype must be floating-point or complex)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10
>>
Rule 3 (output_size as int must be non-negative)
{v_2 : int} |= v_2 ≥ 0
>>
Rule 4 (output_size as tuple must have exactly one element)
{v_2 : tuple(int)} |= v_2.len = 1
>>
Rule 5 (output_size tuple’s single element must be non-negative)
{v_2 : tuple(int)} |= v_2[0] ≥ 0
>>
Rule 6 (input tensor must have all positive shape dimensions)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 7 (limit total number of elements to avoid OOM and overflow)
{v_1 : tensor} |= if ndim(v_1) = 2 then shape(v_1, 0) * shape(v_1, 1) ≤ 100000000 else if ndim(v_1) = 3 then shape(v_1, 0) * shape(v_1, 1) * shape(v_1, 2) ≤ 100000000 else false
