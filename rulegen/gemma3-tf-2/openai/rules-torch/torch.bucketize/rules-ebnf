>>
Rule 1 (boundaries must be a 1-D tensor)
{v_2 : tensor} |= ndim(v_2) = 1
>>
Rule 2 (no complex dtypes for input and boundaries)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10
>>
Rule 3 (out dtype must match out_int32 flag)
{v_3 : bool, v_5 : tensor} |= if v_3 then dtype_(v_5) = 3 else dtype_(v_5) = 4
>>
Rule 4 (out tensor must have the same shape as input tensor)
{v_1 : tensor, v_5 : tensor} |= ndim(v_1) = ndim(v_5) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_5, i)
