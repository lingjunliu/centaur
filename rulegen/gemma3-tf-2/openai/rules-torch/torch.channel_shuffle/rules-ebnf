>>
Rule 1 (input tensor must have more than 2 dimensions)
{v_1 : tensor} |= ndim(v_1) > 2
>>
Rule 2 (groups must be positive)
{v_2 : int} |= v_2 > 0
>>
Rule 3 (channels dimension must be divisible by groups)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) > 2 then shape(v_1, ndim(v_1) - 3) % v_2 = 0
>>
Rule 4 (groups should not exceed the number of channels)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) > 2 then v_2 ≤ shape(v_1, ndim(v_1) - 3)
