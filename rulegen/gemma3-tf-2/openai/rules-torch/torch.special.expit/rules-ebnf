Rule 2 (out tensor must match the shape of input)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (if input is complex, out must also be complex)
{v_1 : tensor, v_2 : tensor} |= if ((dtype_(v_1) = 9) ∨ (dtype_(v_1) = 10)) then ((dtype_(v_2) = 9) ∨ (dtype_(v_2) = 10))
>>
Rule 4 (if input is floating, keep the same dtype in out)
{v_1 : tensor, v_2 : tensor} |= if ((dtype_(v_1) = 6) ∨ (dtype_(v_1) = 7) ∨ (dtype_(v_1) = 8)) then (dtype_(v_2) = dtype_(v_1))
>>
Rule 5 (input tensor may have any rank)
{v_1 : tensor} |= ndim(v_1) ≥ 0
