Rule 1 (Avoid Half overflow when filling)
{v_1 : tensor, v_2 : int ⊎ float} |= if dtype_(v_1) = 6 then -65504 ≤ v_2 ∧ v_2 ≤ 65504
>>
Rule 2 (Boolean tensors accept only 0 or 1 when filling with an integer)
{v_1 : tensor, v_2 : int} |= if dtype_(v_1) = 0 then v_2 = 0 ∨ v_2 = 1
>>
Rule 3 (Prevent int8 overflow when filling with an integer)
{v_1 : tensor, v_2 : int} |= if dtype_(v_1) = 1 then -128 ≤ v_2 ∧ v_2 ≤ 127
>>
Rule 4 (Prevent uint8 overflow when filling with an integer)
{v_1 : tensor, v_2 : int} |= if dtype_(v_1) = 5 then 0 ≤ v_2 ∧ v_2 ≤ 255
>>
Rule 5 (Tensor dimensions are non-negative)
{v_1 : tensor} |= if ndim(v_1) = 0 then true else ∀i ∈ [0, ndim(v_1) - 1] : 0 ≤ shape(v_1, i)
