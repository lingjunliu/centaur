Rule 6 (if both operands are real, out must be Float64)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if dtype_(v_1) ≤ 8 ∧ dtype_(v_2) ≤ 8 then dtype_(v_3) = 8
