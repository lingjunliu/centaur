Rule 1 (input must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 2 (number of sections must be positive when given as an integer)
{v_2 : int} |= v_2 > 0
>>
Rule 3 (even divisibility of the horizontal split dimension for integer sections)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then (shape(v_1, 0) % v_2) = 0 else (shape(v_1, 1) % v_2) = 0
>>
Rule 4 (tuple indices must be representable as 64-bit signed integers)
{v_2 : tuple(int)} |= (v_2.len = 0) ∧ (∀i ∈ [0, v_2.len - 1] : (-9223372036854775808 ≤ v_2[i]) ∧ (v_2[i] ≤ 9223372036854775807))
>>
Rule 5 (tuple indices are within valid range of the split dimension and nondecreasing)
{v_1 : tensor, v_2 : tuple(int)} |= if ndim(v_1) = 1 then ((∀i ∈ [0, v_2.len - 1] : (0 ≤ v_2[i]) ∧ (v_2[i] ≤ shape(v_1, 0))) ∧ (∀i ∈ [0, v_2.len - 2] : v_2[i] ≤ v_2[i + 1])) else ((∀i ∈ [0, v_2.len - 1] : (0 ≤ v_2[i]) ∧ (v_2[i] ≤ shape(v_1, 1))) ∧ (∀i ∈ [0, v_2.len - 2] : v_2[i] ≤ v_2[i + 1]))
>>
Rule 6 (list indices must be representable as 64-bit signed integers)
{v_2 : list(int)} |= (v_2.len = 0) ∧ (∀i ∈ [0, v_2.len - 1] : (-9223372036854775808 ≤ v_2[i]) ∧ (v_2[i] ≤ 9223372036854775807))
>>
Rule 7 (list indices are within valid range of the split dimension and nondecreasing)
{v_1 : tensor, v_2 : list(int)} |= if ndim(v_1) = 1 then ((∀i ∈ [0, v_2.len - 1] : (0 ≤ v_2[i]) ∧ (v_2[i] ≤ shape(v_1, 0))) ∧ (∀i ∈ [0, v_2.len - 2] : v_2[i] ≤ v_2[i + 1])) else ((∀i ∈ [0, v_2.len - 1] : (0 ≤ v_2[i]) ∧ (v_2[i] ≤ shape(v_1, 1))) ∧ (∀i ∈ [0, v_2.len - 2] : v_2[i] ≤ v_2[i + 1]))
