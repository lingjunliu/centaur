>>
Rule 1 (only floating dtypes; avoid complex not implemented)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)
>>
Rule 2 (inputs must be tensors; suppress non-Tensor TypeError)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 0 ∧ ndim(v_2) ≥ 0
>>
Rule 3 (input and other must be broadcastable to avoid size mismatch)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 4 (out tensor must have the same floating dtype as inputs)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ dtype_(v_3) = dtype_(v_1) ∧ dtype_(v_3) = dtype_(v_2)
>>
Rule 5 (out tensor shape must equal the broadcasted shape of input and other)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_3) = ndim(v_1) ∧ ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i) ∧ shape(v_3, i) = shape(v_1, i)) ∨ (shape(v_1, i) = 1 ∧ shape(v_3, i) = shape(v_2, i)) ∨ (shape(v_2, i) = 1 ∧ shape(v_3, i) = shape(v_1, i))
>>
Rule 6 (domain constraints: non-negative inputs and at least one strictly positive)
{v_1 : tensor, v_2 : tensor} |= min(v_1) ≥ 0 ∧ min(v_2) ≥ 0 ∧ (max(v_1) > 0 ∨ max(v_2) > 0)
>>
Rule 9 (inputs must have matching floating dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 12 (out tensor must be floating and match inputs' dtype)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= dtype_(v_3) = dtype_(v_1) ∧ dtype_(v_3) = dtype_(v_2) ∧ (dtype_(v_3) = 6 ∨ dtype_(v_3) = 7 ∨ dtype_(v_3) = 8)
