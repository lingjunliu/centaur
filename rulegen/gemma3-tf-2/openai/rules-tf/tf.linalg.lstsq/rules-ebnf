{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ (if ndim(v_1) > 2 then ∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) = shape(v_2, i))
