Rule 1 (inputs must be a 3-D tensor)
{v_1 : tensor} |= ndim(v_1) = 3
>>
Rule 2 (sequence_length must be rank-1 and its length must equal the batch size of inputs)
{v_1 : tensor, v_2 : tensor} |= ndim(v_2) = 1 ∧ shape(v_2, 0) = shape(v_1, 1)
>>
Rule 3 (beam_width must be at least 1)
{v_3 : int} |= v_3 ≥ 1
>>
Rule 4 (top_paths must be at least 1 and not exceed beam_width)
{v_3 : int, v_4 : int} |= v_4 ≥ 1 ∧ v_4 ≤ v_3
>>
Rule 5 (inputs dimensions must be positive)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 6 (inputs must be a 3-D tensor with positive dimensions)
{v_1 : tensor} |= ndim(v_1) = 3 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 10 (sequence_length length must be consistent with nonzero batch size)
{v_1 : tensor, v_2 : tensor} |= if shape(v_1, 1) > 0 then shape(v_2, 0) > 0
>>
Rule 11 (inputs must have at least one class)
{v_1 : tensor} |= shape(v_1, 2) ≥ 1
