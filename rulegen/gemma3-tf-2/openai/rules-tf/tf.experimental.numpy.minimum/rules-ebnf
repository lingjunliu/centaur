>>
Rule 1 (operands must have identical dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (dtypes must be real or integer; no bool, complex, or string)
{v_1 : tensor, v_2 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8 ∧ 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8
>>
Rule 3 (operands must be broadcastable in NumPy/TF sense)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) ≥ ndim(v_2) ∧ ∀k ∈ [0, ndim(v_1) - 1] : (shape(v_1, ndim(v_1) - 1 - k) = (if k < ndim(v_2) then shape(v_2, ndim(v_2) - 1 - k) else 1) ∨ shape(v_1, ndim(v_1) - 1 - k) = 1 ∨ (if k < ndim(v_2) then shape(v_2, ndim(v_2) - 1 - k) else 1) = 1)) ∨ (ndim(v_2) ≥ ndim(v_1) ∧ ∀k ∈ [0, ndim(v_2) - 1] : (shape(v_2, ndim(v_2) - 1 - k) = (if k < ndim(v_1) then shape(v_1, ndim(v_1) - 1 - k) else 1) ∨ shape(v_2, ndim(v_2) - 1 - k) = 1 ∨ (if k < ndim(v_1) then shape(v_1, ndim(v_1) - 1 - k) else 1) = 1))
>>
Rule 4 (exact same shape is a valid case)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 5 (scalar broadcasting is allowed)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 0 ∨ ndim(v_2) = 0
>>
Rule 6 (when ranks match, only dimensions greater than 1 must agree)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : if (shape(v_1, i) > 1 ∧ shape(v_2, i) > 1) then shape(v_1, i) = shape(v_2, i)
>>
Rule 7 (inputs must be broadcastable across aligned dimensions)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = (if (ndim(v_2) - ndim(v_1) + i) ≥ 0 then shape(v_2, ndim(v_2) - ndim(v_1) + i) else 1) ∨ shape(v_1, i) = 1 ∨ (if (ndim(v_2) - ndim(v_1) + i) ≥ 0 then shape(v_2, ndim(v_2) - ndim(v_1) + i) else 1) = 1) ∧ ∀i ∈ [0, ndim(v_2) - 1] : (shape(v_2, i) = (if (ndim(v_1) - ndim(v_2) + i) ≥ 0 then shape(v_1, ndim(v_1) - ndim(v_2) + i) else 1) ∨ shape(v_2, i) = 1 ∨ (if (ndim(v_1) - ndim(v_2) + i) ≥ 0 then shape(v_1, ndim(v_1) - ndim(v_2) + i) else 1) = 1)
>>
Rule 8 (unsupported dtypes are disallowed: str and np.dtype)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) ≠ 11 ∧ dtype_(v_1) ≠ 12) ∧ (dtype_(v_2) ≠ 11 ∧ dtype_(v_2) ≠ 12)
>>
Rule 9 (complex dtypes are not supported)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10) ∧ (dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10)
>>
Rule 10 (boolean tensors must be paired with boolean tensors)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 0 then dtype_(v_2) = 0 else if dtype_(v_2) = 0 then dtype_(v_1) = 0
>>
Rule 11 (if ranks are equal, each dimension must match or be 1 for broadcasting)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
>>
Rule 12 (dimension sizes must be non-negative)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0) ∧ (∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) ≥ 0)
