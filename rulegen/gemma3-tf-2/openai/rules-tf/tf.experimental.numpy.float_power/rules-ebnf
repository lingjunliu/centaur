>>
Rule 2 (broadcasting when ranks are equal: per-dimension equal or 1)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1
>>
Rule 3 (when v_1 has extra leading dims, they must be size 1 for broadcasting)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > ndim(v_2) then ∀i ∈ [0, ndim(v_1) - ndim(v_2) - 1] : shape(v_1, i) = 1
>>
Rule 4 (when v_2 has extra leading dims, they must be size 1 for broadcasting)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > ndim(v_1) then ∀i ∈ [0, ndim(v_2) - ndim(v_1) - 1] : shape(v_2, i) = 1
>>
Rule 6 (negative exponents require bases to be nonzero everywhere)
{v_1 : tensor, v_2 : tensor} |= if max(v_2) < 0 then min(v_1) > 0 ∨ max(v_1) < 0
>>
Rule 7 (single-dimension right-aligned broadcasting for v_2)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) = 1 then shape(v_2, 0) = 1 ∨ shape(v_1, ndim(v_1) - 1) = shape(v_2, 0) ∨ shape(v_1, ndim(v_1) - 1) = 1
>>
Rule 8 (inputs must be real numeric tensors: int or float dtypes 1–8)
{v_1: tensor, v_2: tensor} |= (1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8) ∧ (1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8)
>>
Rule 9 (complex dtypes are not supported)
{v_1: tensor, v_2: tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10
>>
Rule 11 (1D vector-by-vector case must be broadcastable)
{v_1: tensor, v_2: tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1
>>
Rule 13 (boolean and complex dtypes are not supported)
{v_1: tensor, v_2: tensor} |= dtype_(v_1) ≠ 0 ∧ dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_2) ≠ 0 ∧ dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10
>>
Rule 14 (either exactly equal shapes or one input is a scalar for broadcasting)
{v_1: tensor, v_2: tensor} |= (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)) ∨ ndim(v_1) = 0 ∨ ndim(v_2) = 0
>>
Rule 15 (last dimension must be broadcast-compatible when both are at least 1-D)
{v_1: tensor, v_2: tensor} |= if ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) ∨ shape(v_1, ndim(v_1) - 1) = 1 ∨ shape(v_2, ndim(v_2) - 1) = 1
>>
Rule 16 (allowed dtype pairings: integers and floats can mix, complexes disallowed)
{v_1: tensor, v_2: tensor} |= if 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5 then 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8 else if 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8 then 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8 else false
