>>
Rule 1 (input tensor rank is well-defined and non-negative)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 2 (each input tensor dimension size is non-negative)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 3 (min/max are only constrained for non-empty or scalar tensors)
{v_1 : tensor} |= if ndim(v_1) = 0 ∨ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 then min(v_1) ≤ max(v_1)
>>
Rule 4 (name is an arbitrary string)
{v_2 : str} |= v_2 = v_2
>>
Rule 5 (name does not constrain input properties)
{v_1 : tensor, v_2 : str} |= dtype_(v_1) = dtype_(v_1) ∧ v_2 = v_2
>>
Rule 6 (input tensor must have a well-defined, non-negative rank and dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 0 ∧ (ndim(v_1) = 0 ∨ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0)
>>
Rule 7 (name is an allowed string literal)
{v_1 : str} |= v_1 = "ii" ∨ v_1 = "ii->i" ∨ v_1 = "i,j->ij" ∨ v_1 = "bij,bjk->bik" ∨ v_1 = "...ij->...ji" ∨ v_1 = "bn,anm,bm->ba" ∨ v_1 = "none" ∨ v_1 = "sum" ∨ v_1 = "max" ∨ v_1 = "min" ∨ v_1 = "prod" ∨ v_1 = "relu" ∨ v_1 = "tanh" ∨ v_1 = "sigmoid" ∨ v_1 = "softmax" ∨ v_1 = "elu" ∨ v_1 = "selu" ∨ v_1 = "gelu" ∨ v_1 = "swish" ∨ v_1 = "softplus" ∨ v_1 = "linear" ∨ v_1 = "valid" ∨ v_1 = "same" ∨ v_1 = "causal" ∨ v_1 = "channels_last" ∨ v_1 = "channels_first"
>>
Rule 8 (rank-aware dimensional validity)
{v_1 : tensor} |= if ndim(v_1) = 0 then true else if ndim(v_1) = 1 then shape(v_1, 0) ≥ 0 else shape(v_1, 0) ≥ 0 ∧ shape(v_1, ndim(v_1) - 1) ≥ 0
>>
Rule 9 (dtype of input is a concrete value type)
{v_1 : tensor} |= dtype_(v_1) = dtype_(v_1)
>>
Rule 10 (optional name: when provided (not "none"), input dimensions must be valid)
{v_1 : tensor, v_2 : str} |= if v_2 = "none" then true else (ndim(v_1) ≥ 0 ∧ (ndim(v_1) = 0 ∨ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0))
