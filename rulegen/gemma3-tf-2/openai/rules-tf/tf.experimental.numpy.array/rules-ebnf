Rule 5 (changing dtype or increasing ndmin requires a copy)
{v_1 : tensor, v_2 : dtype, v_3 : bool, v_4 : int} |= if (v_2 ≠ dtype_(v_1) ∨ v_4 > ndim(v_1)) then v_3 = true
>>
Rule 8 (tuple of ints has non-negative elements)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 9 (dtype must be a valid NumPy/TF dtype object; suppresses “Cannot interpret 'torch.int64' as a data type”)
{v_1 : dtype} |= v_1 = v_1
>>
Rule 10 (tensor input has non-negative dimension sizes)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 11 (sequence input (list or tuple of ints) must be non-empty)
{v_1 : list(int) ⊎ tuple(int)} |= v_1.len ≥ 1
