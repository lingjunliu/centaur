>>
Rule 1 (input tensor must be 3D or 4D)
{v_1 : tensor} |= ndim(v_1) = 3 ∨ ndim(v_1) = 4
>>
Rule 2 (input tensor dimensions must be positive except batch dimension)
{v_1 : tensor} |= if ndim(v_1) = 3 then shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0 else shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0 ∧ shape(v_1, 3) > 0
>>
Rule 3 (padding as integer must be non-negative)
{v_1 : int} |= v_1 ≥ 0
>>
Rule 4 (padding tuple must have length 4)
{v_1 : tuple(int)} |= v_1.len = 4
>>
Rule 5 (padding tuple must be divisible by 2 in length)
{v_1 : tuple(int)} |= v_1.len % 2 = 0
>>
Rule 6 (padding tuple values must be non-negative)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 7 (padding as integer must be less than input height for 3D tensor)
{v_1 : int, v_2 : tensor} |= if ndim(v_2) = 3 then v_1 < shape(v_2, 1)
>>
Rule 8 (padding as integer must be less than input width for 3D tensor)
{v_1 : int, v_2 : tensor} |= if ndim(v_2) = 3 then v_1 < shape(v_2, 2)
>>
Rule 9 (padding as integer must be less than input height for 4D tensor)
{v_1 : int, v_2 : tensor} |= if ndim(v_2) = 4 then v_1 < shape(v_2, 2)
>>
Rule 10 (padding as integer must be less than input width for 4D tensor)
{v_1 : int, v_2 : tensor} |= if ndim(v_2) = 4 then v_1 < shape(v_2, 3)
>>
Rule 11 (padding tuple left and right must be less than input width for 3D tensor)
{v_1 : tuple(int), v_2 : tensor} |= if ndim(v_2) = 3 ∧ v_1.len = 4 then v_1[0] < shape(v_2, 2) ∧ v_1[1] < shape(v_2, 2)
>>
Rule 12 (padding tuple top and bottom must be less than input height for 3D tensor)
{v_1 : tuple(int), v_2 : tensor} |= if ndim(v_2) = 3 ∧ v_1.len = 4 then v_1[2] < shape(v_2, 1) ∧ v_1[3] < shape(v_2, 1)
>>
Rule 13 (padding tuple left and right must be less than input width for 4D tensor)
{v_1 : tuple(int), v_2 : tensor} |= if ndim(v_2) = 4 ∧ v_1.len = 4 then v_1[0] < shape(v_2, 3) ∧ v_1[1] < shape(v_2, 3)
>>
Rule 16 (input tensor dimensions must all be positive for 3D)
{v_1 : tensor} |= if ndim(v_1) = 3 then shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0
>>
Rule 17 (input tensor dimensions must all be positive for 4D)
{v_1 : tensor} |= if ndim(v_1) = 4 then shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0 ∧ shape(v_1, 3) > 0
>>
Rule 28 (padding tuple left and right must be less than width for 4D tensor)
{v_1 : tuple(int), v_2 : tensor} |= if ndim(v_2) = 4 ∧ v_1.len = 4 then v_1[0] < shape(v_2, 3)
>>
Rule 34 (output height must be positive for 3D tensor with integer padding)
{v_1 : int, v_2 : tensor} |= if ndim(v_2) = 3 then shape(v_2, 1) + 2 * v_1 > 0
>>
Rule 35 (output width must be positive for 3D tensor with integer padding)
{v_1 : int, v_2 : tensor} |= if ndim(v_2) = 3 then shape(v_2, 2) + 2 * v_1 > 0
>>
Rule 36 (output height must be positive for 4D tensor with integer padding)
{v_1 : int, v_2 : tensor} |= if ndim(v_2) = 4 then shape(v_2, 2) + 2 * v_1 > 0
>>
Rule 37 (output width must be positive for 4D tensor with integer padding)
{v_1 : int, v_2 : tensor} |= if ndim(v_2) = 4 then shape(v_2, 3) + 2 * v_1 > 0
>>
Rule 38 (output height must be positive for 3D tensor with tuple padding)
{v_1 : tuple(int), v_2 : tensor} |= if ndim(v_2) = 3 ∧ v_1.len = 4 then shape(v_2, 1) + v_1[2] + v_1[3] > 0
>>
Rule 39 (output width must be positive for 3D tensor with tuple padding)
{v_1 : tuple(int), v_2 : tensor} |= if ndim(v_2) = 3 ∧ v_1.len = 4 then shape(v_2, 2) + v_1[0] + v_1[1] > 0
>>
Rule 40 (output height must be positive for 4D tensor with tuple padding)
{v_1 : tuple(int), v_2 : tensor} |= if ndim(v_2) = 4 ∧ v_1.len = 4 then shape(v_2, 2) + v_1[2] + v_1[3] > 0
>>
Rule 41 (output width must be positive for 4D tensor with tuple padding)
{v_1 : tuple(int), v_2 : tensor} |= if ndim(v_2) = 4 ∧ v_1.len = 4 then shape(v_2, 3) + v_1[0] + v_1[1] > 0
