>>
Rule 1 (input and target shape must match)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2)
>>
Rule 3 (weight tensor should have the same shape as input or be broadcastable to it)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2) ∨ (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
>>
Rule 13 (check for positive weight value when it is a tensor)
{v_1 : tensor} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 14 (reduction option should not be empty string)
{v_1 : str} |= v_1 ≠ ""
>>
Rule 17 (ensure target and input tensor have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 18 (input tensor should not have zero dimensions)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 23 (input tensor must not be empty)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 24 (pos_weight tensor must be broadcastable to the target tensor)
{v_1 : tensor, v_2 : tensor} |= if v_1 ≠ None then (shape(v_1) = shape(v_2) ∨ (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1 ∨ shape(v_2, i) = 1))
>>
Rule 27 (if size_average is True, reduction must be mean)
{v_1 : bool, v_2 : str} |= if v_1 then v_2 = "mean"
>>
Rule 35 (pos_weight tensor must have non-negative values)
{v_1 : tensor} |= if v_1 != None then ∀i ∈ [0, v_1.len - 1] : v_1[i] >= 0
>>
Rule 38 (reduction string must be valid)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "mean" ∨ v_1 = "sum"
>>
Rule 40 (pos_weight tensor is broadcastable to target)
{v_1 : tensor, v_2 : tensor} |= if v_1 != None then (shape(v_1) = shape(v_2) ∨ (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1 ∨ shape(v_2, i) = 1))
>>
Rule 47 (pos_weight values must be non-negative)
{v_1 : tensor} |= if v_1 != None then ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 56 (pos_weight is broadcastable)
{v_1 : tensor, v_2 : tensor} |= if v_1 != None then ((shape(v_1) = shape(v_2)) ∨ (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)))
