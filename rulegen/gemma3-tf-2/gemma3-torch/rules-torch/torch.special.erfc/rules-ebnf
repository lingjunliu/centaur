Rule 4 (Input tensor shape - ensure at least one dimension)
{v_1 : tensor} |= ndim(v_1) > 0
>>
Rule 6 (Input tensor shape - at least a 2D tensor)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 7 (Input tensor shape - dimension 0 must be positive)
{v_1 : tensor} |= shape(v_1, 0) > 0
>>
Rule 8 (Input tensor shape - all dimensions must be positive)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 9 (Input tensor shape - combination of dimensions)
{v_1 : tensor, v_2 : int} |= shape(v_1, v_2) > 0
>>
Rule 10 (Input tensor shape - check dimension exists)
{v_1 : tensor, v_2 : int} |= v_2 < ndim(v_1)
