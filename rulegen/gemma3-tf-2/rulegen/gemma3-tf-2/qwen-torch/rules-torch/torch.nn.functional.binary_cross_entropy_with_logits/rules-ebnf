Rule 6 (input tensor should not be empty)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 8 (input tensor should not be zero)
{v_1 : tensor} |= ∀i ∈ [0, shape(v_1, 0) - 1] : v_1[i] ≠ 0
>>
Rule 9 (pos_weight must be tensor or None)
{v_1 : tensor, v_2 : tensor} |= v_1 ≠ None ∧ v_2 ≠ None
>>
Rule 13 (input tensor must not have negative values)
{v_1 : tensor} |= ∀i ∈ [0, shape(v_1, 0) - 1] : v_1[i] ≥ 0
>>
Rule 15 (input tensor must have same dimension as target)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
