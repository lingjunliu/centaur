Rule 1 (inputs must be tensors with at least 1 dimension)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0
>>
Rule 2 (for 1-D dot product both tensors must have same length)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 3 (for 2-D matrix multiplication inner dimensions must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then shape(v_1, 1) = shape(v_2, 0)
>>
Rule 4 (for N-D arrays last axis of first tensor matches second-to-last of second)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 2 ∧ ndim(v_2) > 2 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2)
>>
Rule 5 (when first is 1-D and second is 2-D dimensions must be compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 2 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 6 (when first is 2-D and second is 1-D dimensions must be compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 1 then shape(v_1, 1) = shape(v_2, 0)
>>
Rule 7 (tensors must have compatible dtypes for numeric operations)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≠ 11 ∧ dtype_(v_2) ≠ 11
>>
Rule 8 (both tensors cannot exceed reasonable dimensionality)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≤ 32 ∧ ndim(v_2) ≤ 32
>>
Rule 9 (all dimensions must be positive)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 10 (second tensor all dimensions must be positive)
{v_2 : tensor} |= ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0
>>
Rule 19 (for higher dimensional arrays last axis of first matches second-to-last of second)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 2 ∧ ndim(v_2) > 1 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2)
>>
Rule 21 (first tensor dtype must be numeric boolean or integer types)
{v_1 : tensor} |= dtype_(v_1) ≥ 0 ∧ dtype_(v_1) ≤ 5
>>
Rule 22 (second tensor should have floating point or complex dtype)
{v_2 : tensor} |= dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10
>>
Rule 23 (for scalar-like 1D tensors at least one dimension must be greater than 1)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then shape(v_1, 0) > 1 ∨ shape(v_2, 0) > 1
>>
Rule 24 (when both tensors are 2D the result dimensions are bounded)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then shape(v_1, 0) < 10000 ∧ shape(v_2, 1) < 10000
>>
Rule 25 (tensors must have at least one common numeric dtype category)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) < 11 ∧ dtype_(v_2) < 11
>>
Rule 26 (first tensor cannot be zero-dimensional scalar)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 27 (for 3D or higher first tensor batch dimensions are reasonable)
{v_1 : tensor} |= if ndim(v_1) ≥ 3 then ∀i ∈ [0, ndim(v_1) - 3] : shape(v_1, i) ≤ 1024
>>
Rule 28 (when second tensor is multidimensional its first dimension is positive)
{v_2 : tensor} |= if ndim(v_2) ≥ 2 then shape(v_2, 0) > 0
>>
Rule 29 (combined dimensionality of both tensors should be reasonable)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) + ndim(v_2) ≤ 16
>>
Rule 30 (at least one tensor should be 1D or 2D for basic operations)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≤ 2 ∨ ndim(v_2) ≤ 2
