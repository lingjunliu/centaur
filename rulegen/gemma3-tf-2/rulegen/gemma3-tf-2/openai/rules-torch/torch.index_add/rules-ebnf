Rule 1 (input and source must have the same scalar type)
{v_1 : tensor, v_4 : tensor} |= dtype_(v_1) = dtype_(v_4)
>>
Rule 2 (index tensor must be int32 or int64)
{v_3 : tensor} |= dtype_(v_3) = 3 ∨ dtype_(v_3) = 4
>>
Rule 3 (dim must be within the valid range for input)
{v_1 : tensor, v_2 : int} |= 0 - ndim(v_1) ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 4 (index tensor must be 1-D)
{v_3 : tensor} |= ndim(v_3) = 1
>>
Rule 5 (indices are within bounds of the selected dimension)
{v_1 : tensor, v_2 : int, v_3 : tensor} |= if v_2 ≥ 0 then min(v_3) ≥ 0 ∧ max(v_3) ≤ shape(v_1, v_2) - 1 else min(v_3) ≥ 0 ∧ max(v_3) ≤ shape(v_1, ndim(v_1) + v_2) - 1
>>
Rule 6 (source matches input on all non-indexed dimensions)
{v_1 : tensor, v_2 : int, v_4 : tensor} |= ndim(v_4) = ndim(v_1) ∧ if v_2 ≥ 0 then ∀i ∈ [0, ndim(v_1) - 1] : (i = v_2) ∨ (shape(v_4, i) = shape(v_1, i)) else ∀i ∈ [0, ndim(v_1) - 1] : (i = ndim(v_1) + v_2) ∨ (shape(v_4, i) = shape(v_1, i))
>>
Rule 7 (source’s size along dim equals the length of index)
{v_1 : tensor, v_2 : int, v_3 : tensor, v_4 : tensor} |= if v_2 ≥ 0 then shape(v_4, v_2) = shape(v_3, 0) else shape(v_4, ndim(v_1) + v_2) = shape(v_3, 0)
