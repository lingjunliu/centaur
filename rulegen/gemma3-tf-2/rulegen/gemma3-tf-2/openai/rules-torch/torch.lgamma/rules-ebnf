>>
Rule 1 (input tensor must have a real dtype; suppresses "not implemented for 'ComplexFloat'")
{v_1 : tensor} |= (dtype_(v_1) ≠ 9) ∧ (dtype_(v_1) ≠ 10)
>>
Rule 2 (out tensor, if provided, must have a floating dtype; suppresses "result type Float can't be cast to the desired output type Short")
{v_2 : tensor} |= (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)
>>
Rule 3 (out tensor, if provided, must match input shape element-wise)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = ndim(v_2)) ∧ (ndim(v_1) = 0 ∨ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 4 (for floating inputs, out dtype must match input dtype; avoids unsafe cast)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) then dtype_(v_2) = dtype_(v_1)
>>
Rule 5 (for integer inputs, choose a floating out dtype; suppresses cast-to-integer errors)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 5) then (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 6)
