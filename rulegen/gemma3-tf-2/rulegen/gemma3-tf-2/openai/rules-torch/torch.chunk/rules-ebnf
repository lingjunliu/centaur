{v_1 : tensor, v_2 : int, v_3 : int} |= v_2 > 0 ∧ (-1 * ndim(v_1) ≤ v_3 ∧ v_3 ≤ ndim(v_1) - 1) ∧ (if v_3 ≥ 0 then v_2 ≤ shape(v_1, v_3) else v_2 ≤ shape(v_1, v_3 + ndim(v_1)))
