>>
Rule 1 (input tensor must not be Char dtype to avoid CELU backend error)
{v_1 : tensor} |= dtype_(v_1) ≠ "Char"
>>
Rule 2 (alpha must be nonzero for CELU)
{v_2 : float} |= v_2 ≠ 0
>>
Rule 3 (tensor has valid non-negative dimensions)
{v_1 : tensor} |= if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 4 (in-place CELU requires a supported input dtype)
{v_1 : tensor, v_3 : bool} |= if v_3 then dtype_(v_1) ≠ "Char"
