>>
Rule 1 (input must be 3D or 4D tensor)
{v_1 : tensor} |= ndim(v_1) = 3 ∨ ndim(v_1) = 4
>>
Rule 2 (kernel_size as int must be positive)
{v_1 : int} |= v_1 > 0
>>
Rule 3 (kernel_size as tuple must have two positive ints)
{v_1 : tuple(int)} |= v_1.len = 2 ∧ ∀i ∈ [0, 1] : v_1[i] > 0
>>
Rule 6 (padding as int must be non-negative)
{v_1 : int} |= v_1 ≥ 0
>>
Rule 7 (padding as tuple must have two non-negative ints)
{v_1 : tuple(int)} |= v_1.len = 2 ∧ ∀i ∈ [0, 1] : v_1[i] ≥ 0
>>
Rule 8 (padding limited by kernel_size when both are ints)
{v_1 : int, v_2 : int} |= 2 * v_2 ≤ v_1 - 1
>>
Rule 9 (padding limited by kernel_size when both are 2-tuples)
{v_1 : tuple(int), v_2 : tuple(int)} |= v_1.len = 2 ∧ v_2.len = 2 ∧ ∀i ∈ [0, 1] : 2 * v_2[i] ≤ v_1[i] - 1
>>
Rule 10 (padding (tuple) limited by kernel_size (int))
{v_1 : int, v_2 : tuple(int)} |= v_2.len = 2 ∧ ∀i ∈ [0, 1] : 2 * v_2[i] ≤ v_1 - 1
>>
Rule 11 (padding (int) limited by kernel_size (tuple))
{v_1 : tuple(int), v_2 : int} |= v_1.len = 2 ∧ ∀i ∈ [0, 1] : 2 * v_2 ≤ v_1[i] - 1
>>
Rule 12 (valid spatial dimensions for input)
{v_1 : tensor} |= if ndim(v_1) = 3 then shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0
>>
Rule 13 (divisor_override, if provided as int, must be positive)
{v_1 : int} |= v_1 ≥ 1
>>
Rule 14 (tuple parameters are indexed only within [0, 1])
{v_1 : tuple(int)} |= v_1.len = 2 ∧ ∀i ∈ [0, 1] : 0 ≤ i ∧ i < v_1.len
