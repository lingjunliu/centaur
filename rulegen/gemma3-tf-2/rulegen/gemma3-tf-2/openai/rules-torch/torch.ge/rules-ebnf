Rule 1 (broadcasting compatibility between input and other tensors)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : ndim(v_1) - i - 1 < 0 ∨ ndim(v_2) - i - 1 < 0 ∨ shape(v_1, ndim(v_1) - i - 1) = 1 ∨ shape(v_2, ndim(v_2) - i - 1) = 1 ∨ shape(v_1, ndim(v_1) - i - 1) = shape(v_2, ndim(v_2) - i - 1)
>>
Rule 2 (out tensor must have boolean dtype)
{v_3 : tensor} |= dtype_(v_3) = 0
>>
Rule 3 (output shape equals input shape when other is a number)
{v_1 : tensor, v_3 : tensor} |= ndim(v_3) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = shape(v_1, i)
>>
Rule 4 (input tensor must not have complex dtype)
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 5 (other tensor must not have complex dtype)
{v_2 : tensor} |= dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10
