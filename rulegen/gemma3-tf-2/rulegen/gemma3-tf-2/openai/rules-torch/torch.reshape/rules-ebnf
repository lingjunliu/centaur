>>
Rule 4 (zero-sized input reshapes only to shapes containing 0 or -1)
{v_1 : tensor, v_2 : tuple(int)} |= if (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) then (∃j ∈ [0, v_2.len - 1] : (v_2[j] = 0 ∨ v_2[j] = -1))
>>
Rule 5 (no-op reshape when ranks match)
{v_1 : tensor, v_2 : tuple(int)} |= if v_2.len = ndim(v_1) then ∀i ∈ [0, v_2.len - 1] : v_2[i] = shape(v_1, i)
>>
Rule 10 (explicit 0 in target shape without inference implies zero-sized input)
{v_1 : tensor, v_2 : tuple(int)} |= if ((∃j ∈ [0, v_2.len - 1] : v_2[j] = 0) ∧ (∀m ∈ [0, v_2.len - 1] : v_2[m] ≠ -1)) then (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0)
>>
Rule 11 (reshaping to a scalar shape () only when input has exactly one element)
{v_1 : tensor, v_2 : tuple(int)} |= if (v_2.len = 0) then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1)
