Rule 1 (input must be 4D or 5D for 3D adaptive pooling)
{v_1 : tensor} |= ndim(v_1) = 4 ∨ ndim(v_1) = 5
>>
Rule 2 (uint8/Byte input dtype is not supported)
{v_1 : tensor} |= dtype_(v_1) ≠ 5
>>
Rule 6 (input dimension should be at least 2)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 8 (scalar output_size must be non-negative)
{v_2 : int} |= v_2 ≥ 0
>>
Rule 9 (tuple output_size must have length 3)
{v_2 : tuple(int)} |= v_2.len = 3
>>
Rule 10 (elements of tuple output_size must be non-negative)
{v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0
