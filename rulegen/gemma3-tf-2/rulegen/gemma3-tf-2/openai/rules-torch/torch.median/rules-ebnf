Rule 1 (input dtype must be numeric; median not implemented for bool)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 3 (the reduction dimension must have non-zero size)
{v_1 : tensor, v_2 : int} |= shape(v_1, (if v_2 ≥ 0 then v_2 else ndim(v_1) + v_2)) > 0
>>
Rule 4 (out must be a tuple of exactly two tensors)
{v_4 : tuple(tensor)} |= v_4.len = 2
>>
Rule 6 (global median (no dim) requires a non-empty input)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
