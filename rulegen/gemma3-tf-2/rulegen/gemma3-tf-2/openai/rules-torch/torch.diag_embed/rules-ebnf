>>
Rule 1 (input tensor must be at least 1-dimensional)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 2 (dim1 must be a valid output dimension index)
{v_1 : tensor, v_3 : int} |= -1 * (ndim(v_1) + 1) ≤ v_3 ∧ v_3 ≤ (ndim(v_1) + 1) - 1
>>
Rule 3 (dim2 must be a valid output dimension index)
{v_1 : tensor, v_4 : int} |= -1 * (ndim(v_1) + 1) ≤ v_4 ∧ v_4 ≤ (ndim(v_1) + 1) - 1
>>
Rule 4 (diagonal dimensions cannot be identical)
{v_3 : int, v_4 : int} |= v_3 ≠ v_4
>>
Rule 5 (output tensor rank equals input rank plus one)
{v_1 : tensor, v_5 : tensor} |= ndim(v_5) = ndim(v_1) + 1
>>
Rule 6 (for zero offset, the two diagonal dimensions of the output must be equal)
{v_2 : int, v_3 : int, v_4 : int, v_5 : tensor} |= if v_2 = 0 then shape(v_5, v_3) = shape(v_5, v_4)
>>
Rule 7 (each diagonal dimension of the output must be at least the size of the last input dimension)
{v_1 : tensor, v_3 : int, v_4 : int, v_5 : tensor} |= shape(v_5, v_3) ≥ shape(v_1, -1) ∧ shape(v_5, v_4) ≥ shape(v_1, -1)
