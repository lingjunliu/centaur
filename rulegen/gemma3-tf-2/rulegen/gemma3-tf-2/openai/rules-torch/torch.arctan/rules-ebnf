>>
Rule 1 (input tensor must not have boolean dtype)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 2 (out tensor must have the same shape as input)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (out dtype must be compatible with the arctan result to avoid casting errors)
{v_1 : tensor, v_2 : tensor} |= if 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8 then dtype_(v_2) = dtype_(v_1) else if 9 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 10 then dtype_(v_2) = dtype_(v_1) else dtype_(v_2) = 7
