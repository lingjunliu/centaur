>>
Rule 1 (margin must be within [-1, 1])
{v_1 : int ⊎ float} |= v_1 ≥ -1 ∧ v_1 ≤ 1
>>
Rule 2 (valid reduction modes)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "mean" ∨ v_1 = "sum"
>>
Rule 3 (target must be 0D or 1D)
{v_1 : tensor} |= ndim(v_1) = 0 ∨ ndim(v_1) = 1
>>
Rule 4 (1D target requires 2D inputs)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_3) = 1 then (ndim(v_1) = 2 ∧ ndim(v_2) = 2)
>>
Rule 5 (for batched inputs, batch sizes and embedding dims must match and be positive)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_3) = 1 then (shape(v_1, 0) = shape(v_2, 0) ∧ shape(v_1, 1) = shape(v_2, 1) ∧ shape(v_3, 0) = shape(v_1, 0) ∧ shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0)
>>
Rule 6 (for single-sample inputs, inputs must be 1D with same length and positive)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_3) = 0 then (ndim(v_1) = 1 ∧ ndim(v_2) = 1 ∧ shape(v_1, 0) = shape(v_2, 0) ∧ shape(v_1, 0) > 0)
>>
Rule 7 (inputs must share real floating dtype)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = dtype_(v_2)) ∧ (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 8 (when not reducing, enforce explicit 'none' reduction)
{v_1 : bool, v_2 : str} |= if v_1 = false then v_2 = "none"
