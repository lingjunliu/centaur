>>
Rule 1 (out tensor must have the same dtype as input to avoid dtype mismatch)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (out tensor must have the same shape as input)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then ndim(v_2) = 0 else ndim(v_2) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (input dtype must not be ComplexFloat to avoid unsupported dtype)
{v_1 : tensor} |= dtype_(v_1) ≠ 9
>>
Rule 4 (input must have at least one dimension for sorting along the first dim)
{v_1 : tensor} |= ndim(v_1) ≥ 1
