>>
Rule 1 (out dtype must match input to avoid dtype mismatch)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (out must have identical shape as input)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (scalar input requires scalar out)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then ndim(v_2) = 0
>>
Rule 4 (input tensor has a valid number of dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 0
