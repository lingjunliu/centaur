Rule 1 (output tensor must have the same shape as input when provided)
{v_1 : tensor, v_2 : tensor} |= ndim(v_2) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) = shape(v_1, i)
>>
Rule 3 (complex input requires the corresponding real floating output dtype)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 9 then dtype_(v_2) = 7 else if dtype_(v_1) = 10 then dtype_(v_2) = 8
>>
Rule 4 (real floating input preserves its dtype in the output)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 6 then dtype_(v_2) = 6 else if dtype_(v_1) = 7 then dtype_(v_2) = 7 else if dtype_(v_1) = 8 then dtype_(v_2) = 8
