>>
Rule 1 (both inputs must be at least 1D)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1
>>
Rule 2 (inputs must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (out must be a tensor, not a scalar/float)
{v_3 : tensor} |= ndim(v_3) ≥ 0
>>
Rule 4 (out dtype must match inputs’ dtype)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= dtype_(v_3) = dtype_(v_1) ∧ dtype_(v_3) = dtype_(v_2)
>>
Rule 5 (vector @ vector: lengths must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 6 (matrix @ matrix: inner dimensions must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then shape(v_1, 1) = shape(v_2, 0)
>>
Rule 7 (matrix @ vector: inner dimension must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 1 then shape(v_1, 1) = shape(v_2, 0)
>>
Rule 8 (vector @ matrix: inner dimension must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 2 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 9 (batched matmul: last two dims must align)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 3 ∧ ndim(v_2) ≥ 3 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2)
>>
Rule 10 (batched broadcasting when ndim(input) ≥ ndim(other))
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 3 ∧ ndim(v_2) ≥ 3 ∧ ndim(v_1) ≥ ndim(v_2) then ∀j ∈ [0, ndim(v_2) - 3] : shape(v_1, (ndim(v_1) - 3) - j) = shape(v_2, (ndim(v_2) - 3) - j) ∨ shape(v_1, (ndim(v_1) - 3) - j) = 1 ∨ shape(v_2, (ndim(v_2) - 3) - j) = 1
>>
Rule 11 (batched broadcasting when ndim(other) ≥ ndim(input))
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 3 ∧ ndim(v_2) ≥ 3 ∧ ndim(v_2) ≥ ndim(v_1) then ∀j ∈ [0, ndim(v_1) - 3] : shape(v_1, (ndim(v_1) - 3) - j) = shape(v_2, (ndim(v_2) - 3) - j) ∨ shape(v_1, (ndim(v_1) - 3) - j) = 1 ∨ shape(v_2, (ndim(v_2) - 3) - j) = 1
>>
Rule 12 (out shape for matrix @ matrix)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then ndim(v_3) = 2 ∧ shape(v_3, 0) = shape(v_1, 0) ∧ shape(v_3, 1) = shape(v_2, 1)
>>
Rule 13 (out shape for matrix @ vector)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 1 then ndim(v_3) = 1 ∧ shape(v_3, 0) = shape(v_1, 0)
>>
Rule 14 (out shape for vector @ matrix)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 2 then ndim(v_3) = 1 ∧ shape(v_3, 0) = shape(v_2, 1)
>>
Rule 15 (out’s last two dims for >=2D inputs)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2 then shape(v_3, ndim(v_3) - 2) = shape(v_1, ndim(v_1) - 2) ∧ shape(v_3, ndim(v_3) - 1) = shape(v_2, ndim(v_2) - 1)
