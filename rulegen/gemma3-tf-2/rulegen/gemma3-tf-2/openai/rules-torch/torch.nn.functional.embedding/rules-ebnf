Rule 5 (renormalization requires floating or complex weight dtype)
{v_2 : tensor, v_4 : float} |= if v_4 > 0 then (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)
>>
Rule 6 (padding_idx must be within num_embeddings)
{v_2 : tensor, v_3 : int} |= v_3 ≥ 0 ∧ v_3 < shape(v_2, 0)
>>
Rule 7 (embedding matrix has positive sizes)
{v_2 : tensor} |= ∀i ∈ [0, 1] : shape(v_2, i) ≥ 1
