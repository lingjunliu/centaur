>>
Rule 1 (margin must be strictly positive)
{margin : float} |= margin > 0
>>
Rule 2 (norm degree p must be at least 1)
{p : int} |= p ≥ 1
>>
Rule 3 (epsilon must be positive)
{eps : float} |= eps > 0
>>
Rule 4 (inputs must share the same floating-point dtype)
{anchor : tensor, positive : tensor, negative : tensor} |= dtype_(anchor) = dtype_(positive) ∧ dtype_(anchor) = dtype_(negative) ∧ (dtype_(anchor) = 6 ∨ dtype_(anchor) = 7 ∨ dtype_(anchor) = 8)
>>
Rule 5 (inputs must have the same number of dimensions and be 1D or 2D)
{anchor : tensor, positive : tensor, negative : tensor} |= ndim(anchor) = ndim(positive) ∧ ndim(positive) = ndim(negative) ∧ (ndim(anchor) = 1 ∨ ndim(anchor) = 2)
>>
Rule 6 (all shape dimensions must match across anchor, positive, and negative)
{anchor : tensor, positive : tensor, negative : tensor} |= ∀i ∈ [0, ndim(anchor) - 1] : shape(anchor, i) = shape(positive, i) ∧ shape(anchor, i) = shape(negative, i)
>>
Rule 7 (reduction must be a valid option)
{reduction : str} |= reduction = "none" ∨ reduction = "mean" ∨ reduction = "sum"
>>
Rule 8 (when reduce is false, reduction must be 'none')
{reduce : bool, reduction : str} |= if reduce = false then reduction = "none"
>>
Rule 9 (all input tensor dimensions must be positive)
{anchor : tensor, positive : tensor, negative : tensor} |= ∀i ∈ [0, ndim(anchor) - 1] : shape(anchor, i) > 0 ∧ ∀j ∈ [0, ndim(positive) - 1] : shape(positive, j) > 0 ∧ ∀k ∈ [0, ndim(negative) - 1] : shape(negative, k) > 0
