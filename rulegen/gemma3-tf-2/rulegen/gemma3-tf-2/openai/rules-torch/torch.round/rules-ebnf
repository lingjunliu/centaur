Rule 1 (output tensor dtype must match input tensor dtype; avoids dtype mismatch errors)
{v_1 : tensor, v_3 : tensor} |= dtype_(v_1) = dtype_(v_3)
>>
Rule 2 (output tensor must have same number of dimensions as input)
{v_1 : tensor, v_3 : tensor} |= ndim(v_3) = ndim(v_1)
>>
Rule 3 (output tensor shape must match input tensor shape)
{v_1 : tensor, v_3 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = shape(v_1, i)
>>
Rule 4 (out must be a Tensor to avoid TypeError)
{v_3 : tensor} |= ndim(v_3) ≥ 0
>>
Rule 5 (use default rounding granularity to avoid unsupported integer kernels)
{v_2 : int} |= v_2 = 0
>>
Rule 6 (reasonable decimals range to mitigate overflow on low-precision dtypes)
{v_2 : int} |= (-20 ≤ v_2) ∧ (v_2 ≤ 20)
