Rule 1 (valid dim index for the given input tensor to avoid IndexError)
{v_1 : int, v_2 : tensor} |= (0 - ndim(v_2)) ≤ v_1 ∧ v_1 < ndim(v_2)
>>
Rule 2 (selected axis length must be positive)
{v_1 : int, v_2 : tensor} |= if v_1 ≥ 0 then shape(v_2, v_1) > 0 else shape(v_2, ndim(v_2) + v_1) > 0
>>
Rule 3 (input must be floating-point to avoid unsupported 'Char' dtype)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 4 (input must be at least 1D so a dim exists)
{v_1 : tensor} |= ndim(v_1) ≥ 1
