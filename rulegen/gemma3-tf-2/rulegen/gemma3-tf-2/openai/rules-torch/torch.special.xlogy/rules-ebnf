>>
Rule 1 (broadcastability between input and other tensors)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) + ndim(v_2) - 1] : (if i < ndim(v_1) then shape(v_1, ndim(v_1) - 1 - i) else 1) = (if i < ndim(v_2) then shape(v_2, ndim(v_2) - 1 - i) else 1) ∨ (if i < ndim(v_1) then shape(v_1, ndim(v_1) - 1 - i) else 1) = 1 ∨ (if i < ndim(v_2) then shape(v_2, ndim(v_2) - 1 - i) else 1) = 1
>>
Rule 2 (out shape equals broadcasted shape of input and other)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_3) ≥ ndim(v_1) ∧ ndim(v_3) ≥ ndim(v_2) ∧ ∀i ∈ [0, ndim(v_3) - 1] : if (if i < ndim(v_3) - ndim(v_1) then 1 else shape(v_1, i - (ndim(v_3) - ndim(v_1)))) = 1 then shape(v_3, i) = (if i < ndim(v_3) - ndim(v_2) then 1 else shape(v_2, i - (ndim(v_3) - ndim(v_2)))) else if (if i < ndim(v_3) - ndim(v_2) then 1 else shape(v_2, i - (ndim(v_3) - ndim(v_2)))) = 1 then shape(v_3, i) = (if i < ndim(v_3) - ndim(v_1) then 1 else shape(v_1, i - (ndim(v_3) - ndim(v_1)))) else shape(v_3, i) = (if i < ndim(v_3) - ndim(v_1) then 1 else shape(v_1, i - (ndim(v_3) - ndim(v_1)))) ∧ (if i < ndim(v_3) - ndim(v_2) then 1 else shape(v_2, i - (ndim(v_3) - ndim(v_2)))) = (if i < ndim(v_3) - ndim(v_1) then 1 else shape(v_1, i - (ndim(v_3) - ndim(v_1))))
>>
Rule 3 (out must be complex when any input is complex)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if dtype_(v_1) = 10 ∨ dtype_(v_2) = 10 then dtype_(v_3) = 10 else if dtype_(v_1) = 9 ∨ dtype_(v_2) = 9 then dtype_(v_3) = 9 ∨ dtype_(v_3) = 10
>>
Rule 4 (out must be floating or complex for real/integer inputs)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if ((dtype_(v_1) ≤ 5 ∧ dtype_(v_2) ≤ 5) ∨ (6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8) ∨ (6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8)) then 6 ≤ dtype_(v_3) ∧ dtype_(v_3) ≤ 10
