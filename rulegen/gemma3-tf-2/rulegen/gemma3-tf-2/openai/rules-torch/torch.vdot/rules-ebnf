>>
Rule 1 (both input and other must be 1D vectors)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = 1 ∧ ndim(v_2) = 1
>>
Rule 2 (input and other must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (out tensor, if provided, must be a scalar)
{v_3 : tensor} |= ndim(v_3) = 0
>>
Rule 4 (out dtype must match the computation/input dtype)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= dtype_(v_1) = dtype_(v_2) ∧ dtype_(v_3) = dtype_(v_1)
>>
Rule 5 (when both are 1D, vector lengths must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 1 ∧ ndim(v_2) = 1 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 8 (vectors must have the same number of elements)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) = shape(v_2, 0)
