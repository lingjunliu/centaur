>>
Rule 1 (both tensors must have the same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 2 (corresponding dimensions must match for all axes)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (tensors must share the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 4 (scalars must be compared with scalars; otherwise require full shape match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then ndim(v_2) = 0 else (ndim(v_2) ≥ 1 ∧ ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 5 (no broadcasting: ranks and all axis lengths must match for non-scalars)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1 then (ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 6 (scalar tensors must be compared with scalars)
{v_1 : tensor, v_2 : tensor} |= (if ndim(v_1) = 0 then ndim(v_2) = 0) ∧ (if ndim(v_2) = 0 then ndim(v_1) = 0)
>>
Rule 8 (when ranks match, the first and last dimensions must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) ∧ ndim(v_1) ≥ 1 then (shape(v_1, 0) = shape(v_2, 0) ∧ shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1))
