Rule 1 (input must be 2D or 3D for ReplicationPad1d)
{v_1 : tensor} |= ndim(v_1) = 2 ∨ ndim(v_1) = 3
>>
Rule 2 (non-batch dimensions must be positive; batch may be zero)
{v_1 : tensor} |= (ndim(v_1) = 2 ∧ shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0) ∨ (ndim(v_1) = 3 ∧ shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0 ∧ shape(v_1, 0) ≥ 0)
>>
Rule 3 (boolean dtype is not supported by replication_pad1d)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 4 (integer padding must be non-negative)
{v_1 : int} |= v_1 ≥ 0
>>
Rule 5 (tuple padding must be length-2 with non-negative integers)
{v_1 : tuple(int)} |= v_1.len = 2 ∧ ∀i ∈ [0, v_1.len - 1] : v_1[i] ≥ 0
>>
Rule 6 (tuple padding length must be divisible by 2)
{v_1 : tuple(int)} |= v_1.len % 2 = 0
>>
Rule 7 (output width must be positive for integer padding)
{v_1 : int, v_2 : tensor} |= (if ndim(v_2) = 2 then shape(v_2, 1) else shape(v_2, 2)) + 2 * v_1 > 0
>>
Rule 8 (output width must be positive for tuple padding)
{v_1 : tuple(int), v_2 : tensor} |= v_1.len = 2 ∧ (if ndim(v_2) = 2 then shape(v_2, 1) else shape(v_2, 2)) + v_1[0] + v_1[1] > 0
>>
Rule 9 (tuple padding length must not exceed twice the input dimension)
{v_1 : tuple(int), v_2 : tensor} |= v_1.len ≤ 2 * ndim(v_2)
>>
Rule 10 (cap output width for integer padding to avoid excessive memory)
{v_1 : int, v_2 : tensor} |= (if ndim(v_2) = 2 then shape(v_2, 1) else shape(v_2, 2)) + 2 * v_1 ≤ 100000000
>>
Rule 11 (cap total element count for tuple padding to avoid overflow)
{v_1 : tuple(int), v_2 : tensor} |= v_1.len = 2 ∧ (if ndim(v_2) = 2 then shape(v_2, 0) * (shape(v_2, 1) + v_1[0] + v_1[1]) else shape(v_2, 0) * shape(v_2, 1) * (shape(v_2, 2) + v_1[0] + v_1[1])) ≤ 100000000
