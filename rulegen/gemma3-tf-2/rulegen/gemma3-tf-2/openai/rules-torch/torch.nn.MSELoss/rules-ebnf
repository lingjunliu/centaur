Rule 1 (input and target must have identical shapes)
{v_4 : tensor, v_5 : tensor} |= ndim(v_4) = ndim(v_5) ∧ if ndim(v_4) > 0 then ∀i ∈ [0, ndim(v_4) - 1] : shape(v_4, i) = shape(v_5, i)
>>
Rule 2 (input and target dtypes must be floating and equal)
{v_4 : tensor, v_5 : tensor} |= 6 ≤ dtype_(v_4) ∧ dtype_(v_4) ≤ 8 ∧ dtype_(v_5) = dtype_(v_4)
>>
Rule 3 (reduction must be a valid option)
{v_3 : str} |= (v_3 = "none") ∨ (v_3 = "mean") ∨ (v_3 = "sum")
>>
Rule 4 (when reduce is False, no reduction should be applied)
{v_2 : bool, v_3 : str} |= if v_2 = false then v_3 = "none"
>>
Rule 5 (when reduce is True, size_average selects mean or sum)
{v_1 : bool, v_2 : bool, v_3 : str} |= if v_2 = true then if v_1 = true then v_3 = "mean" else v_3 = "sum"
