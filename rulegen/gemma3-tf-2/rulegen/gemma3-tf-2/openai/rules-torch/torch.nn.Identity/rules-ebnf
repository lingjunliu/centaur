>>
Rule 1 (any single constructor argument is accepted)
{v_1 : tensor ⊎ int ⊎ float ⊎ bool ⊎ dtype ⊎ str ⊎ list(int) ⊎ tuple(float)} |= v_1 = v_1
>>
Rule 2 (numeric constructor arguments are unrestricted; addition is commutative)
{v_1 : int ⊎ float, v_2 : int ⊎ float} |= v_1 + v_2 = v_2 + v_1
>>
Rule 3 (list-typed constructor argument is accepted as-is)
{v_1 : list(dtype)} |= v_1 = v_1
>>
Rule 4 (tuple-typed constructor argument is accepted; safe to access element if non-empty)
{v_1 : tuple(int)} |= if v_1.len ≥ 1 then v_1[0] = v_1[0]
>>
Rule 5 (dtype constructor argument is accepted)
{v_1 : dtype} |= v_1 = v_1
>>
Rule 6 (boolean constructor argument is accepted regardless of value)
{v_1 : bool} |= if v_1 then true
>>
Rule 7 (string constructor argument is accepted)
{v_1 : str} |= v_1 = v_1
>>
Rule 8 (input tensor can have any rank)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 9 (each input tensor dimension size is non-negative)
{v_1 : tensor} |= if ndim(v_1) = 0 then true else ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 10 (input tensor dtype is unrestricted)
{v_1 : tensor} |= dtype_(v_1) = dtype_(v_1)
