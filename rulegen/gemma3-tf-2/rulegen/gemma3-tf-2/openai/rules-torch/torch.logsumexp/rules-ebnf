>>
Rule 3 (tuple dims must be unique to avoid duplicate-dim RuntimeError)
{v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : ∀j ∈ [0, v_2.len - 1] : if i ≠ j then v_2[i] ≠ v_2[j]
>>
Rule 5 (when out is used with tuple dim, out must be a tensor with rank consistent with keepdim to avoid TypeError)
{v_1 : tensor, v_2 : tuple(int), v_3 : bool, v_4 : tensor} |= (v_3 = true ∧ ndim(v_4) = ndim(v_1)) ∨ (v_3 = false ∧ ndim(v_4) = ndim(v_1) - v_2.len)
>>
Rule 6 (out tensor dtype must match input tensor dtype to avoid result-type RuntimeError)
{v_1 : tensor, v_4 : tensor} |= dtype_(v_4) = dtype_(v_1)
>>
Rule 7 (if keepdim is true with integer dim, the reduced dimension in out must be size 1)
{v_1 : tensor, v_2 : int, v_3 : bool, v_4 : tensor} |= if v_3 = true then ((v_2 ≥ 0 ∧ shape(v_4, v_2) = 1) ∨ (v_2 < 0 ∧ shape(v_4, v_2 + ndim(v_1)) = 1))
>>
Rule 8 (if keepdim is true with tuple dim, all reduced dimensions in out must be size 1)
{v_1 : tensor, v_2 : tuple(int), v_3 : bool, v_4 : tensor} |= ∀i ∈ [0, v_2.len - 1] : if v_3 = true then ((v_2[i] ≥ 0 ∧ shape(v_4, v_2[i]) = 1) ∨ (v_2[i] < 0 ∧ shape(v_4, v_2[i] + ndim(v_1)) = 1))
