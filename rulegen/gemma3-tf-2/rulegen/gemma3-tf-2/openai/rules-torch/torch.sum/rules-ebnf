Rule 1 (single integer dim must be in valid range to avoid IndexError)
{v_1 : tensor, v_2 : int} |= (v_2 ≥ 0 ∧ v_2 ≤ ndim(v_1) - 1) ∨ (v_2 < 0 ∧ v_2 ≥ 0 - ndim(v_1))
>>
Rule 2 (each tuple dim must be in valid range to avoid IndexError)
{v_1 : tensor, v_2 : tuple(int)} |= if v_2.len = 0 then true else ∀k ∈ [0, v_2.len - 1] : ( (v_2[k] ≥ 0 ∧ v_2[k] ≤ ndim(v_1) - 1) ∨ (v_2[k] < 0 ∧ v_2[k] ≥ 0 - ndim(v_1)) )
>>
Rule 3 (no repeated dims after negative-index normalization to avoid RuntimeError)
{v_1 : tensor, v_2 : tuple(int)} |= if v_2.len ≥ 2 then ∀i ∈ [0, v_2.len - 1] : ∀j ∈ [i + 1, v_2.len - 1] : if v_2[i] ≥ 0 then if v_2[j] ≥ 0 then v_2[i] ≠ v_2[j] else v_2[i] ≠ ndim(v_1) + v_2[j] else if v_2[j] ≥ 0 then ndim(v_1) + v_2[i] ≠ v_2[j] else ndim(v_1) + v_2[i] ≠ ndim(v_1) + v_2[j]
>>
Rule 4 (number of reduction dims must not exceed input rank)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len ≤ ndim(v_1)
>>
Rule 6 (keepdim must be a boolean flag)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
