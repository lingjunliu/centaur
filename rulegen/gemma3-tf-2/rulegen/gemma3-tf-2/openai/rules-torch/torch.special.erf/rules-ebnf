>>
Rule 1 (input must not be ComplexDouble to avoid unimplemented kernel)
{v_1 : tensor} |= dtype_(v_1) ≠ 10
>>
Rule 2 (out tensor, if provided, must have the same dtype as input)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (when input is ComplexDouble, out must not be Bool to avoid invalid cast)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 10 then dtype_(v_2) ≠ 0
>>
Rule 4 (out tensor, if provided, must have the same shape as input)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
