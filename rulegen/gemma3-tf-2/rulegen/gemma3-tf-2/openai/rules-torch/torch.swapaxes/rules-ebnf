Rule 1 (axes must be within valid range for input dimensions)
{v_1 : tensor, v_2 : int, v_3 : int} |= ndim(v_1) ≥ 1 ∧ (0 - ndim(v_1)) ≤ v_2 ∧ v_2 < ndim(v_1) ∧ (0 - ndim(v_1)) ≤ v_3 ∧ v_3 < ndim(v_1)
>>
Rule 3 (1D input: only -1 or 0 are valid axes)
{v_1 : tensor, v_2 : int, v_3 : int} |= ndim(v_1) = 1 ∧ ((v_2 = 0 ∨ v_2 = 0 - 1) ∧ (v_3 = 0 ∨ v_3 = 0 - 1))
>>
Rule 4 (equal axes are allowed; otherwise axes must be valid)
{v_1 : tensor, v_2 : int, v_3 : int} |= ndim(v_1) ≥ 1 ∧ if v_2 = v_3 then true else ((0 - ndim(v_1)) ≤ v_2 ∧ v_2 < ndim(v_1) ∧ (0 - ndim(v_1)) ≤ v_3 ∧ v_3 < ndim(v_1))
