Rule 1 (input must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (input must be non-empty across all dimensions)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 3 (lengths tensor must be a 1D vector)
{v_2 : tensor} |= ndim(v_2) = 1
>>
Rule 4 (lengths tensor dtype must be int64)
{v_2 : tensor} |= dtype_(v_2) = 4
>>
Rule 5 (each length in lengths tensor is strictly positive)
{v_2 : tensor} |= min(v_2) > 0
>>
Rule 6 (each length in lengths list is strictly positive)
{v_2 : list(int)} |= ∀i ∈ [0, v_2.len - 1] : v_2[i] > 0
>>
Rule 7 (tensor lengths count must equal batch size)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 then shape(v_2, 0) = shape(v_1, 0) else shape(v_2, 0) = shape(v_1, 1)
>>
Rule 8 (list lengths count must equal batch size)
{v_1 : tensor, v_2 : list(int), v_3 : bool} |= if v_3 then v_2.len = shape(v_1, 0) else v_2.len = shape(v_1, 1)
>>
Rule 9 (tensor lengths must not exceed the time dimension)
{v_1 : tensor, v_2 : tensor, v_3 : bool} |= if v_3 then max(v_2) ≤ shape(v_1, 1) else max(v_2) ≤ shape(v_1, 0)
>>
Rule 10 (list lengths must not exceed the time dimension)
{v_1 : tensor, v_2 : list(int), v_3 : bool} |= if v_3 then ∀i ∈ [0, v_2.len - 1] : v_2[i] ≤ shape(v_1, 1) else ∀i ∈ [0, v_2.len - 1] : v_2[i] ≤ shape(v_1, 0)
>>
Rule 11 (when enforce_sorted is True, list lengths must be non-increasing)
{v_2 : list(int), v_4 : bool} |= if v_4 then ∀i ∈ [0, v_2.len - 2] : v_2[i] ≥ v_2[i + 1]
>>
Rule 12 (unified bound on lengths for either tensor or list)
{v_1 : tensor, v_2 : tensor ⊎ list(int), v_3 : bool} |= if v_3 then ((ndim(v_2) = 1 ∧ max(v_2) ≤ shape(v_1, 1)) ∨ (∀i ∈ [0, v_2.len - 1] : v_2[i] ≤ shape(v_1, 1))) else ((ndim(v_2) = 1 ∧ max(v_2) ≤ shape(v_1, 0)) ∨ (∀i ∈ [0, v_2.len - 1] : v_2[i] ≤ shape(v_1, 0)))
