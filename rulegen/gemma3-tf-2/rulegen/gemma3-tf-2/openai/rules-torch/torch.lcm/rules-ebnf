>>
Rule 1 (inputs must be integer tensors)
{v_1 : tensor, v_2 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5 ∧ 1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5
>>
Rule 2 (dimension 0 must be broadcast-compatible)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1 ∧ (shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1)
>>
Rule 3 (all dimensions are broadcastable when ranks match)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : (shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
>>
Rule 4 (out must be a tensor argument, not a float)
{v_3 : tensor} |= ndim(v_3) ≥ 0
>>
Rule 5 (out dtype equals the promoted integer dtype of inputs)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= (1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5) ∧ (1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5) ∧ (1 ≤ dtype_(v_3) ∧ dtype_(v_3) ≤ 5) ∧ (if dtype_(v_1) ≥ dtype_(v_2) then dtype_(v_3) = dtype_(v_1) else dtype_(v_3) = dtype_(v_2))
>>
Rule 6 (out shape matches the broadcasted shape when ranks match)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ndim(v_3) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : if shape(v_1, i) = 1 then shape(v_3, i) = shape(v_2, i) else if shape(v_2, i) = 1 then shape(v_3, i) = shape(v_1, i) else shape(v_3, i) = shape(v_1, i) ∧ shape(v_1, i) = shape(v_2, i)
>>
Rule 7 (no complex or Half dtypes for inputs/outputs)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_2) ≠ 9 ∧ dtype_(v_2) ≠ 10 ∧ dtype_(v_3) ≠ 9 ∧ dtype_(v_3) ≠ 10 ∧ dtype_(v_1) ≠ 6 ∧ dtype_(v_2) ≠ 6 ∧ dtype_(v_3) ≠ 6
