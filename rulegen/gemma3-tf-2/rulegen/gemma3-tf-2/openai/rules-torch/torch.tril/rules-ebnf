>>
Rule 1 (input must be at least 2-D)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (out tensor must have the same dtype as input)
{v_1 : tensor, v_3 : tensor} |= dtype_(v_1) = dtype_(v_3)
>>
Rule 3 (out tensor must match input shape)
{v_1 : tensor, v_3 : tensor} |= ndim(v_1) = ndim(v_3) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_3, i)
>>
Rule 4 (diagonal index is bounded by the matrix dimensions)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) ≥ 2 then ((0 - shape(v_1, ndim(v_1) - 2)) ≤ v_2 ∧ v_2 ≤ shape(v_1, ndim(v_1) - 2) - 1 ∧ (0 - shape(v_1, ndim(v_1) - 1)) ≤ v_2 ∧ v_2 ≤ shape(v_1, ndim(v_1) - 1) - 1)
