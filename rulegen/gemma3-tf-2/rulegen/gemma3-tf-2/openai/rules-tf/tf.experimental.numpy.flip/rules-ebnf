>>
Rule 1 (input tensor must be at least 1-dimensional)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 3 (single-axis constraint for 1D inputs)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then (v_2 = 0 ∨ v_2 = -1)
>>
Rule 4 (tuple axis length is valid)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len > 0 ∧ v_2.len ≤ ndim(v_1)
>>
Rule 6 (tuple axis indices are unique after normalization)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : ∀j ∈ [i + 1, v_2.len - 1] : if v_2[i] < 0 then (if v_2[j] < 0 then v_2[i] ≠ v_2[j] else v_2[i] + ndim(v_1) ≠ v_2[j]) else (if v_2[j] < 0 then v_2[i] ≠ v_2[j] + ndim(v_1) else v_2[i] ≠ v_2[j])
>>
Rule 7 (integer axis must be within valid range for the input tensor)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 1 ∧ 0 - ndim(v_1) ≤ v_2 ∧ v_2 ≤ ndim(v_1) - 1
>>
Rule 8 (each axis in a tuple must be within valid range)
{v_1 : tensor, v_2 : tuple(int)} |= if v_2.len = 0 then true else ∀ i ∈ [0, v_2.len - 1] : 0 - ndim(v_1) ≤ v_2[i] ∧ v_2[i] ≤ ndim(v_1) - 1
>>
Rule 9 (axes in the tuple must be unique after normalization)
{v_1 : tensor, v_2 : tuple(int)} |= if v_2.len ≤ 1 then true else ∀ i ∈ [0, v_2.len - 2] : ∀ j ∈ [i + 1, v_2.len - 1] : (if v_2[i] < 0 then v_2[i] + ndim(v_1) else v_2[i]) ≠ (if v_2[j] < 0 then v_2[j] + ndim(v_1) else v_2[j])
>>
Rule 10 (scalar input only permits an empty tuple of axes)
{v_1 : tensor, v_2 : tuple(int)} |= if ndim(v_1) = 0 then v_2.len = 0
