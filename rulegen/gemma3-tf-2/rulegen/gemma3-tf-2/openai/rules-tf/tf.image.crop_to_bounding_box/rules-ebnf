>>
Rule 1 (image must be 3-D or 4-D)
{v_1 : tensor} |= ndim(v_1) = 3 ∨ ndim(v_1) = 4
>>
Rule 2 (inner 3 dims must be > 0)
{v_1 : tensor} |= if ndim(v_1) = 4 then ∀i ∈ [1, 3] : shape(v_1, i) > 0 else if ndim(v_1) = 3 then ∀j ∈ [0, 2] : shape(v_1, j) > 0 else false
>>
Rule 3 (offset_height must be non-negative)
{v_2 : int} |= v_2 ≥ 0
>>
Rule 4 (offset_width must be non-negative)
{v_3 : int} |= v_3 ≥ 0
>>
Rule 5 (target_height must be positive)
{v_4 : int} |= v_4 > 0
>>
Rule 6 (target_width must be positive)
{v_5 : int} |= v_5 > 0
>>
Rule 7 (image width must accommodate offset_width + target_width)
{v_1 : tensor, v_3 : int, v_5 : int} |= if ndim(v_1) = 3 then shape(v_1, 1) ≥ v_3 + v_5 else if ndim(v_1) = 4 then shape(v_1, 2) ≥ v_3 + v_5 else false
>>
Rule 8 (image height must accommodate offset_height + target_height)
{v_1 : tensor, v_2 : int, v_4 : int} |= if ndim(v_1) = 3 then shape(v_1, 0) ≥ v_2 + v_4 else if ndim(v_1) = 4 then shape(v_1, 1) ≥ v_2 + v_4 else false
>>
Rule 10 (inner 3 spatial dimensions of image must be positive)
{v_1 : tensor} |= (ndim(v_1) = 3 ∧ ∀i ∈ [0, 2] : shape(v_1, i) > 0) ∨ (ndim(v_1) = 4 ∧ ∀j ∈ [1, 3] : shape(v_1, j) > 0)
>>
Rule 15 (width must be >= offset_width + target_width)
{v_1 : tensor, v_3 : int, v_5 : int} |= if ndim(v_1) = 3 then shape(v_1, 1) ≥ v_3 + v_5 else shape(v_1, 2) ≥ v_3 + v_5
>>
Rule 16 (height must be >= offset_height + target_height)
{v_1 : tensor, v_2 : int, v_4 : int} |= if ndim(v_1) = 3 then shape(v_1, 0) ≥ v_2 + v_4 else shape(v_1, 1) ≥ v_2 + v_4
>>
Rule 17 (image rank must be 3 or 4)
{v_1 : tensor} |= 3 ≤ ndim(v_1) ∧ ndim(v_1) ≤ 4
>>
Rule 18 (positive spatial dimensions for 3D/4D image)
{v_1 : tensor} |= if ndim(v_1) = 3 then shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0 else shape(v_1, 1) > 0 ∧ shape(v_1, 2) > 0 ∧ shape(v_1, 3) > 0
>>
Rule 19 (offsets must be non-negative)
{v_2 : int, v_3 : int} |= v_2 ≥ 0 ∧ v_3 ≥ 0
>>
Rule 20 (target crop sizes must be positive)
{v_4 : int, v_5 : int} |= v_4 > 0 ∧ v_5 > 0
>>
Rule 21 (crop must fit within image bounds for both ranks)
{v_1 : tensor, v_2 : int, v_3 : int, v_4 : int, v_5 : int} |= if ndim(v_1) = 3 then (shape(v_1, 0) ≥ v_2 + v_4 ∧ shape(v_1, 1) ≥ v_3 + v_5) else (shape(v_1, 1) ≥ v_2 + v_4 ∧ shape(v_1, 2) ≥ v_3 + v_5)
