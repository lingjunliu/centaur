>>
Rule 1 (inputs must be matrices or batched matrices)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2
>>
Rule 2 (x and y must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (core dimension compatibility accounting for adjoints)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= (if v_3 then shape(v_1, ndim(v_1) - 2) else shape(v_1, ndim(v_1) - 1)) = (if v_4 then shape(v_2, ndim(v_2) - 1) else shape(v_2, ndim(v_2) - 2))
>>
Rule 4 (broadcasting compatibility across batch dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 2 ∨ ndim(v_2) > 2 then ∀i ∈ [0, if (ndim(v_1) - 2) ≥ (ndim(v_2) - 2) then ndim(v_1) - 3 else ndim(v_2) - 3] : ndim(v_1) - i - 3 < 0 ∨ ndim(v_2) - i - 3 < 0 ∨ shape(v_1, ndim(v_1) - i - 3) = 1 ∨ shape(v_2, ndim(v_2) - i - 3) = 1 ∨ shape(v_1, ndim(v_1) - i - 3) = shape(v_2, ndim(v_2) - i - 3)
>>
Rule 5 (inputs must be at least matrices and have identical dtype)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2 ∧ dtype_(v_1) = dtype_(v_2)
>>
Rule 6 (inner dimensions must align based on adjoint flags)
{v_1 : tensor, v_2 : tensor, v_3 : bool, v_4 : bool} |= if v_3 then (if v_4 then shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 1) else shape(v_1, ndim(v_1) - 2) = shape(v_2, ndim(v_2) - 2)) else (if v_4 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1) else shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 2))
>>
Rule 7 (when ranks match, batch dimensions must be broadcast-compatible)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then (if ndim(v_1) ≥ 3 then ∀i ∈ [0, ndim(v_1) - 3] : (shape(v_1, i) = 1 ∨ shape(v_2, i) = 1 ∨ shape(v_1, i) = shape(v_2, i)))
>>
Rule 8 (last two dimensions of each input matrix slice must be positive)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 2 ∧ shape(v_1, ndim(v_1) - 2) ≥ 1 ∧ shape(v_1, ndim(v_1) - 1) ≥ 1 ∧ shape(v_2, ndim(v_2) - 2) ≥ 1 ∧ shape(v_2, ndim(v_2) - 1) ≥ 1
