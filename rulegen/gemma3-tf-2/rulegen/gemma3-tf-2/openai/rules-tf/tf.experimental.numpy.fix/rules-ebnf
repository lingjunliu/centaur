Rule 1 (input must have a numeric dtype: integers or floats)
{v_1 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 2 (boolean dtype is not allowed)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 3 (shape dimensions are non-negative for any ranked tensor)
{v_1 : tensor} |= if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 4 (supports scalars and higher-rank tensors)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 5 (input must be real-valued numeric tensor)
{v_1 : tensor} |= dtype_(v_1) = 0 ∨ dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 6 (complex dtypes are not supported)
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 7 (string dtype is not supported)
{v_1 : tensor} |= dtype_(v_1) ≠ 11
>>
Rule 9 (tensor should not be empty across any dimension)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
