{v_1 : str, v_2 : list(tensor), v_3 : list(dtype)} |= if v_1 = "sum" ∨ v_1 = "max" ∨ v_1 = "min" ∨ v_1 = "prod" then v_2.len ≥ 1 ∧ v_3.len = 1
