>>
Rule 1 (reduction parameter must be valid string)
{v_1 : str} |= v_1 = "none" ∨ v_1 = "mean" ∨ v_1 = "sum"
>>
Rule 2 (input must be 1D or 2D tensor)
{v_1 : tensor} |= ndim(v_1) = 1 ∨ ndim(v_1) = 2
>>
Rule 3 (input and target must have same number of dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 4 (input and target must have same shape in all dimensions)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 5 (input tensor must have positive dimensions)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 6 (input must not have more than 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≤ 2
>>
Rule 7 (if input is 2D, batch size must be positive)
{v_1 : tensor} |= if ndim(v_1) = 2 then shape(v_1, 0) > 0
>>
Rule 8 (input must have at least 1 dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 9 (when reduction is none, input must be 2D for batch output)
{v_1 : str, v_2 : tensor} |= if v_1 = "none" then ndim(v_2) = 2
>>
Rule 11 (last dimension of input must match last dimension of target)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1)
>>
Rule 12 (if input is 2D, both dimensions must be positive)
{v_1 : tensor} |= if ndim(v_1) = 2 then shape(v_1, 0) > 0 ∧ shape(v_1, 1) > 0
>>
Rule 23 (target tensor dimensions must all be positive)
{v_1 : tensor} |= ndim(v_1) > 0 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 24 (if input is 2D number of classes must be positive)
{v_1 : tensor} |= if ndim(v_1) = 2 then shape(v_1, 1) > 0
>>
Rule 25 (first dimension of input and target must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 1 ∧ ndim(v_2) ≥ 1 then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 26 (last dimension of input and target must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1)
>>
Rule 27 (size_average must be boolean)
{v_1 : bool} |= v_1 = true ∨ v_1 = false
