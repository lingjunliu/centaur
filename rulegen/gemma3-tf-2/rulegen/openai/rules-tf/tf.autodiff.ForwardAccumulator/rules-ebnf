Rule 1 (arguments must be tensors; avoids passing dtype objects like torch.dtype)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 0 ∧ ndim(v_2) ≥ 0
>>
Rule 2 (primals and tangents must have identical dtypes)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (primals and tangents must have exactly the same shape)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 4 (no empty dimensions in primals or tangents)
{v_1 : tensor, v_2 : tensor} |= ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 ∧ ∀ j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) > 0
>>
Rule 5 (scalar consistency)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then ndim(v_2) = 0 else ndim(v_2) > 0
>>
Rule 6 (tangent shape matches each primal axis)
{v_1 : tensor, v_2 : tensor} |= ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) = shape(v_1, i)
