Rule 1 (inputs must have allowed numeric dtypes and match)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ dtype_(v_2) = dtype_(v_1)
>>
Rule 2 (shapes must be broadcast-compatible across trailing dimensions)
{v_1 : tensor, v_2 : tensor} |= (∀i ∈ [0, ndim(v_1) - 1] : if i + ndim(v_2) - ndim(v_1) < 0 then shape(v_1, i) = 1 else (shape(v_1, i) = shape(v_2, i + ndim(v_2) - ndim(v_1)) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i + ndim(v_2) - ndim(v_1)) = 1)) ∧ (∀j ∈ [0, ndim(v_2) - 1] : if j + ndim(v_1) - ndim(v_2) < 0 then shape(v_2, j) = 1 else (shape(v_2, j) = shape(v_1, j + ndim(v_1) - ndim(v_2)) ∨ shape(v_2, j) = 1 ∨ shape(v_1, j + ndim(v_1) - ndim(v_2)) = 1))
>>
Rule 3 (name may be any string; no semantic constraint)
{v_3 : str} |= v_3 = v_3
>>
Rule 4 (x and y must have the same allowed dtype; bool and complex/string/dtype are disallowed)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2) ∧ dtype_(v_1) ≠ 0 ∧ dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_1) ≠ 11 ∧ dtype_(v_1) ≠ 12
>>
Rule 6 (name, if provided, is a valid string)
{v_3 : str} |= v_3 = "none" ∨ v_3 = "sum" ∨ v_3 = "max" ∨ v_3 = "min" ∨ v_3 = "prod" ∨ v_3 = "linear"
>>
Rule 7 (x and y must share a supported numeric dtype)
{v_1 : tensor, v_2 : tensor} |= 1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8 ∧ dtype_(v_2) = dtype_(v_1)
