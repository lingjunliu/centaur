Rule 1 (axis as integer must be within valid range [-ndim(a), ndim(a) - 1])
{v_1 : tensor, v_2 : int} |= 0 - ndim(v_1) ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 2 (each axis in tuple must be within valid range [-ndim(a), ndim(a) - 1])
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : 0 - ndim(v_1) ≤ v_2[i] ∧ v_2[i] < ndim(v_1)
>>
Rule 3 (each axis in list must be within valid range [-ndim(a), ndim(a) - 1])
{v_1 : tensor, v_2 : list(int)} |= ∀i ∈ [0, v_2.len - 1] : 0 - ndim(v_1) ≤ v_2[i] ∧ v_2[i] < ndim(v_1)
