Rule 1 (out must be a Tensor when provided)
{v_2 : tensor} |= ndim(v_2) ≥ 0
>>
Rule 2 (output dtype must match input dtype to avoid invalid casts)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 3 (output shape must match input shape)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
