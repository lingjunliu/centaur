{v_8 : bool, v_9 : bool, v_10 : str} |= if v_9 = true ∧ v_8 = true then v_10 = "mean"
>>
Rule 10 (if reduce is true and size_average is false, reduction is "sum")
{v_8 : bool, v_9 : bool, v_10 : str} |= if v_9 = true ∧ v_8 = false then v_10 = "sum"
