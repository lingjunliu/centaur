Rule 1 (anchor, positive, and negative must have identical shape and at least 1 dimension)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ndim(v_1) = ndim(v_3) ∧ ndim(v_1) ≥ 1 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i) ∧ shape(v_1, i) = shape(v_3, i)
>>
Rule 2 (anchor, positive, and negative must have the same dtype)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= dtype_(v_1) = dtype_(v_2) ∧ dtype_(v_1) = dtype_(v_3)
>>
Rule 3 (margin must be strictly positive)
{v_4 : float} |= v_4 > 0
>>
Rule 4 (p must be at least 1)
{v_5 : float} |= v_5 ≥ 1
