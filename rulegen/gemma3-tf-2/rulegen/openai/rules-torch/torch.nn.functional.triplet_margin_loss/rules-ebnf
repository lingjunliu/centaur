Rule 7 (valid reduction values only; prevents “0 is not a valid value for reduction”)
{v_10 : str} |= v_10 = "none" ∨ v_10 = "mean" ∨ v_10 = "sum"
>>
Rule 8 (if reduce is false, reduction must be "none")
{v_9 : bool, v_10 : str} |= if v_9 = false then v_10 = "none"
>>
