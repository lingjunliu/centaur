Rule 1 (out tensor must have same dtype as input to avoid dtype mismatch error)
{v_1 : tensor, v_5 : tensor} |= dtype_(v_1) = dtype_(v_5)
>>
Rule 2 (out must be a Tensor, not a scalar/float)
{v_5 : tensor} |= ndim(v_5) ≥ 0
>>
Rule 3 (out tensor must have the same shape as input)
{v_1 : tensor, v_5 : tensor} |= ndim(v_1) = ndim(v_5) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_5, i)
>>
Rule 4 (posinf replacement should not be less than neginf replacement)
{v_3 : int ⊎ float, v_4 : int ⊎ float} |= v_3 ≥ v_4
>>
Rule 5 (when input is bool or integer dtype, replacements must be integers)
{v_1 : tensor, v_2 : int ⊎ float, v_3 : int ⊎ float, v_4 : int ⊎ float} |= if (0 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5) then ((v_2 % 1) = 0 ∧ (v_3 % 1) = 0 ∧ (v_4 % 1) = 0)
>>
Rule 6 (when input is boolean dtype, replacements must be 0 or 1)
{v_1 : tensor, v_2 : int ⊎ float, v_3 : int ⊎ float, v_4 : int ⊎ float} |= if dtype_(v_1) = 0 then ((v_2 % 1 = 0 ∧ 0 ≤ v_2 ∧ v_2 ≤ 1) ∧ (v_3 % 1 = 0 ∧ 0 ≤ v_3 ∧ v_3 ≤ 1) ∧ (v_4 % 1 = 0 ∧ 0 ≤ v_4 ∧ v_4 ≤ 1))
>>
Rule 7 (for floating-point inputs, posinf should be positive and neginf negative)
{v_1 : tensor, v_3 : int ⊎ float, v_4 : int ⊎ float} |= if (6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8) then (v_3 > 0 ∧ v_4 < 0)
