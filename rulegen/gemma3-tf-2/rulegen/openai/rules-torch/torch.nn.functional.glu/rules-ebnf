Rule 2 (input must have at least one dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 4 (dim must be within the valid range for input’s dimensions)
{v_1 : tensor, v_2 : int} |= (0 - ndim(v_1)) ≤ v_2 ∧ v_2 ≤ ndim(v_1) - 1
>>
Rule 6 (size along the effective split dimension must be even)
{v_1 : tensor, v_2 : int} |= (0 ≤ v_2 ∧ v_2 ≤ ndim(v_1) - 1 ∧ shape(v_1, v_2) % 2 = 0) ∨ ((0 - ndim(v_1)) ≤ v_2 ∧ v_2 < 0 ∧ shape(v_1, v_2 + ndim(v_1)) % 2 = 0)
