>>
Rule 1 (input tensor must be float32 or float64; complex not supported)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 2 (out tensor, if provided, must match input dtype and be float32/float64 to avoid half-overflow)
{v_1 : tensor, v_3 : tensor} |= dtype_(v_3) = dtype_(v_1) ∧ (dtype_(v_3) = 7 ∨ dtype_(v_3) = 8)
>>
Rule 3 (out tensor shape must match input tensor shape)
{v_1 : tensor, v_3 : tensor} |= ndim(v_3) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = shape(v_1, i)
>>
Rule 4 (eps must be a float scalar and within a reasonable clamp range)
{v_2 : float} |= 0 ≤ v_2 ∧ v_2 ≤ 0.5
