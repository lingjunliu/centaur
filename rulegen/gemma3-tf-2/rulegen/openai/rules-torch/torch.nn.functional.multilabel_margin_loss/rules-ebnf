>>
Rule 1 (input must be a 1D vector or 2D matrix; classes dimension non-empty, batch may be 0)
{v_1 : tensor} |= (ndim(v_1) = 1 ∧ shape(v_1, 0) > 0) ∨ (ndim(v_1) = 2 ∧ shape(v_1, 1) > 0 ∧ shape(v_1, 0) ≥ 0)
>>
Rule 2 (target shape must exactly match input shape)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 3 (input must have floating-point dtype: float16/32/64)
{v_1 : tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8
>>
Rule 4 (target must have int64 dtype)
{v_2 : tensor} |= dtype_(v_2) = 4
>>
Rule 5 (reduction must be one of the supported options)
{v_5 : str} |= v_5 = "none" ∨ v_5 = "mean" ∨ v_5 = "sum"
>>
Rule 6 (consistency between reduction and reduce/size_average flags)
{v_3 : bool, v_4 : bool, v_5 : str} |= (if v_5 = "none" then v_4 = false) ∧ (if v_5 = "mean" then (v_4 = true ∧ v_3 = true)) ∧ (if v_5 = "sum" then (v_4 = true ∧ v_3 = false))
>>
Rule 7 (target indices must be in [-1, C-1], where C is number of classes)
{v_1 : tensor, v_2 : tensor} |= (if ndim(v_1) = 1 then (min(v_2) ≥ -1 ∧ max(v_2) < shape(v_1, 0))) ∧ (if ndim(v_1) = 2 then (min(v_2) ≥ -1 ∧ max(v_2) < shape(v_1, 1)))
