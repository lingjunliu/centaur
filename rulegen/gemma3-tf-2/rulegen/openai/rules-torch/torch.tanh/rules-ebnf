Rule 1 (out tensor must have exactly the same shape as input)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 0 then ndim(v_2) = 0 else (ndim(v_1) = ndim(v_2) ∧ ∀ i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 2 (out dtype compatible with floating-point input; no downcast)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 6 ∧ (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)) ∨ (dtype_(v_1) = 7 ∧ (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)) ∨ (dtype_(v_1) = 8 ∧ dtype_(v_2) = 8)
>>
Rule 3 (integer/bool input requires floating out to avoid unsafe cast)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 0 ∨ dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5) then (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)
>>
Rule 4 (out dtype compatible with complex input; allow equal or upcast)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) then ((dtype_(v_1) = 9 ∧ (dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)) ∨ (dtype_(v_1) = 10 ∧ dtype_(v_2) = 10))
