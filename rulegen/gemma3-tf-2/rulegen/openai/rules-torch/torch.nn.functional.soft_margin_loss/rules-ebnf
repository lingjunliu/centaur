Rule 1 (inputs must be floating tensors and share the same dtype to avoid bool negation)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ dtype_(v_2) = dtype_(v_1)
>>
Rule 2 (target must be broadcastable to input to avoid shape/broadcast mismatches)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_2) = 0) ∨ (ndim(v_1) = ndim(v_2) ∧ if ndim(v_1) ≥ 1 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) = shape(v_1, i) ∨ shape(v_2, i) = 1)
>>
Rule 3 (reduction must be one of the supported options)
{v_5 : str} |= v_5 = "none" ∨ v_5 = "mean" ∨ v_5 = "sum"
>>
Rule 4 (when reduce is false, reduction must be 'none')
{v_4 : bool, v_5 : str} |= if v_4 = false then v_5 = "none"
>>
Rule 5 (when reduce is true and size_average is true, reduction is 'mean')
{v_3 : bool, v_4 : bool, v_5 : str} |= if v_4 = true ∧ v_3 = true then v_5 = "mean"
>>
Rule 6 (when reduce is true and size_average is false, reduction is 'sum')
{v_3 : bool, v_4 : bool, v_5 : str} |= if v_4 = true ∧ v_3 = false then v_5 = "sum"
>>
Rule 7 (targets are expected to be in the range [-1, 1])
{v_2 : tensor} |= min(v_2) ≥ -1 ∧ max(v_2) ≤ 1
