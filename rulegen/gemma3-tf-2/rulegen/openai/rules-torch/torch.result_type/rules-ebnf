Rule 1 (valid two-argument type categories for result_type; suppresses invalid-combination error)
{v_1 : tensor ⊎ dtype ⊎ int ⊎ float ⊎ bool, v_2 : tensor ⊎ dtype ⊎ int ⊎ float ⊎ bool} |= v_1 = v_1 ∧ v_2 = v_2
>>
Rule 2 (both inputs are tensors with non-negative dimensionality and shapes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 0 ∧ ndim(v_2) ≥ 0 ∧ (if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0) ∧ (if ndim(v_2) > 0 then ∀j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) ≥ 0)
>>
Rule 3 (tensor with dtype is allowed)
{v_1 : tensor, v_2 : dtype} |= dtype_(v_1) = dtype_(v_1) ∧ v_2 = v_2
>>
Rule 4 (tensor with integer scalar is allowed; integer magnitude bounded)
{v_1 : tensor, v_2 : int} |= ndim(v_1) ≥ 0 ∧ (-1000000 ≤ v_2 ∧ v_2 ≤ 1000000)
>>
Rule 5 (tensor with float scalar is allowed; float magnitude bounded)
{v_1 : tensor, v_2 : float} |= ndim(v_1) ≥ 0 ∧ (-1000000 ≤ v_2 ∧ v_2 ≤ 1000000)
>>
Rule 6 (tensor with boolean scalar is allowed)
{v_1 : tensor, v_2 : bool} |= ndim(v_1) ≥ 0 ∧ (v_2 = true ∨ v_2 = false)
>>
Rule 7 (dtype with tensor is allowed)
{v_1 : dtype, v_2 : tensor} |= v_1 = v_1 ∧ dtype_(v_2) = dtype_(v_2)
>>
Rule 8 (dtype with dtype is allowed)
{v_1 : dtype, v_2 : dtype} |= v_1 = v_1 ∧ v_2 = v_2
>>
Rule 9 (dtype with numeric scalar is allowed)
{v_1 : dtype, v_2 : int ⊎ float ⊎ bool} |= v_1 = v_1 ∧ (v_2 = true ∨ v_2 = false ∨ (-1000000 ≤ v_2 ∧ v_2 ≤ 1000000))
>>
Rule 10 (numeric scalar with tensor is allowed)
{v_1 : int ⊎ float ⊎ bool, v_2 : tensor} |= (v_1 = true ∨ v_1 = false ∨ (-1000000 ≤ v_1 ∧ v_1 ≤ 1000000)) ∧ ndim(v_2) ≥ 0
>>
Rule 11 (numeric scalar with dtype is allowed)
{v_1 : int ⊎ float ⊎ bool, v_2 : dtype} |= v_2 = v_2 ∧ (v_1 = true ∨ v_1 = false ∨ (-1000000 ≤ v_1 ∧ v_1 ≤ 1000000))
>>
Rule 12 (numeric scalar with numeric scalar is allowed)
{v_1 : int ⊎ float ⊎ bool, v_2 : int ⊎ float ⊎ bool} |= (v_1 = true ∨ v_1 = false ∨ (-1000000 ≤ v_1 ∧ v_1 ≤ 1000000)) ∧ (v_2 = true ∨ v_2 = false ∨ (-1000000 ≤ v_2 ∧ v_2 ≤ 1000000))
