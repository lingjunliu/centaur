{v_1 : tuple(int), v_2 : tensor} |= (ndim(v_2) = 4 ∧ shape(v_2, 2) + v_1[2] + v_1[3] ≥ 1 ∧ shape(v_2, 3) + v_1[0] + v_1[1] ≥ 1) ∨ (ndim(v_2) = 3 ∧ shape(v_2, 1) + v_1[2] + v_1[3] ≥ 1 ∧ shape(v_2, 2) + v_1[0] + v_1[1] ≥ 1)
