>>
Rule 1 (input must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (input dtype must be floating-point or complex)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 3 (float16 input is disallowed to avoid 'lu_cpu' not implemented for Half)
{v_1 : tensor} |= dtype_(v_1) ≠ 6
>>
Rule 4 (last two dimensions must form square matrices)
{v_1 : tensor} |= shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2)
>>
Rule 5 (out tensor, if provided, must match output shape and dtype)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 2 then (ndim(v_2) = ndim(v_1) - 2 ∧ dtype_(v_2) = dtype_(v_1) ∧ if ndim(v_1) ≥ 3 then ∀i ∈ [0, ndim(v_1) - 3] : shape(v_2, i) = shape(v_1, i))
>>
Rule 9 (last two dimensions must be square and strictly positive)
{v_1 : tensor} |= shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2) ∧ shape(v_1, ndim(v_1) - 1) > 0
>>
Rule 10 (out tensor matches det output shape and dtype)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) ≥ 3 then (ndim(v_2) = ndim(v_1) - 2 ∧ dtype_(v_2) = dtype_(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 3] : shape(v_2, i) = shape(v_1, i)) else if ndim(v_1) = 2 then (ndim(v_2) = 0 ∧ dtype_(v_2) = dtype_(v_1))
