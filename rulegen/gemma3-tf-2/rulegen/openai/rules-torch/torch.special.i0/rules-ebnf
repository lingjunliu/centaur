>>
Rule 1 (input must be a floating tensor)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 2 (disallow ComplexDouble input to avoid unsupported implementation)
{v_1 : tensor} |= dtype_(v_1) ≠ 10
>>
Rule 3 (out tensor, if provided, must have the same shape as input)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 4 (out tensor must not be bool to avoid invalid casting)
{v_2 : tensor} |= dtype_(v_2) ≠ 0
>>
Rule 5 (out tensor dtype must match input dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_2) = dtype_(v_1)
