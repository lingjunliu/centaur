>>
Rule 1 (input tensor must not be boolean; suppresses bool-negation error)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 2 (out tensor must have the same dtype as input; suppresses dtype mismatch errors like Float vs Double)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_2) = dtype_(v_1)
>>
Rule 3 (out tensor must match input shape exactly)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
