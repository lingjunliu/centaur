>>
Rule 1 (input must be a 2-D matrix)
{v_1 : tensor} |= ndim(v_1) = 2
>>
Rule 2 (mat2 must be a 2-D matrix)
{v_2 : tensor} |= ndim(v_2) = 2
>>
Rule 3 (inner dimensions must match for matrix multiplication)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = 2 ∧ ndim(v_2) = 2 then shape(v_1, 1) = shape(v_2, 0)
>>
Rule 4 (input and mat2 must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 5 (out, if provided, must be a tensor matrix)
{v_4 : tensor} |= ndim(v_4) = 2
>>
Rule 6 (out tensor must have the expected dtype)
{v_1 : tensor, v_2 : tensor, v_3 : dtype, v_4 : tensor} |= dtype_(v_1) = v_3 ∧ dtype_(v_2) = v_3 ∧ dtype_(v_4) = v_3
>>
Rule 7 (out tensor must have the correct shape (n × p))
{v_1 : tensor, v_2 : tensor, v_4 : tensor} |= shape(v_4, 0) = shape(v_1, 0) ∧ shape(v_4, 1) = shape(v_2, 1)
