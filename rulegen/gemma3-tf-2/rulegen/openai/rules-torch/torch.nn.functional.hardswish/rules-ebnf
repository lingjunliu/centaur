>>
Rule 1 (input must be a Tensor object, not a Python/numpy scalar)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 2 (input dtype must be floating-point)
{v_1 : tensor} |= dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 8
>>
Rule 3 (disallow Char/int8 dtype explicitly)
{v_1 : tensor} |= dtype_(v_1) ≠ 1
>>
Rule 4 (inplace flag must be a boolean)
{v_2 : bool} |= v_2 = true ∨ v_2 = false
>>
Rule 5 (if inplace is used, enforce floating-point dtype)
{v_1 : tensor, v_2 : bool} |= if v_2 then (dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 8)
