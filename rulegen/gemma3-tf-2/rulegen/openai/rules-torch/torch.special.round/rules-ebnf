>>
Rule 1 (input tensor dtype must not be bool to avoid unsupported operation)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 2 (out tensor, when provided, must have the same dtype as input)
{v_1 : tensor, v_3 : tensor} |= dtype_(v_3) = dtype_(v_1)
>>
Rule 3 (out tensor shape must match input tensor shape)
{v_1 : tensor, v_3 : tensor} |= if ndim(v_1) = 0 then ndim(v_3) = 0 else ndim(v_3) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = shape(v_1, i)
>>
Rule 4 (decimals is a bounded integer)
{v_2 : int} |= v_2 ≥ -100 ∧ v_2 ≤ 100
>>
Rule 5 (input tensor must have a numeric dtype supported by round)
{v_1 : tensor} |= dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
