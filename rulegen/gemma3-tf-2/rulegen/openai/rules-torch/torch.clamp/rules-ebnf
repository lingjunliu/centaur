Rule 1 (input tensor must not be complex)
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 2 (out must be a tensor with same dtype and shape as input)
{v_1 : tensor, v_4 : tensor} |= dtype_(v_4) = dtype_(v_1) ∧ ndim(v_4) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_4, i) = shape(v_1, i)
>>
Rule 7 (tensor min must match input dtype and be broadcastable to input)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_2) = dtype_(v_1) ∧ (ndim(v_2) = 0 ∨ (ndim(v_2) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) = 1 ∨ shape(v_2, i) = shape(v_1, i)))
>>
Rule 8 (tensor max must match input dtype and be broadcastable to input)
{v_1 : tensor, v_3 : tensor} |= dtype_(v_3) = dtype_(v_1) ∧ (ndim(v_3) = 0 ∨ (ndim(v_3) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = 1 ∨ shape(v_3, i) = shape(v_1, i)))
>>
Rule 9 (both tensor bounds: dtypes must match input and both must be broadcastable)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= dtype_(v_2) = dtype_(v_1) ∧ dtype_(v_3) = dtype_(v_1) ∧ (ndim(v_2) = 0 ∨ (ndim(v_2) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) = 1 ∨ shape(v_2, i) = shape(v_1, i))) ∧ (ndim(v_3) = 0 ∨ (ndim(v_3) = ndim(v_1) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = 1 ∨ shape(v_3, i) = shape(v_1, i)))
