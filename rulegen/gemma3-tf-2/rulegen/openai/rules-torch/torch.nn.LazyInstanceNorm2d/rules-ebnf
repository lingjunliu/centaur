Rule 1 (input must be 3D or 4D to avoid indexing errors and shape mismatch)
{v_6 : tensor} |= (ndim(v_6) = 3 ∨ ndim(v_6) = 4)
>>
Rule 2 (all input dimensions must be positive)
{v_6 : tensor} |= ∀i ∈ [0, ndim(v_6) - 1] : shape(v_6, i) > 0
>>
Rule 3 (input dtype must be floating or complex and match the dtype argument)
{v_5 : dtype, v_6 : tensor} |= dtype_(v_6) = v_5 ∧ (v_5 = 6 ∨ v_5 = 7 ∨ v_5 = 8 ∨ v_5 = 9 ∨ v_5 = 10)
>>
Rule 4 (disallow Char/Byte dtypes to avoid unsupported batch_norm)
{v_5 : dtype, v_6 : tensor} |= dtype_(v_6) = v_5 ∧ v_5 ≠ 1 ∧ v_5 ≠ 5
>>
Rule 5 (when affine or running stats are used, parameters must be Float32)
{v_3 : bool, v_4 : bool, v_5 : dtype} |= if (v_3 ∨ v_4) then v_5 = 7
>>
Rule 6 (disable running stats to avoid running_mean size mismatch)
{v_4 : bool} |= v_4 = false
>>
Rule 7 (for 3D inputs (C,H,W), disable affine to avoid num_features mismatch)
{v_3 : bool, v_6 : tensor} |= if ndim(v_6) = 3 then v_3 = false
>>
Rule 8 (eps must be positive for numerical stability)
{v_1 : float} |= v_1 > 0
>>
Rule 9 (momentum must be in [0, 1))
{v_2 : float} |= v_2 ≥ 0 ∧ v_2 < 1
>>
Rule 10 (prevent mixed dtype: input dtype must equal the dtype argument)
{v_5 : dtype, v_6 : tensor} |= dtype_(v_6) = v_5
