Rule 1 (input must be 3D or 4D to match 2D pooling expectations)
{v_1 : tensor} |= ndim(v_1) = 3 ∨ ndim(v_1) = 4
>>
Rule 2 (when returning indices, input must have at least 3 dimensions)
{v_1 : tensor, v_3 : bool} |= if v_3 then ndim(v_1) ≥ 3
>>
Rule 3 (input must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 4 (disallow Char/int8 dtype which is not implemented)
{v_1 : tensor} |= dtype_(v_1) ≠ 1
>>
Rule 5 (single-integer output_size must be positive)
{v_2 : int} |= v_2 ≥ 1
>>
Rule 6 (tuple output_size must have length 2; ensures it’s a tuple and avoids len() errors)
{v_2 : tuple(int)} |= v_2.len = 2
>>
Rule 7 (each element of tuple output_size must be positive to avoid negative dimensions)
{v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ 1
