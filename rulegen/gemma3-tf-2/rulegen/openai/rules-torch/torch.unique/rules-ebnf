Rule 1 (dim must be valid for the input’s rank; handles 0-D tensors explicitly to avoid IndexError)
{v_1 : tensor, v_5 : int} |= if ndim(v_1) = 0 then (v_5 = 0 ∨ v_5 = -1) else (-1 * ndim(v_1) ≤ v_5 ∧ v_5 ≤ ndim(v_1) - 1)
>>
Rule 2 (using dim with complex dtypes is disallowed to avoid "unique_dim" not implemented for complex)
{v_1 : tensor, v_5 : int} |= if (-1 * ndim(v_1) ≤ v_5 ∧ v_5 ≤ ndim(v_1) - 1) then (dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10)
>>
Rule 3 (negative dim canonicalizes into a valid non-negative index)
{v_1 : tensor, v_5 : int} |= if v_5 < 0 then (0 ≤ v_5 + ndim(v_1) ∧ v_5 + ndim(v_1) ≤ ndim(v_1) - 1)
>>
Rule 4 (boolean flags are booleans)
{v_2 : bool, v_3 : bool, v_4 : bool} |= (v_2 = true ∨ v_2 = false) ∧ (v_3 = true ∨ v_3 = false) ∧ (v_4 = true ∨ v_4 = false)
>>
Rule 5 (input tensor’s dtype is a known supported dtype index)
{v_1 : tensor} |= 0 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 12
>>
Rule 6 (all dimension sizes are non-negative)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
