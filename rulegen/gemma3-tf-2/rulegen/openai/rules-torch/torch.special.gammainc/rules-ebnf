{v_1: tensor, v_2: tensor, v_3: tensor} |= 6 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 8 ∧ dtype_(v_2) = dtype_(v_1) ∧ dtype_(v_3) = dtype_(v_1)
