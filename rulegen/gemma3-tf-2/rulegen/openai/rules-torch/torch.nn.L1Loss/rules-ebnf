>>
Rule 1 (inputs and targets must have the same number of dimensions)
{v_4 : tensor, v_5 : tensor} |= ndim(v_4) = ndim(v_5)
>>
Rule 2 (inputs and targets must match in every dimension — prevents size mismatch errors)
{v_4 : tensor, v_5 : tensor} |= ∀i ∈ [0, ndim(v_4) - 1] : shape(v_4, i) = shape(v_5, i)
>>
Rule 3 (tensor dtypes must match)
{v_4 : tensor, v_5 : tensor} |= dtype_(v_4) = dtype_(v_5)
>>
Rule 4 (tensor dtype must be floating-point or complex)
{v_4 : tensor} |= 6 ≤ dtype_(v_4) ∧ dtype_(v_4) ≤ 10
>>
Rule 5 (reduction must be one of the allowed options)
{v_3 : str} |= v_3 = "none" ∨ v_3 = "mean" ∨ v_3 = "sum"
>>
Rule 6 (if reduce is False, reduction should be 'none')
{v_2 : bool, v_3 : str} |= if v_2 = false then v_3 = "none"
>>
Rule 7 (if reduce is True and size_average is True, reduction should be 'mean')
{v_1 : bool, v_2 : bool, v_3 : str} |= if v_2 = true ∧ v_1 = true then v_3 = "mean"
>>
Rule 8 (if reduce is True and size_average is False, reduction should be 'sum')
{v_1 : bool, v_2 : bool, v_3 : str} |= if v_2 = true ∧ v_1 = false then v_3 = "sum"
