>>
Rule 4 (no duplicate dims in a tuple after normalization)
{v_1 : tensor, v_2 : tuple(int)} |= ∀i ∈ [0, v_2.len - 1] : ∀j ∈ [i + 1, v_2.len - 1] : (if v_2[i] < 0 then v_2[i] + ndim(v_1) else v_2[i]) ≠ (if v_2[j] < 0 then v_2[j] + ndim(v_1) else v_2[j])
>>
Rule 5 (no duplicate dims in a list after normalization)
{v_1 : tensor, v_2 : list(int)} |= ∀i ∈ [0, v_2.len - 1] : ∀j ∈ [i + 1, v_2.len - 1] : (if v_2[i] < 0 then v_2[i] + ndim(v_1) else v_2[i]) ≠ (if v_2[j] < 0 then v_2[j] + ndim(v_1) else v_2[j])
>>
Rule 6 (complex inputs and complex dtypes are not supported)
{v_1 : tensor, v_2 : dtype} |= dtype_(v_1) ≤ 8 ∧ v_2 ≤ 8
>>
Rule 7 (integer/bool inputs must be cast to floating dtype to avoid 'Long' error)
{v_1 : tensor, v_2 : dtype} |= if 0 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5 then 6 ≤ v_2 ∧ v_2 ≤ 8
>>
Rule 8 (input and requested dtype must not be complex or Long)
{v_1 : tensor, v_2 : dtype} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10 ∧ dtype_(v_1) ≠ 4 ∧ v_2 ≠ 9 ∧ v_2 ≠ 10 ∧ v_2 ≠ 4
>>
Rule 12 (dtype override must be a floating-point type)
{v_1 : dtype} |= v_1 = 6 ∨ v_1 = 7 ∨ v_1 = 8
