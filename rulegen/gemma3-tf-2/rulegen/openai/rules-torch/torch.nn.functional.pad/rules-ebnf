>>
Rule 1 (pad length must be even and not exceed twice the input ndim)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len ≤ 2 * ndim(v_1) ∧ ∃k ∈ [1, v_2.len] : v_2.len = 2 * k
>>
Rule 2 (padding mode must be one of the supported strings)
{v_3 : str} |= v_3 = "constant" ∨ v_3 = "reflect" ∨ v_3 = "replicate" ∨ v_3 = "circular"
>>
Rule 3 (non-constant padding only supported for 2D–5D inputs)
{v_1 : tensor, v_3 : str} |= if (v_3 = "reflect" ∨ v_3 = "replicate" ∨ v_3 = "circular") then (2 ≤ ndim(v_1) ∧ ndim(v_1) ≤ 5)
>>
Rule 7 (all pad entries are non-negative)
{v_2 : tuple(int)} |= if v_2.len ≥ 1 then ∀i ∈ [0, v_2.len - 1] : v_2[i] ≥ 0
