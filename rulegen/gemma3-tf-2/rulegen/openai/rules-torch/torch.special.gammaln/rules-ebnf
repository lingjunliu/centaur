>>
Rule 1 (input must have a real, non-complex dtype)
{v_1 : tensor} |= dtype_(v_1) ≠ 9 ∧ dtype_(v_1) ≠ 10
>>
Rule 2 (out tensor, if provided, must have a floating dtype)
{v_2 : tensor} |= 6 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 8
>>
Rule 3 (no unsafe cast with out: output dtype must match result dtype)
{v_1 : tensor, v_2 : tensor} |= if dtype_(v_1) = 8 then dtype_(v_2) = 8 else if dtype_(v_1) = 7 then dtype_(v_2) = 7 else if dtype_(v_1) = 6 then dtype_(v_2) = 6 else (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)
>>
Rule 4 (input must be a Tensor object)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 5 (out tensor must match the output shape: same as input for gammaln)
{v_1 : tensor, v_2 : tensor} |= ndim(v_2) = ndim(v_1) ∧ if ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_2, i) = shape(v_1, i)
