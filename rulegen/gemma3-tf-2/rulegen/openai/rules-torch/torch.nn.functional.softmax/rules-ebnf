>>
Rule 1 (dim must be within valid indexing range for the input tensor)
{v_1 : tensor, v_2 : int} |= v_2 ≥ 0 - ndim(v_1) ∧ v_2 ≤ ndim(v_1) - 1
>>
Rule 2 (for 1D input, dim must be -1 or 0)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then (v_2 = -1 ∨ v_2 = 0)
>>
Rule 3 (input dtype must not be int8/Char)
{v_1 : tensor} |= dtype_(v_1) ≠ 1
>>
Rule 4 (when provided, dtype override must be a floating type)
{v_3 : dtype} |= v_3 = 6 ∨ v_3 = 7 ∨ v_3 = 8
>>
Rule 5 (if input is int8/Char, require a floating dtype override)
{v_1 : tensor, v_3 : dtype} |= if dtype_(v_1) = 1 then (v_3 = 6 ∨ v_3 = 7 ∨ v_3 = 8)
