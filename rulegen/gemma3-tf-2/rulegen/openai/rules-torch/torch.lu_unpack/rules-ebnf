>>
Rule 1 (LU_data must have at least two dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (LU_pivots must be an int32 tensor with at least 1 dimension)
{v_2 : tensor} |= ndim(v_2) ≥ 1 ∧ dtype_(v_2) = 3
>>
Rule 3 (Pivot values must lie in [1, number of rows] of LU_data)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 1 ∧ 1 ≤ min(v_2) ∧ max(v_2) ≤ shape(v_1, ndim(v_1) - 2)
>>
Rule 4 (Pivot vector length equals min(m, n) of LU_data)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) ≥ 2 ∧ ndim(v_2) ≥ 1 ∧ if shape(v_1, ndim(v_1) - 2) ≤ shape(v_1, ndim(v_1) - 1) then shape(v_2, ndim(v_2) - 1) = shape(v_1, ndim(v_1) - 2) else shape(v_2, ndim(v_2) - 1) = shape(v_1, ndim(v_1) - 1)
>>
Rule 5 (Output tuple, if provided, must hold three tensors)
{v_5 : tuple(tensor)} |= v_5.len = 3
>>
Rule 6 (Flags are boolean-valued)
{v_3 : bool, v_4 : bool} |= (v_3 = true ∨ v_3 = false) ∧ (v_4 = true ∨ v_4 = false)
