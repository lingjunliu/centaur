Rule 1 (input and weight must have the same dtype)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = dtype_(v_2)
>>
Rule 2 (2-D weight: input last dimension must equal in_features)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) = 2 then shape(v_1, ndim(v_1) - 1) = shape(v_2, 1)
>>
Rule 3 (input must be at least 1-D)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 4 (1-D weight uses dot: require 1-D input and matching length)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) = 1 then (ndim(v_1) = 1 ∧ shape(v_1, 0) = shape(v_2, 0))
>>
Rule 5 (weight must have at most 2 dimensions)
{v_2 : tensor} |= ndim(v_2) ≤ 2
>>
Rule 6 (bias must be a tensor)
{v_3 : tensor} |= ndim(v_3) ≥ 0
>>
Rule 7 (bias shape for 2-D weight: scalar or length = out_features)
{v_2 : tensor, v_3 : tensor} |= if ndim(v_2) = 2 then ((ndim(v_3) = 0) ∨ (ndim(v_3) = 1 ∧ shape(v_3, 0) = shape(v_2, 0)))
>>
Rule 8 (bias for 1-D weight must be scalar)
{v_2 : tensor, v_3 : tensor} |= if ndim(v_2) = 1 then ndim(v_3) = 0
>>
Rule 9 (bias dtype must match input dtype before addition)
{v_1 : tensor, v_3 : tensor} |= dtype_(v_1) = dtype_(v_3)
>>
Rule 10 (1-D dot path: dtypes must match explicitly)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) = 1 ∧ ndim(v_2) = 1) then dtype_(v_1) = dtype_(v_2)
