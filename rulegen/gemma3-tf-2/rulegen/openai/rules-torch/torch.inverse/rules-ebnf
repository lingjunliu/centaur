>>
Rule 1 (input must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 2 (input must be batches of non-empty square matrices)
{v_1 : tensor} |= ndim(v_1) ≥ 2 ∧ shape(v_1, ndim(v_1) - 2) = shape(v_1, ndim(v_1) - 1) ∧ ∀j ∈ [ndim(v_1) - 2, ndim(v_1) - 1] : shape(v_1, j) > 0
>>
Rule 3 (input dtype must be floating or complex)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 4 (low-precision float16 (Half) not supported)
{v_1 : tensor} |= dtype_(v_1) ≠ 6
>>
Rule 5 (out tensor, if provided, must have the same dtype as input)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_2) = dtype_(v_1)
