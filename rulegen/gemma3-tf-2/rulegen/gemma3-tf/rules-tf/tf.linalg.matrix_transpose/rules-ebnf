Rule 4 (Tensor shape check for non-empty dimensions)
{a : tensor} |= ∀dim ∈ [0, ndim(a) - 1] : shape(a, dim) > 0
>>
Rule 6 (Rank 3 tensor check)
{a : tensor} |= ndim(a) ≤ 3
>>
Rule 9 (Shape consistency check)
{a : tensor} |= shape(a, 0) > 0 ∧ shape(a, 1) > 0
>>
Rule 12 (Tuple length check)
{v_1 : tuple(int)} |= v_1.len = 2
>>
Rule 13 (Positive integer check)
{v_1 : int} |= v_1 > 0
>>
Rule 15 (List of integers check)
{v_1 : list(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] > 0
>>
Rule 17 (Dimension constraint check)
{a : tensor, dim : int} |= dim < ndim(a)
>>
Rule 18 (Valid shape size)
{a : tensor, size : int} |= size > 0 ∧ size ≤ shape(a, 0)
>>
Rule 20 (Negative rank check)
{a : tensor} |= ndim(a) > 0
>>
Rule 21 (Check for positive shape values)
{a : tensor} |= ∀i ∈ [0, ndim(a)-1] : shape(a, i) > 0
>>
Rule 24 (Integer scalar constraint)
{v_1 : int} |= v_1 = 1
