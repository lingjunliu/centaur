{ellipsis_mask: int, begin_mask: int, end_mask: int, new_axis_mask: int, shrink_axis_mask: int} |= if ellipsis_mask ≠ 0 then begin_mask = 0 ∧ end_mask = 0 ∧ new_axis_mask = 0 ∧ shrink_axis_mask = 0
>>
Rule 48 (If shrink_axis_mask is set, the corresponding stride must be positive)
{strides: tensor, shrink_axis_mask: int, shape: tensor} |= if shrink_axis_mask = 1 then strides[shape(shape, 0)-1] > 0
