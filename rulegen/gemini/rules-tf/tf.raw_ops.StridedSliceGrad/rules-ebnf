>>
Rule 1 (shape, begin, end and strides must have the same type)
{shape : tensor, begin : tensor, end : tensor, strides : tensor} |= dtype_(shape) = dtype_(begin) ∧ dtype_(begin) = dtype_(end) ∧ dtype_(end) = dtype_(strides)
>>
Rule 2 (shape must be int32 or int64, indices 3 and 4 respectively)
{shape : tensor} |= dtype_(shape) = 3 ∨ dtype_(shape) = 4
>>
Rule 3 (dy must be a tensor)
{dy : tensor} |= ndim(dy) ≥ 0
>>
Rule 4 (begin_mask, end_mask, ellipsis_mask, new_axis_mask, shrink_axis_mask should be non-negative)
{begin_mask : int, end_mask : int, ellipsis_mask : int, new_axis_mask : int, shrink_axis_mask : int} |= begin_mask ≥ 0 ∧ end_mask ≥ 0 ∧ ellipsis_mask ≥ 0 ∧ new_axis_mask ≥ 0 ∧ shrink_axis_mask ≥ 0
