  >>> elems = np.array([1, 2, 3, 4, 5, 6])
  >>> tf.map_fn(lambda x: x * x, elems)
  <tf.Tensor: shape=(6,), dtype=int64, numpy=array([ 1,  4,  9, 16, 25, 36])>

  >>> elems = (np.array([1, 2, 3]), np.array([-1, 1, -1]))
