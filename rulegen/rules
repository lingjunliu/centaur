{v_1 : tensor, v_2 : str} |= if (ndim(v_1) = 2) ∧ (v_2 ≠ "none") then (∀i ∈ [0, shape(v_1, 0) - 1] : ∀j ∈ [0, shape(v_1, 1) - 1] : v_1 = 1) ∨ (∀i ∈ [0, shape(v_1, 0) - 1] : ∀j ∈ [0, shape(v_1, 1) - 1] : v_1 = -1)
