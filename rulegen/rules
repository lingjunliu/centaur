{v_1 : tensor, v_2 : int, v_3 : str} |= if (ndim(v_1) = v_2) ∧ (v_3 = "tanh") ∧ (ndim(v_1) > 0) then shape(v_1, 0) < 5 ∧ max(v_1) < 1
