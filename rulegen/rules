{v_1 : tensor} |= if (dtype_(v_1) ≠ 0 ∧ dtype_(v_1) ≠ 11) ∧ ndim(v_1) > 1 ∧ (shape(v_1, 0) + shape(v_1, 1) > 5) then min(v_1) * max(v_1) ≤ 1000
>>
