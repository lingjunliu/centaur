{v_1: tensor} |= if ndim(v_1) > 2 then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i)) / 3 = ((∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i)) + 1 - 1) / 3
