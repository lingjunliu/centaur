>>
Rule 0 (input tensor's data type should be one of the supported types, encoded as an integer)
{v_1 : tensor, v_2 : int} |= v_2 = 0 ∨ v_2 = 1 ∨ v_2 = 2 ∨ v_2 = 3 ∨ v_2 = 4 ∨ v_2 = 5 ∨ v_2 = 6 ∨ v_2 = 7 ∨ v_2 = 8 ∨ v_2 = 9 ∨ v_2 = 10 ∨ v_2 = 11 ∨ v_2 = 12
>>
Rule 1 (check whether the input string is not empty)
{v_1 : str} |= v_1 ≠ ""
>>
Rule 2 (Check if all elements in the tensor are the same)
{v_1 : tensor} |= ∀i ∈ [1, ndim(v_1) - 1] : shape(v_1, 0) = shape(v_1, i)
>>
Rule 3 (a float should be between 0 and 1)
{v_1 : float} |= v_1 ≥ 0 ∧ v_1 ≤ 1
>>
Rule 4 (the dimension size of the tensor must be greater than a value)
{v_1 : tensor, v_2 : int} |= shape(v_1, 0) > v_2
>>
Rule 5 (if dimension is 1, tensor size must be a specific value)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 1 then shape(v_1, 0) = v_2 else true
>>
Rule 6 (the sum of two integers should be greater than zero)
{v_1 : int, v_2 : int} |= v_1 + v_2 > 0
>>
Rule 7 (if a boolean is true, then a tensor must have ndim > 0)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then ndim(v_2) > 0 else true
>>
Rule 8 (If dtype is float, min value should be positive)
{v_1 : tensor} |= if dtype(v_1) = 7 ∨ dtype(v_1) = 8 ∨ dtype(v_1) = 6 then min(v_1) > 0 else true
>>
Rule 9 (Two integers must not be the same)
{v_1 : int, v_2 : int} |= v_1 ≠ v_2
>>
Rule 10 (If the first shape dimension is 1, then the second should be greater than 10)
{v_1 : tensor} |= if shape(v_1, 0) = 1 then shape(v_1, 1) > 10 else true
>>
Rule 11 (Either tensor is empty, or both are non-empty)
{v_1 : tensor, v_2 : tensor} |= (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) ∨ (∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = 0) ∨ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0)
>>
Rule 12 (The minimum and maximum of a tensor should not be the same)
{v_1 : tensor} |= min(v_1) ≠ max(v_1)
>>
Rule 13 (If tensor is 2-dimensional, the two shape dimensions should be equal)
{v_1 : tensor} |= if ndim(v_1) = 2 then shape(v_1, 0) = shape(v_1, 1) else true
>>
Rule 14 (If the tensor has more than one dimension, its min should be less than 10)
{v_1 : tensor} |= if ndim(v_1) > 1 then min(v_1) < 10 else true
>>
Rule 15 (If a boolean is false, then dtype should not be in the range 1-5)
{v_1 : bool, v_2 : tensor} |= if v_1 = false then dtype(v_2) < 1 ∨ dtype(v_2) > 5 else true
>>
Rule 16 (If dtype is complex, ndim must be greater than 0)
{v_1 : tensor} |= if dtype(v_1) = 9 ∨ dtype(v_1) = 10 then ndim(v_1) > 0 else true
>>
Rule 17 (tensor shape dimensions must be less than a constant if ndim is 3)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 3 then ∀i ∈ [0, 2] : shape(v_1, i) < v_2 else true
>>
Rule 18 (string should be a valid file path, though cannot be validated in this limited environment)
{v_1 : str} |= true
>>
Rule 19 (int should be a power of 2)
{v_1 : int} |= ∃i ∈ [0, 10] : v_1 = 2 * i
>>
Rule 20 (Tensor dimension size should be within acceptable ranges)
{v_1 : tensor} |= ndim(v_1) ≥ 0 ∧ ndim(v_1) ≤ 5
>>
Rule 21 (An integer should not be negative)
{v_1 : int} |= v_1 ≥ 0
>>
Rule 22 (If tensor has fewer than two dimensions, the first dimension should not be zero)
{v_1 : tensor} |= if ndim(v_1) < 2 then shape(v_1, 0) ≠ 0 else true
>>
Rule 23 (If dtype is bool, then all elements must be true)
{v_1 : tensor} |= if dtype(v_1) = 0 then min(v_1) = true ∧ max(v_1) = true else true
>>
Rule 24 (If one tensor is empty, other must also be empty)
{v_1 : tensor, v_2 : tensor} |= (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0) ∧ (∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = 0) ∨ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0)
>>
Rule 25 (If a bool is true, all elements of a tensor must be non-negative)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then min(v_2) ≥ 0 else true
