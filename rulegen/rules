>>
Rule 1037 (If the string is "i,j->ij", then the tensors must be 1D and the first must have an integer data type)
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "i,j->ij" then ndim(v_1) = 1 ∧ ndim(v_2) = 1 ∧ dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 5
>>
Rule 1038 (The data type of the weight tensor must be floating point to ensure numerical stability)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 1039 (If the input is complex, the other one must be complex, too.)
{v_1 : tensor, v_2 : tensor} |= if (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) then (dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)
>>
Rule 1040 (If the input data type is an integer, then the number of classes can only be an integer)
{v_1 : tensor, v_2 : int ⊎ float} |= if dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 5 then (v_2 / 1) * 1 = v_2
>>
Rule 1041 (If the string is "...ij->...ji", then input tensor dimensions are equal or greater than 2)
{v_1 : tensor, v_2 : str} |= if v_2 = "...ij->...ji" then ndim(v_1) ≥ 2
>>
Rule 1042 (If the scale factor is specified, then it can not be equal to zero.)
{v_1 : float} |= v_1 ≠ 0
>>
Rule 1043 (If the string parameter is set to tanh, then the data type of the input tensor cannot be a bool type.)
{v_1 : tensor, v_2 : str} |= if v_2 = "tanh" then dtype_(v_1) ≠ 0
>>
Rule 1044 (If the sizes are given, then their product must be equal to the number of elements in the input tensor.)
{v_1 : tensor, v_2 : tuple(int)} |= (∀i ∈ [0, v_2.len - 1] : v_2[i] > 0) ∧ (if v_2.len > 0 then (∀i ∈ [0, v_2.len - 1] : v_2[i] > 0 ∧ shape(v_1, i) = v_2[i] ))
>>
Rule 1045 (If the number of input channels for the 2d convolution is smaller than 1, then raise a value error)
{v_1: int} |= v_1 > 0
>>
Rule 1046 (If the parameter is 'sum' or 'mean' and the input tensor is a bool, the output datatype has to be floating point.)
{v_1 : tensor, v_2 : str} |= if (v_2 = "sum" ∨ v_2 = "mean") ∧ dtype_(v_1) = 0 then (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 1047 (If dilation is specified, then it must be greater than 0.)
{v_1 : int} |= v_1 > 0
>>
Rule 1048 (If the tensor requires grad, then its dtype must be a floating point or complex type.)
{v_1 : tensor} |= if ∃i ∈ [0, ndim(v_1) - 1] : true then (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10)
>>
Rule 1049 (If the first tensor requires gradient, the second tensor should require gradient too.)
{v_1 : tensor, v_2 : tensor} |= if ∃i ∈ [0, ndim(v_1) - 1] : true then (∃j ∈ [0, ndim(v_2) - 1] : true)
>>
Rule 1050 (If the target is of index type, then it is strictly non-negative.)
{v_1 : tensor} |= if dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 5 then min(v_1) ≥ 0
>>
Rule 1051 (For string parameters representing einsum equations, there must be at least one '->'.)
{v_1 : str} |= ∃i ∈ [0, v_1.len - 1] : v_1[i] = "-" ∧ (i+1 < v_1.len ∧ v_1[i+1] = ">")
>>
Rule 1052 (If the mode is constant, the dtype of constant value must match tensor dtype)
{v_1 : tensor, v_2 : str, v_3 : int ⊎ float} |= if v_2 = "constant" then (if dtype_(v_1) ≥ 1 ∧ dtype_(v_1) ≤ 5 then (v_3 / 1) * 1 = v_3 else if dtype_(v_1) ≥ 6 ∧ dtype_(v_1) ≤ 8 then true else false)
>>
Rule 1053 (If the string value corresponds to a specific einsum operation, then input tensors should have corresponding number of dimensions)
{v_1 : tensor, v_2 : str} |= if v_2 = "ii->i" then ndim(v_1) = 2 else if v_2 = "i,j->ij" then ndim(v_1) = 1 else if v_2 = "bij,bjk->bik" then ndim(v_1) = 3 else if v_2 = "...ij->...ji" then ndim(v_1) ≥ 2 else if v_2 = "bn,anm,bm->ba" then ndim(v_1) = 2
>>
Rule 1054 (When specifying the padding size as a tuple, the number of elements in the tuple should match the number of spatial dimensions in the input (ndim -2))
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len = ndim(v_1) - 2
>>
Rule 1055 (The weights used in a linear layer must have shape (output_dimension, input_dimension))
{v_1 : tensor, v_2 : int, v_3 : int} |= ndim(v_1) = 2 ∧ shape(v_1, 0) = v_2 ∧ shape(v_1, 1) = v_3
>>
Rule 1056 (If an adaptive pooling layer with output size specified then output size > 0)
{v_1: int ⊎ float} |= v_1 > 0
>>
Rule 1057 (For string parameters representing einsum equations, each letter should be alphabet characters only)
{v_1 : str} |= ∀i ∈ [0, v_1.len - 1] : (v_1[i] ≥ "a" ∧ v_1[i] ≤ "z") ∨ (v_1[i] ≥ "A" ∧ v_1[i] ≤ "Z") ∨ v_1[i] = "," ∨ v_1[i] = ">" ∨ v_1[i] = "-" ∨ v_1[i] = "."
>>
Rule 1058 (When a specific padding is specified as a tuple, if the input is 1D, tuple.len must be 1)
{v_1 : tensor, v_2 : tuple(int)} |= if ndim(v_1) = 1 then v_2.len = 1
>>
Rule 1059 (When the shape is specified in AdaptiveAvgPool2D, the output size must be greater or equal than 1)
{v_1 : int ⊎ float} |= v_1 ≥ 1
>>
Rule 1060 (If you specify scale_factor, you should have positive value)
{v_1 : float} |= v_1 > 0
>>
Rule 1061 (When the input has three dimensions, and the data format is NLC, then the number of channels must be first shape)
{v_1 : tensor, v_2 : str, v_3 : int} |= if ndim(v_1) = 3 ∧ v_2 = "NLC" then shape(v_1, 1) = v_3
>>
Rule 1062 (When the data format parameter is specified, the number of channels should be greater than 0.)
{v_1 : str, v_2 : int} |= if v_1 = "NLC" ∨ v_1 = "NCL" then v_2 > 0
>>
Rule 1063 (If the target shape is specified by a tensor, the target tensor's elements have to be positive integers)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : (v_1[i] / 1) * 1 = v_1[i] ∧ v_1[i] > 0
>>
Rule 1064 (If the scale factor is specified, the output size must match the input size times scale factor)
{v_1 : tensor, v_2 : float, v_3 : tensor} |= ndim(v_1) = ndim(v_3) ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_3, i) = shape(v_1, i) * v_2
>>
Rule 1065 (When using convTranspose2d, the kernel size should be less than the input tensor size)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len = 2 ∧ shape(v_1,2) > v_2[0] ∧ shape(v_1,3) > v_2[1]
>>
Rule 1066 (If the string is 'none', 'mean', 'sum', or 'max', the tensor dimension number must be more than zero)
{v_1 : str, v_2 : tensor} |= if v_1 = "none" ∨ v_1 = "mean" ∨ v_1 = "sum" ∨ v_1 = "max" then ndim(v_2) > 0
>>
Rule 1067 (When the input tensor has at least two dimension, the first two dimensions should have a positive size)
{v_1 : tensor} |= if ndim(v_1) ≥ 2 then shape(v_1,0) > 0 ∧ shape(v_1,1) > 0
>>
Rule 1068 (If a stride is specified by a tuple, then each element of the stride must be more than zero.)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] > 0
>>
Rule 1069 (If the mode is max, the output dtype should be same as the input dtype.)
{v_1 : tensor, v_2 : str, v_3 : tensor} |= if v_2 = "max" then dtype_(v_1) = dtype_(v_3)
>>
Rule 1070 (When input and output sizes are given, the scale factor cannot be specified)
{v_1 : int ⊎ float, v_2 : tensor, v_3 : tensor} |= if v_1 > 0 then ndim(v_2) = 0 ∧ ndim(v_3) = 0
>>
Rule 1071 (The size of the kernel, stride, and padding cannot be all nones simultaneously)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= (ndim(v_1) ≠ 0 ∨ ndim(v_2) ≠ 0 ∨ ndim(v_3) ≠ 0)
>>
Rule 1072 (When input is N-dimensional, the weight must have N-2 dimensions)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 1 then ndim(v_2) = ndim(v_1)-2
>>
Rule 1073 (If a weight is specified, the input and output channels must match the weight shape)
{v_1 : tensor, v_2 : int, v_3 : int} |= ndim(v_1) > 1 ∧ shape(v_1,0) = v_2 ∧ shape(v_1,1) = v_3
>>
Rule 1074 (If the data type of a tensor is bool, its values must either be 0 or 1)
{v_1 : tensor} |= if dtype_(v_1) = 0 then (min(v_1) = 0 ∧ max(v_1) = 1)
>>
Rule 1075 (For any tensor, if stride is specified the number of elements must align)
{v_1 : tensor, v_2 : tuple(int)} |= if v_2.len > 0 then (∀i ∈ [0, v_2.len - 1] : shape(v_1,i) > 0)
>>
Rule 1076 (If parameter is 'tanh', the min must be less or equal than zero)
{v_1 : tensor, v_2 : str} |= if v_2 = "tanh" then min(v_1) ≤ 0
>>
Rule 1077 (If the number of groups is greater than one, then the input channels and the output channels must both be divisible by the number of groups.)
{v_1 : int, v_2 : int, v_3 : int} |= if v_1 > 1 then (v_2 / v_1) * v_1 = v_2 ∧ (v_3 / v_1) * v_1 = v_3
>>
Rule 1078 (For the mode = constant and if the dtype is bool, the value parameter must be either true or false)
{v_1 : str, v_2 : dtype, v_3 : bool} |= if v_1 = "constant" ∧ v_2 = 0 then v_3 = true ∨ v_3 = false
>>
Rule 1079 (If string parameter is one of einsum equations "ii->i","i,j->ij", the tensor must have element values of the same type as its dtype)
{v_1 : tensor, v_2 : str} |= if v_2 = "ii->i" ∨ v_2 = "i,j->ij" then ∀i ∈ [0, ndim(v_1) - 1] : (dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10)
>>
Rule 1080 (If the mode is equal to none, then the output tensor must have the same number of dimensions and same shape as the input)
{v_1 : tensor, v_2 : str, v_3 : tensor} |= if v_2 = "none" then ndim(v_1) = ndim(v_3) ∧ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_3, i))
>>
Rule 1081 (when use max pooling, maxpool.return_indices must be false)
{v_1 : bool} |= v_1 = false
>>
Rule 1082 (if return_indices = True, the indices tensor should have int data type, i.e., index from 1 to 5.)
{v_1: bool, v_2: tensor} |= if v_1 = true then (1 ≤ dtype_(v_2) ∧ dtype_(v_2) ≤ 5)
>>
Rule 1083 (For convolution transpose layers, if output_padding is specified, it should be non-negative and smaller than max(kernel_size, stride))
{v_1 : int, v_2 : int, v_3 : int} |= v_1 ≥ 0 ∧ v_1 < max(v_2, v_3)
>>
Rule 1084 (If string parameter is set to max and tensor has floating point type, then number of element must be int type)
{v_1 : str, v_2 : tensor} |= if v_1="max" ∧ (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8) then (v_2 / 1) * 1 = v_2
>>
Rule 1085 (If output_padding is specified by tuple, then its length has to be less or equal to the length of kernel_size)
{v_1 : tuple(int), v_2 : tuple(int)} |= v_1.len ≤ v_2.len
>>
Rule 1086 (When specifying padding mode as constant, the constant value needs to be within the dtype range of the input data.)
{v_1 : tensor, v_2 : str, v_3 : int ⊎ float} |= if v_2 = "constant" then (if dtype_(v_1) = 1 then (-128 ≤ v_3 ∧ v_3 ≤ 127) else if dtype_(v_1) = 2 then (-32768 ≤ v_3 ∧ v_3 ≤ 32767) else if dtype_(v_1) = 3 then (-2147483648 ≤ v_3 ∧ v_3 ≤ 2147483647) else if dtype_(v_1) = 4 then (-9223372036854775808 ≤ v_3 ∧ v_3 ≤ 9223372036854775807))
>>
Rule 1087 (When groups is not defined, it must be 1)
{v_1 : int} |= v_1 = 1
>>
Rule 1088 (if bias flag is True, the bias must have a dimension matching the output channel)
{v_1 : bool, v_2 : tensor, v_3 : int} |= if v_1 = true then ndim(v_2) = 1 ∧ shape(v_2, 0) = v_3
>>
Rule 1089 (If the string is 'none', then there should be no value for the constant value)
{v_1 : str, v_2 : int ⊎ float} |= if v_1 = "none" then v_2 = 0
>>
Rule 1090 (The value of channels for the input tensor has to equal to the in_channels of conv2d layer )
{v_1: tensor, v_2 : int} |= ndim(v_1) ≥ 3 ∧ shape(v_1, 1) = v_2
>>
Rule 1091 (When the scale factor is specified as a tensor, it needs to have the same shape as the input.)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i))
>>
Rule 1092 (If you specify the string parameter to be tanh, the value must be between -1 and 1 )
{v_1 : str, v_2 : float} |= if v_1 = "tanh" then v_2 ≥ -1 ∧ v_2 ≤ 1
>>
Rule 1093 (if the parameter mode is 'max' or 'sum' and the input type is fp16, then output_type must be fp32)
{v_1 : tensor, v_2 : dtype, v_3 : str} |= if (v_3 = "max" ∨ v_3 = "sum") ∧ dtype_(v_1) = 6 then v_2 = 7
>>
Rule 1094 (For string parameters representing einsum equations, if the equation is not one of "ii->i","i,j->ij", then it cannot be used as input)
{v_1 : str} |= v_1 = "ii->i" ∨ v_1 = "i,j->ij" ∨ v_1 = "bij,bjk->bik" ∨ v_1 = "...ij->...ji" ∨ v_1 = "bn,anm,bm->ba" ∨ v_1 = "none" ∨ v_1 = "mean" ∨ v_1 = "sum" ∨ v_1 = "max" ∨ v_1 = "constant" ∨ v_1 = "tanh"
>>
Rule 1095 (For ConvTranspose2d, the product of stride and input size must be greater or equal than kernel Size)
{v_1: tensor, v_2: tuple(int), v_3: tuple(int)} |= ndim(v_1) = 4 ∧ v_2.len=2 ∧ v_3.len=2 ∧ (shape(v_1,2) * v_3[0] ≥ v_2[0] ∧ shape(v_1,3) * v_3[1] ≥ v_2[1])
>>
Rule 1096 (If the weight is specified, the number of output channels has to match the weight shape.)
{v_1 : tensor, v_2 : int} |= ndim(v_1) > 1 ∧ shape(v_1, 0) = v_2
>>
Rule 1097 (If autograd is enabled for the input, then output must have the same dtype as the input tensor.)
{v_1 : tensor, v_2 : tensor} |= if ∃i ∈ [0, ndim(v_1) - 1] : true then dtype_(v_1) = dtype_(v_2)
>>
Rule 1098 (The number of input channels for the 2d convolution must be divisible by groups.)
{v_1: int, v_2: int} |= (v_2 / v_1) * v_1 = v_2
>>
Rule 1099 (If the string parameter is one of einsum equations "ij->i", the dimension of a tensor have to be equal or greater than 2)
{v_1 : tensor, v_2 : str} |= if v_2 = "i,j->i" then ndim(v_1) = 2
>>
Rule 1100 (If the input and output are different shapes, string must be none )
{v_1: str, v_2: tensor, v_3: tensor} |= if ndim(v_2) ≠ ndim(v_3) then v_1 = "none"
>>
Rule 1101 (The output_padding has to be no more than stride - 1.)
{v_1: int, v_2: int} |= v_1 ≤ v_2 - 1
>>
Rule 1102 (If the padding is specified to be 'same', the stride must be greater or equal to dilation.)
{v_1 : str, v_2 : int, v_3: int} |= if v_1 = "same" then v_2 ≥ v_3
>>
Rule 1103 (When specifying size, the size must be positive)
{v_1 : list(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] > 0
>>
Rule 1104 (If output_size is specified, then scale_factor cannot be used.)
{v_1 : tuple(int), v_2 : float} |= if v_1.len > 0 then v_2 = 0
>>
Rule 1105 (When weight parameter is not None, groups parameter must be great equal than 1)
{v_1: tensor, v_2: int} |= if ndim(v_1) > 0 then v_2 ≥ 1
>>
Rule 1106 (When output_size is specified, the output tensor's spatial dimensions have to match output_size)
{v_1 : tuple(int), v_2 : tensor} |= v_1.len = 2 ∧ ndim(v_2) = 4 ∧ shape(v_2, 2) = v_1[0] ∧ shape(v_2, 3) = v_1[1]
>>
Rule 1107 (If the output_size is None, the number of elements in the list stride must be equal to number of dimension - 2)
{v_1 : tensor, v_2 : list(int)} |= if ndim(v_1) > 1 then v_2.len = ndim(v_1) - 2
>>
Rule 1108 (if the number of output channels is provided and the number of groups > 1, then number of output channel and number of groups can't be identical.)
{v_1 : int, v_2 : int} |= if v_2 > 1 then v_1 ≠ v_2
>>
Rule 1109 (When string parameter equals to none, then number of output must equal to dimensions of input.)
{v_1 : str, v_2 : tensor, v_3 : tensor} |= if v_1 = "none" then ndim(v_2) = ndim(v_3)
>>
Rule 1110 (If kernel size is a tuple, then dilation must be a tuple with same number of elements)
{v_1 : tuple(int), v_2: tuple(int)} |= v_1.len = v_2.len
>>
Rule 1111 (When using convTranspose2d, the kernel size has to be smaller or equal to the input size)
{v_1: tensor, v_2: tuple(int)} |= v_2.len = 2 ∧ shape(v_1,2) ≥ v_2[0] ∧ shape(v_1,3) ≥ v_2[1]
>>
Rule 1112 (output padding value has to be less than stride.)
{v_1: tuple(int), v_2: tuple(int)} |= v_1.len = 2 ∧ v_2.len = 2 ∧ (v_1[0] < v_2[0] ∧ v_1[1] < v_2[1])
>>
Rule 1113 (When kernel size and dilation size are specified by tuple, dilation should be less than or equal to kernel)
{v_1: tuple(int), v_2: tuple(int)} |= v_1.len = 2 ∧ v_2.len = 2 ∧ (v_1[0] ≥ v_2[0] ∧ v_1[1] ≥ v_2[1])
>>
Rule 1114 (If there is one more tensor than the equations, then the one additional tensor must be one dimensional with same data type of other tensors)
{v_1 : tensor, v_2 : tensor, v_3 : tensor} |= if (ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ndim(v_3) = 1) then (dtype_(v_1) = dtype_(v_2) ∧ dtype_(v_2) = dtype_(v_3))
>>
Rule 1115 (If the input tensor's data type is an integer, then the value of reduction dimension should be an integer)
{v_1 : tensor, v_2 : int ⊎ float} |= if dtype_(v_1) > 0 ∧ dtype_(v_1) < 6 then (v_2 / 1) * 1 = v_2
>>
Rule 1116 (For einsum with 'bn,anm,bm->ba', if a dimension of any of the tensors is zero, then all resulting dimensions from it must be zero. For dimension a )
{v_1 : tensor, v_2 : str} |= if v_2 = "bn,anm,bm->ba" then (shape(v_1, 1) > 0)
>>
Rule 1117 (If input size is specified and tensor is provided, the size must match.)
{v_1 : tensor, v_2 : tuple(int)} |= if (∃i ∈ [0, ndim(v_1)-1] : shape(v_1, i) ≠ 0) then (v_2.len = ndim(v_1) ∧ (∀i ∈ [0, v_2.len - 1] : v_2[i] = shape(v_1, i)))
>>
Rule 1118 (If the equation is a transposition, the two dimensions have to be equal.)
{v_1 : tensor, v_2 : str} |= if v_2 = "...ij->...ji" then (shape(v_1, ndim(v_1) - 1) = shape(v_1, ndim(v_1) - 2))
>>
Rule 1119 (For parameter mode, if value is constant, that means only float16 and float32, and float64 are available)
{v_1 : str, v_2 : dtype} |= if v_1 = "constant" then (v_2 = 6 ∨ v_2 = 7 ∨ v_2 = 8)
>>
Rule 1120 (When the kernel size is specified by a tuple or a list, the padding, stride, and dilation parameter has to have the same length, too.)
{v_1 : tuple(int), v_2 : tuple(int), v_3 : tuple(int)} |= v_1.len = v_2.len ∧ v_2.len = v_3.len
>>
Rule 1121 (If the padding is 'same' or 'valid' then dilation must be 1)
{v_1 : str, v_2 : int} |= if v_1 = "same" ∨ v_1 = "valid" then v_2 = 1
>>
Rule 1122 (For string parameter equals to none or pad, then constant must have the type float or integer.)
{v_1 : str, v_2 : int ⊎ float} |= if v_1="none" ∨ v_1="pad" then (v_2 / 1) * 1 = v_2
>>
Rule 1123 (If kernel_size type is int, and a weight is specified then the shape 1 has to be equal shape 2)
{v_1 : tensor} |= if ndim(v_1) > 0 then shape(v_1,1) = shape(v_1,2)
>>
Rule 1124 (When bias is set to false, the bias tensor cannot have any elements)
{v_1 : bool, v_2 : tensor} |= if v_1 = false then ndim(v_2) = 0
>>
Rule 1125 (When the data type is quantized, the scale factor must be of type float.)
{v_1 : dtype, v_2 : float} |= if v_1 > 10 then (v_2 / 1) * 1 = v_2
>>
Rule 1126 (If input tensor shape has zero value, output shape has to has a zero, too.)
{v_1 : tensor, v_2 : tensor} |= if ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0 then ∃j ∈ [0, ndim(v_2) - 1] : shape(v_2, j) = 0
>>
Rule 1127 (For convTranspose2d and if output_size is specified, it needs to have shape output_channel * input + output_padding - (kernel_size -1))
{v_1 : tensor, v_2 : int, v_3 : int, v_4 : int} |= if ndim(v_1) > 0 then v_4 = v_2 * (shape(v_1,0) - 1) + v_3 - (shape(v_1,0) - 1)
>>
Rule 1128 (If the string is tanh, the tensor dtype must not be an integer type)
{v_1 : tensor, v_2 : str} |= if v_2 = "tanh" then (1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5) = false
>>
Rule 1129 (when parameter is constant and weight requires grad, the parameter value has to be zero.)
{v_1 : tensor, v_2 : str, v_3: bool} |= if v_2="constant" ∧  ∃i ∈ [0, ndim(v_1) - 1] : true then v_3=false
>>
Rule 1130 (If you specify the string parameter to be tanh, all elements of the tensor must have a floating point data type)
{v_1 : str, v_2 : tensor} |= if v_1 = "tanh" then dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8
>>
Rule 1131 (For AdaptiveMaxPool2d, all values of output size have to be either NULL or greater than 0)
{v_1 : tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] = 0 ∨ v_1[i] > 0
>>
Rule 1132 (If the stride parameter is a tuple, then every element needs to be larger than zero)
{v_1: tuple(int)} |= ∀i ∈ [0, v_1.len - 1] : v_1[i] > 0
>>
Rule 1133 (If groups > 1, in_channels and out_channels must be divisible by groups)
{v_1: int, v_2: int} |= if v_1 > 1 then (v_2 / v_1) * v_1 = v_2
>>
Rule 1134 (when you use stride parameter, this value must be integer)
{v_1: int ⊎ float} |= (v_1/1)*1 = v_1
>>
Rule 1135 (The kernel size should be a tuple of positive values )
{v_1 : tuple(int)} |= v_1.len > 0 ∧ ∀i ∈ [0, v_1.len - 1] : v_1[i] > 0
>>
Rule 1136 (For a 2D convolution, if the number of output channels is specified, the weight must have dimension four. )
{v_1 : int, v_2: tensor} |= if v_1 > 0 then ndim(v_2) = 4
>>
Rule 1137 (If bias is set to True for ConvTranspose2d, bias must have one dimension)
{v_1: bool, v_2: tensor} |= if v_1 = true then ndim(v_2) = 1
>>
Rule 1138 (For ConvTranspose2d, if the number of dimension of input tensor is four and data_format equals "NLC", it is not allowed)
{v_1: tensor, v_2: str} |= if ndim(v_1) = 4 then v_2 ≠ "NLC"
>>
Rule 1139 (If the string is tanh, it can only process Floating Point Tensors of complex Tensors)
{v_1 : str, v_2 : tensor} |= if v_1 = "tanh" then (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)
>>
Rule 1140 (If dilation size is not one, tensor number dimension should be larger than 2)
{v_1 : tensor, v_2: int} |= if v_2 ≠ 1 then ndim(v_1) > 2
>>
Rule 1141 (if the data format is provided, it should be in valid format)
{v_1: str} |= v_1 = "NLC" ∨ v_1 = "NCL" ∨ v_1 = "NHWC" ∨ v_1 = "NCHW"
>>
Rule 1142 (data_format parameter must be specified if number of dimension does not equal 4 and greater than 1)
{v_1: tensor, v_2 : str} |= if (ndim(v_1) > 1 ∧ ndim(v_1) ≠ 4) then v_2 = "NLC" ∨ v_2 = "NCL" ∨ v_2 = "NHWC" ∨ v_2 = "NCHW"
>>
Rule 1143 (When the tensor has no dimensions, then stride value must be equal to 1)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 0 then v_2 = 1
>>
Rule 1144 (If string parameter is tanh the min of tensor must be greater or equal -1 and max tensor has to be less equal 1.)
{v_1 : str, v_2 : tensor} |= if v_1 = "tanh" then (min(v_2) ≥ -1 ∧ max(v_2) ≤ 1)
>>
Rule 1145 (When scale_factor has more than one dimension the upsampling should be done only on spatial dimensions.)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > 1 then ndim(v_1) > 2
>>
Rule 1146 (For max operation if return indice == true, then indice must have element values of the int type)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then (dtype_(v_2) = 1 ∨ dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 ∨ dtype_(v_2) = 5)
>>
Rule 1147 (When bias is set to False, then number of bias tensors should be zero)
{v_1: bool, v_2: tensor} |= if v_1 = false then ndim(v_2) = 0
>>
Rule 1148 (When groups > 1, weight tensor number of dimensions has to be larger than 1)
{v_1 : tensor, v_2 : int} |= if v_2 > 1 then ndim(v_1) > 1
>>
Rule 1149 (When the String is one of "none","mean","sum","max","constant","tanh" then input tensor must have elements values of same type as its dtype)
{v_1 : str, v_2 : tensor} |= if v_1 = "none" ∨ v_1 = "mean" ∨ v_1 = "sum" ∨ v_1 = "max" ∨ v_1 = "constant" ∨ v_1 = "tanh" then ∃i ∈ [0, ndim(v_2) - 1] : (dtype_(v_2) = 1 ∨ dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4 ∨ dtype_(v_2) = 5 ∨ dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 9 ∨ dtype_(v_2) = 10)
>>
Rule 1150 (If the number of output channels is set to greater than zero, then the weight tensor needs to have a number of dimensions larger than 0 too.)
{v_1 : int, v_2 : tensor} |= if v_1 > 0 then ndim(v_2) > 0
>>
Rule 1151 (If output_size parameter is a tuple/list then the weight tensor's number of dimensions is 4)
{v_1 : tuple(int), v_2 : tensor} |= if v_1.len > 0 then ndim(v_2) = 4
>>
Rule 1152 (If the output_padding is specified and stride is provided as a tuple, then stride should have the same number of elements and higher than the padding)
{v_1: tuple(int), v_2: tuple(int)} |= if v_1.len > 0 then (v_2.len = v_1.len ∧ (∀i ∈ [0, v_1.len - 1] : v_2[i] ≥ v_1[i]))
>>
Rule 1153 (If the parameter mode is not constant, the value has to be none)
{v_1: str, v_2: int ⊎ float} |= if v_1 ≠ "constant" then v_2 = 0
>>
Rule 1154 (If the tensor shape is a constant value, all tensors have to be float 16,32 or 64 bit)
{v_1 : tensor} |= if ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1 then (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 )
>>
Rule 1155 (For batch norm affine parameter, if parameter is false then the shape is must be empty.)
{v_1 : bool, v_2 : tensor} |= if v_1 = false then shape(v_2, 0) = 0
>>
Rule 1156 (When string parameter equals to none, the shape of the output tensor and input tensor should be equal.)
{v_1 : str, v_2 : tensor, v_3 : tensor} |= if v_1 = "none" then (∀i ∈ [0, ndim(v_2)-1] : shape(v_2, i) = shape(v_3, i))
>>
Rule 1157 (when mode is equal 'tanh', the constant value must be within range -1 and 1.)
{v_1 : str, v_2 : int ⊎ float} |= if v_1 = "tanh" then v_2 ≥ -1 ∧ v_2 ≤ 1
>>
Rule 1158 (If there is a tuple called kernel, the stride, padding and output_padding should be smaller than 1 or of same size of the kernel )
{v_1 : tuple(int), v_2 : tuple(int), v_3 : tuple(int)} |= v_1.len = 2 ∧ v_2.len ≤ 2 ∧ v_3.len ≤ 2
>>
Rule 1159 (When bias parameter is False, number of parameters must be smaller than four.)
{v_1: bool, v_2: int} |= if v_1=false then v_2 < 4
>>
Rule 1160 (If kernel size is int, dilation has to have one dimension and be the same type )
{v_1 : tensor} |= ndim(v_1) = 1 ∧ (dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∨ dtype_(v_1) = 5 ∨ dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 1161 (When the data format is NLC or NCL, the last or first dimension of the input has to match input channels number.)
{v_1 : tensor, v_2 : int, v_3 : str} |= (v_3="NCL" ∧ shape(v_1, ndim(v_1) - 1) = v_2) ∨ (v_3 = "NLC" ∧ shape(v_1, 0) = v_2)
>>
Rule 1162 (If the number of input channels is not provided (is zero), then the weight tensor has to have size equal to zero in the second dimension.)
{v_1 : tensor, v_2 : int} |= if v_2 = 0 then shape(v_1, 1) = 0
>>
Rule 1163 (The output tensor must has the same data type with input if mode equal to sum.)
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "sum" then dtype_(v_1) = dtype_(v_2)
>>
Rule 1164 (If the data type is complex and stride/kernel is not 1 then the output must have same type)
{v_1 : tensor, v_2 : int, v_3 : tensor} |= if (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) ∧ v_2 ≠ 1 then (dtype_(v_1) = dtype_(v_3))
>>
Rule 1165 (When the number of output channels for the 2d convolution does not equal the number of output channels in weight, the number of groups cannot be set to 1.)
{v_1 : tensor, v_2 : int, v_3 : int} |= if shape(v_1, 0) ≠ v_2 then v_3 ≠ 1
>>
Rule 1166 (For same pad and if kernel_size or stride are different, the kernel_size or stride parameters must be specified to be a tuple)
{v_1: str, v_2: tuple(int), v_3: tuple(int)} |= if v_1 = "same" then v_2.len > 1 ∨ v_3.len > 1
>>
Rule 1167 (if the number of dimension of input is larger than one, all stride's element must be larger than 0.)
{v_1 : tensor, v_2 : tuple(int)} |= if ndim(v_1) > 1 then ∀i ∈ [0, v_2.len - 1] : v_2[i] > 0
>>
Rule 1168 (In case we want to do batch normalization, channel size must be different of size of the other element for a 4d tensor.)
{v_1 : tensor} |= if ndim(v_1) = 4 then shape(v_1,1) ≠ shape(v_1,0) ∧ shape(v_1,1) ≠ shape(v_1,2) ∧ shape(v_1,1) ≠ shape(v_1,3)
>>
Rule 1169 (For one-dimensional tensors, values should have the same dtype)
{v_1 : tensor} |= if ndim(v_1) = 1 then ∃i ∈ [0, shape(v_1, 0) -1] : dtype_(v_1) = dtype_(v_1)
>>
Rule 1170 (If the string is ii->i,  dimension zero must have shape greather or equal than dimension one.)
{v_1 : tensor, v_2 : str} |= if v_2 = "ii->i" then shape(v_1, 0) ≥ shape(v_1, 1)
>>
Rule 1171 (For conv2d, when padding mode equals 'same', the stride should divide the kernel size.)
{v_1: str, v_2: tuple(int), v_3: tuple(int)} |= if v_1 = "same" then (∃i ∈ [0, v_2.len - 1] : (v_3[i] / v_2[i]) * v_2[i] = v_3[i])
>>
Rule 1172 (If string = "tanh", all elements of tensor must belong float type.)
{v_1 : tensor, v_2 : str} |= if v_2 = "tanh" then dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 1173 (For string parameter equals to constant, then output_size must be integer, it can be integer or float data type.)
{v_1 : str, v_2 : int ⊎ float} |= if v_1 = "constant" then (v_2 / 1) * 1 = v_2
>>
Rule 1174 (If the dimension equals to one, then parameter output_size value must be larger or equals to zero. )
{v_1 : tensor, v_2 : int ⊎ float} |= if ndim(v_1) = 1 then v_2 ≥ 0
>>
Rule 1175 (For a tuple of ints, the greatest common divisor of all values must be greater than zero.)
{v_1 : tuple(int)} |= v_1.len > 0 ∧ ∃i ∈ [0,v_1.len -1] : v_1[i] > 0
>>
Rule 1176 (if bias = True and tensor data type is int, bias must belong to a union type)
{v_1 : tensor, v_2 : bool, v_3 : dtype} |= if v_1.len > 0 ∧ (v_3 = 1 ∨ v_3 = 2 ∨ v_3 = 3 ∨ v_3 = 4 ∨ v_3 = 5 ) then v_2 = true
>>
Rule 1177 (For string parameter equals to ii->i, ij->i or ,j->ij each individual letter must be on the input shape to transpose the tensor for every letter)
{v_1 : tensor, v_2 : str} |= if v_2 = "ii->i" then shape(v_1,0) = shape(v_1,1) else if v_2 = "i,j->ij" then ndim(v_1) = 2
>>
Rule 1178 (For convTranspose2d if you specify kernel_size or stride, you must provide 2 elements in tuple)
{v_1 : tuple(int)} |= v_1.len = 2
>>
Rule 1179 (If the data type is complex, input tensor size need to be a valid one)
{v_1 : tensor} |= if (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 1180 (When the shape for the weight is not specified, the output size for AdaptiveAvgPool2d is 1.)
{v_1 : tensor} |= if ndim(v_1) = 0 then shape(v_1,0) = 1
>>
Rule 1181 (For an einsum equation using "bn,anm,bm->ba" If  all inputs are the same number, then result dimensions must be the same.)
{v_1 : tensor, v_2: str} |= if v_2 = "bn,anm,bm->ba" then shape(v_1,0) = shape(v_1,1)
>>
Rule 1182 (If the string parameter value corresponds to a valid einsum equation, at least one of the tensors must be non-empty.)
{v_1: tensor, v_2: tensor, v_3: tensor, v_4 : str} |= if v_4 = "bn,anm,bm->ba" ∨ v_4 = "ii->i" ∨ v_4 = "i,j->ij" ∨ v_4 = "...ij->...ji" then (ndim(v_1) > 0 ∨ ndim(v_2) > 0 ∨ ndim(v_3) > 0)
>>
Rule 1183 (For all parameters that are int, they must have a zero value if the tensor shape is zero)
{v_1 : tensor, v_2 : int} |= if ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0 then v_2 = 0
>>
Rule 1184 (If a string corresponds to one of the valid equations, then the ndim of its tensors must be smaller or equal than 4)
{v_1 : str, v_2 : tensor} |= if v_1 = "ii->i" ∨ v_1 = "i,j->ij" ∨ v_1 = "bij,bjk->bik" ∨ v_1 = "...ij->...ji" ∨ v_1 = "bn,anm,bm->ba" then ndim(v_2) ≤ 4
>>
Rule 1185 (If the weight is a tensor and bias is none then the number of bias parameters should be zero.)
{v_1: tensor, v_2: tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) = 0
>>
Rule 1186 (if the scale_factor is of type tensor, then it only accepts a tensor of float point)
{v_1 : tensor} |= if ndim(v_1) > 0 then (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8)
>>
Rule 1187 (For parameter mode has max or constant value and at least output size is positive.)
{v_1 : str, v_2 : int ⊎ float} |= if (v_1 = "max" ∨ v_1 = "constant") then v_2 ≥ 0
>>
Rule 1188 (If scale factor is a tensor of values and one of the dimension is not specified, its data type must be an integer type (0 <= dtype <=5))
{v_1 : tensor, v_2 : tensor} |= if ndim(v_2) > 0 ∧ (∃i ∈ [0, ndim(v_2)-1] : shape(v_2, i) = 1) then (1 ≤ dtype_(v_1) ∧ dtype_(v_1) ≤ 5)
>>
Rule 1189 (The number of dimensions in stride parameters has to match a maximum of 3 dimensions in tensor)
{v_1 : tensor, v_2 : tuple(int)} |= v_2.len ≤ 3 ∧ ndim(v_1) ≤ 3
>>
Rule 1190 (If the padding mode is specified as a constant, and complex input tensors are used, complex type is necessary)
{v_1: tensor, v_2: str} |= if (dtype_(v_1) = 9 ∨ dtype_(v_1) = 10) ∧ v_2 = "constant" then (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0 )
>>
Rule 1191 (If the string is tanh, tensor has to have more than one element to make sense.)
{v_1: str, v_2: tensor} |= if v_1 = "tanh" then ∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0
>>
Rule 1192 (If the tensor has one dimension, the stride can not be different of kernel size)
{v_1: tensor, v_2: tuple(int)} |= if ndim(v_1) = 1 then v_2.len = 1
>>
Rule 1193 (For the mode = constant, the number of values for the constant value should be less or equal than number of channel_number if it is present or less or equal with 3 dimensions.)
{v_1 : tensor, v_2: int} |= shape(v_1,0) ≤ v_2 ∨ ndim(v_1) <= 3
>>
Rule 1194 (If tensor size of the certain dimension in conv2d layer is 1, dilation parameter must equal one)
{v_1 : tensor, v_2: int} |= if ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1 then v_2 = 1
>>
Rule 1195 (If the group size is more than one for a convolution layer with weight, then (number of channels / number of groups) has to have 1 element)
{v_1: tensor, v_2: int} |= if (ndim(v_1) > 0 ∧ v_2 > 1) then (shape(v_1, 1) / v_2) = 1
>>
Rule 1196 (For einsum op, the number of dimensions of output has to be a valid one )
{v_1 : tensor, v_2 : str} |= if v_2 = "ii->i" ∨ v_2 = "i,j->ij" ∨ v_2 = "bij,bjk->bik" ∨ v_2 = "...ij->...ji" ∨ v_2 = "bn,anm,bm->ba" then ndim(v_1) > 0
>>
Rule 1197 (When the tensor's dtype is complex (9 or 10), the padding has to be 0)
{v_1 : tensor, v_2 : int} |= if dtype_(v_1) = 9 ∨ dtype_(v_1) = 10 then v_2 = 0
>>
Rule 1198 (Suppressing argmin error when input tensor has zero elements)
{v_1 : tensor} |= shape(v_1, 0) > 0 ∨ ndim(v_1) > 1
>>
Rule 1199 (Output argument 'out' must be a tensor)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_2) = dtype_(v_1)
>>
Rule 1200 (index tensor v_2 should be within the range of the number of embeddings in v_1)
{v_1 : tensor, v_2 : tensor} |= min(v_2) ≥ 0 ∧ max(v_2) < shape(v_1, 0)
>>
Rule 1201 (Output argument 'out' must be of floating point dtype when input is floating point)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 6) ∧ (dtype_(v_2) = 7 ∨ dtype_(v_2) = 8 ∨ dtype_(v_2) = 6)
>>
Rule 1202 (dim and shape arguments must have the same length)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2)
>>
Rule 1203 (Indices tensor (v_2) should have the same shape as input tensor (v_1) except the channel dimension)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ ∀i ∈ [1, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, i)
>>
Rule 1204 (Target (v_1) and variance (v_2) tensors should have compatible shapes)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 1) = shape(v_2, 1)
>>
Rule 1205 (Input tensor v_1 must be of integer type)
{v_1 : tensor} |= dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4
>>
Rule 1206 (Input (v_1) and target (v_2) tensors should have compatible shapes)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) = ndim(v_2) ∧ shape(v_1, 0) = shape(v_2, 0)
>>
Rule 1207 (Input tensors must be of integer type)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) = 1 ∨ dtype_(v_1) = 2 ∨ dtype_(v_1) = 3 ∨ dtype_(v_1) = 4 ∧ dtype_(v_2) = 1 ∨ dtype_(v_2) = 2 ∨ dtype_(v_2) = 3 ∨ dtype_(v_2) = 4
>>
Rule 1208 (Expanded size (v_2) must be compatible with existing size (v_1))
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) = shape(v_2, 0) ∨ shape(v_1, 0) = 1 ∨ shape(v_2, 0) = 1 ∨ shape(v_1, 0) = 0
>>
Rule 1209 (Input tensors (v_1, v_2) must have compatible shapes along dimension 0)
{v_1 : tensor, v_2 : tensor} |= shape(v_1, 0) = shape(v_2, 0)
>>
Rule 1210 (Input tensor (v_1) must be of float type)
{v_1 : tensor} |= dtype_(v_1) = 7
>>
Rule 1211 (Input tensors v_1 and v_2 must have the same shape)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) > ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : (i >= ndim(v_1) ∨ i >= ndim(v_2) ∨ shape(v_1, i) = shape(v_2, i))
>>
Rule 1212 (Input tensors v_1 and v_2 must have compatible shapes for broadcasting)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) > ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : (i >= ndim(v_1) ∨ i >= ndim(v_2) ∨ shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i) ∨ shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = 1)
>>
Rule 1213 (Probability p must be between 0 and 1 inclusive)
{v_1 : float} |= v_1 ≥ 0 ∧ v_1 ≤ 1
>>
Rule 1214 (Input tensor must have at least 2 dimensions)
{v_1 : tensor} |= ndim(v_1) ≥ 2
>>
Rule 1215 (Input list of tensors v_1 must not be empty)
{v_1 : tensor} |= ndim(v_1) > 0 ∧ shape(v_1, 0) > 0
>>
Rule 1216 (Input tensor must be of floating-point type)
{v_1 : tensor} |= dtype_(v_1) = 7 ∨ dtype_(v_1) = 8
>>
Rule 1217 (Input and target tensors must be of floating-point type)
{v_1 : tensor, v_2 : tensor} |= (dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8) ∧ (dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8)
>>
Rule 1218 (Input tensor must be of Double type)
{v_1 : tensor} |= dtype_(v_1) = 8
>>
Rule 1219 (All dimensions in the shape of input tensor v_1 must be non-negative)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≥ 0
>>
Rule 1220 (Input tensor must have exactly one element)
{v_1 : tensor} |= ndim(v_1) = 0
>>
Rule 1221 (Input tensors v_1 and v_2 must have broadcastable shapes)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : (i ≥ ndim(v_1) ∨ i ≥ ndim(v_2) ∨ shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i) ∨ shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = 1)
>>
Rule 1222 (The list of tensors v_1 must contain at least 2 tensors)
{v_1 : tensor} |= ndim(v_1) > 0 ∧ shape(v_1, 0) ≥ 2
>>
Rule 1223 (The running_mean tensor v_2 should contain v_1 elements)
{v_1 : int, v_2 : tensor} |= shape(v_2, 0) = v_1
>>
Rule 1224 (Number of steps v_1 must be non-negative)
{v_1 : int} |= v_1 ≥ 0
>>
Rule 1225 (Input tensors v_1 and v_2 must have broadcastable shapes)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) > ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : (i >= ndim(v_1) ∨ i >= ndim(v_2) ∨ shape(v_1, i) = shape(v_2, i) ∨ shape(v_1, i) = 1 ∨ shape(v_2, i) = 1)
>>
Rule 1226 (Pivots v_2 must be within the range [1, LU.size(-2)])
{v_1 : tensor, v_2 : tensor} |= min(v_2) ≥ 1 ∧ max(v_2) ≤ shape(v_1, ndim(v_1) - 2)
>>
Rule 1227 (Input height and width must be large enough given padding sizes)
{v_1 : tensor, v_2 : int} |= shape(v_1, ndim(v_1) - 2) > v_2 ∧ shape(v_1, ndim(v_1) - 1) > v_2
>>
Rule 1228 (Input v_1 must be a tensor)
{v_1 : tensor} |= ndim(v_1) ≥ 0
>>
Rule 1229 (The input tensor v_1 must have a non-zero size along the specified dimension)
{v_1 : tensor, v_2 : int} |= shape(v_1, v_2) > 0
>>
Rule 1230 (The input tensors v_1 and v_2 should have broadcastable shapes)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, if ndim(v_1) ≥ ndim(v_2) then ndim(v_1) - 1 else ndim(v_2) - 1] : (i >= ndim(v_1) ∨ i >= ndim(v_2) ∨ shape(v_1, ndim(v_1) - 1 - i) = shape(v_2, ndim(v_2) - 1 - i) ∨ shape(v_1, ndim(v_1) - 1 - i) = 1 ∨ shape(v_2, ndim(v_2) - 1 - i) = 1)
>>
Rule 1231 (The output dtype v_2 should be able to accommodate the input dtype v_1 without narrowing)
{v_1 : tensor, v_2 : tensor} |= dtype_(v_1) ≤ dtype_(v_2)
>>
Rule 1232 (Input tensor must be of floating-point or integer type)
