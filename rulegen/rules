{v_1 : tensor} |= if (dtype_(v_1) ≠ 0 ∧ dtype_(v_1) ≠ 11) ∧ ndim(v_1) = 2 ∧ (shape(v_1, 0) * shape(v_1, 1) < 10) then max(v_1) ≥ -10
