Rule 30 (If tensor has two dimensions, dimension sizes should have a specific ratio)
{v_1 : tensor, v_2 : int} |= if ndim(v_1) = 2 then shape(v_1, 0) = shape(v_1, 1) * v_2 else true
>>
Rule 31 (if shape is greater than 10, all elements in tensor must be greater than zero)
{v_1 : tensor} |= if shape(v_1, 0) > 10 then min(v_1) > 0 else true
>>
Rule 32 (If int or float, should be greater than the min of the tensor)
{v_1 : int ⊎ float, v_2 : tensor} |= v_1 > min(v_2)
>>
Rule 33 (If dimension size is odd, dtype must be int)
{v_1 : tensor} |= if shape(v_1, 0) / 2 ≠ shape(v_1, 0) / 2.0 then dtype(v_1) = 1 ∨ dtype(v_1) = 2 ∨ dtype(v_1) = 3 ∨ dtype(v_1) = 4 ∨ dtype(v_1) = 5 else true
>>
Rule 34 (String must start with a specific character)
{v_1 : str} |= if v_1 = "" then true else v_1 > "a"
>>
