>>
Rule 113 (If dtype of the tensor is not integer 1-5 and all values in tensor are boolean then max must be greater than -1.)
{v_1 : tensor} |= if (dtype(v_1) < 1 ∨ dtype(v_1) > 5) ∧ (min(v_1) = true ∨ min(v_1) = false) then max(v_1) > -1 else true
>>
Rule 114 (Given a float if that float * min value of Tensor is > 10)
{v_1: float, v_2:tensor} |= if ∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0 then v_1 * min(v_2) > 10 else true
>>
Rule 115 (If the string parameter is the string “max”, max of tensor 1 must be equal to max of tensor 2)
{v_1 : tensor, v_2 : tensor, v_3 : str} |= if v_3 = "max" then max(v_1) = max(v_2) else true
>>
Rule 116 (A number must be non-positive when Tensor's dtype is not integer)
{v_1 : tensor, v_2 : int ⊎ float} |= if dtype(v_1) < 1 ∨ dtype(v_1) > 5 then v_2 ≤ 0 else true
>>
Rule 117 (If tensor dtype is not a string, and dimension equal to 1, max(tensor) has to be smaller than 150)
{v_1 : tensor} |= if dtype(v_1) ≠ 11 ∧ ndim(v_1) = 1 then max(v_1) < 150 else true
>>
Rule 118 (If String var is “tensor_min”, all elements of tensor must be greater than integer variable.)
{v_1: tensor, v_2: str, v_3 : int} |= if v_2 = "tensor_min" then ∀i ∈ [0, ndim(v_1) - 1]: shape(v_1, i) > 0 ∧ min(v_1) > v_3 else true
>>
Rule 119 (If String variable is equal to "even" or "odd", then shape[0] % 2 == 0 or shape[0] % 2 == 1, respectively)
{v_1: tensor, v_2: str} |= if v_2 = "even" then shape(v_1, 0) * 0.5 = shape(v_1, 0) / 2 else if v_2 = "odd" then shape(v_1, 0) / 2 ≠ shape(v_1, 0) * 0.5 else true
>>
Rule 120 (All elements in the tensor should be greater than -500)
{v_1 : tensor} |= min(v_1) ≥ -500
>>
Rule 121 (if dimension is larger than 0, and shape[0] is larger than shape[1], a string must not be empty string)
{v_1 : tensor, v_2 : str} |= if ndim(v_1) > 0 ∧ shape(v_1, 0) > shape(v_1, 1) then v_2 ≠ "" else true
>>
Rule 122 (For an integer value if a tensor has two dimensions where shape is >5 for both dimensions, min(tensor) + int should be > max(tensor) - int)
{v_1 : tensor, v_2: int} |= if (ndim(v_1) = 2) ∧ (shape(v_1, 0) > 5) ∧ (shape(v_1, 1) > 5) then (min(v_1) + v_2) > (max(v_1) - v_2) else true
>>
Rule 123 (If tensor dtype is bool or float, then tensor must not have empty dimensions)
{v_1 : tensor} |= if dtype(v_1) = 0 ∨ dtype(v_1) = 6 ∨ dtype(v_1) = 7 ∨ dtype(v_1) = 8 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 else true
>>
Rule 124 (A string variable should not be equal to any function names)
{v_1 : str} |= v_1 ≠ "ndim" ∧ v_1 ≠ "shape" ∧ v_1 ≠ "dtype" ∧ v_1 ≠ "min" ∧ v_1 ≠ "max"
>>
Rule 125 (All dimensions of the boolean type tensors must not be more than 10 if ndim greater than 0)
{v_1 : tensor} |= if dtype(v_1) = 0 ∧ ndim(v_1) > 0 then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≤ 10 else true
>>
Rule 126 (A number should be either 0 or 1 when tensor's dtype is bool)
{v_1: tensor, v_2: int ⊎ float} |= if dtype(v_1) = 0 then v_2 = 0 ∨ v_2 = 1 else true
>>
Rule 127 (Tensor with more than one dimension should have different size in each dimension when datatype is integer)
{v_1 : tensor} |= if (ndim(v_1) > 1) ∧ (dtype(v_1) ≥ 1 ∧ dtype(v_1) ≤ 5) then ∀i ∈ [1, ndim(v_1) - 1] : shape(v_1, 0) ≠ shape(v_1, i) else true
>>
Rule 128 (If a tensor is 2 dimensional then all values should be greather than the number 150)
{v_1: tensor} |= if (ndim(v_1) = 2) then min(v_1) > 150 else true
>>
Rule 129 (If the dimension is not zero then tensor must not contain a value equal to the shape size of first dimension)
{v_1 : tensor} |= if ndim(v_1) ≠ 0 then min(v_1) ≠ shape(v_1, 0) ∧ max(v_1) ≠ shape(v_1, 0) else true
>>
Rule 130 (If dtype is np.dtype, a number that is a multiple of five and less than 350)
{v_1 : tensor, v_2 : int ⊎ float} |= if dtype(v_1) = 12 then v_2 * 5 = 0 ∧ v_2 < 70 else true
>>
Rule 131 (If tensor has more than 3 dimensions, then sum of last two shapes has to be > shape of first dimension.)
{v_1 : tensor} |= if ndim(v_1) > 3 then (shape(v_1, ndim(v_1) - 1) + shape(v_1, ndim(v_1) -2)) > shape(v_1, 0) else true
>>
Rule 132 (If the tensor data type is not string, the absolute value of a float must be greater than min of tensor)
{v_1 : tensor, v_2 : float} |= if dtype(v_1) ≠ 11 then 0 - v_2 > min(v_1) ∨ v_2 > min(v_1) else true
>>
Rule 133 (If any dimension size is <= 1, min value must be negative or zero)
{v_1 : tensor} |= if ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) ≤ 1 then min(v_1) ≤ 0 else true
>>
Rule 134 (If a string is empty, then there must exist one dimension on a tensor that has a shape greater than 10)
{v_1 : str, v_2 : tensor} |= if v_1 = "" then ∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 10 else true
>>
Rule 135 (if a float number is less than the max number and if the max number is less than first element size, the first element has to be greather than integer 1)
{v_1 : tensor, v_2: float} |= if max(v_1) > v_2 ∧ shape(v_1, 0) > max(v_1) then shape(v_1, 0) > 1 else true
>>
Rule 136 (Tensor must contain at least a single value)
{v_1 : tensor} |= ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 137 (if there is a boolean and a tensor, and the boolean is true all the dimensions of tensor should be greater than 5.)
{v_1 : bool, v_2 : tensor} |= if v_1 = true then ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 5 else true
>>
Rule 138 (If the tensor dimensions is more than 2 and data type is not boolean, check shape(1) should not be great than shape(ndim-1))
{v_1 : tensor} |= if ndim(v_1) > 2 ∧ (dtype(v_1) ≠ 0) then shape(v_1, 1) ≤ shape(v_1, ndim(v_1)-1) else true
>>
Rule 139 (If the max value in a tensor is even, then tensor's dtype must not be string)
{v_1: tensor} |= if max(v_1) * 0.5 = max(v_1) / 2 then dtype(v_1) ≠ 11 else true
>>
Rule 140 (If tensor dimension size is one, then its minimum and maximum size must be greater than -5 and less than +5)
{v_1 : tensor} |= if ndim(v_1) = 1 then (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ min(v_1) > -5 ∧ max(v_1) < 5 else true
>>
Rule 141 (String needs to have length more than 50 or min value should be negative)
{v_1 : str, v_2 : tensor} |= if v_1 > "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" then true else min(v_2) < 0
>>
Rule 142 (If a tensor has integer dtype and also a string variable is given, then the string must be equal to "int")
{v_1: tensor, v_2: str} |= if (dtype(v_1) ≥ 1 ∧ dtype(v_1) ≤ 5) then v_2 = "int" else true
>>
Rule 143 (If a tensor has boolean dtype and the number is either 0 or 1, it means max must be either "false" or "true")
{v_1 : tensor, v_2 : int ⊎ float} |= if (dtype(v_1) = 0) ∧ (v_2 = 0 ∨ v_2 = 1) then (max(v_1) = "true") ∨ (max(v_1) = "false") else true
>>
Rule 144 (If the value is an integer or float and less than zero, then tensor's shape has to be empty on any dimension)
{v_1 : int ⊎ float, v_2 : tensor} |= if v_1 < 0 then (∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) = 0) else true
>>
Rule 145 (If tensor data type is int, then maximum of that tensor to the power of 2 is still inside of integer limit)
{v_1 : tensor} |= if dtype(v_1) ≥ 1 ∧ dtype(v_1) ≤ 5 then max(v_1) * max(v_1) ≤ 9223372036854775807 else true
>>
Rule 146 (If tensor has bool value, then there should be any element which value is true and other element's value is false)
{v_1 : tensor} |= if dtype(v_1) = 0 then (∃i ∈ [0, ndim(v_1) - 1] : (∃j ∈ [0, shape(v_1, i) - 1]: v_1 = true) ∧ (∃k ∈ [0, shape(v_1, i) - 1]: v_1 = false)) else true
>>
Rule 147 (If there are two tensors, v1's dimension times the square of v2 max value should be smaller than 100)
{v_1 : tensor, v_2 : tensor} |= if (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) ∧ (∃i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0) then ndim(v_1) * max(v_2) * max(v_2) < 100 else true
>>
Rule 148 (If the input tensor must be 1-dimensional and data type must be Integer, then tensor min value should be larger than 10)
{v_1 : tensor} |= if (ndim(v_1) = 1) ∧ (dtype(v_1) ≥ 1 ∧ dtype(v_1) ≤ 5) then min(v_1) > 10 else true
>>
Rule 149 (If the tensor's dimension is positive, then the sum of max and min value should not be great than 100)
{v_1 : tensor} |= if ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 then max(v_1) + min(v_1) ≤ 100 else true
>>
Rule 150 (If dtype is complex, all elements should have a complex value where min < 0 and max > 0 )
{v_1: tensor} |= if (dtype(v_1) = 9 ∨ dtype(v_1) = 10) then min(v_1) < 0 ∧ max(v_1) > 0 else true
>>
Rule 151 (If any of the shape dimensions is odd and tensor dtype is bool, all elements in tensor must be false)
{v_1: tensor} |= if ∃i ∈ [0, ndim(v_1) - 1]: shape(v_1, i) / 2 ≠ shape(v_1, i) * 0.5 ∧ dtype(v_1) = 0 then min(v_1) = false ∧ max(v_1) = false else true
>>
Rule 152 (If the value is not a string and not a boolean , but has same value of the max in tensor, then it will be an invalid parameter)
{v_1: tensor, v_2: int ⊎ float} |= if (dtype(v_1) ≠ 0 ∧ dtype(v_1) ≠ 11) then v_2 ≠ max(v_1) else true
>>
Rule 153 (If the data type is float and a tensor has dimension equal to 3, then all the shapes dimension needs to be same)
{v_1 : tensor} |= if (dtype(v_1) ≥ 6 ∧ dtype(v_1) ≤ 8) ∧ (ndim(v_1) = 3) then ∀i ∈ [1, ndim(v_1) - 1] : shape(v_1, 0) = shape(v_1, i) else true
>>
Rule 154 (If the dtype is string and tensor has more than one dimension and string value is bigger than "hello," all shapes needs to be smaller than 10)
{v_1 : tensor, v_2 : str} |= if (dtype(v_1) = 11) ∧ (ndim(v_1) > 1) ∧ (v_2 > "hello") then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) < 10 else true
>>
Rule 155 (If max element in tensor is greater than 10 and the number of dimensions is more than 0 then shape[0] * 2 must be less than int)
{v_1 : tensor} |= if max(v_1) > 10 ∧ ndim(v_1) > 0 then shape(v_1, 0) * 2 < 9223372036854775807 else true
>>
Rule 156 (If the first shape dimension is a power of 2, and the tensor has more than 2 dimensions then a new integer parameter must have a value that falls within the range of the tensor)
{v_1 : tensor, v_2 : int} |= if (shape(v_1, 0) ∧ (shape(v_1, 0) - 1)) = 0 ∧ ndim(v_1) > 2 then v_2 ≥ min(v_1) ∧ v_2 ≤ max(v_1) else true
>>
Rule 157 (For a bool tensor if the max is true ,the dimension must be 2 or less)
{v_1: tensor} |= if (dtype(v_1) = 0) ∧ (max(v_1) = true) then ndim(v_1) ≤ 2 else true
>>
Rule 158 (If dtype is int, tensor must have same min and max value if string == same)
{v_1 : tensor, v_2 : str} |= if (dtype(v_1) >= 1) ∧ (dtype(v_1) <=5) ∧ (v_2 = "same") then (max(v_1) = min(v_1)) else true
>>
Rule 159 (if all the shape dimension is same, the the minimum and maximum has to have equal absolute value)
{v_1 : tensor} |= if ∀i ∈ [1, ndim(v_1) - 1] : shape(v_1, 0) = shape(v_1, i) then 0 - min(v_1) = max(v_1) else true
>>
Rule 160 (If there is an integer or float value, the max value of the tensor must be divisable by the integer or float value)
{v_1 : tensor, v_2: int ⊎ float} |= max(v_1) * (1 / v_2) = max(v_1) / v_2
>>
Rule 161 (if tensor contains boolean dtype , then sum of shape is equal to a given interger parameter)
{v_1 : tensor, v_2 : int} |= if dtype(v_1) = 0 then ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, 0) + shape(v_1, i) = v_2 else true
>>
Rule 162 (If the floating number * 2 is larger than 100, min value must be greater than the shape value of 0)
{v_1 : float, v_2 : tensor} |= if v_1 * 2 > 100 then min(v_2) > shape(v_2, 0) else true
>>
Rule 163 (If the dimension sizes are more than zero and smaller than one then max of that tensor must be non-positive)
{v_1 : tensor} |= if ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 ∧ shape(v_1, i) < 1 then max(v_1) <= 0 else true
>>
Rule 164 (if tensor has a floating point type, it must be not empty AND all values inside it are different than 0)
{v_1 : tensor} |= if (dtype(v_1) ≥ 6 ∧ dtype(v_1) ≤ 8) then ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 ∧ min(v_1) ≠ 0 ∧ max(v_1) ≠ 0 else true
>>
Rule 165 (if there is a float number in any of dimension that value should smaller than 5 * value)
{v_1 : tensor, v_2 : float} |= if ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 then shape(v_1, 0) < v_2 * 5 else true
>>
Rule 166 (If dtype is an integer and has at least two dimensions, then sum of elements in shape must be positive)
{v_1 : tensor} |= if (dtype(v_1) ≥ 1 ∧ dtype(v_1) ≤ 5) ∧ ndim(v_1) ≥ 2 then ∃i ∈ [1, ndim(v_1) - 1] : shape(v_1, 0) + shape(v_1, i) > 0 else true
>>
Rule 167 (If a bool is false and then dtype should be integer 1 to 5, shape's first value must be even)
{v_1 : bool, v_2 : tensor} |= if v_1 = false ∧ (dtype(v_2) ≥ 1 ∧ dtype(v_2) ≤ 5) then (shape(v_2, 0) * 0.5) = (shape(v_2, 0) / 2) else true
>>
Rule 168 ( If there is an integer variable and tensor has a floating-point number dtype then the integer variable must be smaller than the average of the max and min )
{v_1 : int, v_2 : tensor} |= if (dtype(v_2) = 6 ∨ dtype(v_2) = 7 ∨ dtype(v_2) = 8) then v_1 < (max(v_2) + min(v_2)) / 2 else true
>>
Rule 169 (If String has value "less" and float has value larger than 0, than value from min of Tensor must be great than floting parameter multply by 2)
{v_1: tensor, v_2: str, v_3: float} |= if (v_2 = "less") ∧ (v_3 > 0) then min(v_1) > (v_3 *2) else true
>>
Rule 170 (if the shape dimensions values are greater than 2, dtype must not be boolean)
{v_1 : tensor} |= if ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 2 then dtype(v_1) ≠ 0 else true
>>
Rule 171 (If the tensor's data type is a string and its min is not an empty string, the sum of its shape dimensions should be at least 5)
{v_1: tensor} |= if (dtype(v_1) = 11) ∧ (min(v_1) ≠ "") then ∃i ∈ [0, ndim(v_1)-1]: shape(v_1, i) > 0 ∧ ∀i ∈ [1, ndim(v_1) - 1]: shape(v_1, 0) + shape(v_1, i) > 5 else true
>>
Rule 172 (If tensor is bool type and not empty then minimum value in the tensor must not be greater than 1)
{v_1 : tensor} |= if dtype(v_1) = 0 ∧ (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) then min(v_1) ≤ 1 else true
>>
Rule 173 (A float or integer value needs to be in range of each shape size on every dimension in tensor)
{v_1: tensor, v_2 : int ⊎ float} |= ∀i ∈ [0, ndim(v_1) - 1]: v_2 ≥ 0 ∧ v_2 ≤ shape(v_1, i)
>>
Rule 174 (If dtype is float, then max value should not be positive if all shape values are equal to each other)
{v_1 : tensor} |= if (dtype(v_1) ≥ 6 ∧ dtype(v_1) ≤ 8) ∧ (∀i ∈ [1, ndim(v_1) - 1] : shape(v_1, 0) = shape(v_1, i)) then max(v_1) ≤ 0 else true
>>
Rule 175 (if a float is negative and tensor is two dimensional then shape 1 should greater than zero)
{v_1 : tensor, v_2 : float} |= if v_2 < 0 ∧ (ndim(v_1) = 2) then shape(v_1, 1) > 0 else true
>>
Rule 176 (If max of the tensor's absolute values is less than 1, data type shouldn't be uint8)
{v_1: tensor} |= if max(v_1) < 1 then dtype(v_1) ≠ 5 else true
>>
Rule 177 (If the minimum of any two tensor dimensions is zero, data type must be string)
{v_1 : tensor} |= if ∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 0 then dtype(v_1) = 11 else true
>>
Rule 178 (If tensor has a dimension value equal to 1, and has at least another dimension, the data type cannot be boolean)
{v_1 : tensor} |= if (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = 1) ∧ (ndim(v_1) > 1) then dtype(v_1) ≠ 0 else true
>>
Rule 179 (If the max value is larger than 10, all dimensions must be same value)
{v_1 : tensor} |= if max(v_1) > 10 then ∀i ∈ [1, ndim(v_1) - 1] : shape(v_1, 0) = shape(v_1, i) else true
>>
Rule 180 (If the integer variable is greater than 100, the dtype of the tensor must be a float)
{v_1: tensor, v_2: int} |= if v_2 > 100 then dtype(v_1) = 6 ∨ dtype(v_1) = 7 ∨ dtype(v_1) = 8 else true
>>
Rule 181 (If all the shape values of the input tensor are equal and the shape is not empty then the data type must be int 8 or int 16 or int 32 or int 64)
{v_1 : tensor} |= if (∀i ∈ [1, ndim(v_1) - 1] : shape(v_1, 0) = shape(v_1, i)) ∧ (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0) then dtype(v_1) = 1 ∨ dtype(v_1) = 2 ∨ dtype(v_1) = 3 ∨ dtype(v_1) = 4 else true
>>
Rule 182 (If there is a boolean variable that is true, all the element must be positive value ( min > 0 ))
{v_1: tensor, v_2 : bool} |= if v_2 = true then min(v_1) > 0 else true
>>
Rule 183 (String variable and the tensor maximum value must not be same as True or False)
{v_1: tensor, v_2: str} |= (v_2 ≠ "true") ∧ (v_2 ≠ "false") ∧ (max(v_1) ≠ "true") ∧ (max(v_1) ≠ "false")
>>
Rule 184 (Check if all shape dimensions of input tensor match shape of the other tensor)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0 ∧ ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) = shape(v_2, 0)
>>
Rule 185 (If a string is not equals “true” all min values must not be greater than zero)
{v_1 : tensor, v_2 : str} |= if v_2 ≠ "true" then min(v_1) ≤ 0 else true
>>
Rule 186 (If tensor has one dimension and has type integer and float value is not smaller than -1)
{v_1: tensor, v_2: float} |= if (ndim(v_1) = 1) ∧ (dtype(v_1) ≥ 1 ∧ dtype(v_1) ≤ 5) then v_2 > -1 else true
>>
Rule 187 (if the min of a tensor is > 0 and dtype == bool, the max value should be true)
{v_1 : tensor} |= if (min(v_1) > 0) ∧ (dtype(v_1) = 0) then max(v_1) = true else true
>>
Rule 188 (If the tensor's shape is a square matrix (2 dimensions with same shape), then it must be floating point)
{v_1 : tensor} |= if (ndim(v_1) = 2) ∧ (shape(v_1, 0) = shape(v_1, 1)) then (dtype(v_1) ≥ 6 ∧ dtype(v_1) ≤ 8) else true
>>
Rule 189 (if dimension of tensor is 0, then it must be a string)
{v_1 : tensor} |= if ndim(v_1) = 0 then dtype(v_1) = 11 else true
>>
Rule 190 (If there are two tensors and tensor_1 dtype isn't string and dimension of tensor2 is smaller than 4 then shape(1,2) should be smaller than max of tensor1)
{v_1: tensor, v_2: tensor} |= if dtype(v_1) ≠ 11 ∧ ndim(v_2) < 4 then shape(v_1,0) < max(v_2) else true
>>
Rule 191 (if shape value in dim 0,1,2 are different, the tensor data type can't be bool)
{v_1: tensor} |= if (ndim(v_1) > 2) ∧ shape(v_1, 0) ≠ shape(v_1, 1) ∧ shape(v_1, 1) ≠ shape(v_1, 2) ∧ shape(v_1, 0) ≠ shape(v_1, 2) then dtype(v_1) ≠ 0 else true
>>
Rule 192 (Given a float is not 0 , and a tensor has a string dtype , then the floating parameter can only be 0 or 1)
{v_1 : tensor, v_2 : float} |= if (v_2 ≠ 0) ∧ dtype(v_1) = 11 then (v_2 = 0 ∨ v_2 = 1) else true
>>
Rule 193 (If the number of dimension on two tensors are equal, then the max of first tensor must not be equals to the minimum of the second dimension)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) = ndim(v_2) then max(v_1) ≠ min(v_2) else true
>>
Rule 194 (if the floating number * 2 is less than 2 , data type must not be in np.float32)
{v_1 : tensor, v_2 : float} |= if (v_2 * 2 < 2) then (dtype(v_1) ≠ 7) else true
>>
Rule 195 (If tensor value is string or integer, string must be in range [0,256])
{v_1 : tensor} |= if (dtype(v_1) = 11) ∨ (dtype(v_1) >= 1 ∧ dtype(v_1) <= 5) then max(v_1) ≤ 256 ∧ min(v_1) ≥ 0 else true
>>
Rule 196 (if the first shape is not 0 then, minimum element of tensor cannot be equal to Integer parameter.)
{v_1 : tensor, v_2 : int} |= if shape(v_1, 0) ≠ 0 then min(v_1) ≠ v_2 else true
>>
Rule 197 (If tensor has more than 1 dimensions and the shape is same for every dimensions, then it can't contain a boolean value)
{v_1 : tensor} |= if (ndim(v_1) > 1) ∧ (∀i ∈ [1, ndim(v_1) - 1] : shape(v_1, 0) = shape(v_1, i)) then dtype(v_1) ≠ 0 else true
>>
Rule 198 (Check a 1D tensor (string) with two specific strings)
{v_1 : tensor} |= if ndim(v_1) = 1 ∧ (dtype(v_1) = 11) then ∃i ∈ [0,0] : (v_1 = "Hello") ∨ (v_1 = "World") else true
>>
Rule 199 (If a float number is given, a one dimensional shape value of the tensor must be equal to 1 or float should be less than -10)
{v_1 : tensor, v_2 : float} |= if ndim(v_1) = 1 then shape(v_1, 0) = 1 ∨ v_2 < -10 else true
>>
Rule 200 (For all dimensions > 2 all shape values need to be greater than maximum value when dtype is float32 or float 64 and minimum shape has to be less than that)
{v_1: tensor} |= if (ndim(v_1) > 2) ∧ ((dtype(v_1) = 7) ∨ (dtype(v_1) = 8)) then (∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > max(v_1)) ∧ (∃i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) < max(v_1)) else true
