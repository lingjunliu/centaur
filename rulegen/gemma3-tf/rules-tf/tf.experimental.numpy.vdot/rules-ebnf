Rule 1 (Input tensors must have the same shape)
{v_1 : tensor, v_2 : tensor} |= shape(v_1) = shape(v_2)
>>
Rule 3 (Check for non-empty tensors)
{v_1 : tensor, v_2 : tensor} |= ndim(v_1) > 0 ∧ ndim(v_2) > 0
>>
Rule 11 (Dimension check for 1D tensors)
{v_1 : tensor, v_2 : tensor} |= (ndim(v_1) = 1 ∧ ndim(v_2) = 1) ∧ (shape(v_1) = shape(v_2))
>>
Rule 12 (Check for non-negative tensor shape values)
{v_1 : tensor, v_2 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0 ∧ ∀i ∈ [0, ndim(v_2) - 1] : shape(v_2, i) > 0
>>
Rule 24 (If the tensors have at least one dimension, the last dimension must match)
{v_1 : tensor, v_2 : tensor} |= if ndim(v_1) > 0 ∧ ndim(v_2) > 0 then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1)
>>
Rule 30 (Tensor dimensions must be positive integers)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 32 (If the tensors have at least one dimension, the last dimension must match)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) > 0 ∧ ndim(v_2) > 0) then shape(v_1, ndim(v_1) - 1) = shape(v_2, ndim(v_2) - 1)
>>
Rule 33 (v_2 should be a valid dimension of input tensor)
{v_1 : tensor, v_2 : int} |= -1 * ndim(v_1) ≤ v_2 ∧ v_2 < ndim(v_1)
>>
Rule 34 (list of ints used as dimensions/axes, all non-negative and valid for tensor shape)
{v_1 : tensor, v_2 : list(int)} |= ∀i ∈ [0, v_2.len - 1] : 0 ≤ v_2[i] ∧ v_2[i] < ndim(v_1)
>>
Rule 35 (tensor shape matches given tuple shape)
{v_1 : tensor, v_2 : tuple(int)} |= ndim(v_1) = v_2.len ∧ ∀i ∈ [0, v_2.len - 1] : shape(v_1, i) = v_2[i]
>>
Rule 47 (Dimension 0 must be equal)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) > 0 ∧ ndim(v_2) > 0) then shape(v_1, 0) = shape(v_2, 0)
>>
Rule 48 (Dimension 1 must be equal)
{v_1 : tensor, v_2 : tensor} |= if (ndim(v_1) > 1 ∧ ndim(v_2) > 1) then shape(v_1, 1) = shape(v_2, 1)
