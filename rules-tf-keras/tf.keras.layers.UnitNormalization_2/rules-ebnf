{v_1 : tuple(int), v_2 : tensor} |= ∀i ∈ [0, v_1.len - 1] : if v_1[i] ≥ 0 then shape(v_2, v_1[i]) > 0 else shape(v_2, v_1[i] + ndim(v_2)) > 0
