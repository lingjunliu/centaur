Rule 3 (Input tensor to Activation layer must have at least 1 dimension)
{v_1 : tensor} |= ndim(v_1) ≥ 1
>>
Rule 4 (Softmax activation requires the input tensor to have at least one dimension)
{v_1 : str, v_2 : tensor} |= if v_1 = "softmax" then ndim(v_2) ≥ 1
>>
Rule 8 (Allowed data types for the input tensor)
{v_1 : tensor} |= dtype_(v_1) = 6 ∨ dtype_(v_1) = 7 ∨ dtype_(v_1) = 8 ∨ dtype_(v_1) = 9 ∨ dtype_(v_1) = 10
>>
Rule 9 (Input tensor must not be a boolean tensor)
{v_1 : tensor} |= dtype_(v_1) ≠ 0
>>
Rule 10 (Softmax activation requires the last dimension size of the input tensor to be at least 1)
{v_1 : str, v_2 : tensor} |= if v_1 = "softmax" then ndim(v_2) ≥ 1 ∧ shape(v_2, ndim(v_2) - 1) ≥ 1
>>
Rule 11 (Input tensor dimensions should be between 1 and 5 inclusive)
{v_1 : tensor} |= ndim(v_1) ≥ 1 ∧ ndim(v_1) ≤ 5
>>
Rule 12 (SELU activation requires floating-point input tensor)
{v_1 : str, v_2 : tensor} |= if v_1 = "selu" then dtype_(v_2) = 6 ∨ dtype_(v_2) = 7 ∨ dtype_(v_2) = 8
>>
Rule 13 (The layer dtype should be a floating-point type)
{v_1 : dtype} |= v_1 = 6 ∨ v_1 = 7 ∨ v_1 = 8
>>
Rule 14 (All dimensions of the input tensor must have a size greater than 0)
{v_1 : tensor} |= ∀i ∈ [0, ndim(v_1) - 1] : shape(v_1, i) > 0
>>
Rule 15 (If input tensor is 4-dimensional, its channel dimension must be at least 1)
{v_1 : tensor} |= if ndim(v_1) = 4 then shape(v_1, 3) ≥ 1
>>
Rule 16 (To prevent overflow, the maximum value of the input tensor for exponent-based activations should be bounded)
{v_1 : str, v_2 : tensor} |= if v_1 = "softmax" ∨ v_1 = "sigmoid" ∨ v_1 = "elu" ∨ v_1 = "softplus" then max(v_2) ≤ 100000
>>
Rule 17 (To avoid the dying ReLU problem, the input tensor should have at least one positive value)
{v_1 : str, v_2 : tensor} |= if v_1 = "relu" then max(v_2) > 0
