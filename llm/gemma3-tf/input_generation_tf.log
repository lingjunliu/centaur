import tensorflow as tf
import numpy as np
import copy

tf.config.experimental.enable_op_determinism()
tf.random.set_seed(42)

def tf_experimental_numpy_signbit_inputs():
    list_of_inputs = []
    
    x = np.array([-1.0, -2.0, -3.0])
    list_of_inputs.append({"tf.experimental.numpy.signbit": tf.convert_to_tensor(x, dtype=np.float32)})
    
    x = np.array([1.0, 2.0, 3.0])
    list_of_inputs.append({"tf.experimental.numpy.signbit": tf.convert_to_tensor(x, dtype=np.float64)})

    x = np.array([0.0, -0.0, 0.0])
    list_of_inputs.append({"tf.experimental.numpy.signbit": tf.convert_to_tensor(x, dtype=np.float16)})

    x = np.array([[-1.0, 2.0], [3.0, -4.0]])
    list_of_inputs.append({"tf.experimental.numpy.signbit": tf.convert_to_tensor(x, dtype=np.float32)})
    
    x = np.array([[[1.0], [-2.0]], [[3.0], [-4.0]]])
    list_of_inputs.append({"tf.experimental.numpy.signbit": tf.convert_to_tensor(x, dtype=np.float64)})

    x = np.array([1e-8, -1e-8, 0.0])
    list_of_inputs.append({"tf.experimental.numpy.signbit": tf.convert_to_tensor(x, dtype=np.float32)})

    return list_of_inputs

