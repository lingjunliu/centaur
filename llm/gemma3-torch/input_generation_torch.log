def dequantize_inputs():
    list_of_inputs = []
    
    input1 = torch.quantize_per_tensor(torch.randn(3), scale=2.0, zero_point=0, dtype=torch.qint8)
    list_of_inputs.append({"tensor": input1.numpy()})

    input2 = torch.quantize_per_tensor(torch.randn(2, 4), scale=1.0, zero_point=0, dtype=torch.qint8)
    list_of_inputs.append({"tensor": input2.numpy()})

    input3 = torch.quantize_per_tensor(torch.randn(5, 5, 5), scale=0.5, zero_point=1, dtype=torch.qint8)
    list_of_inputs.append({"tensor": input3.numpy()})

    input4 = torch.quantize_per_tensor(torch.randn(2, 2), scale=3.0, zero_point=-2, dtype=torch.qint8)
    list_of_inputs.append({"tensor": input4.numpy()})

