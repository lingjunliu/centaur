    list_of_inputs.append({"tensor": input5.numpy()})
    
    input6 = torch.quantize_per_tensor(torch.randn(10, 10, 10, 10), scale=1.5, zero_point=0, dtype=torch.qint8)
    list_of_inputs.append({"tensor": input6.numpy()})

