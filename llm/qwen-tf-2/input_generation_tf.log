    x = np.array([[1.0, 2.0], [3.0, 4.0]], dtype=np.float64)
    input_dict = {'name': 'test_7', 'x': x}
    list_of_inputs.append(copy.deepcopy(input_dict))
    
    # Input 8: Half type
    x = np.array([[1.0, 2.0], [3.0, 4.0]], dtype=np.float16)
    input_dict = {'name': 'test_8', 'x': x}
    list_of_inputs.append(copy.deepcopy(input_dict))
    
