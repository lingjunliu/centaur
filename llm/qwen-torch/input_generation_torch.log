    list_of_inputs.append(copy.deepcopy({"input": input_arr, "out": out_arr}))

    # 8) 1D complex64
    input_arr = torch.tensor([1+1j, -2-0.5j, 0+3j], dtype=torch.complex64).numpy()
    out_arr = np.empty_like(input_arr)
