import torch, copy, numpy as np

def block_diag_inputs():
    list_of_inputs = []

    # Input 1: two 2x2 float32 matrices with negatives
    t1 = torch.tensor([[1.5, -2.0],
                       [3.0,  4.5]], dtype=torch.float32).numpy()
    t2 = torch.tensor([[0.0, 7.0],
                       [-8.0, 9.0]], dtype=torch.float32).numpy()
    list_of_inputs.append(copy.deepcopy({"tensors": [t1, t2]}))

    # Input 2: three matrices with different rectangular shapes (float64)
    a = torch.tensor([[1.0, 2.0, 3.0]], dtype=torch.float64).numpy()          # 1x3
    b = torch.tensor([[4.0, 5.0],
                      [6.0, 7.0]], dtype=torch.float64).numpy()               # 2x2
    c = torch.tensor([[8.0],
                      [9.0],
                      [10.0]], dtype=torch.float64).numpy()                   # 3x1
    list_of_inputs.append(copy.deepcopy({"tensors": [a, b, c]}))

    # Input 3: int64
    m1 = torch.tensor([[1, 2, 3],
                       [4, 5, 6]], dtype=torch.int64).numpy()
    m2 = torch.tensor([[7, 8],
                       [9, 10],
                       [11, 12]], dtype=torch.int64).numpy()
    list_of_inputs.append(copy.deepcopy({"tensors": [m1, m2]}))

    # Input 4: bool dtype
    b1 = torch.tensor([[True, False, True],
                       [False, True, False]], dtype=torch.bool).numpy()
    b2 = torch.tensor([[True]], dtype=torch.bool).numpy()
    list_of_inputs.append(copy.deepcopy({"tensors": [b1, b2]}))

    # Input 5: complex64
    c1 = torch.tensor([[1+2j, 3-4j],
                       [-5+0.5j, 6j]], dtype=torch.complex64).numpy()
    c2 = torch.tensor([[0-1j, 2+0j, -3-3j]], dtype=torch.complex64).numpy()
    list_of_inputs.append(copy.deepcopy({"tensors": [c1, c2]}))

    # Input 6: uint8
    u1 = torch.tensor([[0, 255],
                       [128, 64]], dtype=torch.uint8).numpy()
    u2 = torch.tensor([[10, 20, 30]], dtype=torch.uint8).numpy()
    u3 = torch.tensor([[40],
                       [50]], dtype=torch.uint8).numpy()
    list_of_inputs.append(copy.deepcopy({"tensors": [u1, u2, u3]}))

    # Input 7: empty list (no tensors)
    list_of_inputs.append(copy.deepcopy({"tensors": []}))

    # Input 8: include an empty 0x0 matrix with a regular matrix (float32)
    e = torch.empty((0, 0), dtype=torch.float32).numpy()
    r = torch.tensor([[1.0, 2.0],
