    input = np.tile(base.reshape(1, 1, 2, 2), (2, 3, 1, 1))
    out = np.empty_like(input)
    list_of_inputs.append(copy.deepcopy({"input": input, "out": out}))

    # 14: batched 2x2 complex64 (batch=2)
    M1 = np.array([[1+1j, 0+0j],
