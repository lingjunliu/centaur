    # 3D int32 with a zero-sized dimension, swap dim 1 and 2
    input = torch.empty((2, 0, 5), dtype=torch.int32).numpy()
    dim0 = 1
    dim1 = 2
    list_of_inputs.append(copy.deepcopy({"input": input, "dim0": dim0, "dim1": dim1}))

    # 6D uint8, swap dims 2 and 4
