    lambd = 0.4
    list_of_inputs.append(copy.deepcopy({"lambd": float(lambd), "input": inp}))

    # 10: Empty array
    inp = np.array([], dtype=np.float32)
    lambd = 0.1
    list_of_inputs.append(copy.deepcopy({"lambd": float(lambd), "input": inp}))

    # 11: 5D array with broadcasting-friendly singleton dims
