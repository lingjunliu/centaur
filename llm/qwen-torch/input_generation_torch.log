                           [[True, False, True, False]],
                           [[False, True, True, False]]]], dtype=torch.bool).numpy()
    dim0 = 1
    dim1 = 3
    list_of_inputs.append(copy.deepcopy({"input": input, "dim0": dim0, "dim1": dim1}))

