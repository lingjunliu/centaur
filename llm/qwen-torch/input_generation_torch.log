    out_arr = torch.empty_like(t).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input_arr, "out": out_arr}))

    # 10: Column vector arange (float64)
    t = torch.arange(1, 6, dtype=torch.float64).view(5, 1)
    input_arr = t.numpy()
    out_arr = torch.empty_like(t).numpy()
