    inp = np.linspace(-2.0, 2.0, num=6, dtype=np.float32).reshape(2, 3)
    lambd = 0.0
    list_of_inputs.append(copy.deepcopy({"lambd": float(lambd), "input": inp}))

    # 3: 0D scalar float32
    inp = np.array(3.0, dtype=np.float32)
