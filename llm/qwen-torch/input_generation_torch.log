    list_of_inputs.append(copy.deepcopy({"input": input}))

    # 8: batch (2,1,1) with positive and negative
    input = np.array([[[3.0]],
                      [[-1.0]]], dtype=np.float64)
    list_of_inputs.append(copy.deepcopy({"input": input}))

    # 9: 3x3 diagonal with large values
