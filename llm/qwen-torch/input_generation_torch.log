    mat2_t = torch.randn(2, 4, 5, dtype=torch.float32)
    input = input_t.numpy()
    mat2 = mat2_t.numpy()
    out = np.empty((input.shape[0], input.shape[1], mat2.shape[2]), dtype=input.dtype)
    list_of_inputs.append(copy.deepcopy({"input": input, "mat2": mat2, "out": out}))

    # Input 2: float64, b=1
