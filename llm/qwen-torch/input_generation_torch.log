import torch, copy, numpy as np

def atleast_3d_inputs():
    list_of_inputs = []

    # 1: single 0-D float32
    a1 = torch.tensor(7.0, dtype=torch.float32).numpy()
    list_of_inputs.append(copy.deepcopy({"input": [a1]}))

    # 2: single 1-D int64 with negatives
    a2 = torch.tensor([-3, 0, 5], dtype=torch.int64).numpy()
    list_of_inputs.append(copy.deepcopy({"input": [a2]}))

    # 3: single 2-D float64
    a3 = torch.tensor([[1.2, -2.3], [3.4, 4.5]], dtype=torch.float64).numpy()
    list_of_inputs.append(copy.deepcopy({"input": [a3]}))

    # 4: multiple tensors: 0-D bool and 1-D bool
    a4_1 = torch.tensor(True).numpy()
    a4_2 = torch.tensor([False, True]).numpy()
    list_of_inputs.append(copy.deepcopy({"input": [a4_1, a4_2]}))

    # 5: single 3-D int32 with negatives
    a5 = torch.arange(-24, 0, dtype=torch.int32).view(2, 3, 4).numpy()
    list_of_inputs.append(copy.deepcopy({"input": [a5]}))

    # 6: single 4-D float16
    a6 = torch.randn(2, 3, 4, 5, dtype=torch.float16).numpy()
    list_of_inputs.append(copy.deepcopy({"input": [a6]}))

    # 7: single 1-D complex64
    a7 = torch.tensor([1 + 2j, -3 - 4j], dtype=torch.complex64).numpy()
    list_of_inputs.append(copy.deepcopy({"input": [a7]}))

    # 8: single empty 1-D float32
    a8 = torch.empty(0, dtype=torch.float32).numpy()
    list_of_inputs.append(copy.deepcopy({"input": [a8]}))

    # 9: single empty 2-D float64
    a9 = torch.empty(2, 0, dtype=torch.float64).numpy()
    list_of_inputs.append(copy.deepcopy({"input": [a9]}))

    # 10: non-contiguous 3-D float32 via transpose
    a10 = torch.arange(24, dtype=torch.float32).view(2, 3, 4).transpose(1, 2).numpy()
    list_of_inputs.append(copy.deepcopy({"input": [a10]}))

    # 11: multiple tensors: 0-D int16, 2-D bool, 3-D float32
    a11_1 = torch.tensor(-5, dtype=torch.int16).numpy()
    a11_2 = torch.tensor([[True, False], [False, True]]).numpy()
    a11_3 = torch.randn(1, 2, 3, dtype=torch.float32).numpy()
    list_of_inputs.append(copy.deepcopy({"input": [a11_1, a11_2, a11_3]}))

    # 12: multiple tensors: 0-D complex128, 1-D int8, 2-D float64
    a12_1 = torch.tensor(3 - 1j, dtype=torch.complex128).numpy()
    a12_2 = torch.tensor([-128, 0, 127], dtype=torch.int8).numpy()
    a12_3 = torch.tensor([[0.0]], dtype=torch.float64).numpy()
    list_of_inputs.append(copy.deepcopy({"input": [a12_1, a12_2, a12_3]}))

    return list_of_inputs

