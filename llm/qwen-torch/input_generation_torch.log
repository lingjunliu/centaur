import torch, copy
import numpy as np

def dequantize_2_inputs():
    list_of_inputs = []

    tensors = np.array([np.array([0, 127, -128, 64, -64], dtype=np.int8)], dtype=object)
    list_of_inputs.append(copy.deepcopy({"tensors": tensors}))

    tensors = np.array([np.array([[0, 255], [128, 64]], dtype=np.uint8)], dtype=object)
    list_of_inputs.append(copy.deepcopy({"tensors": tensors}))

    tensors = np.array([np.array([[[1, -1], [2, -2]], [[3, -3], [4, -4]]], dtype=np.int8)], dtype=object)
    list_of_inputs.append(copy.deepcopy({"tensors": tensors}))

    tensors = np.array([np.array([-2147483648, -1, 0, 1, 2147483647], dtype=np.int32)], dtype=object)
    list_of_inputs.append(copy.deepcopy({"tensors": tensors}))

    tensors = np.array([
        np.array([-5, 0, 5, 10], dtype=np.int8),
        np.array([10, 20, 30, 40], dtype=np.uint8)
    ], dtype=object)
    list_of_inputs.append(copy.deepcopy({"tensors": tensors}))

    tensors = np.array([np.random.randint(-128, 128, size=(2, 3, 4, 5), dtype=np.int8)], dtype=object)
    list_of_inputs.append(copy.deepcopy({"tensors": tensors}))

    tensors = np.array([np.asfortranarray(np.arange(24, dtype=np.uint8).reshape(2, 3, 4))], dtype=object)
    list_of_inputs.append(copy.deepcopy({"tensors": tensors}))

    base = np.arange(-60, 60, dtype=np.int8)
    tensors = np.array([base[::3]], dtype=object)
    list_of_inputs.append(copy.deepcopy({"tensors": tensors}))

    tensors = np.array([np.array(-7, dtype=np.int8)], dtype=object)
    list_of_inputs.append(copy.deepcopy({"tensors": tensors}))

    tensors = np.array([np.array([], dtype=np.int8)], dtype=object)
    list_of_inputs.append(copy.deepcopy({"tensors": tensors}))

    tensors = np.array([np.empty((2, 0, 3), dtype=np.int8)], dtype=object)
    list_of_inputs.append(copy.deepcopy({"tensors": tensors}))

    tensors = np.array([np.arange(-12, 0, dtype=np.int8).reshape(3, 4).T], dtype=object)
    list_of_inputs.append(copy.deepcopy({"tensors": tensors}))

    return list_of_inputs

