def svdvals_inputs():
    list_of_inputs = []

    # Helper to get output dtype for given input dtype
    def out_dtype_for(dtype):
        if dtype == torch.complex64:
            return torch.float32
        if dtype == torch.complex128:
            return torch.float64
        return dtype

