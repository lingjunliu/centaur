import torch, copy
import numpy as np

def view_as_complex_inputs():
    list_of_inputs = []

    input = torch.tensor([1.0, -2.0], dtype=torch.float32).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.tensor([[1.5, -0.5],
                          [0.0, 2.0],
                          [-3.0, 4.0]], dtype=torch.float64).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.arange(0, 24, dtype=torch.float32).reshape(3, 4, 2).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = (torch.rand((2, 3, 4, 2), dtype=torch.float32) * 2 - 1).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.zeros((1, 2, 1, 3, 2), dtype=torch.float64).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.empty((0, 2), dtype=torch.float32).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.empty((4, 0, 2), dtype=torch.float64).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.tensor([[float('nan'), 0.0],
                          [float('inf'), -float('inf')]], dtype=torch.float32).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.linspace(-10, 10, steps=12, dtype=torch.float32).reshape(6, 2).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.randn((3, 5, 2), dtype=torch.float64).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.tensor([[1e20, -1e20],
                          [1e-20, -1e-20],
                          [3.14159265, -2.71828183],
                          [-0.0, 0.0],
                          [-123456789.0, 987654321.0]], dtype=torch.float64).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.full((7, 2), fill_value=-3.5, dtype=torch.float32).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    return list_of_inputs

