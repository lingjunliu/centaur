import torch, copy

def swapdims_inputs():
    list_of_inputs = []

    # 1D float32, swapping same dim (no-op)
    input = torch.arange(5, dtype=torch.float32).numpy()
    dim0 = 0
    dim1 = 0
    list_of_inputs.append(copy.deepcopy({"input": input, "dim0": dim0, "dim1": dim1}))

