    list_of_inputs.append(copy.deepcopy({"tensors": [e, r]}))

    # Input 9: zero-sized dimensions (0x3) and (2x0) float32
    z1 = torch.empty((0, 3), dtype=torch.float32).numpy()
    z2 = torch.empty((2, 0), dtype=torch.float32).numpy()
    list_of_inputs.append(copy.deepcopy({"tensors": [z1, z2]}))

    # Input 10: float16 matrices of differing shapes
    h1 = torch.tensor([[1.0, -2.0, 3.0],
