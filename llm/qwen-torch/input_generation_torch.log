import torch, copy
import numpy as np

def view_as_complex_inputs():
    list_of_inputs = []

    input = torch.tensor([1.0, -2.0], dtype=torch.float32).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.tensor([[1.5, -0.5],
                          [0.0, 2.0],
                          [-3.0, 4.0]], dtype=torch.float64).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.arange(0, 12, dtype=torch.float16).reshape(2, 3, 2).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = (torch.rand((1, 2, 3, 2), dtype=torch.float32) * 2 - 1).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.empty((0, 2), dtype=torch.float32).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.empty((4, 0, 2), dtype=torch.float64).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.linspace(-10, 10, steps=20, dtype=torch.float16).reshape(10, 2).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.zeros((2, 1, 3, 4, 2), dtype=torch.float32).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    arr = np.arange(24, dtype=np.float32).reshape(3, 4, 2)
    arr = arr[:, ::-1, :]
    input = np.ascontiguousarray(arr)
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = np.array([[np.nan, 0.0],
                      [1.0, np.nan]], dtype=np.float64)
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = np.array([[1e20, -1e20],
                      [1e-20, -1e-20],
                      [3.14159265, -2.71828183],
                      [-0.0, 0.0],
                      [-123456789.0, 987654321.0]], dtype=np.float64)
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = (torch.randn((2, 2, 2, 2), dtype=torch.float16) * 5).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    return list_of_inputs

