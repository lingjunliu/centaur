    mat2_t = torch.randn(1, 2, 3, dtype=torch.float64)
    input = input_t.numpy()
    mat2 = mat2_t.numpy()
    out = np.zeros((1, 2, 3), dtype=input.dtype)
    list_of_inputs.append(copy.deepcopy({"input": input, "mat2": mat2, "out": out}))

