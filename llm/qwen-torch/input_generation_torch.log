    input = base[:, ::2].numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.zeros(2, 0, 3, 1, dtype=torch.float64).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = torch.tensor([0+0j, -1+0j, 2.5+0j], dtype=torch.complex64).numpy()
    list_of_inputs.append(copy.deepcopy({"input": input}))

