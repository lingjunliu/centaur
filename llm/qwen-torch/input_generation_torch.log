import torch, copy
import numpy as np

def lu_solve_inputs():
    list_of_inputs = []

    # Input 1: float32, 3x3, k=1
    m = 3
    A = torch.randn(m, m, dtype=torch.float32)
    A = A + torch.eye(m, dtype=torch.float32) * 3.0
    LU_data, LU_pivots = torch.linalg.lu_factor(A)
    b = torch.randn(m, 1, dtype=torch.float32)
