    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = np.ascontiguousarray(np.zeros((6, 2), dtype=np.float64))
    list_of_inputs.append(copy.deepcopy({"input": input}))

    input = np.ascontiguousarray(np.full((7, 2), -3.5, dtype=np.float32))
