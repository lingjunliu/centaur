def tf_image_transpose_inputs():
    list_of_inputs = []

    # Input 1: 3D float32 with negatives
    image = np.array(
        [[[ -1.0, 0.5], [2.5, -3.2], [4.1, 5.5]],
         [[7.0, -8.0], [9.2, 10.3], [-11.4, 12.6]]],
