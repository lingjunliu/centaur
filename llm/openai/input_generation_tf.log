    input_dict = {"image": image, "name": "transpose_case_2"}
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 3: 3D int32 non-square dims
    image = (np.arange(5*2*4).reshape(5, 2, 4).astype(np.int32) - 10)
    input_dict = {"image": image, "name": "transpose_case_3"}
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 4: 4D float64 with batch=1, height=1
    image = np.linspace(-1, 1, 1*1*5*2).reshape(1, 1, 5, 2).astype(np.float64)
    input_dict = {"image": image, "name": "transpose_case_4"}
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 5: 3D uint16 with large values
    image = np.array(
        [[[1000, 2000], [3000, 4000]],
         [[5000, 6000], [7000, 8000]],
         [[9000, 10000], [11000, 12000]]],
        dtype=np.uint16
    )
    input_dict = {"image": image, "name": "transpose_case_5"}
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 6: 4D int16 with negatives
    image = (np.random.randint(-1000, 1000, size=(4, 3, 2, 3))).astype(np.int16)
    input_dict = {"image": image, "name": "transpose_case_6"}
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 7: 3D complex64
    real = (np.arange(3*3*2) / 10.0).reshape(3, 3, 2).astype(np.float32)
    imag = (-np.arange(3*3*2) / 10.0).reshape(3, 3, 2).astype(np.float32)
    image = (real + 1j * imag).astype(np.complex64)
    input_dict = {"image": image, "name": "transpose_case_7"}
    list_of_inputs.append(copy.deepcopy(input_dict))

    # Input 8: 4D float32 single channel
