    list_of_inputs.append(copy.deepcopy({"image": image, "gamma": gamma, "gain": gain}))

    # Input 7: uint16 single-channel HWC
    rng = np.random.RandomState(5)
    image = rng.randint(0, 1024, size=(4, 4, 1), dtype=np.uint16)
