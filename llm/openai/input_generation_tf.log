import numpy as np
import copy

def tf_linalg_LinearOperatorCirculant2D_inputs():
    rng = np.random.default_rng(123)
    list_of_inputs = []

    def hermitize(arr):
        a = np.array(arr, dtype=np.complex64, copy=True)
        N0, N1 = a.shape[-2], a.shape[-1]
        out = np.empty_like(a)
        it = np.ndindex(a.shape[:-2])
        for idx in it:
            A = a[idx]
            H = np.empty_like(A)
            for n0 in range(N0):
                for n1 in range(N1):
                    m0 = (-n0) % N0
                    m1 = (-n1) % N1
                    H[n0, n1] = 0.5 * (A[n0, n1] + np.conj(A[m0, m1]))
            out[idx] = H
        return out

    # Input 1: Real positive spectrum, float32
    spectrum = np.array([[1.5, 2.0, 3.25],
                         [4.5, 5.0, 6.75]], dtype=np.float32)
    input_dict = {
