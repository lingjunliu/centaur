        start_list=[0, 0, 1],
        output_indices_list=[[0, 1, 2], [1, 2, 3], [2, 3, 4], [3, 4, 5]],
        extra_inputs=2
    )))

    list_of_inputs.append(copy.deepcopy(add_case(
        name="sparse_slice_grad_case_4_uint8_rank2",
        backprop_vals=[255],
        backprop_dtype=np.uint8,
        start_list=[5, 0],
        output_indices_list=[[2, 2]],
        extra_inputs=3
