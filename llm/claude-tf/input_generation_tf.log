    x = np.array([1.0, 2.0, 3.0, 4.0])
    input_dict = {"x": x}
    list_of_inputs.append(copy.deepcopy(input_dict))
    
    # Input 5: 2D array with infinity values
    x = np.array([[np.inf, 1.0], [-np.inf, 2.0]])
    input_dict = {"x": x}
    list_of_inputs.append(copy.deepcopy(input_dict))
    
    # Input 6: 3D array with infinity values
